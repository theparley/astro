---
/* IDEEN, NICHT EINGEBUNDEN (Rasul 13.11.2026): „alles, was jetzt nach Augenzeugen kommt, macht
   das alles mal weg. Weil es ja jetzt nicht mehr unserer Reise entspricht, wir nehmen vielleicht
   wieder Teile daraus, also nicht löschen. Aber wir werden das so nicht verwenden, nur als Ideen.“
   Hier liegen die Abschnitte 6 bis 9 der Startseite (Befragung, Kosten, Zur Person, Termin) so,
   wie sie am 13.11.2026 aus Bausteinen gebaut waren. Liegt außerhalb von src/pages, wird also nicht
   als Seite gebaut. Wiederverwenden: Abschnitt herauskopieren oder die Datei als Komponente
   einbinden. Texte waren noch nicht abgenommen, Preise offen. */
import Seitentitel from "../components/bausteine/Seitentitel.astro";
import Akkordeon from "../components/bausteine/Akkordeon.astro";
import Textblock from "../components/bausteine/Textblock.astro";
import Karten from "../components/bausteine/Karten.astro";
import TextBild from "../components/bausteine/TextBild.astro";
import Platzhalter from "../components/bausteine/Platzhalter.astro";
import Aufruf from "../components/bausteine/Aufruf.astro";

const FRAGEN = [
	["Wie viel Zeit kostet uns das?", "Unter zwei Stunden im Monat, davon eine im Gespräch. Vorher ein kurzes Telefonat zu Thema und Gast, danach die Freigabe am Rechner. Skript, Technik, Schnitt und Ausspielung übernehmen wir."],
	["Müssen wir etwas vorbereiten?", "Nein. Ihr redet über das, was ihr ohnehin wisst. Die Fragen stellen wir."],
	["Wir sind keine Creator. Passt das trotzdem?", "Genau dafür ist es gemacht. Ihr müsst euch nicht anpreisen, ihr werdet gefragt."],
	["Unser Thema haben doch schon alle besprochen.", "Gesagt haben es viele. Im Gespräch hört man, wie ihr darüber denkt. Das kann niemand kopieren."],
	["Was, wenn uns ein Satz nicht gefällt?", "Nichts geht raus, was ihr nicht freigegeben habt. Ihr bekommt eine Korrekturliste und entscheidet."],
	["Wo nehmen wir auf?", "Im Blickkontaktstudio in Karlsruhe, mit unserem mobilen Studio bei euch oder in einem eigenen Studio, das wir bei euch einrichten."],
	["Was kostet das?", "Ihr bezahlt kein Paket, sondern das, was ihr braucht: je Gespräch, je Beitrag und monatlich für die Formatredaktion, die euren Kanal führt. Die Preise stehen gleich darunter."],
];

const PREISE = [
	{ titel: "Gespräch", zeile: "Die Aufnahme mit allem, was zur Folge gehört.<br />[Preis offen]", platzhalter: "Platzhalter: Preis offen" },
	{ titel: "Beitrag", zeile: "Der fertige Ausschnitt samt Text.<br />[Preis offen]", platzhalter: "Platzhalter: Preis offen" },
	{ titel: "Formatredaktion", zeile: "Redaktion, Ausspielung, Kommentare und Monatsbericht.<br />[Preis offen] je Monat", platzhalter: "Platzhalter: Preis offen" },
];
---

{/* ── 6 · DIE BEFRAGUNG ── hell (BBH: Lektüre hell). Seitentitel B1 mittig, Akkordeon B11
   ohne Titel: Mitte 8 von 12. Texte noch nicht abgenommen. */}
<section class="abschnitt hell" aria-labelledby="ab6-titel">
	<Seitentitel id="ab6-titel" titel="Was ihr uns oft fragt." />
	<div class="nach-titel"><Akkordeon fragen={FRAGEN} /></div>
</section>

{/* ── 7 · DIE KOSTEN ── Textblock in der Mitte, darunter drei Karten (B7, Drittel).
   Texte noch nicht abgenommen, Preise offen. */}
<section class="abschnitt" aria-labelledby="ab7-titel">
	<Textblock id="ab7-titel" titel="Ihr bezahlt, was ihr braucht.">
		<p>Je Gespräch die Aufnahme mit allem, was zur Folge gehört. Je Beitrag der fertige Ausschnitt samt Text. Und monatlich die Formatredaktion, die euren Kanal führt: Redaktion, Ausspielung, Kommentare und Monatsbericht. Was das für euer Format heißt, rechnen wir am besten gemeinsam durch.</p>
	</Textblock>
	<div class="nach-textbild"><Karten spalten={3} format="4/3" karten={PREISE} /></div>
</section>

{/* ── 8 · ZUR PERSON ── B6 Text-Bild, Foto als Anker links. Texte noch nicht abgenommen. */}
<section class="abschnitt" aria-labelledby="ab8-titel">
	<TextBild id="ab8-titel" titel="Ich stelle die Fragen.">
		<Platzhalter slot="medium" format="1/1" text="Platzhalter: Foto Fred" />
		<p>Ich bin Fred Eric Eckert. Mit Parley Film bringe ich Experten ins Gespräch, im Blickkontaktstudio in Karlsruhe, mit dem mobilen Studio bei euch oder in einem Studio, das wir bei euch einrichten. Am liebsten lerne ich euch persönlich kennen.</p>
		<p><span class="entwurf">Platzhalter: Ich-Text aus der Gesamtgeschichte einarbeiten; Foto Studio Lotzbeckstraße</span></p>
	</TextBild>
</section>

{/* ── 9 · DER TERMIN ── Aufruf R11: Bogle xl, ein Satz, ein Knopf, mittig. */}
<section class="abschnitt abschnitt--letzter" aria-labelledby="ab9-titel">
	<Aufruf id="ab9-titel" titel="Euer Gespräch fängt hier an." knopf={{ href: "/termin", text: "Let’s Parley" }}>
		<p>Kommt zum Studiotermin, schaut euch das Blickkontaktstudio an und erzählt uns, worüber ihr sprechen wollt. In 30 Minuten wisst ihr, welches Format zu euch passt. Online geht es auch.</p>
	</Aufruf>
</section>

<style>
	.nach-textbild { margin-top: var(--abstand-lg); }
	.nach-titel { margin-top: var(--abstand-md); }
	.abschnitt--letzter { margin-bottom: var(--abstand-xl); }
</style>
