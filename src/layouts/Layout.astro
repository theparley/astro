---
import { ClientRouter } from "astro:transitions";
// Phase-1-Menü-Rückbau (Website-Brief, "Entscheidung 29.08."): das Kachel-
// Menü-System ist archiviert in TileMenu.astro (aktuell nicht eingebunden,
// Kommentar-Kopf dort erklärt die Reaktivierung für Phase 2). Aktiv bleibt
// nur noch der eigenständige CTA-Button (CtaTile.astro); das Logo lebt jetzt
// nur noch im Hero der Startseite (BrandLogo.astro, siehe index.astro).
import CtaTile from "../components/CtaTile.astro";
import PageWipe from "../components/PageWipe.astro";

interface Props {
	title: string;
	description?: string;
	// true nur auf /buchen: "Let's Parley" verschwindet, weil die Tür, auf die
	// der Button zeigt, schon erreicht ist (Website-Brief, Konversions-Kapitel).
	hideCta?: boolean;
	// true nur auf der Startseite: der CTA bleibt verdeckt, bis das Hero-Logo
	// (BrandLogo.astro) aus dem Viewport gescrollt ist — siehe Bugfix-
	// Kommentar in CtaTile.astro. Unterseiten haben keinen Hero und zeigen
	// den CTA deshalb sofort.
	gateCtaBehindHero?: boolean;
}

const {
	title,
	description = "Kein Business ohne Witness. Echte Gespräche, filmreif ohne Kamerastress. Als Videopodcast, Webinar, Clip oder Kundentestimonial.",
	hideCta = false,
	gateCtaBehindHero = false,
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · The Parley</title>
		<ClientRouter />
	</head>
	<body>
		<PageWipe />
		<CtaTile hideCta={hideCta} gateBehindHero={gateCtaBehindHero} />
		<slot />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Forma DJR";
		src: url("/fonts/FormaDJRVariable.woff2") format("woff2-variations");
		font-weight: 100 900;
		font-style: normal;
		font-display: swap;
	}

	:root {
		/* Farb-Treppe (29.08., aus BBHs ausgeliefertem CSS gemessen + für Parley
		   adaptiert — gilt seitenweit als Token-Satz, siehe Website-Brief
		   /buchen-Kapitel). Ersetzt die vorherigen Ad-hoc-Werte (--white war
		   #fafafa, --gray war #888) durch die entschiedenen Spec-Werte. */
		--black: #000000;
		--panel: #0d0d0d;
		--tile: #404040;
		--tile-text: #c8c8c8;
		--surface: #ededed;
		--white: #ffffff;
		--gray: #999894;
		--line: #2a2a2a;
		--max-width: 1100px;
		--logo-h: clamp(32px, 4.4vw, 56px);
		/* Fahne + Lücke + Text bei --logo-h, aus den Original-SVG-Maßen (1160.62/2018.08 Fahne, 1986.93/2018.08 Text, 4px Lücke) */
		--logo-w: calc(var(--logo-h) * 1.5596 + 4px);
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--black);
	}

	body {
		margin: 0;
		background: var(--black);
		color: var(--white);
		font-family: "Forma DJR", Helvetica, Arial, sans-serif;
		font-weight: 400;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
	}

	h1, h2, h3, p {
		margin: 0;
	}
</style>
