---
import { ClientRouter } from "astro:transitions";
// Menü-Umbau (Fred 30.08. abends, "grundlegend andere Entscheidung"): der
// Let's-Parley-CTA (CtaTile.astro, jetzt unbenutzt/archiviert) ist durch den
// Zwetschke-artigen Menü-Knopf ersetzt (MenuTile.astro — Hamburger + "Menü",
// eckig, klappt große Listenzeilen nach oben auf; "Kontakt" übernimmt darin
// die Tür zu /termin). Der Knopf ist Navigation, kein Verkaufsknopf — er
// erscheint deshalb auf JEDER Seite, auch /termin (die frühere hideCta-Logik
// entfällt). TileMenu.astro (BBH-Kachelmenü) bleibt weiter archiviert.
import MenuTile from "../components/MenuTile.astro";
// Alternative nach BBH (Rasul 13.11.2026, „Als Alternative“), umschaltbar, siehe Menü-Wahl unten.
import MenuBBH from "../components/MenuBBH.astro";
import PageWipe from "../components/PageWipe.astro";
import SiteFooter from "../components/SiteFooter.astro";
// Designsystem nach BBH (Neustart 13.11.2026): Schriften, Tokens, Raster, Textstile, Bewegung.
import "../styles/system.css";

interface Props {
	// Ohne title = Startseite (eigener Tab-Titel, s. unten).
	title?: string;
	description?: string;
	// true nur auf der Startseite: der Menü-Knopf bleibt verdeckt, bis das
	// Hero-Logo (BrandLogo.astro) eingefahren ist und ihn aus der Stange
	// "gebiert". Unterseiten haben keinen Hero und zeigen ihn sofort.
	gateMenuBehindHero?: boolean;
}

const {
	title,
	description = "Kein Business ohne Witness. Echte Gespräche, filmreif ohne Kamerastress. Als Videopodcast, Webinar, Clip oder Kundentestimonial.",
	gateMenuBehindHero = false,
} = Astro.props;

// NAME IM TAB (Fred 26.10.2026, Namensregel in PARLEY_WORDING.md: Parley Film
// ist der Name nach außen, The Parley wird das Studio). Unterseiten
// „Studio · Parley Film“, die Startseite trägt Name und Satz aus der
// Claim-Architektur (Nachtrag 25.10.: „Parley Film. Echte Gespräche.
// Filmreif.“). Vorher „{title} · The Parley“.
const SITE_NAME = "Parley Film";
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Echte Gespräche. Filmreif.`;
// Websitename für Google (strukturierte Daten WebSite, nur auf der
// Startseite, wie Google es verlangt). Die Adresse kommt aus `site` in
// astro.config.mjs (seit 26.10.2026 parleyfilm.com, vorher theparley.de).
const SITE_URL = new URL("/", Astro.site).href;
// Canonical und Open Graph: immer die parleyfilm.com-Adresse der Seite, auch
// wenn sie über die pages.dev-Vorschau oder die alte Domain aufgerufen wird.
// Mit Schrägstrich am Ende, wie Astro baut: Cloudflare Pages leitet /kontakt
// per 308 auf /kontakt/ um.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const websiteJsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_NAME,
	url: SITE_URL,
});
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{/* Schriften vorladen (Neustart 13.11.2026): Lesetext und Hero-Schrift sind beim ersten Bild da,
		   sonst springt die Seite nach dem Laden (Befund 14.06.2026). Alle frei, selbst gehostet. */}
		<link rel="preload" href="/fonts/frei/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/frei/BBH-DE-Ecken-Hegarty.woff2?v=1" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/frei/BBH-DE-Ecken-Bogle.woff2?v=1" as="font" type="font/woff2" crossorigin />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		{!title && <script type="application/ld+json" set:html={websiteJsonLd} />}
		<ClientRouter />
		{/* Menü-Wahl (Rasul 13.11.2026): Zwetschke-Knopf (Standard) oder BBH-Kachelmenü.
		   Umschalten mit ?menu=bbh bzw. ?menu=zwetschke oder dem Schalter unten rechts;
		   die Wahl bleibt im Browser gespeichert und überlebt Seitenwechsel. */}
		<script is:inline>
			(function () {
				var K = "parley-menu";
				function lies() {
					var q = new URLSearchParams(location.search).get("menu");
					try {
						if (q === "bbh" || q === "zwetschke") localStorage.setItem(K, q);
						return localStorage.getItem(K) || "zwetschke";
					} catch (e) { return q || "zwetschke"; }
				}
				// Hero-Demo (Rasul 13.11.2026: „machen wir doch jetzt mal kurz eine Demo, wo wir unser Video
				// Bildschirmflächen machen, voll machen und das Menü so drübersetzen wie BBH“): ?hero=film|text.
				// Im Film-Modus gilt immer das BBH-Menü. Grundeinstellung seit 13.11.2026 „film“ (Rasul: „Also ich
				// glaube, mit dem großen Video am Anfang ist es die beste Lösung.“).
				function liesHero() {
					var q = new URLSearchParams(location.search).get("hero");
					try {
						if (q === "film" || q === "text") localStorage.setItem("parley-hero", q);
						return localStorage.getItem("parley-hero") || "film";
					} catch (e) { return q || "film"; }
				}
				// Grundeinstellung „gemischt“ (Rasul 13.11.2026: „Ja, Gemischt“).
				// Menülage (Rasul 13.11.2026: „wir kleben es gleich unten mittig an den Bildschirm. Und beim
				// Scrollen fährt es dann zusammen, das gucken wir uns mal als Variante an“): ?lage=unten|links.
				function liesLage() {
					var q = new URLSearchParams(location.search).get("lage");
					try {
						if (q === "unten" || q === "links" || q === "gemischt") localStorage.setItem("parley-lage", q);
						return localStorage.getItem("parley-lage") || "gemischt";
					} catch (e) { return q || "gemischt"; }
				}
				// Satz-Vergleich unter dem Film (13.11.2026): ?satz=a bis y; Grundeinstellung y (Rasul 13.11. abends: „Ja, wir nehmen ypsilon.“; davor w, v, i)
				function liesSatz() {
					var q = new URLSearchParams(location.search).get("satz");
					try {
						if (q === "a" || q === "b" || q === "c" || q === "d" || q === "e" || q === "f" || q === "g" || q === "h" || q === "i" || q === "j" || q === "k" || q === "l" || q === "m" || q === "n" || q === "o" || q === "p" || q === "q" || q === "r" || q === "s" || q === "t" || q === "u" || q === "v" || q === "w" || q === "x" || q === "y") localStorage.setItem("parley-satz", q);
						return localStorage.getItem("parley-satz") || "y";
					} catch (e) { return q || "y"; }
				}
				function liesUmlaut() {
					var q = new URLSearchParams(location.search).get("umlaut");
					try {
						if (q === "innen" || q === "aussen" || q === "ecken") localStorage.setItem("parley-umlaut", q);
						return localStorage.getItem("parley-umlaut") || "ecken"; // Grundeinstellung „Ecken“ seit 13.11.2026 abends
					} catch (e) { return q || "ecken"; }
				}
				// Anlass vor den Kacheln (13.11.2026 abends): ?kopf=videobeweis|band|kachel; Grundeinstellung „videobeweis“.
				// Rasul: „sollen wir nicht erst nochmal dann die Szene setzen, also jetzt den Spruch bringen? Oder gleich einsteigen?“
				function liesKopf() {
					var q = new URLSearchParams(location.search).get("kopf");
					try {
						if (q === "videobeweis" || q === "band" || q === "kachel") localStorage.setItem("parley-kopf", q);
						return localStorage.getItem("parley-kopf") || "band"; // Grundeinstellung „band“ seit 13.11.2026 abends (Rasul: Aufbau Film, Satz, Problem, Kacheln „Beweis“)
					} catch (e) { return q || "band"; }
				}
				// Ende der Animation Experten-Auswahl (13.11.2026 abends): ?ende=drei|eins|grau|unscharf; Grundeinstellung „unscharf“
				// (Rasul 13.11.2026 abends: „Unscharf“; dazu: „Es würde unbewusst klarmachen, dass wir einen Fokus geben.“)
				function liesEnde() {
					var q = new URLSearchParams(location.search).get("ende");
					try {
						if (q === "drei" || q === "eins" || q === "grau" || q === "unscharf" || q === "ebenen" || q === "kamera") localStorage.setItem("parley-ende", q);
						return localStorage.getItem("parley-ende") || "kamera";
					} catch (e) { return q || "kamera"; }
				}
				// Rahmen der Experten-Auswahl (13.11.2026 abends): ?rahmen=21|16; Grundeinstellung 21 (21:9, Rasul: „Probier mal 21 zu 9“)
				function liesRahmen() {
					var q = new URLSearchParams(location.search).get("rahmen");
					try {
						if (q === "21" || q === "16") localStorage.setItem("parley-rahmen", q);
						return localStorage.getItem("parley-rahmen") || "16"; // seit 13.11.2026 abends wieder 16:9 (Rasul: „dass es verständlicher ist“)
					} catch (e) { return q || "16"; }
				}
				// Form der Personen in der Kamerafahrt (13.11.2026 abends): ?form=figur|punkt; Grundeinstellung „figur“
				// (Rasul: „Vielleicht machen wir sogar noch als Variante, dass es wirklich Punkte sind am Anfang und am Ende zu Personen werden.“)
				function liesForm() {
					var q = new URLSearchParams(location.search).get("form");
					try {
						if (q === "figur" || q === "punkt") localStorage.setItem("parley-form", q);
						return localStorage.getItem("parley-form") || "figur"; // Rasul 13.11.2026 abends: „Zurück zu Figuren“
					} catch (e) { return q || "figur"; }
				}
				// Höhe der Kamera am Ende (13.11.2026 abends): ?hoehe=oben|auge; Grundeinstellung „oben“
				function liesHoehe() {
					var q = new URLSearchParams(location.search).get("hoehe");
					try {
						if (q === "oben" || q === "auge") localStorage.setItem("parley-hoehe", q);
						return localStorage.getItem("parley-hoehe") || "auge"; // Rasul 13.11.2026 abends: „Augenhöhe“
					} catch (e) { return q || "auge"; }
				}
				// Aufstellung der Personen (13.11.2026 abends): ?aufstellung=reihen|nah; Grundeinstellung „reihen“
				function liesAufstellung() {
					var q = new URLSearchParams(location.search).get("aufstellung");
					try {
						if (q === "reihen" || q === "nah") localStorage.setItem("parley-aufstellung", q);
						return localStorage.getItem("parley-aufstellung") || "reihen";
					} catch (e) { return q || "reihen"; }
				}
				// Höhe der Animation in % der Fensterhöhe und Größe der Band-Überschrift (13.11.2026 abends)
				function liesWahl(name, werte, vorgabe) {
					var q = new URLSearchParams(location.search).get(name);
					try {
						if (werte.indexOf(q) >= 0) localStorage.setItem("parley-" + name, q);
						return localStorage.getItem("parley-" + name) || vorgabe;
					} catch (e) { return q || vorgabe; }
				}
				// Aufbau der Startseite (13.11.2026): ?aufbau=abschnitte|kacheln; Grundeinstellung „kacheln“ (Rasul: „Kacheln“)
				function liesAufbau() {
					var q = new URLSearchParams(location.search).get("aufbau");
					try {
						if (q === "abschnitte" || q === "kacheln") localStorage.setItem("parley-aufbau", q);
						return localStorage.getItem("parley-aufbau") || "kacheln";
					} catch (e) { return q || "kacheln"; }
				}
				function setze() {
					document.documentElement.dataset.aufbau = liesAufbau();
					document.documentElement.dataset.umlaut = liesUmlaut();
					document.documentElement.dataset.kopf = liesKopf();
					document.documentElement.dataset.ende = liesEnde();
					document.documentElement.dataset.rahmen = liesRahmen();
					document.documentElement.dataset.form = liesForm();
					document.documentElement.dataset.hoehe = liesHoehe();
					document.documentElement.dataset.aufstellung = liesAufstellung();
					document.documentElement.dataset.animhoehe = liesWahl("animhoehe", ["100", "90", "80", "70", "60", "50"], "50"); // 50 % Grundeinstellung (Rasul 14.11.2026: „Mach mal auf 50 … Dann würde, glaube ich, alles drauf passen, die Überschrift“)
					document.documentElement.dataset.titelgroesse = liesWahl("titelgroesse", ["huge", "2xl"], "2xl");
					document.documentElement.dataset.raster = liesWahl("raster", ["aus", "an"], "aus");
					document.documentElement.dataset.satz = liesSatz();
					document.documentElement.dataset.lage = liesLage();
					var h = liesHero();
					document.documentElement.dataset.hero = h;
					document.documentElement.dataset.menu = h === "film" ? "bbh" : lies();
				}
				setze();
				if (!window.__parleyMenuWahl) {
					window.__parleyMenuWahl = true;
					document.addEventListener("astro:after-swap", setze);
				}
			})();
		</script>
	</head>
	<body>
		<PageWipe />
		<MenuTile gateBehindHero={gateMenuBehindHero} />
		<MenuBBH startseite={gateMenuBehindHero} />
		{/* Schalter zum Ausprobieren, nur lokal (npm run dev) sichtbar, nie auf der Live-Seite. */}
		{import.meta.env.DEV && (<>
			{/* Einstellungen nur lokal, seit 13.11.2026 abends als Knopf unten rechts zum Auf- und Zumachen (Rasul: „Ich habe
			    jetzt so einen riesen Einstellungsmenü quer über den Bildschirm oben. Mach mir das mal rechts unten hin als
			    Knopf zum Auf- und Zumachen.“). Zustand offen/zu bleibt im Browser gespeichert. */}
			<button type="button" class="menu-wahl-knopf" aria-controls="menu-wahl" aria-expanded="false" aria-label="Einstellungen zum Testen">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /><circle cx="9" cy="6" r="2.2" /><circle cx="15" cy="12" r="2.2" /><circle cx="7" cy="18" r="2.2" /></svg>
			</button>
			<div class="menu-wahl" id="menu-wahl" aria-label="Menü zum Testen umschalten" hidden>
				<div class="menu-wahl__zeile">
					<span>Menü</span>
					<button type="button" data-wahl="zwetschke">Zwetschke</button>
					<button type="button" data-wahl="bbh">BBH</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Aufbau</span>
					<button type="button" data-aufbau-wahl="abschnitte">Abschnitte</button>
					<button type="button" data-aufbau-wahl="kacheln">Kacheln</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Kacheln</span>
					<button type="button" data-kopf-wahl="videobeweis">Videobeweis</button>
					<button type="button" data-kopf-wahl="band">Band</button>
					<button type="button" data-kopf-wahl="kachel">Kachel</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Animation</span>
					<button type="button" data-ende-wahl="drei">Drei</button>
					<button type="button" data-ende-wahl="eins">Einer</button>
					<button type="button" data-ende-wahl="grau">Grau</button>
					<button type="button" data-ende-wahl="unscharf">Unscharf</button>
					<button type="button" data-ende-wahl="ebenen">Ebenen</button>
					<button type="button" data-ende-wahl="kamera">Kamera</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Rahmen</span>
					<button type="button" data-rahmen-wahl="21">21:9</button>
					<button type="button" data-rahmen-wahl="16">16:9</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Form</span>
					<button type="button" data-form-wahl="figur">Figuren</button>
					<button type="button" data-form-wahl="punkt">Punkte</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Höhe</span>
					<button type="button" data-hoehe-wahl="oben">Leicht von oben</button>
					<button type="button" data-hoehe-wahl="auge">Augenhöhe</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Aufstellung</span>
					<button type="button" data-aufstellung-wahl="reihen">Reihen</button>
					<button type="button" data-aufstellung-wahl="nah">Nah, locker</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Animation hoch</span>
					<button type="button" data-allg-wahl="animhoehe" data-wert="100">100 %</button>
					<button type="button" data-allg-wahl="animhoehe" data-wert="90">90 %</button>
					<button type="button" data-allg-wahl="animhoehe" data-wert="80">80 %</button>
					<button type="button" data-allg-wahl="animhoehe" data-wert="70">70 %</button>
					<button type="button" data-allg-wahl="animhoehe" data-wert="60">60 %</button>
					<button type="button" data-allg-wahl="animhoehe" data-wert="50">50 %</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Überschrift</span>
					<button type="button" data-allg-wahl="titelgroesse" data-wert="huge">huge</button>
					<button type="button" data-allg-wahl="titelgroesse" data-wert="2xl">2xl</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Raster</span>
					<button type="button" data-allg-wahl="raster" data-wert="aus">aus</button>
					<button type="button" data-allg-wahl="raster" data-wert="an">an</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Umlaut</span>
					<button type="button" data-umlaut-wahl="aussen">Außen</button>
					<button type="button" data-umlaut-wahl="innen">Innen</button>
					<button type="button" data-umlaut-wahl="ecken">Ecken</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Satz</span>
					<button type="button" data-satz-wahl="a">A</button>
					<button type="button" data-satz-wahl="b">B</button>
					<button type="button" data-satz-wahl="c">C</button>
					<button type="button" data-satz-wahl="d">D</button>
					<button type="button" data-satz-wahl="e">E</button>
					<button type="button" data-satz-wahl="f">F</button>
					<button type="button" data-satz-wahl="g">G</button>
					<button type="button" data-satz-wahl="h">H</button>
					<button type="button" data-satz-wahl="i">I</button>
					<button type="button" data-satz-wahl="j">J</button>
					<button type="button" data-satz-wahl="k">K</button>
					<button type="button" data-satz-wahl="l">L</button>
					<button type="button" data-satz-wahl="m">M</button>
					<button type="button" data-satz-wahl="n">N</button>
					<button type="button" data-satz-wahl="o">O</button>
					<button type="button" data-satz-wahl="p">P</button>
					<button type="button" data-satz-wahl="q">Q</button>
					<button type="button" data-satz-wahl="r">R</button>
					<button type="button" data-satz-wahl="s">S</button>
					<button type="button" data-satz-wahl="t">T</button>
					<button type="button" data-satz-wahl="u">U</button>
					<button type="button" data-satz-wahl="v">V</button>
					<button type="button" data-satz-wahl="w">W</button>
					<button type="button" data-satz-wahl="x">X</button>
					<button type="button" data-satz-wahl="y">Y</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Lage</span>
					<button type="button" data-lage-wahl="links">Links</button>
					<button type="button" data-lage-wahl="unten">Unten</button>
					<button type="button" data-lage-wahl="gemischt">Gemischt</button>
				</div>
				<div class="menu-wahl__zeile">
					<span>Hero</span>
					<button type="button" data-hero-wahl="text">Text</button>
					<button type="button" data-hero-wahl="film">Film</button>
				</div>
			</div>
		</>)}
		{/* Sticky-Reveal-Stapel (BBH-/Nuxt-Muster, siehe SiteFooter.astro):
		   Inhalt auf Ebene 10 mit eigenem schwarzen Grund, Footer klebt auf
		   Ebene 0 darunter und wird beim Zuendescrollen freigelegt. Der
		   Wrapper braucht die eigene Hintergrundfarbe zwingend — sonst
		   schiene der Footer durch die transparenten Sektionen durch. */}
		<div class="site-content">
			<slot />
			{/* Sentinel fürs Footer-Einblenden (siehe SiteFooter.astro): der
			   Footer selbst ist per sticky IMMER geometrisch im Viewport —
			   ein IntersectionObserver direkt auf ihm feuert deshalb sofort
			   beim Laden (der Bug "Footer ist sofort weiß"). Beobachtet wird
			   stattdessen dieses Element am ENDE des Inhalts: erst wenn das
			   Inhalts-Ende in den Viewport scrollt, beginnt das Freilegen. */}
			<div data-content-end aria-hidden="true"></div>
		</div>
		<SiteFooter />
	</body>
</html>

<style is:global>
	/* Tokens, Schriften, Raster und Textstile stehen seit dem Neustart (13.11.2026) in
	   src/styles/system.css. Hier nur noch der Stapel für die Fußzeile. */

	/* Inhalts-Ebene des Sticky-Reveal-Stapels: Inhalt auf Ebene 10 mit eigenem
	   schwarzen Grund, Fußzeile klebt darunter (BBH). min-height, damit kurze
	   Seiten die Fußzeile nicht sofort freilegen (Befund 14.06.2026). */
	.site-content {
		position: relative;
		z-index: 10;
		background: var(--black);
		min-height: 100dvh;
	}

	/* Schutz gegen Browser-Erweiterungen, die Elemente in den body schieben
	   (Befund 14.06.2026): unsere Bausteine haben feste Plätze, Fremdes ans Ende. */
	body { display: flex; flex-direction: column; }
	body > * { order: 9999; }
	body > .site-content { order: 1; }
	body > .site-footer { order: 2; }

	/* Menü-Wahl: immer nur eines der beiden Menüs zeigen */
	html[data-menu="bbh"] .menu-root { display: none; }
	html:not([data-menu="bbh"]) .bbh-menu { display: none; }
	/* Mit dem BBH-Menü entfällt das Logo im Hero (Rasul 13.11.2026: „Wir könnten uns dann tatsächlich
	   unser Logo auf der Seite rausnehmen“); die Logo-Kachel und der Name „parley“ im Menü übernehmen. */
	html[data-menu="bbh"] .hero__logo { display: none; }
	/* Film-Hero (Demo): Fläche für das mitwandernde Menü (MenuBBH, absolut über die ganze Seitenhöhe) */
	html[data-hero="film"] body { position: relative; }
	/* BBH-Menü sitzt oben links und ist auf der Startseite anfangs offen: unter 768 px würde es
	   das Hero-Logo überdecken (gemessen bei 375 px), deshalb rückt die Bühne dann tiefer. */
	@media (max-width: 767px) {
		html[data-menu="bbh"] .hero__buehne { padding-top: calc(72px + var(--abstand-md, 16px)); }
	}

	.menu-wahl-knopf {
		position: fixed;
		right: 4px;
		bottom: 4px;
		z-index: 9001;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		padding: 0;
		background: rgba(20, 20, 20, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.35);
		color: var(--white);
		cursor: pointer;
	}
	.menu-wahl-knopf svg { width: 18px; height: 18px; fill: rgba(20, 20, 20, 1); stroke: currentColor; stroke-width: 1.5; }
	.menu-wahl-knopf[aria-expanded="true"] { background: var(--white); color: var(--black); }
	.menu-wahl-knopf[aria-expanded="true"] svg { fill: var(--white); }
	.menu-wahl {
		position: fixed;
		right: 4px;
		bottom: 36px;
		z-index: 9000;
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: max-content;
		max-width: calc(100vw - 8px);
		max-height: calc(100dvh - 48px);
		overflow: auto;
		padding: 6px;
		background: rgba(20, 20, 20, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.25);
		font-family: var(--schrift-mono);
		font-size: var(--text-sm);
		color: var(--grey, #999894);
	}
	.menu-wahl[hidden] { display: none; }
	.menu-wahl__zeile { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; max-width: 440px; }
	.menu-wahl span { padding: 0 4px; min-width: 56px; }
	.menu-wahl button {
		font: inherit;
		color: var(--white);
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.25);
		padding: 2px 8px;
		cursor: pointer;
	}
	html[data-aufbau="kacheln"] .menu-wahl [data-aufbau-wahl="kacheln"],
	html[data-aufbau="abschnitte"] .menu-wahl [data-aufbau-wahl="abschnitte"],
	html[data-kopf="videobeweis"] .menu-wahl [data-kopf-wahl="videobeweis"],
	html[data-animhoehe="100"] .menu-wahl [data-allg-wahl="animhoehe"][data-wert="100"],
	html[data-animhoehe="90"] .menu-wahl [data-allg-wahl="animhoehe"][data-wert="90"],
	html[data-animhoehe="80"] .menu-wahl [data-allg-wahl="animhoehe"][data-wert="80"],
	html[data-animhoehe="70"] .menu-wahl [data-allg-wahl="animhoehe"][data-wert="70"],
	html[data-animhoehe="60"] .menu-wahl [data-allg-wahl="animhoehe"][data-wert="60"],
	html[data-animhoehe="50"] .menu-wahl [data-allg-wahl="animhoehe"][data-wert="50"],
	html[data-raster="aus"] .menu-wahl [data-allg-wahl="raster"][data-wert="aus"],
	html[data-raster="an"] .menu-wahl [data-allg-wahl="raster"][data-wert="an"],
	html[data-titelgroesse="huge"] .menu-wahl [data-allg-wahl="titelgroesse"][data-wert="huge"],
	html[data-titelgroesse="2xl"] .menu-wahl [data-allg-wahl="titelgroesse"][data-wert="2xl"],
	html:not([data-aufstellung="nah"]) .menu-wahl [data-aufstellung-wahl="reihen"],
