	html:not([data-hoehe="oben"]) .menu-wahl [data-hoehe-wahl="auge"],
	html:not([data-form="punkt"]) .menu-wahl [data-form-wahl="figur"],
	html[data-form="punkt"] .menu-wahl [data-form-wahl="punkt"],
	html[data-rahmen="21"] .menu-wahl [data-rahmen-wahl="21"],
	html:not([data-rahmen="21"]) .menu-wahl [data-rahmen-wahl="16"],
	html[data-ende="drei"] .menu-wahl [data-ende-wahl="drei"],
	html[data-ende="eins"] .menu-wahl [data-ende-wahl="eins"],
