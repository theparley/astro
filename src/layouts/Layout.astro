---
import { ClientRouter } from "astro:transitions";
// Menü-Umbau (Fred 30.08. abends, "grundlegend andere Entscheidung"): der
// Let's-Parley-CTA (CtaTile.astro, jetzt unbenutzt/archiviert) ist durch den
// Zwetschke-artigen Menü-Knopf ersetzt (MenuTile.astro — Hamburger + "Menü",
// eckig, klappt große Listenzeilen nach oben auf; "Kontakt" übernimmt darin
// die Tür zu /termin). Der Knopf ist Navigation, kein Verkaufsknopf — er
// erscheint deshalb auf JEDER Seite, auch /termin (die frühere hideCta-Logik
// entfällt). TileMenu.astro (BBH-Kachelmenü) bleibt weiter archiviert.
import MenuTile from "../components/MenuTile.astro";
// Alternative nach BBH (Rasul 13.11.2026, „Als Alternative“), umschaltbar, siehe Menü-Wahl unten.
import MenuBBH from "../components/MenuBBH.astro";
import PageWipe from "../components/PageWipe.astro";
import SiteFooter from "../components/SiteFooter.astro";
// Designsystem nach BBH (Neustart 13.11.2026): Schriften, Tokens, Raster, Textstile, Bewegung.
import "../styles/system.css";

interface Props {
	// Ohne title = Startseite (eigener Tab-Titel, s. unten).
	title?: string;
	description?: string;
	// true nur auf der Startseite: der Menü-Knopf bleibt verdeckt, bis das
	// Hero-Logo (BrandLogo.astro) eingefahren ist und ihn aus der Stange
	// "gebiert". Unterseiten haben keinen Hero und zeigen ihn sofort.
	gateMenuBehindHero?: boolean;
}

const {
	title,
	description = "Kein Business ohne Witness. Echte Gespräche, filmreif ohne Kamerastress. Als Videopodcast, Webinar, Clip oder Kundentestimonial.",
	gateMenuBehindHero = false,
} = Astro.props;

// NAME IM TAB (Fred 26.10.2026, Namensregel in PARLEY_WORDING.md: Parley Film
// ist der Name nach außen, The Parley wird das Studio). Unterseiten
// „Studio · Parley Film“, die Startseite trägt Name und Satz aus der
// Claim-Architektur (Nachtrag 25.10.: „Parley Film. Echte Gespräche.
// Filmreif.“). Vorher „{title} · The Parley“.
const SITE_NAME = "Parley Film";
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Echte Gespräche. Filmreif.`;
// Websitename für Google (strukturierte Daten WebSite, nur auf der
// Startseite, wie Google es verlangt). Die Adresse kommt aus `site` in
// astro.config.mjs (seit 26.10.2026 parleyfilm.com, vorher theparley.de).
const SITE_URL = new URL("/", Astro.site).href;
// Canonical und Open Graph: immer die parleyfilm.com-Adresse der Seite, auch
// wenn sie über die pages.dev-Vorschau oder die alte Domain aufgerufen wird.
// Mit Schrägstrich am Ende, wie Astro baut: Cloudflare Pages leitet /kontakt
// per 308 auf /kontakt/ um.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const websiteJsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_NAME,
	url: SITE_URL,
});
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		{/* Favicon aus dem neuen Zeichen (Rasul 18.11.2026; Dateien aus dem Marketing-Ordner
		    branding/aktiv/favicon/zeichen-neu/, Generator favicon_neu.py): mittiger Ausschnitt ohne Text wie die erste
		    Menükachel. Davor das Zeichen mit Biss, Variante D (Stand in Git: 2ca1f32). */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{/* Schriften vorladen (Neustart 13.11.2026): Lesetext und Hero-Schrift sind beim ersten Bild da,
		   sonst springt die Seite nach dem Laden (Befund 14.06.2026). Alle frei, selbst gehostet. */}
		<link rel="preload" href="/fonts/frei/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/frei/BBH-DE-Ecken-Hegarty.woff2?v=1" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/frei/BBH-DE-Ecken-Bogle.woff2?v=1" as="font" type="font/woff2" crossorigin />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		{/* Vorschaubild für LinkedIn und Co. (Qualitätscheck 14.11.2026: fehlte). Seit 14.11. Rasuls Logo-Bild (Blase + „parley Film“),
		   Wortmarke aus Forma DJR: vor dem Livegang Lizenz klären (WEBSITE.md Punkt 18). */}
		<meta property="og:image" content="https://parleyfilm.com/og-parleyfilm.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Logo von Parley Film: ein Filmbild, aus dem eine Sprechblase mit Play herausgebissen ist. Daneben steht parley Film." />
		<meta name="twitter:card" content="summary_large_image" />
		{!title && <script type="application/ld+json" set:html={websiteJsonLd} />}
		<ClientRouter />
		{/* Menü-Wahl (Rasul 13.11.2026): Zwetschke-Knopf (Standard) oder BBH-Kachelmenü.
		   Umschalten mit ?menu=bbh bzw. ?menu=zwetschke oder dem Schalter unten rechts;
		   die Wahl bleibt im Browser gespeichert und überlebt Seitenwechsel. */}
		<script is:inline define:vars={{ nurLokal: import.meta.env.DEV }}>
			(function () {
				// Werkstatt-Schalter (?ende=, ?raster=, …) und ihre gespeicherte Wahl gelten nur lokal; live und auf der Dev-Seite
				// immer die Grundeinstellungen (Code-Prüfung N1, 14.11.2026: ein geteilter Prüflink hätte Fremden sonst
				// dauerhaft Hilfslinien oder Varianten gezeigt).
				var suche = nurLokal ? location.search : "";
				var speicher = null;
				try { if (nurLokal) speicher = localStorage; } catch (e) { speicher = null; }
				if (!speicher) speicher = { getItem: function () { return null; }, setItem: function () {} };
				var K = "parley-menu";
				function lies() {
					var q = new URLSearchParams(suche).get("menu");
					try {
						if (q === "bbh" || q === "zwetschke") speicher.setItem(K, q);
						return speicher.getItem(K) || "zwetschke";
					} catch (e) { return q || "zwetschke"; }
				}
				// Hero-Demo (Rasul 13.11.2026: „machen wir doch jetzt mal kurz eine Demo, wo wir unser Video
				// Bildschirmflächen machen, voll machen und das Menü so drübersetzen wie BBH“): ?hero=film|text.
				// Im Film-Modus gilt immer das BBH-Menü. Grundeinstellung seit 13.11.2026 „film“ (Rasul: „Also ich
				// glaube, mit dem großen Video am Anfang ist es die beste Lösung.“).
				function liesHero() {
					var q = new URLSearchParams(suche).get("hero");
					try {
						if (q === "film" || q === "text") speicher.setItem("parley-hero", q);
						return speicher.getItem("parley-hero") || "film";
					} catch (e) { return q || "film"; }
				}
				// Grundeinstellung „gemischt“ (Rasul 13.11.2026: „Ja, Gemischt“).
				// Menülage (Rasul 13.11.2026: „wir kleben es gleich unten mittig an den Bildschirm. Und beim
				// Scrollen fährt es dann zusammen, das gucken wir uns mal als Variante an“): ?lage=unten|links.
				function liesLage() {
					var q = new URLSearchParams(suche).get("lage");
					try {
						if (q === "unten" || q === "links" || q === "gemischt") speicher.setItem("parley-lage", q);
						return speicher.getItem("parley-lage") || "unten"; // seit 18.11.2026 überall unten mittig (Rasul: „Wir lassen das Menü tatsächlich immer unten sitzen.“); davor „gemischt“
					} catch (e) { return q || "unten"; }
				}
				// Satz-Vergleich unter dem Film (13.11.2026): ?satz=a bis y; Grundeinstellung y (Rasul 13.11. abends: „Ja, wir nehmen ypsilon.“; davor w, v, i)
				function liesSatz() {
					var q = new URLSearchParams(suche).get("satz");
					try {
						if (q === "a" || q === "b" || q === "c" || q === "d" || q === "e" || q === "f" || q === "g" || q === "h" || q === "i" || q === "j" || q === "k" || q === "l" || q === "m" || q === "n" || q === "o" || q === "p" || q === "q" || q === "r" || q === "s" || q === "t" || q === "u" || q === "v" || q === "w" || q === "x" || q === "y") speicher.setItem("parley-satz", q);
						return speicher.getItem("parley-satz") || "y";
					} catch (e) { return q || "y"; }
				}
				function liesUmlaut() {
					var q = new URLSearchParams(suche).get("umlaut");
					try {
						if (q === "innen" || q === "aussen" || q === "ecken") speicher.setItem("parley-umlaut", q);
						return speicher.getItem("parley-umlaut") || "ecken"; // Grundeinstellung „Ecken“ seit 13.11.2026 abends
					} catch (e) { return q || "ecken"; }
				}
				// Anlass vor den Kacheln (13.11.2026 abends): ?kopf=videobeweis|band|kachel; Grundeinstellung „videobeweis“.
				// Rasul: „sollen wir nicht erst nochmal dann die Szene setzen, also jetzt den Spruch bringen? Oder gleich einsteigen?“
				function liesKopf() {
					var q = new URLSearchParams(suche).get("kopf");
					try {
						if (q === "videobeweis" || q === "band" || q === "kachel") speicher.setItem("parley-kopf", q);
						return speicher.getItem("parley-kopf") || "band"; // Grundeinstellung „band“ seit 13.11.2026 abends (Rasul: Aufbau Film, Satz, Problem, Kacheln „Beweis“)
					} catch (e) { return q || "band"; }
				}
				// Ende der Animation Experten-Auswahl (13.11.2026 abends): ?ende=drei|eins|grau|unscharf; Grundeinstellung „unscharf“
				// (Rasul 13.11.2026 abends: „Unscharf“; dazu: „Es würde unbewusst klarmachen, dass wir einen Fokus geben.“)
				function liesEnde() {
					var q = new URLSearchParams(suche).get("ende");
					try {
						if (q === "drei" || q === "eins" || q === "grau" || q === "unscharf" || q === "ebenen" || q === "kamera") speicher.setItem("parley-ende", q);
						return speicher.getItem("parley-ende") || "kamera";
					} catch (e) { return q || "kamera"; }
				}
				// Rahmen der Experten-Auswahl (13.11.2026 abends): ?rahmen=21|16; Grundeinstellung 21 (21:9, Rasul: „Probier mal 21 zu 9“)
				function liesRahmen() {
					var q = new URLSearchParams(suche).get("rahmen");
					try {
						if (q === "21" || q === "16") speicher.setItem("parley-rahmen", q);
						return speicher.getItem("parley-rahmen") || "16"; // seit 13.11.2026 abends wieder 16:9 (Rasul: „dass es verständlicher ist“)
					} catch (e) { return q || "16"; }
				}
				// Form der Personen in der Kamerafahrt (13.11.2026 abends): ?form=figur|punkt; Grundeinstellung „figur“
				// (Rasul: „Vielleicht machen wir sogar noch als Variante, dass es wirklich Punkte sind am Anfang und am Ende zu Personen werden.“)
				function liesForm() {
					var q = new URLSearchParams(suche).get("form");
					try {
						if (q === "figur" || q === "punkt") speicher.setItem("parley-form", q);
						return speicher.getItem("parley-form") || "figur"; // Rasul 13.11.2026 abends: „Zurück zu Figuren“
					} catch (e) { return q || "figur"; }
				}
				// Höhe der Kamera am Ende (13.11.2026 abends): ?hoehe=oben|auge; Grundeinstellung „oben“
				function liesHoehe() {
					var q = new URLSearchParams(suche).get("hoehe");
					try {
						if (q === "oben" || q === "auge") speicher.setItem("parley-hoehe", q);
						return speicher.getItem("parley-hoehe") || "auge"; // Rasul 13.11.2026 abends: „Augenhöhe“
					} catch (e) { return q || "auge"; }
				}
				// Aufstellung der Personen (13.11.2026 abends): ?aufstellung=reihen|nah; Grundeinstellung „reihen“
				function liesAufstellung() {
					var q = new URLSearchParams(suche).get("aufstellung");
					try {
						if (q === "reihen" || q === "nah") speicher.setItem("parley-aufstellung", q);
						return speicher.getItem("parley-aufstellung") || "reihen";
					} catch (e) { return q || "reihen"; }
				}
				// Höhe der Animation in % der Fensterhöhe und Größe der Band-Überschrift (13.11.2026 abends)
				// Im Rahmen (Vergleichsseite) zählt nur die Adresse: nichts merken, nichts Gemerktes lesen. Sonst setzt die
				// Vergleichsseite die Wahl für den ganzen Browser, und das normale Fenster zeigt danach die Probe
				// (Fehler 15.11.2026, siehe Website_Neustart_2026-11.md).
				var imRahmen = window.top !== window.self;
				function liesWahl(name, werte, vorgabe) {
					var q = new URLSearchParams(suche).get(name);
					if (imRahmen) return werte.indexOf(q) >= 0 ? q : vorgabe;
					try {
						if (werte.indexOf(q) >= 0) speicher.setItem("parley-" + name, q);
						return speicher.getItem("parley-" + name) || vorgabe;
					} catch (e) { return q || vorgabe; }
				}
				// Aufbau der Startseite (13.11.2026): ?aufbau=abschnitte|kacheln; Grundeinstellung „kacheln“ (Rasul: „Kacheln“)
				function liesAufbau() {
					var q = new URLSearchParams(suche).get("aufbau");
					try {
						if (q === "abschnitte" || q === "kacheln") speicher.setItem("parley-aufbau", q);
						return speicher.getItem("parley-aufbau") || "kacheln";
					} catch (e) { return q || "kacheln"; }
				}
				function setze() {
					document.documentElement.dataset.aufbau = liesAufbau();
					document.documentElement.dataset.umlaut = liesUmlaut();
					document.documentElement.dataset.kopf = liesKopf();
					document.documentElement.dataset.ende = liesEnde();
					document.documentElement.dataset.rahmen = liesRahmen();
					document.documentElement.dataset.form = liesForm();
					document.documentElement.dataset.hoehe = liesHoehe();
					document.documentElement.dataset.aufstellung = liesAufstellung();
					document.documentElement.dataset.animhoehe = liesWahl("animhoehe", ["100", "90", "80", "70", "60", "50"], "50"); // 50 % Grundeinstellung (Rasul 14.11.2026: „Mach mal auf 50 … Dann würde, glaube ich, alles drauf passen, die Überschrift“)
					document.documentElement.dataset.titelgroesse = liesWahl("titelgroesse", ["huge", "2xl"], "2xl");
					// Probe „neues Zeichen“ in Menü und Fuß, nur lokal (Rasul 18.11.2026): ?zeichen=film|parley|alt, ?ausschnitt=mitte|rechts.
					// Im Bau wird nichts gesetzt; dort gilt fest „parley Film“ mit mittigem Ausschnitt (MenuBBH.astro und SiteFooter.astro, ZEICHEN_NEU).
					if (nurLokal) {
						document.documentElement.dataset.zeichen = liesWahl("zeichen", ["film", "parley", "alt"], "film");
						document.documentElement.dataset.ausschnitt = liesWahl("ausschnitt", ["mitte", "rechts"], "mitte");
						document.documentElement.dataset.bedienung = liesWahl("bedienung", ["liste", "kacheln"], "liste"); // Probe Liste nach oben, siehe MenuBBH.astro (LISTE_PROBE)
						document.documentElement.dataset.zeilen = liesWahl("zeilen", ["gross", "fett", "fein"], "fett"); // fett gilt auch im Bau; gross und fein nur als Vergleich auf localhost, siehe MenuBBH.astro (ZEILEN)
						document.documentElement.dataset.kmass = liesWahl("kmass", ["90", "72"], "90"); // Handy-Menü: 90 = neues Maß und neue Reihenfolge (gilt im Bau), 72 = Stand davor; siehe MenuBBH.astro (HANDY_MENUE)
					}
					// EXPERTEN-ANIMATION, AUCH IM BAU (20.11.2026; Rasul im Website · Master: „Die Version fürs dritte Segment, also
					// die Animation mit dem Video und dem Reinzoomen … Das schieben wir auf Dev und wir schieben es auf live.“).
					// Die folgenden Zeilen standen bis heute im Block „nur lokal“. Im Bau liest liesWahl weder Adresse noch Speicher
					// und gibt immer die Vorgabe zurück: Der Bau bekommt also fest den Stand von localhost. Zwei Ausnahmen: figur ist
					// im Bau fest „echt“ (auf localhost bleibt die Vorgabe „neu“, echt über ?figur=echt), clip ist im Bau fest
					// „kurz“ (das ganze Video ist zu groß für Cloudflare Pages). Die älteren Kommentare „nur lokal“ und „Im Bau wird
					// nichts gesetzt“ in diesem Abschnitt gelten damit nicht mehr. Weg zurück: die schließende Klammer wieder hinter
					// die Zeile mit „spalten“ setzen.
					{
						// Probe Startschwelle der Experten-Animation, nur lokal (Rasul 19.11.2026: „Lass uns mal die Schwelle ändern und
						// dann probiere ich es aus."): ?start=20|50|80 = Anteil der Animationsfläche in Prozent, der im Fenster stehen
						// muss, bevor sie losläuft. 20 = Stand bis 19.11.2026 und weiter der Stand im Bau; 50 = Grundeinstellung der Probe.
						// Im Bau wird nichts gesetzt, dort gilt fest 20 (ExpertenAuswahl.astro, START_ANTEIL). Weg zurück: diese Zeile
						// löschen und in ExpertenAuswahl.astro wieder „const START_ANTEIL = 0.2;" setzen.
						document.documentElement.dataset.start = liesWahl("start", ["20", "50", "80"], "50");
						// Probe Zweispalte im Videobeweis-Band, nur lokal (Rasul 19.11.2026): ?spalten=mitte|titellinks|titelbreit|b6|b6voll|aus, siehe
						// index.astro (PROBE SATZ LINKS, TEXT RECHTS). Im Bau wird nichts gesetzt, dort bleibt es gestapelt.
						// Form der Figur in der Experten-Animation, nur lokal (Rasul 19.11.2026): ?figur=neu|alt. neu = Form B „Schulter“
						// (Grundeinstellung auf localhost), alt = Form bis 19.11.2026. Im Bau wird nichts gesetzt, dort gilt die alte.
						// Ganzes Video mit Ton oder der kurze Ausschnitt (Auftrag T, Rasul 19.11.2026 nachts): ?clip=ganz|kurz, nur mit ?figur=echt
						document.documentElement.dataset.clip = nurLokal ? liesWahl("clip", ["ganz", "kurz"], "ganz") : "kurz";
						// Bauchbinde im Video (Auftrag Y, Rasul 20.11.2026): ?binde=kurz|immer, kurz = blendet nach 6 s aus
						document.documentElement.dataset.binde = liesWahl("binde", ["kurz", "immer"], "kurz");
						// Namensangabe als Zeile unter der Karte (Rasuls Wahl, 20.11.2026) oder als Bauchbinde im Bild (verworfen, Weg zurück): ?namensform=zeile|binde
						document.documentElement.dataset.namensform = liesWahl("namensform", ["zeile", "binde"], "zeile");
						// Karte und Namenszeile auf einem gemeinsamen schwebenden Blatt (Rasul 20.11.2026: „Ein Blatt“): ?blatt=an|aus
						// BLATT WIEDER WEG (Rasul 20.11.2026 morgens, in Website · Programmierung: „Mach diese extra Karte weg, lasst das Video
						// für sich stehen und macht die Beschreibung, häng die unten drunter, ohne dass es ein eigenes Blatt wird“; er hatte
						// es am Vortag schon zurückgenommen, das war untergegangen). Vorgabe aus. Der Wert heißt „mit“ statt „an“, damit
						// ein gemerktes „an“ nicht weiterwirkt. Weg zurück: ?blatt=mit oder Vorgabe "mit".
						document.documentElement.dataset.blatt = liesWahl("blatt", ["mit", "aus"], "aus");
						document.documentElement.dataset.figur = nurLokal ? liesWahl("figur", ["neu", "alt", "echt"], "neu") : "echt"; // echt = in der Karte Umriss und Clip eines echten Menschen (Platzhalter, Kundenmaterial nur lokal), nur in den neuen Fassungen der Animation
						// Zweite Fassung der Experten-Animation, nur lokal (Rasul 19.11.2026 abends): ?anim=geste|zoom|zoomnah (zoomnah = wie zoom, die Fahrt endet früher, die blaue Karte bleibt halb so breit wie die Fläche). geste = heutige
						// Fassung und Grundeinstellung; zoom = blaue 16:9-Fläche, Kamerafahrt ohne Geste, Geste erst am Ende. Siehe
						// ExpertenAuswahl.astro (ZWEITE FASSUNG „zoom“). Im Bau wird nichts gesetzt, dort läuft die heutige.
						document.documentElement.dataset.anim = liesWahl("anim", ["geste", "zoom", "zoomnah", "kombi", "kombimitte"], "kombimitte"); // Grundeinstellung auf localhost kombimitte (Rasul 19.11.2026 abends: „Auf der Localhost 4321 ist die Animation nicht so, wie wir sie vorhin gemacht haben. Da fehlt jetzt der Stopp, bevor die Videobeweisbewegung es nochmal größer zieht.“); vorher geste. Im Bau läuft weiter geste.
						// kombimitte = wie kombi, die Karte wächst aber nur bis ?ziel=… px Breite (bezogen auf 680 px Fläche), damit die
						// Menge daneben stehen bleibt. Die Werte sind zum Suchen der Grenze da.
						// Deckkraft der blauen Karte in Prozent (Rasul 19.11.2026: „mach mal das Blau ein bisschen durchsichtig“), zum Vergleichen
						document.documentElement.dataset.deck = liesWahl("deck", ["100", "92", "85", "78", "70", "60"], "70"); // Grundeinstellung 70 (Website · Master 19.11.2026): gilt nur noch während der Fahrt, am Ende ist das Blau immer deckend; mit 85 war der Wechsel zu leise. 85 bleibt über ?deck=85
						// Blau der Karte (Rasul 19.11.2026: an das Blau des Videos angleichen): ?kartenblau=blase|ton|verlauf, siehe
						// ExpertenAuswahl.astro. Nicht „kachel“: Der Name und html[data-kachel] gehören schon der Menükachel (MenuBBH.astro).
						document.documentElement.dataset.kartenblau = liesWahl("kartenblau", ["blase", "ton", "verlauf"], "verlauf");
						// Menge der Experten-Animation (Rasul 19.11.2026: doppelt so viele): ?menge=doppelt|einfach, nur in den neuen Fassungen
						document.documentElement.dataset.menge = liesWahl("menge", ["doppelt", "einfach"], "doppelt");
						// Zeichenfläche der Experten-Animation breiter als ihr Platz, Menge bis hinter den Text (Rasul 19.11.2026): ?breit=an|aus
						document.documentElement.dataset.breit = liesWahl("breit", ["an", "aus"], "an");
						// Anfang der neuen Fassungen (Rasul 19.11.2026 spät): ?beginn=neu|alt. neu = die Fahrt läuft ab dem ersten Bild,
						// die blaue Karte blendet ein; alt = Standbild, dann Fahrt, Karte von Anfang an. Nicht „anfang“, der Name ist vergeben.
