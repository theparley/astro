---
import Header from "../components/Header.astro";

interface Props {
	title: string;
	description?: string;
	hideHeader?: boolean;
}

const { title, description = "Kein Business ohne Witness. Echte Gespräche, filmreif ohne Kamerastress. Als Videopodcast, Webinar, Clip oder Kundentestimonial.", hideHeader = false } = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · The Parley</title>
	</head>
	<body>
		{!hideHeader && <Header />}
		<slot />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Forma DJR";
		src: url("/fonts/FormaDJRVariable.woff2") format("woff2-variations");
		font-weight: 100 900;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--black: #000000;
		--white: #fafafa;
		--gray: #888;
		--max-width: 1100px;
		--logo-h: clamp(32px, 4.4vw, 56px);
		/* Fahne + Lücke + Text bei --logo-h, aus den Original-SVG-Maßen (1160.62/2018.08 Fahne, 1986.93/2018.08 Text, 4px Lücke) */
		--logo-w: calc(var(--logo-h) * 1.5596 + 4px);
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--black);
	}

	body {
		margin: 0;
		background: var(--black);
		color: var(--white);
		font-family: "Forma DJR", Helvetica, Arial, sans-serif;
		font-weight: 400;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
	}

	h1, h2, h3, p {
		margin: 0;
	}
</style>
