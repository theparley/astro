<script>
	/* Menü-Schalter (nur lokal): Wahl speichern und sofort umschalten. */
	const wahlZustand = () => {
		const knopf = document.querySelector<HTMLElement>(".menu-wahl-knopf");
		const tafel = document.querySelector<HTMLElement>(".menu-wahl");
		if (!knopf || !tafel) return;
		let offen = false;
		try { offen = localStorage.getItem("parley-einstellungen") === "offen"; } catch {}
		tafel.hidden = !offen;
		knopf.setAttribute("aria-expanded", String(offen));
	};
	document.addEventListener("astro:page-load", wahlZustand);
	document.addEventListener("click", (e) => {
		if ((e.target as HTMLElement).closest(".menu-wahl-knopf")) {
			const tafel = document.querySelector<HTMLElement>(".menu-wahl")!;
			const offen = tafel.hidden;
			tafel.hidden = !offen;
			(e.target as HTMLElement).closest(".menu-wahl-knopf")!.setAttribute("aria-expanded", String(offen));
			try { localStorage.setItem("parley-einstellungen", offen ? "offen" : "zu"); } catch {}
			return;
		}
		const aufbau = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-aufbau-wahl]");
		if (aufbau) {
			try { localStorage.setItem("parley-aufbau", aufbau.dataset.aufbauWahl!); } catch {}
			location.reload();
			return;
		}
		const allg = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-allg-wahl]");
		if (allg) {
			const name = allg.dataset.allgWahl!, w = allg.dataset.wert!;
			try { localStorage.setItem("parley-" + name, w); } catch {}
			document.documentElement.dataset[name] = w;
			document.querySelector<HTMLElement>("[data-experten]")?.click(); // neu messen und abspielen
			return;
		}
		const aufstellungWahl = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-aufstellung-wahl]");
		if (aufstellungWahl) {
			const w = aufstellungWahl.dataset.aufstellungWahl!;
			try { localStorage.setItem("parley-aufstellung", w); } catch {}
			document.documentElement.dataset.aufstellung = w;
			document.querySelector<HTMLElement>("[data-experten]")?.click();
			return;
		}
		const hoeheWahl = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-hoehe-wahl]");
		if (hoeheWahl) {
			const w = hoeheWahl.dataset.hoeheWahl!;
			try { localStorage.setItem("parley-hoehe", w); } catch {}
			document.documentElement.dataset.hoehe = w;
			document.querySelector<HTMLElement>("[data-experten]")?.click();
			return;
		}
		const formWahl = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-form-wahl]");
		if (formWahl) {
			const w = formWahl.dataset.formWahl!;
			try { localStorage.setItem("parley-form", w); } catch {}
			document.documentElement.dataset.form = w;
			document.querySelector<HTMLElement>("[data-experten]")?.click();
			return;
		}
		const rahmenWahl = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-rahmen-wahl]");
		if (rahmenWahl) {
			const w = rahmenWahl.dataset.rahmenWahl!;
			try { localStorage.setItem("parley-rahmen", w); } catch {}
			document.documentElement.dataset.rahmen = w;
			document.querySelector<HTMLElement>("[data-experten]")?.click(); // neu legen und abspielen
			return;
		}
		const endeWahl = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-ende-wahl]");
		if (endeWahl) {
			const w = endeWahl.dataset.endeWahl!;
			try { localStorage.setItem("parley-ende", w); } catch {}
			document.documentElement.dataset.ende = w;
			document.querySelector<HTMLElement>("[data-experten]")?.click(); // gleich noch einmal abspielen
			return;
		}
		const kopf = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-kopf-wahl]");
		if (kopf) {
			const w = kopf.dataset.kopfWahl!;
			try { localStorage.setItem("parley-kopf", w); } catch {}
			document.documentElement.dataset.kopf = w;
			return;
		}
		const umlaut = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-umlaut-wahl]");
		if (umlaut) {
			const w = umlaut.dataset.umlautWahl!;
			try { localStorage.setItem("parley-umlaut", w); } catch {}
			document.documentElement.dataset.umlaut = w;
			return;
		}
		const satz = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-satz-wahl]");
		if (satz) {
			const w = satz.dataset.satzWahl!;
			try { localStorage.setItem("parley-satz", w); } catch {}
			document.documentElement.dataset.satz = w;
			return;
		}
		const lage = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-lage-wahl]");
		if (lage) {
			try { localStorage.setItem("parley-lage", lage.dataset.lageWahl!); } catch {}
			location.reload();
			return;
		}
		const hero = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-hero-wahl]");
		if (hero) {
			// Hero-Wechsel ändert Aufbau und Menülage: Seite neu laden
			try { localStorage.setItem("parley-hero", hero.dataset.heroWahl!); } catch {}
			location.reload();
			return;
		}
		const knopf = (e.target as HTMLElement).closest<HTMLElement>(".menu-wahl [data-wahl]");
		if (!knopf) return;
		const wahl = knopf.dataset.wahl!;
		try { localStorage.setItem("parley-menu", wahl); } catch {}
		document.documentElement.dataset.menu = wahl;
	});

	/* Einblenden wie BBH (Analyse 1.9): Elemente mit data-einblenden blenden über die
	   Deckkraft ein, sobald sie 20 % vor der Fensterunterkante sind, und beim
	   Zurückscrollen wieder aus. Bei jedem Seitenwechsel neu (Astro-Seitenübergänge). */
	let einblendenBeobachter: IntersectionObserver | null = null;
	function einblenden() {
		einblendenBeobachter?.disconnect();
		const ziele = document.querySelectorAll<HTMLElement>("[data-einblenden]");
		if (!ziele.length) return;
		einblendenBeobachter = new IntersectionObserver(
			(eintraege) => eintraege.forEach((e) => e.target.classList.toggle("sichtbar", e.isIntersecting)),
			{ rootMargin: "0px 0px -20% 0px" },
		);
		ziele.forEach((z) => einblendenBeobachter!.observe(z));
	}
	document.addEventListener("astro:page-load", einblenden);
</script>
