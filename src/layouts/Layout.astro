---
import { ClientRouter } from "astro:transitions";
// Menü-Umbau (Fred 30.08. abends, "grundlegend andere Entscheidung"): der
// Let's-Parley-CTA (CtaTile.astro, jetzt unbenutzt/archiviert) ist durch den
// Zwetschke-artigen Menü-Knopf ersetzt (MenuTile.astro — Hamburger + "Menü",
// eckig, klappt große Listenzeilen nach oben auf; "Kontakt" übernimmt darin
// die Tür zu /buchen). Der Knopf ist Navigation, kein Verkaufsknopf — er
// erscheint deshalb auf JEDER Seite, auch /buchen (die frühere hideCta-Logik
// entfällt). TileMenu.astro (BBH-Kachelmenü) bleibt weiter archiviert.
import MenuTile from "../components/MenuTile.astro";
import PageWipe from "../components/PageWipe.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
	title: string;
	description?: string;
	// true nur auf der Startseite: der Menü-Knopf bleibt verdeckt, bis das
	// Hero-Logo (BrandLogo.astro) eingefahren ist und ihn aus der Stange
	// "gebiert". Unterseiten haben keinen Hero und zeigen ihn sofort.
	gateMenuBehindHero?: boolean;
}

const {
	title,
	description = "Kein Business ohne Witness. Echte Gespräche, filmreif ohne Kamerastress. Als Videopodcast, Webinar, Clip oder Kundentestimonial.",
	gateMenuBehindHero = false,
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · The Parley</title>
		<ClientRouter />
	</head>
	<body>
		<PageWipe />
		<MenuTile gateBehindHero={gateMenuBehindHero} />
		{/* Sticky-Reveal-Stapel (BBH-/Nuxt-Muster, siehe SiteFooter.astro):
		   Inhalt auf Ebene 10 mit eigenem schwarzen Grund, Footer klebt auf
		   Ebene 0 darunter und wird beim Zuendescrollen freigelegt. Der
		   Wrapper braucht die eigene Hintergrundfarbe zwingend — sonst
		   schiene der Footer durch die transparenten Sektionen durch. */}
		<div class="site-content">
			<slot />
			{/* Sentinel fürs Footer-Einblenden (siehe SiteFooter.astro): der
			   Footer selbst ist per sticky IMMER geometrisch im Viewport —
			   ein IntersectionObserver direkt auf ihm feuert deshalb sofort
			   beim Laden (der Bug "Footer ist sofort weiß"). Beobachtet wird
			   stattdessen dieses Element am ENDE des Inhalts: erst wenn das
			   Inhalts-Ende in den Viewport scrollt, beginnt das Freilegen. */}
			<div data-content-end aria-hidden="true"></div>
		</div>
		<SiteFooter />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Forma DJR";
		src: url("/fonts/FormaDJRVariable.woff2") format("woff2-variations");
		font-weight: 100 900;
		font-style: normal;
		font-display: swap;
	}

	:root {
		/* Farb-Treppe (29.08., aus BBHs ausgeliefertem CSS gemessen + für Parley
		   adaptiert — gilt seitenweit als Token-Satz, siehe Website-Brief
		   /buchen-Kapitel). Ersetzt die vorherigen Ad-hoc-Werte (--white war
		   #fafafa, --gray war #888) durch die entschiedenen Spec-Werte. */
		--black: #000000;
		--panel: #0d0d0d;
		--tile: #404040;
		--tile-text: #c8c8c8;
		--surface: #ededed;
		--white: #ffffff;
		--gray: #999894;
		--line: #2a2a2a;
		--max-width: 1100px;
		/* Nur noch von den archivierten Komponenten gelesen (Header.astro,
		   TileMenu.astro — beide "nirgends eingebunden", siehe deren eigene
		   Archiv-Kommentare). BrandLogo.astro, das aktive Hero-Logo, definiert
		   sein --logo-h lokal (1.5× dieser Basis). Bleibt hier stehen statt
		   gelöscht zu werden, damit eine Reaktivierung der archivierten
		   Komponenten den globalen Wert sofort wieder vorfindet (Audit-Fix B7). */
		--logo-h: clamp(32px, 4.4vw, 56px);
	}

	* {
		box-sizing: border-box;
	}

	/* Inhalts-Ebene des Sticky-Reveal-Stapels (siehe body-Markup oben). */
	.site-content {
		position: relative;
		z-index: 10;
		background: var(--black);
	}

	html {
		background: var(--black);
	}

	body {
		margin: 0;
		background: var(--black);
		color: var(--white);
		font-family: "Forma DJR", Helvetica, Arial, sans-serif;
		font-weight: 400;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
	}

	h1, h2, h3, p {
		margin: 0;
	}
</style>
