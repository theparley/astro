	html:not([data-ende="drei"]):not([data-ende="eins"]):not([data-ende="grau"]):not([data-ende="unscharf"]):not([data-ende="ebenen"]) .menu-wahl [data-ende-wahl="kamera"],
	html:not([data-kopf="videobeweis"]):not([data-kopf="kachel"]) .menu-wahl [data-kopf-wahl="band"],
	html[data-kopf="kachel"] .menu-wahl [data-kopf-wahl="kachel"],
