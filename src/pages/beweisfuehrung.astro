---
/* Unterseite 02 Beweisführung, bis 14.11.2026 „Beweisverfahren“ (Rasul 14.11.2026: „Ja, Beweisführung“). Angelegt 13.11.2026 ( Variante Kachel-Startseite; Rasul: „Ja, mach's mal als Variante zum
   Ausprobieren“). Inhalt ist derselbe Baustein wie auf der Startseite (src/components/abschnitte/Beweisfuehrung.astro).
   In der Sitemap seit 13.11.2026 (Rasul: „Kacheln“). */
import Layout from "../layouts/Layout.astro";
import Beweisfuehrung from "../components/abschnitte/Beweisfuehrung.astro";
import Kapitelende from "../components/abschnitte/Kapitelende.astro";
---
<Layout title="Beweisführung" description="02 Beweisführung: so arbeitet Parley Film.">
	<main class="kapitel">
		<Beweisfuehrung />
		<Kapitelende weiter={{ href: "/beweisstuecke", nr: "03", titel: "Beweisstücke" }} />
	</main>
</Layout>
<style>
	.kapitel { padding-top: 0; }   /* oben genügt der xl-Abstand des Abschnitts (BBH: Titel mit py-xl) */
	/* letzter Abschnitt der Startseite bringt unten xl mit; auf der Unterseite folgt noch das Kapitel-Ende */
	.kapitel :global(.abschnitt--letzter) { margin-bottom: 0; }
</style>
