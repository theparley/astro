---
// STUNDEN-PROBE, Fassung C (Fred 21.09.: Ringe um die Stunde, die Uhren
// eine nach der anderen im Uhrzeigersinn, Ring fuer Ring nach aussen).
//
// ALLE ZEITEN STEHEN HIER, in Sekunden, und alles andere wird daraus
// abgeleitet (Fred: „sag mir mal, mit welchen Werten ich bestimmen kann,
// wie schnell die Uhren animiert werden … und das gleiche fuer das Raus-
// und Reinzoomen"). Wer eine Zahl aendert, muss sonst nichts anfassen —
// die Runde wird am Ende zusammengerechnet.
const ZEIT = {
	halt: 0.72,        // dunkler Halt am Anfang, die Einblendung endet hier
	stunde: 2.16,      // die Stunde zeichnet sich (Rand, Fuellung, Zeiger)
	// Kamera von 7 auf 1,15, beginnt, wenn die Stunde steht. "letzteUhr"
	// heisst: sie faehrt genau so lang, bis die letzte Uhr fertig ist (Fred
	// 21.09.: „mach die Zeit vom Rauszoomen so lang, dass es passt mit der
	// letzten Uhr, die fertig animiert wird … vielleicht ist es ja gar
	// nicht zu lang"). Eine Zahl in Sekunden macht es wieder unabhaengig;
	// vorher standen hier 6,12.
	kameraRaus: "letzteUhr" as number | "letzteUhr",
	uhrenStart: 3.24,  // ab Rundenbeginn: die erste Uhr faengt an
	uhrenDauer: 14.4,  // von der ersten bis zum Ende der letzten Uhr
	                   // (war 11,52 — mit „eine nach der anderen" am Anfang
	                   // reichte das nur fuer eine einzige langsame Uhr, dann
	                   // muessten 175 in acht Sekunden; 14,4 = 8 Bandschritte)
	// RAMPE UND VERHAELTNIS (Fred 21.09.: „es fuehlt sich natuerlicher an,
	// wenn es ein Verhaeltnis gaebe zwischen dem Ramp, wie die Uhren
	// entstehen, und wie schnell die Uhren animiert werden"). Statt einer
	// festen Dauer je Uhr:
	//   rampe     wie viel schneller die Uhren am ENDE der Reihe anfangen
	//             als am Anfang (4 = am Ende viermal so viele je Sekunde).
	//             Nur eine Steigerung, kein Auslaufen (Fred 21.09.: „das
	//             darf schneller werden — je mehr draussen ist, desto mehr
	//             vervielfaeltigt sich das; beim Rauszoomen sieht man
	//             ploetzlich viel mehr Uhren, wenn da die Animation
	//             schneller wird, ist es besser").
	// EINE NACH DER ANDEREN, DANN IMMER SCHNELLER (Fred 21.09., drei Stufen:
	// „Verhaeltnis zwischen Ramp und Uhrdauer" → „Rampe am Ende raus, das
	// darf schneller werden" → „am Anfang entstehen fuenf gleichzeitig, den
	// Anfang haette ich gern langsamer, eine Uhr nach der anderen").
	// Die Abstaende zwischen den Starts schrumpfen von Uhr zu Uhr um denselben
	// Faktor (geometrisch = gleichmaessige Beschleunigung), und jede Uhr
	// dauert genau so lang wie ihr Abstand zur naechsten — die naechste
	// faengt also an, wenn die vorige fertig ist. Nur nach unten gedeckelt,
	// damit spaete Uhren noch sichtbar zeichnen.
	//   ersteLuecke  Abstand und Dauer der ersten weissen Uhr — so lang wie
	//                die Stunde, damit sie „genauso schnell wie die erste
	//                Uhr" ist
	//   dauerMin     kuerzeste Dauer einer Uhr; unterhalb laufen sie ueber-
	//                lappend, weil die Abstaende weiter schrumpfen
	//   lueckeMin    kleinster Abstand zwischen zwei Starts. OHNE diesen
	//                Boden schrumpfen die Abstaende geometrisch gegen null
	//                und das Ende wird ein Blitz (gemessen: 13 Uhren nach
	//                14 s, dann 158 auf einmal in der letzten halben
	//                Sekunde). Mit Boden wird das Ende ein schneller,
	//                gleichmaessiger Regen: dauerMin / lueckeMin Uhren laufen
	//                dann gleichzeitig.
	// Der Schrumpffaktor ergibt sich aus uhrenDauer: 176 Uhren in 11,52 s bei
	// 2,16 s Anfang heisst, nach den ersten paar Sekunden geht es sehr
	// schnell — das ist Arithmetik, kein Regler. Wer das Finale weicher
	// will, verlaengert uhrenDauer.
	ersteLuecke: 2.16,
	dauerMin: 0.3,
	lueckeMin: 0.05,
	stand: 2.04,       // das fertige Bild steht, gerechnet ab der letzten Uhr
	ausblenden: 3.9,   // alles blendet aus
	kameraRein: 6.84,  // Kamera zurueck auf 7, laeuft parallel zum Ausblenden
	nachlauf: 1.56,    // dunkel bis zur naechsten Runde
};
// Eine Kurve fuer alles: symmetrisch, weich am Anfang wie am Ende. Gilt
// fuer die Kamera, die Stunde, jede einzelne Uhr — und seit 21.09. auch
// fuer die REIHENFOLGE der Uhren (Fred: „das Animieren der Uhren ist
// momentan linear, gib dir so wie beim Zoomen ein Fade-in und Fade-out"):
// die Startzeiten liegen nicht mehr gleichmaessig, sondern folgen der
// Kurve — innen faengt es langsam an, in der Mitte laufen viele
// gleichzeitig, aussen laeuft es aus.
const KURVE = [0.65, 0, 0.35, 1];
// Kamera: Anfang und Ende als Massstab. NICHT GANZ RAUS (Fred 21.09.: „wir
// wollen ja bloss ca. 100 Uhren sehen und die anderen angeschnitten — und
// im Zweifel weniger als 100"). Bei 1,0 waren 132 Uhren ganz im Bild, bei
// 1,15 sind es 96, dazu 36 angeschnittene rundum:
//   1,00 → 132 · 1,05 → 120 · 1,10 → 114 · 1,12 → 102 · 1,15 → 96 · 1,20 → 92
const KAMERA = { start: 7, ende: 1.15 };

// Abgeleitete Marken (Sekunden ab Rundenbeginn)
const uhrenEnde = ZEIT.uhrenStart + ZEIT.uhrenDauer;
const M = {
	halt: ZEIT.halt,
	stundeEnde: ZEIT.halt + ZEIT.stunde,
	kameraEnde: ZEIT.kameraRaus === "letzteUhr" ? uhrenEnde : ZEIT.halt + ZEIT.stunde + ZEIT.kameraRaus,
	uhrenEnde,
};
const standEnde = Math.max(M.uhrenEnde, M.kameraEnde) + ZEIT.stand;
const RUNDE = Math.max(standEnde + ZEIT.ausblenden, standEnde + ZEIT.kameraRein) + ZEIT.nachlauf;
const plan = JSON.stringify({ ZEIT, KURVE, KAMERA, M, standEnde, RUNDE, N: 176 });

// Geometrie: sieben Ringe um die Stunde, Abstand 90, je Ring round(2·pi·k)
// Uhren — 176 insgesamt; beim Ende-Massstab 1,15 sind 96 ganz im Bild.
// viewBox 1000 x 1250 auf der ganzen Kachel („slice"), Stunde in (500, 625).
import Layout from "../layouts/Layout.astro";
---

