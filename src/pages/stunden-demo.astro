</Layout>

<style>
	.probe {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: clamp(60px, 10vw, 140px) 24px 160px;
	}
	.reihe { display: grid; gap: 16px; }
	@media (min-width: 800px) { .reihe { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	.hinweis { color: var(--gray); font-size: 0.95rem; margin: 0 0 12px; }
	.fuss { color: var(--gray); font-size: 0.95rem; margin: 40px 0 0; max-width: 46rem; }

	/* Kachelform wie auf der Startseite: 4:5, Panel-Grund, 2,5cqw Polster. */
	.kachel {
		container-type: inline-size;
		aspect-ratio: 4 / 5;
		background: var(--panel);
		padding: 2.5cqw;
		overflow: hidden;
	}
	.buehne { width: 100%; height: 100%; display: grid; place-items: center; }

	/* KONTRAST-PROBEN (Fred 21.09., Handy: „kann die beiden Flaechen nicht
	   voneinander unterscheiden"). Kachel #0d0d0d auf Seite #000 ist ein
	   Helligkeitsabstand von 5 % — auf OLED-Handys mit dunkler Gammakurve
	   verschwindet er. Drei Wege, per Adresse zuschaltbar, kombinierbar:
	     ?rand    1 px Linie in 14 % Weiss
	     ?hell    Kachelgrund #161616 (statt #0d0d0d)
	     ?heller  Kachelgrund #1f1f1f
	   Der Rand aendert nichts an der Flaeche, die Aufhellung aendert den
	   Token --panel fuer die ganze Seite mit — das waere dann auch die
	   Farbe der dunklen Stunde und der Fallblatt-Kacheln. */
	:global(body.rand) .kachel { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14); }
	:global(body.hell) .kachel { background: #161616; }
	:global(body.heller) .kachel { background: #1f1f1f; }

	/* ── A: 1:1 aus der Komponente ──────────────────────────────────── */
	.variante-a .stunde {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* Kamera = eine Gruppe, die um die Bildmitte skaliert. transform-box:
	   view-box macht 50 % 50 % zur Mitte der viewBox, also (500, 625) —
	   ohne das laege der Drehpunkt in der linken oberen Ecke. */
	.variante-a .kamera {
		transform-box: view-box;
		transform-origin: 50% 50%;
		transform: scale(5);
		opacity: 0;
	}

	/* SPLITTER AM ANFANG (Fred 21.09., Raster-Probe: „am Anfang gleich ein
	   weisser Strich, der konisch zulaeuft"): bei Versatz genau 1 fallen
	   Strichanfang und Pfadende aufeinander, und der Browser laesst an der
	   Kante einen Splitter stehen — bei 500 Einheiten Strichbreite ein Keil
	   vom Mittelpunkt zum Rand. Deshalb Versatz 1,02 und ein Muster mit
	   Luecke 2: der ganze Pfad (Laenge 1) liegt am Anfang sicher in der
	   Luecke, bei Versatz 0 deckt der Strich ihn ganz. */
	.variante-a .gross,
	.variante-a .stunde-fuellung,
	.variante-a .stunde-rand {
		fill: none;
		stroke-dasharray: 1 2;
		stroke-dashoffset: 1.02;
	}

	/* Halber Radius + Strich = Radius: die volle Scheibe (s. Markup). */
	.variante-a .gross {
		stroke: #ffffff;
		stroke-width: 500;
	}

	/* Der Naht-Deckel (s. Markup): unsichtbar, bis das Stueck voll ist. */
	.variante-a .gross-voll {
		fill: #ffffff;
		opacity: 0;
	}

	/* Dunkle Fuellung der Stunde, gleicher Trick, gleicher Takt wie ihre
	   Kontur — auf Schwarz zunaechst unsichtbar, bleibt aber stehen, sobald
	   das Weiss des grossen Kreises darunter durchlaeuft (Fred 20.09.:
	   „wenn es geht, bleibt der schwarze Kreis innen drin schwarz"). */
	.variante-a .stunde-fuellung {
		stroke: var(--panel);
		stroke-width: 50;
	}

	/* Kontur und Speichen: 2,5 Einheiten. Bei Kamera 5 sind das 12,5
	   Einheiten, rund 6 px auf einer 542er Kachel; in Ruhe knapp 1,3 px —
	   dieselben Werte wie vorher (0,12cqw, zehnfach im Zoom). Die Linie
	   waechst mit der Kamera, das ist gewollt: sichtbar ist am Anfang die
	   absolute Dicke. */
	.variante-a .stunde-rand,
	.variante-a .speiche {
		stroke: #ffffff;
		stroke-width: 2.5;
	}

	.variante-a .speiche--lauf {
		transform-box: view-box;
		transform-origin: 50% 50%;
	}

	/* TAKT 18s = genau zehn Schritte des Piktogramm-Bands in Kachel 1
	   (1,8 s je Schritt), die Kacheln bleiben phasengleich. Hintergrund der
	   Zahl: der exakte Tempo-Abgleich mit dem Band (52,7 px/s Kante) haette
	   45 s gebraucht — Fred am Handy: „viel zu langsam". Weitere Taktstufen:
	   14,4 s (8 Schritte), 21,6 s (12), 25,2 s (14).
	   Kurve cubic-bezier(0.65, 0, 0.35, 1) ist symmetrisch, gleich weich am
	   Anfang wie am Ende; CSS legt sie auf jeden Abschnitt einzeln, die
	   Haltezeiten sind konstante Werte und bleiben unberuehrt. */
	.variante-a.laeuft .kamera {
		animation:
			kamera 18s cubic-bezier(0.65, 0, 0.35, 1) infinite,
			ausblenden 18s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	.variante-a.laeuft .stunde-rand,
	.variante-a.laeuft .stunde-fuellung {
		animation: stunde-zeichnen 18s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	.variante-a.laeuft .speiche--lauf {
		animation: stunde-drehen 18s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	.variante-a.laeuft .gross {
		animation: kreis-fuellen 18s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	.variante-a.laeuft .gross-voll {
		animation: kreis-deckel 18s linear infinite;
	}

	/* Kamera: durchgehend von 5 auf 1 und zurueck, ohne Wegpunkt — ein
	   Zwischenhalt liesse die Fahrt mit der Abschnittskurve bis zum
	   Stillstand bremsen. Bei 5 ist die Stunde so gross wie spaeter der
	   ganze Kreis in Ruhe; bei 1 steht der grosse Kreis mit der Kachel-
	   Polsterung als Luft vollstaendig im Bild. */
	@keyframes kamera {
		0%, 4% { transform: scale(5); }
		50% { transform: scale(1); }
		88%, 100% { transform: scale(5); }
	}

	@keyframes ausblenden {
		0%, 2% { opacity: 0; }
		4%, 72.5% { opacity: 1; }
		94%, 100% { opacity: 0; }
	}

	@keyframes stunde-zeichnen {
		0%, 4% { stroke-dashoffset: 1.02; }
		16%, 100% { stroke-dashoffset: 0; }
	}

	@keyframes stunde-drehen {
		0%, 4% { transform: rotate(0turn); }
		16%, 100% { transform: rotate(1turn); }
	}

	@keyframes kreis-fuellen {
		0%, 16% { stroke-dashoffset: 1.02; }
		38%, 100% { stroke-dashoffset: 0; }
	}

	/* Deckel: kurze Ueberblendung genau um das Schliessen bei 38 %. */
	@keyframes kreis-deckel {
		0%, 37.5% { opacity: 0; }
		38.5%, 100% { opacity: 1; }
	}

	/* ── B: das Raster ─────────────────────────────────────────────── */
	.raster { display: block; width: 100%; height: 100%; overflow: visible; }

	/* Kamera wie in A, nur die Startweite ist anders: bei 7 misst die
	   Stunde 476 Einheiten, knapp die halbe Breite — wie die Stunde in A
	   bei 5 (500). Die Nachbarn liegen bei 7 mit ihren Mitten 630 Einheiten
	   von der Mitte, also ausserhalb des Bilds; sie sind ohnehin unsichtbar,
	   bis ihre Welle sie fuellt. */
	/* RASTER MITTIG, KAMERA FAEHRT MIT (Fred 21.09., „dass unser Kreis
	   nachher in der Mitte ist"). 100 hat keine Mittelzelle — jedes Rechteck
	   mit 100 Zellen hat eine gerade Seite. Also: das Raster liegt mittig in
	   der Kachel, die schwarze Stunde in Zelle (4,4), einer der vier
	   mittleren, bei (455, 580) — 45 Einheiten links und ueber der
	   Bildmitte. Damit sie am ANFANG trotzdem exakt mittig steht, faehrt die
	   Kamera mit: translate(315, 315) bei Faktor 7 bildet die
	   Stunde genau auf (500, 625) ab, bei Faktor 1 ist die Verschiebung 0
	   und das Raster steht mittig. Rechnung: O + s·(H − O) + t = O
	   ⇒ t = −s·(H − O). */
	.kamera-b {
		transform-box: view-box;
		transform-origin: 50% 50%;
		transform: translate(315px, 315px) scale(7);
		opacity: 0;
	}

	/* Naht-Deckel je Scheibe (s. Komponente): blendet ein, sobald der Ring
	   voll ist, und deckt die Haarlinie auf zwoelf Uhr zu. */
	.variante-b .feld-voll { fill: #ffffff; opacity: 0; }

	/* Die 99: weisse Scheiben per Kuchenstueck-Trick, anfangs leer. */
	.variante-b .feld {
		fill: none;
		stroke: #ffffff;
		stroke-width: 34;
		stroke-dasharray: 1 2;   /* Splitter-Fix, s. Komponente */
		stroke-dashoffset: 1.02;
	}

	/* Die eine: dunkle Fuellung, weisse Kontur, Speichen — wie in A. */
	.variante-b .stunde-fuellung,
	.variante-b .stunde-rand {
		fill: none;
		stroke-dasharray: 1 2;
		stroke-dashoffset: 1.02;
	}
	.variante-b .stunde-fuellung { stroke: var(--panel); stroke-width: 34; }
	.variante-b .stunde-rand,
	.variante-b .speiche { stroke: #ffffff; stroke-width: 2.5; }
	.variante-b .speiche--lauf { transform-box: view-box; transform-origin: 455px 580px; }

	.variante-b.laeuft .kamera-b {
		animation:
			kamera-b 18s cubic-bezier(0.65, 0, 0.35, 1) infinite,
			ausblenden-b 18s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}
	.variante-b.laeuft .stunde-rand,
	.variante-b.laeuft .stunde-fuellung { animation: zeichnen-b 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .speiche--lauf { animation: drehen-b 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .feld.ring-1 { animation: welle-1 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .feld-voll.ring-1 { animation: deckel-1 18s linear infinite; }
	.variante-b.laeuft .feld.ring-2 { animation: welle-2 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .feld-voll.ring-2 { animation: deckel-2 18s linear infinite; }
	.variante-b.laeuft .feld.ring-3 { animation: welle-3 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .feld-voll.ring-3 { animation: deckel-3 18s linear infinite; }
	.variante-b.laeuft .feld.ring-4 { animation: welle-4 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .feld-voll.ring-4 { animation: deckel-4 18s linear infinite; }
	.variante-b.laeuft .feld.ring-5 { animation: welle-5 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .feld-voll.ring-5 { animation: deckel-5 18s linear infinite; }

	@keyframes kamera-b {
		0%, 4% { transform: translate(315px, 315px) scale(7); }
		50% { transform: translate(0px, 0px) scale(1); }
		88%, 100% { transform: translate(315px, 315px) scale(7); }
	}
	@keyframes ausblenden-b {
		0%, 2% { opacity: 0; }
		4%, 72.5% { opacity: 1; }
		94%, 100% { opacity: 0; }
	}
	@keyframes zeichnen-b {
		0%, 4% { stroke-dashoffset: 1.02; }
		16%, 100% { stroke-dashoffset: 0; }
	}
	@keyframes drehen-b {
		0%, 4% { transform: rotate(0turn); }
		16%, 100% { transform: rotate(1turn); }
	}
	@keyframes welle-1 {
		0%, 26% { stroke-dashoffset: 1.02; }
		31%, 100% { stroke-dashoffset: 0; }
	}
	@keyframes deckel-1 {
		0%, 30.5% { opacity: 0; }
		31.5%, 100% { opacity: 1; }
	}
	@keyframes welle-2 {
		0%, 30% { stroke-dashoffset: 1.02; }
		35%, 100% { stroke-dashoffset: 0; }
	}
	@keyframes deckel-2 {
		0%, 34.5% { opacity: 0; }
		35.5%, 100% { opacity: 1; }
	}
	@keyframes welle-3 {
		0%, 34% { stroke-dashoffset: 1.02; }
		39%, 100% { stroke-dashoffset: 0; }
	}
	@keyframes deckel-3 {
		0%, 38.5% { opacity: 0; }
		39.5%, 100% { opacity: 1; }
	}
	@keyframes welle-4 {
		0%, 38% { stroke-dashoffset: 1.02; }
		43%, 100% { stroke-dashoffset: 0; }
	}
	@keyframes deckel-4 {
		0%, 42.5% { opacity: 0; }
		43.5%, 100% { opacity: 1; }
	}
	@keyframes welle-5 {
		0%, 42% { stroke-dashoffset: 1.02; }
		47%, 100% { stroke-dashoffset: 0; }
	}
	@keyframes deckel-5 {
		0%, 46.5% { opacity: 0; }
		47.5%, 100% { opacity: 1; }
	}
</style>

<script>
	// Beide Fassungen im selben Augenblick starten, damit sie synchron
	// laufen — auf der Startseite uebernimmt das der Sichtbarkeits-Beobachter
	// der Komponente, hier reicht der Seitenstart.
	document.addEventListener("astro:page-load", () => {
		document.querySelectorAll("[data-probe]").forEach((el) => el.classList.add("laeuft"));
		const p = new URLSearchParams(location.search);
		for (const k of ["rand", "hell", "heller"]) document.body.classList.toggle(k, p.has(k));
	});
</script>
