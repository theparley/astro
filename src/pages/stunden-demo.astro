								<circle class="feld ring-5" cx="725" cy="1030" r="17" pathLength="1" transform="rotate(-90 725 1030)" />
								<circle class="feld ring-5" cx="815" cy="1030" r="17" pathLength="1" transform="rotate(-90 815 1030)" />
								<circle class="feld ring-5" cx="905" cy="1030" r="17" pathLength="1" transform="rotate(-90 905 1030)" />
								<circle class="stunde-fuellung" cx="455" cy="580" r="17" pathLength="1" transform="rotate(-90 455 580)" />
