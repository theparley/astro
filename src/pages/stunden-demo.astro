	}
	.variante-c.laeuft .stunde-rand,
	.variante-d.laeuft .stunde-rand,
	.variante-c.laeuft .stunde-fuellung,
	.variante-d.laeuft .stunde-fuellung { animation: zeichnen-c 25.2s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-c.laeuft .speiche--lauf,
	.variante-d.laeuft .speiche--lauf { animation: drehen-c 25.2s cubic-bezier(0.65, 0, 0.35, 1) infinite; }

	@keyframes kamera-c {
		0%, 2.86% { transform: scale(7); }
		35.71%, 66.67% { transform: scale(1); }
		93.81%, 100% { transform: scale(7); }
	}
	@keyframes ausblenden-c {
		0%, 1.43% { opacity: 0; }
		2.86%, 66.67% { opacity: 1; }
		82.14%, 100% { opacity: 0; }
	}
	@keyframes zeichnen-c {
