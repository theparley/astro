<style>
	.probe {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: clamp(60px, 10vw, 140px) 24px 160px;
	}
	.reihe { display: grid; gap: 16px; }
	@media (min-width: 800px) { .reihe { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	.hinweis { color: var(--gray); font-size: 0.95rem; margin: 0 0 12px; }
	.fuss { color: var(--gray); font-size: 0.95rem; margin: 40px 0 0; max-width: 46rem; }

	/* Kachelform wie auf der Startseite: 4:5, Panel-Grund, 2,5cqw Polster. */
	.kachel {
		position: relative;
		container-type: inline-size;
		aspect-ratio: 4 / 5;
		background: var(--panel);
		padding: 2.5cqw;
		overflow: hidden;
	}
	.buehne { width: 100%; height: 100%; display: grid; place-items: center; }

	/* KONTRAST-PROBEN (Fred 21.09., Handy: Kachel und Seite fallen farblich
	   zusammen). ?rand 1 px Linie in 14 % Weiss · ?hell #161616 · ?heller
	   #1f1f1f. Der Rand aendert nur die Kante; die Aufhellung wuerde auf der
	   Startseite den Token --panel mitziehen. */
	:global(body.rand) .kachel { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14); }
	:global(body.hell) .kachel { background: #161616; }
	:global(body.heller) .kachel { background: #1f1f1f; }

	/* ── A: 1:1 aus der Komponente ──────────────────────────────────── */
	.variante-a .stunde {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* Kamera = eine Gruppe, die um die Bildmitte skaliert. transform-box:
	   view-box macht 50 % 50 % zur Mitte der viewBox, also (500, 625) —
	   ohne das laege der Drehpunkt in der linken oberen Ecke. */
	.variante-a .kamera {
		transform-box: view-box;
		transform-origin: 50% 50%;
		transform: scale(5);
		opacity: 0;
	}

	/* SPLITTER AM ANFANG (Fred 21.09., Raster-Probe: „am Anfang gleich ein
	   weisser Strich, der konisch zulaeuft"): bei Versatz genau 1 fallen
	   Strichanfang und Pfadende aufeinander, und der Browser laesst an der
	   Kante einen Splitter stehen — bei 500 Einheiten Strichbreite ein Keil
	   vom Mittelpunkt zum Rand. Deshalb Versatz ueber 1 und ein Muster mit
	   Luecke 2: der ganze Pfad (Laenge 1) liegt am Anfang sicher in der
	   Luecke.
	   SPALT AM ENDE (Fred 21.09., „der erste Kreis schliesst die weisse
	   Linie nicht ganz, da bleibt ein Mini-Spalt Schwarz"): bei Versatz 0
	   endete der Strich (Laenge 1) rechnerisch exakt am Pfadende — und die
	   Pfadlaenge ist im Browser nie ganz exakt 1. Der Strich ist jetzt 1,04
	   lang und schiesst um 4 % ueber zwoelf Uhr hinaus; Startversatz 1,06,
	   damit er anfangs trotzdem komplett in der Luecke liegt. Der Ueberschuss
	   malt in derselben Farbe ueber den Anfang, also unsichtbar — und deckt
	   nebenbei die Naht der Kuchenstuecke mit ab. */
	.variante-a .gross,
	.variante-a .stunde-fuellung,
	.variante-a .stunde-rand {
		fill: none;
		stroke-dasharray: 1.04 2;
		stroke-dashoffset: 1.06;
	}

	/* Halber Radius + Strich = Radius: die volle Scheibe (s. Markup). */
	.variante-a .gross {
		stroke: #ffffff;
		stroke-width: 500;
	}

	/* Der Naht-Deckel (s. Markup): unsichtbar, bis das Stueck voll ist. */
	.variante-a .gross-voll {
		fill: #ffffff;
		opacity: 0;
	}

	/* Dunkle Fuellung der Stunde, gleicher Trick, gleicher Takt wie ihre
	   Kontur — auf Schwarz zunaechst unsichtbar, bleibt aber stehen, sobald
	   das Weiss des grossen Kreises darunter durchlaeuft (Fred 20.09.:
	   „wenn es geht, bleibt der schwarze Kreis innen drin schwarz"). */
	.variante-a .stunde-fuellung {
		stroke: var(--panel);
		stroke-width: 50;
	}

	/* Kontur und Speichen: 2,5 Einheiten. Bei Kamera 5 sind das 12,5
	   Einheiten, rund 6 px auf einer 542er Kachel; in Ruhe knapp 1,3 px —
	   dieselben Werte wie vorher (0,12cqw, zehnfach im Zoom). Die Linie
	   waechst mit der Kamera, das ist gewollt: sichtbar ist am Anfang die
	   absolute Dicke. */
	.variante-a .stunde-rand,
	.variante-a .speiche {
		stroke: #ffffff;
		stroke-width: 2.5;
	}

	.variante-a .speiche--lauf {
		transform-box: view-box;
		transform-origin: 50% 50%;
	}

	/* TAKT 18s = genau zehn Schritte des Piktogramm-Bands in Kachel 1
	   (1,8 s je Schritt), die Kacheln bleiben phasengleich. Hintergrund der
	   Zahl: der exakte Tempo-Abgleich mit dem Band (52,7 px/s Kante) haette
	   45 s gebraucht — Fred am Handy: „viel zu langsam". Weitere Taktstufen:
	   14,4 s (8 Schritte), 21,6 s (12), 25,2 s (14).
	   Kurve cubic-bezier(0.65, 0, 0.35, 1) ist symmetrisch, gleich weich am
	   Anfang wie am Ende; CSS legt sie auf jeden Abschnitt einzeln, die
	   Haltezeiten sind konstante Werte und bleiben unberuehrt. */
	.variante-a.laeuft .kamera {
		animation:
			kamera 18s cubic-bezier(0.65, 0, 0.35, 1) infinite,
			ausblenden 18s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	.variante-a.laeuft .stunde-rand,
	.variante-a.laeuft .stunde-fuellung {
		animation: stunde-zeichnen 18s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	.variante-a.laeuft .speiche--lauf {
		animation: stunde-drehen 18s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	.variante-a.laeuft .gross {
		animation: kreis-fuellen 18s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	.variante-a.laeuft .gross-voll {
		animation: kreis-deckel 18s linear infinite;
	}

	/* Kamera: durchgehend von 5 auf 1 und zurueck, ohne Wegpunkt — ein
	   Zwischenhalt liesse die Fahrt mit der Abschnittskurve bis zum
	   Stillstand bremsen. Bei 5 ist die Stunde so gross wie spaeter der
	   ganze Kreis in Ruhe; bei 1 steht der grosse Kreis mit der Kachel-
	   Polsterung als Luft vollstaendig im Bild. */
	@keyframes kamera {
		0%, 4% { transform: scale(5); }
		50% { transform: scale(1); }
		88%, 100% { transform: scale(5); }
	}

	@keyframes ausblenden {
		0%, 2% { opacity: 0; }
		4%, 72.5% { opacity: 1; }
		94%, 100% { opacity: 0; }
	}

	@keyframes stunde-zeichnen {
		0%, 4% { stroke-dashoffset: 1.06; }
		16%, 100% { stroke-dashoffset: 0; }
	}

	@keyframes stunde-drehen {
		0%, 4% { transform: rotate(0turn); }
		16%, 100% { transform: rotate(1turn); }
	}

	@keyframes kreis-fuellen {
		0%, 16% { stroke-dashoffset: 1.06; }
		38%, 100% { stroke-dashoffset: 0; }
	}

	/* Deckel: kurze Ueberblendung genau um das Schliessen bei 38 %. */
	@keyframes kreis-deckel {
		0%, 37.5% { opacity: 0; }
		38.5%, 100% { opacity: 1; }
	}


	/* ── B und C: gemeinsames Material ─────────────────────────────── */
	/* SVG auf der GANZEN Kachel (nicht in der Innenflaeche, sonst bleibt die
	   Polsterung als Rand und der Anschnitt faellt weg), „slice" legt x = 0
	   exakt auf die linke Kachelkante. */
	.raster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.kamera-b,
	.kamera-c {
		transform-box: view-box;
		transform-origin: 50% 50%;
		transform: scale(7);
		opacity: 0;
	}

	/* Kuchenstueck-Trick, anfangs leer; Strich 1,04 lang gegen Splitter am
	   Anfang und Spalt am Ende (s. Komponente). */
	.variante-b .feld,
	.variante-c .feld,
	.variante-d .feld {
		fill: none;
		stroke: #ffffff;
		stroke-width: 34;
		stroke-dasharray: 1.04 2;
		stroke-dashoffset: 1.06;
	}
	.variante-b .feld-voll { fill: #ffffff; opacity: 0; }

	.variante-b .stunde-fuellung,
	.variante-b .stunde-rand,
	.variante-c .stunde-fuellung,
	.variante-d .stunde-fuellung,
	.variante-c .stunde-rand,
	.variante-d .stunde-rand {
		fill: none;
		stroke-dasharray: 1.04 2;
		stroke-dashoffset: 1.06;
	}
	.variante-b .stunde-fuellung,
	.variante-c .stunde-fuellung,
	.variante-d .stunde-fuellung { stroke: var(--panel); stroke-width: 34; }
	.variante-b .stunde-rand,
	.variante-b .speiche,
	.variante-c .stunde-rand,
	.variante-d .stunde-rand,
	.variante-c .speiche,
	.variante-d .speiche { stroke: #ffffff; stroke-width: 2.5; }
	.variante-b .speiche--lauf,
	.variante-c .speiche--lauf,
	.variante-d .speiche--lauf { transform-box: view-box; transform-origin: 50% 50%; }

	/* ZIFFERNBLATT als zwei gestrichelte Kreise je Uhr (Strichbreite =
	   radiale Laenge des Ticks, Muster = Tick-Breite und Luecke; pathLength
	   60 bzw. 4). Dunkle Blaetter liegen ueber den weissen Scheiben und
	   erscheinen in dem Mass, wie das Weiss darunter waechst. */
	.blatt { fill: none; }
	.blatt.minute { stroke-width: 3.5; }
	.blatt.viertel { stroke-width: 7.0; }
	.blatt--hell { stroke: #ffffff; }
	.blatt--dunkel { stroke: var(--panel); }
	:global(body.hell) .blatt--dunkel { stroke: #161616; }
	:global(body.heller) .blatt--dunkel { stroke: #1f1f1f; }
	:global(body.ohneblatt) .blatt { display: none; }

	.variante-b.laeuft .kamera-b {
		animation:
			kamera-bc 18s cubic-bezier(0.65, 0, 0.35, 1) infinite,
			ausblenden-bc 18s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}
	.variante-b.laeuft .stunde-rand,
	.variante-b.laeuft .stunde-fuellung { animation: zeichnen-bc 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	.variante-b.laeuft .speiche--lauf { animation: drehen-bc 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	/* C: EIGENE RUNDE VON 25.2 s = 14 Bandschritte (Fred 21.09.: „die Animation
	   von den Uhren ist zu schnell … verändere nicht die Zoom-Geschwindigkeit,
	   halbiere die Geschwindigkeit, wie wir die Uhren nacheinander animieren,
	   und lass dafür am Ende das Bild länger stehen"). Alle Phasen behalten
	   ihre absoluten Zeiten von der 18-s-Runde, nur der Durchlauf der Uhren
	   dauert doppelt so lang und die Kamera bleibt stehen, bis er fertig ist:
	     0–0.72 s       Halt, Einblendung
	     0.72–2.88 s    Stunde zeichnet sich
	     2.88–9.0 s    Kamera 7 → 1 (unveraendert)
	     3.24–14.76 s  Uhren einzeln, Ring fuer Ring (vorher bis 9,0 s)
	     bis 16.8 s      Bild steht, alle Uhren voll
	     16.8–20.7 s   Ausblenden
	     16.8–23.64 s  Kamera zurueck auf 7
	   In Prozent der Runde: */
	.variante-c.laeuft .kamera-c,
	.variante-d.laeuft .kamera-c {
		animation:
			kamera-c 25.2s cubic-bezier(0.65, 0, 0.35, 1) infinite,
