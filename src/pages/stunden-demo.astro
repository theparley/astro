		11.43%, 100% { transform: rotate(1turn); }
	}

	:global(body.wellen) .variante-b.laeuft .feld.ring-1 { animation: welle-1 18s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
	:global(body.wellen) .variante-b.laeuft .feld-voll.ring-1 { animation: deckel-1 18s linear infinite; }
