<script>
	// C: jede Uhr bekommt ihre eigene 18-s-Animation mit vier Marken — leer
	// bis zu ihrem Start, dann 1,5 % lang fuellen, dann voll bis zum Ende der
	// Runde. Erst diese anlegen, dann im selben Durchlauf die Klasse setzen,
	// damit CSS- und WAAPI-Animationen im selben Bild beginnen.
	function uhrenAnlegen() {
		const wellen = new URLSearchParams(location.search).has("wellen");
		const ziel = wellen ? ".variante-c .feld[data-s]" : ".feld[data-s]";
		document.querySelectorAll<SVGCircleElement>(ziel).forEach((el) => {
			const s = Number(el.dataset.s);
			const e = Number(el.dataset.e);
			const RUNDE = Number(el.closest<HTMLElement>("[data-runde]")?.dataset.runde ?? 18000);
			el.animate(
				[
					{ strokeDashoffset: 1.06, offset: 0 },
					{ strokeDashoffset: 1.06, offset: s, easing: "cubic-bezier(0.65, 0, 0.35, 1)" },
					{ strokeDashoffset: 0, offset: e },
					{ strokeDashoffset: 0, offset: 1 },
				],
				{ duration: RUNDE, iterations: Infinity },
			);
		});
	}
	document.addEventListener("astro:page-load", () => {
		uhrenAnlegen();
		document.querySelectorAll("[data-probe]").forEach((el) => el.classList.add("laeuft"));
		const p = new URLSearchParams(location.search);
		for (const k of ["rand", "hell", "heller", "ohneblatt", "wellen"]) document.body.classList.toggle(k, p.has(k));
	});
</script>
