<style>
	.probe {
		max-width: 542px;
		margin: 0 auto;
		padding: clamp(60px, 10vw, 140px) 24px 160px;
	}
	.hinweis { color: var(--gray); font-size: 0.95rem; margin: 0 0 12px; }
	.fuss { color: var(--gray); font-size: 0.95rem; margin: 40px 0 0; white-space: pre-line; }

	/* Kachelform wie auf der Startseite: 4:5, Panel-Grund, 2,5cqw Polster. */
	.kachel {
		position: relative;
		container-type: inline-size;
		aspect-ratio: 4 / 5;
		background: var(--panel);
		padding: 2.5cqw;
		overflow: hidden;
	}
	.buehne { width: 100%; height: 100%; }

	/* Kontrast-Proben per Adresse: ?rand ?hell ?heller (s. Kommentar der
	   frueheren Fassung: 5 % Helligkeitsabstand verschwindet auf OLED). */
	:global(body.rand) .kachel { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14); }
	:global(body.hell) .kachel { background: #161616; }
	:global(body.heller) .kachel { background: #1f1f1f; }

	/* SVG auf der GANZEN Kachel, „slice" legt x = 0 auf die linke Kante. */
	.raster { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

	/* Kamera um die Bildmitte. Ruhezustaende hier; die Bewegung kommt aus
	   dem Skript (Web Animations API), damit alle Zeiten aus ZEIT stammen. */
	.kamera { transform-box: view-box; transform-origin: 50% 50%; transform: scale(7); opacity: 0; }

	/* Kuchenstueck-Trick, Strich 1,04 lang gegen Splitter und Spalt. */
	.feld,
	.stunde-fuellung,
	.stunde-rand { fill: none; stroke-dasharray: 1.04 2; stroke-dashoffset: 1.06; }
	.feld { stroke: #ffffff; stroke-width: 34; }
	.stunde-fuellung { stroke: var(--panel); stroke-width: 34; }
	.stunde-rand,
	.speiche { stroke: #ffffff; stroke-width: 2.5; }
	.speiche--lauf { transform-box: view-box; transform-origin: 50% 50%; }

	/* Ziffernblatt als zwei gestrichelte Kreise je Uhr. */
	.blatt { fill: none; }
	.blatt.minute { stroke-width: 3.5; }
	.blatt.viertel { stroke-width: 7.0; }
	.blatt--hell { stroke: #ffffff; }
	.blatt--dunkel { stroke: var(--panel); }
	:global(body.hell) .blatt--dunkel { stroke: #161616; }
	:global(body.heller) .blatt--dunkel { stroke: #1f1f1f; }
	:global(body.ohneblatt) .blatt { display: none; }
</style>

<script>
	// Loeser fuer eine CSS-Kurve cubic-bezier(x1, y1, x2, y2): gibt zu einem
	// Fortschritt x (0..1) den Wert y. Gebraucht, um die STARTZEITEN der
	// Uhren auf dieselbe Kurve zu legen wie die Kamera.
	function bezier(x1: number, y1: number, x2: number, y2: number) {
		const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
		const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
		const X = (t: number) => ((ax * t + bx) * t + cx) * t;
		const Y = (t: number) => ((ay * t + by) * t + cy) * t;
		const dX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
		return (x: number) => {
			let t = x;
			for (let i = 0; i < 8; i++) { const d = X(t) - x; if (Math.abs(d) < 1e-6) break; t -= d / dX(t); }
			return Y(Math.min(1, Math.max(0, t)));
		};
	}

	function anlegen(buehne: HTMLElement) {
		const P = JSON.parse(buehne.dataset.plan!);
		const { ZEIT, KURVE, KAMERA, M, standEnde, RUNDE, N } = P;
		const S0 = `scale(${KAMERA.start})`, S1 = `scale(${KAMERA.ende})`;
		const K = `cubic-bezier(${KURVE.join(", ")})`;
		const ms = RUNDE * 1000;
		const o = (s: number) => s / RUNDE; // Sekunde -> Anteil der Runde
		// GEOMETRISCHE BESCHLEUNIGUNG: Luecke_i = ersteLuecke · q^i. Der
		// Faktor q wird so gesucht (Bisektion), dass die letzte Uhr genau bei
		// uhrenEnde fertig ist: Summe der Luecken + Dauer der letzten = uhrenDauer.
		const dauerVon = (luecke: number) => Math.max(ZEIT.dauerMin, luecke);
		const lueckeVon = (roh: number) => Math.max(ZEIT.lueckeMin, roh);
		const gesamt = (q: number) => {
			let t = 0, g = ZEIT.ersteLuecke;
			for (let i = 0; i < N - 1; i++) { t += lueckeVon(g); g *= q; }
			return t + dauerVon(lueckeVon(g));
		};
		let lo = 0.5, hi = 1;
		for (let k = 0; k < 60; k++) { const mid = (lo + hi) / 2; if (gesamt(mid) > ZEIT.uhrenDauer) hi = mid; else lo = mid; }
		const q = (lo + hi) / 2;
		const starts: number[] = [], dauern: number[] = [];
		for (let i = 0, t = 0, g = ZEIT.ersteLuecke; i < N; i++, t += lueckeVon(g), g *= q) { starts.push(t); dauern.push(dauerVon(lueckeVon(g))); }
		// Nur fuer die Fusszeile: wann sind 10, 50, 100 Uhren gestartet?
		const wann = (n: number) => starts[Math.min(N - 1, n - 1)].toFixed(1);
		const opt = { duration: ms, iterations: Infinity };

		const kamera = buehne.querySelector<SVGGElement>(".kamera")!;
		kamera.animate([
			{ transform: S0, offset: 0 },
			{ transform: S0, offset: o(M.stundeEnde), easing: K },
			{ transform: S1, offset: o(M.kameraEnde) },
			{ transform: S1, offset: o(standEnde), easing: K },
			{ transform: S0, offset: o(standEnde + ZEIT.kameraRein) },
			{ transform: S0, offset: 1 },
		], opt);
		kamera.animate([
			{ opacity: 0, offset: 0 },
			{ opacity: 0, offset: o(M.halt / 2) },
			{ opacity: 1, offset: o(M.halt) },
			{ opacity: 1, offset: o(standEnde), easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
			{ opacity: 0, offset: o(standEnde + ZEIT.ausblenden) },
			{ opacity: 0, offset: 1 },
		], opt);

		// Die Stunde: Rand und dunkle Fuellung zeichnen sich, der Zeiger dreht.
		const zeichnen = [
			{ strokeDashoffset: 1.06, offset: 0 },
			{ strokeDashoffset: 1.06, offset: o(M.halt), easing: K },
			{ strokeDashoffset: 0, offset: o(M.stundeEnde) },
			{ strokeDashoffset: 0, offset: 1 },
		];
		buehne.querySelectorAll<SVGCircleElement>(".stunde-rand, .stunde-fuellung").forEach((el) => el.animate(zeichnen, opt));
		buehne.querySelector<SVGLineElement>(".speiche--lauf")!.animate([
			{ transform: "rotate(0turn)", offset: 0 },
			{ transform: "rotate(0turn)", offset: o(M.halt), easing: K },
			{ transform: "rotate(1turn)", offset: o(M.stundeEnde) },
			{ transform: "rotate(1turn)", offset: 1 },
		], opt);

		// Die Uhren: Start und Dauer aus der Beschleunigung (s. oben).
		buehne.querySelectorAll<SVGCircleElement>(".feld[data-i]").forEach((el) => {
			const i = Number(el.dataset.i);
			const s = ZEIT.uhrenStart + starts[i];
			el.animate([
				{ strokeDashoffset: 1.06, offset: 0 },
				{ strokeDashoffset: 1.06, offset: o(s), easing: K },
				{ strokeDashoffset: 0, offset: o(s + dauern[i]) },
				{ strokeDashoffset: 0, offset: 1 },
			], opt);
		});
		const mitte = Math.floor(N / 2);

		const fuss = document.querySelector("[data-fuss]");
		if (fuss) fuss.textContent =
			`Runde ${RUNDE.toFixed(2)} s.\n` +
			`Stunde ${M.halt}–${M.stundeEnde.toFixed(2)} s · Kamera raus ${M.stundeEnde.toFixed(2)}–${M.kameraEnde.toFixed(2)} s · ` +
			`Uhren ${ZEIT.uhrenStart}–${M.uhrenEnde.toFixed(2)} s, Schrumpffaktor ${q.toFixed(3)} je Uhr — ` +
			`Dauer erste ${dauern[0].toFixed(2)} s, zehnte ${dauern[9].toFixed(2)} s, Mitte ${dauern[mitte].toFixed(2)} s, letzte ${dauern[N - 1].toFixed(2)} s; ` +
			`10 Uhren gestartet nach ${wann(10)} s, 50 nach ${wann(50)} s, 100 nach ${wann(100)} s · ` +
			`steht bis ${standEnde.toFixed(2)} s · ausblenden bis ${(standEnde + ZEIT.ausblenden).toFixed(2)} s · ` +
			`Kamera rein bis ${(standEnde + ZEIT.kameraRein).toFixed(2)} s.\n` +
			`Schalter: ?rand ?hell ?heller ?ohneblatt`;
	}

	document.addEventListener("astro:page-load", () => {
		document.querySelectorAll<HTMLElement>("[data-probe]").forEach(anlegen);
		const p = new URLSearchParams(location.search);
		for (const k of ["rand", "hell", "heller", "ohneblatt"]) document.body.classList.toggle(k, p.has(k));
	});
</script>
