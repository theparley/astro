---
import Layout from "../layouts/Layout.astro";
---

{/* /termin — DIE eine Tür der Seite (Struktur-Entscheid Fred 2026-06-14:
   Home + /termin + /kontakt; ersetzt /buchen, das per Redirect hierher
   zeigt). Eigenbau-Kalender auf Basis der meetergo-API (Website-Brief,
   /buchen-Kapitel + FINALE UI-Spec 29.08. abends) — PAT bleibt server-
   seitig in den Cloudflare Pages Functions unter functions/api/
   {slots,book}.js, siehe functions/_lib/meetergo.js. Der ?kalender-
   Schalter ist Geschichte: Secrets sind gesetzt, Strecke Ende-zu-Ende
   getestet (Brief-Fortschritt 2026-06-14), der Kalender ist scharf.
   Das Anfrage-Formular lebt jetzt auf /kontakt (stilles Fallnetz, nie
   als CTA beworben — Ein-Tür-Konvention bleibt intakt). */}
<Layout title="Termin" description="Let's Parley: ein kleines Gespräch. 30 Minuten, nichts vorbereiten. Buche direkt einen Termin mit The Parley.">
	<main class="buchen">
		{/* Headline = Name der Terminart (Fred 2026-06-14): "Let's Parley" —
		   identisch mit meetergo-Terminart und künftigem CTA. Intro-Text
		   bewusst leer (Fred 2026-06-14: alter Text verworfen, kein Vorrat —
		   neuer Text folgt in einer Wording-Runde). */}
		<h1>Let's Parley</h1>

		<div id="kalenderTeil">
		{/* Desktop-Zweispalter (Fred 2026-06-14, revidiert FINALE-Spec-Punkt
		   "Uhrzeiten docken unter dem Monat an"): ab 900px sitzen Uhrzeiten +
		   Formular als sticky Seitenspalte RECHTS neben dem Kalender — alles
		   auf einen Blick, kein Scrollen. Unter 900px (Handy) bleibt das
		   bewährte Andocken unterm gewählten Monat. Das Umdocken macht
		   dockSteps() im Script anhand derselben 900px-Media-Query. */}
		<div class="kalender-grid">
		{/* Schritt 1: Tag */}
		<div id="stepDay">
			<p class="step-label">1 · Tag wählen</p>
			<div id="monthsContainer">
				<p class="status" id="loadingStatus" role="status" aria-live="polite">Termine werden geladen …</p>
			</div>
		</div>
		<aside id="sidePanel">
			<p class="side-hint" id="sideHint">Wähle links einen Tag —<br />die freien Uhrzeiten erscheinen hier.</p>
		</aside>
		{/* Dritte Spalte (Fred 2026-06-14): ab 1150px wandert Schritt 3
		   (Formular) in eine eigene Spalte — 1 Tag · 2 Uhrzeit · 3 Daten
		   nebeneinander. Zwischen 900 und 1150px bleibt das Formular unter
		   den Uhrzeiten im sidePanel, mobil unterm Monat. */}
		<aside id="sideForm"></aside>
		</div>

		{/* Schritt 2: Uhrzeit — wird per JS in die inline-{Monat}-Andockstelle
		   unter dem gewählten Monat verschoben (FINALE Spec: Auswahl und
		   Antwort bleiben beieinander). IMMER Liste untereinander (Fred-
		   Entscheid 29.08.), kein Zeilen-/Auto-Modus mehr. */}
		<div id="stepTime" class="hidden">
			<p class="step-label">2 · Uhrzeit wählen: <span id="timeDayLabel"></span></p>
			<div class="slots" id="slotsGrid"></div>
			<p class="status error hidden" id="slotsError" role="alert" aria-live="assertive"></p>
		</div>

		{/* Schritt 3: Daten */}
		<div id="stepForm" class="hidden">
			<p class="step-label">3 · Fast geschafft</p>
			<p class="chosen" id="chosenLabel"></p>
			<div class="field"><label for="f-name">Name</label><input id="f-name" type="text" autocomplete="name" /></div>
			<div class="field"><label for="f-email">E-Mail</label><input id="f-email" type="email" autocomplete="email" /></div>
			<div class="field"><label for="f-message">Worum geht es? (optional)</label><textarea id="f-message" rows="2"></textarea></div>
			{/* Honeypot (Audit-Fix A4): für Menschen unsichtbares Feld, für simple
			   Spam-Bots aber wie ein normales Formularfeld auffindbar. Ist es beim
			   Absenden gefüllt, gilt die Anfrage server-seitig als Spam (siehe
			   functions/api/book.js) — dort still verworfen, ohne den Bot durch
			   eine abweichende Fehlerantwort schlauer zu machen. */}
			<div class="hp-field" aria-hidden="true">
				<label for="f-website">Website</label>
				<input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
			</div>
			<p class="privacy">Deine Daten nutzen wir nur für diesen Termin. <a href="/datenschutz">Datenschutz</a></p>
			<p class="status error hidden" id="formError" role="alert" aria-live="assertive"></p>
			<div class="actions">
				<button type="button" class="btn-back" id="btnBack">Zurück</button>
				<button type="button" class="btn-confirm" id="btnConfirm">Gespräch buchen</button>
			</div>
		</div>

		{/* Bestätigung */}
		<div id="stepDone" class="hidden done">
			<div class="flag">⚑</div>
			<h2>Parley angenommen.</h2>
			<p id="doneLabel"></p>
			<p style="margin-top:8px">Die Bestätigung ist unterwegs in dein Postfach.</p>
		</div>

		</div>

		{/* Telefonnummer von der Website genommen (Fred 2026-06-14) — die
		   stille Direkt-Zeile ist jetzt Mail-only. */}
		<div class="direct">
			Lieber direkt? Schreib uns.<br />
			<a href="mailto:eckert@theparley.de">eckert@theparley.de</a>
		</div>
	</main>
</Layout>

<style is:global>
	/* is:global (nicht Astros scoped CSS): fast der gesamte Kalender wird per
	   JS erzeugt (Tage, Uhrzeiten, Balken) — dynamisch angelegte Elemente
	   bekommen NIE Astros data-astro-cid-Attribut, scoped Selektoren würden
	   sie also nie treffen. Kollisionsrisiko gering: dieser Style-Block lädt
	   ohnehin nur auf /termin, kein anderes Astro-Bundle bekommt ihn zu sehen.
	   Farb-Treppe kommt aus dem sitewiten Token-Satz (Layout.astro) — hier nur
	   die Balken-Töne, die laut Website-Brief eigene "Fred-Token" sind statt
	   Teil der allgemeinen Treppe. Wrapper-Klasse heißt weiterhin .buchen
	   (geerbtes CSS-Vokabular der alten /buchen-Seite — bewusst nicht
	   umbenannt, /kontakt nutzt dieselbe Grundspalte). */
	.buchen {
		--seg-free: #6e6e6e;
		--seg-busy: #383838;
		--seg-free-selected: #0a0a0a;
	}

	/* Eine zentrierte Spalte, fluid bis Deckel 520px (FINALE Spec Punkt 4).
	   NEU (Fred 2026-06-14): ab 900px weitet sich die Seite und der Kalender
	   bekommt eine Seitenspalte — der einzige Struktur-Breakpoint der Seite,
	   bewusst gesetzt ("wenn die Fläche es hergibt"). */
	.buchen {
		max-width: 520px;
		margin: 0 auto;
		padding: 64px 16px 140px;
		/* Mindesthöhe = Viewport (Fred-Befund 2026-06-14): Während der Kalender
		   lädt, war die Seite nur wenige hundert Pixel hoch — der Sticky-Footer
		   (Parley-Monument, z-0) stand dadurch beim Laden im Viewport und wurde
		   nach dem Slot-Fetch weggeschoben (Flackern + durchguckende P-Spitze).
		   Mit min-height füllt der Inhalt den Viewport von Anfang an, der
		   Footer bleibt bis zum echten Zuendescrollen verdeckt. */
		min-height: 100dvh;
	}

	@media (min-width: 1024px) {
		.buchen {
			padding-left: 32px;
			padding-right: 32px;
		}
	}

	/* Desktop-Zweispalter: Kalender links (max. 520px wie gehabt), Uhrzeiten/
	   Formular rechts als sticky Panel — bleibt beim Scrollen durch die zwei
	   Monatsblöcke im Blick. Auf Mobil ist .kalender-grid ein normaler
	   Block-Fluss und #sidePanel leer (die Schritte docken unterm Monat an). */
	@media (min-width: 900px) {
		.buchen {
			max-width: 960px;
		}

		.kalender-grid {
			display: grid;
			grid-template-columns: minmax(0, 520px) minmax(280px, 1fr);
			gap: 0 48px;
			align-items: start;
		}

		#sidePanel {
			position: sticky;
			top: 32px;
		}
	}

	/* Drei Spalten (Fred 2026-06-14): 1 Tag · 2 Uhrzeit · 3 Formular. */
	@media (min-width: 1150px) {
		.buchen {
			max-width: 1200px;
		}

		.kalender-grid {
			grid-template-columns: minmax(0, 500px) minmax(200px, 280px) minmax(260px, 1fr);
		}

		#sideForm {
			position: sticky;
			top: 32px;
		}
	}

	.side-hint {
		display: none;
	}

	@media (min-width: 900px) {
		.side-hint {
			display: block;
			margin-top: 26px;
			font-size: 0.85rem;
			color: var(--gray);
			border-left: 2px solid var(--line);
			padding-left: 10px;
			line-height: 1.45;
		}

		.side-hint.hidden {
			display: none;
		}
	}

	h1 {
		font-size: 1.9rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.sub {
		color: var(--gray);
		margin-top: 6px;
		font-size: 1rem;
	}

	.geleit {
		margin-top: 14px;
		font-size: 0.85rem;
		color: var(--gray);
		border-left: 2px solid var(--line);
		padding-left: 10px;
		line-height: 1.45;
	}

	.step-label {
		margin: 26px 0 10px;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray);
	}

	.status {
		font-size: 0.85rem;
		color: var(--gray);
		padding: 12px 0;
	}

	/* #e0a0a0 bewusst außerhalb der Kern-Farb-Treppe (Audit-Fix B8, Befund
	   dokumentiert statt umgefärbt): eigener Fehler-Rot-Ton fürs Kalender-
	   Formular, kein Token in Layout.astro dafür vorgesehen. */
	.status.error {
		color: #e0a0a0;
	}

	.hidden {
		display: none;
	}

	/* Tages-Kacheln — immer 7 Spalten (Mo–So), FINALE Spec: kein Werktage-
	   Umschalter mehr, das war nur ein Regler-Experiment in der Demo. */
	.month {
		font-size: 0.9rem;
		font-weight: 700;
		margin: 10px 0 8px;
		text-transform: capitalize;
	}

	.dows,
	.days {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 6px;
	}

	.dows span {
		font-size: 0.65rem;
		color: var(--gray);
		text-align: center;
		letter-spacing: 0.05em;
	}

	.day {
		aspect-ratio: 1;
		border: none;
		background: none;
		/* --tile-text statt --white (Audit-Fix B7/B8): dieser Wert greift nur
		   für freie Tage (.day.full/.off/.selected überschreiben ihn weiter
		   unten je mit eigener Farbe) — und genau die haben --tile (#404040)
		   als Hintergrund (.day.free-Regel unten). --tile-text (#c8c8c8) ist
		   im Token-Satz (Layout.astro) exakt für diesen Kontrast-Fall gedacht. */
		color: var(--tile-text);
		font-family: inherit;
		/* Zahl + Balken skalieren mit der Kachelbreite (cqw) — kein Breakpoint */
		container-type: inline-size;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 0;
	}

	.day .num {
		font-size: clamp(0.95rem, 42cqw, 1.55rem);
		font-weight: 700;
		line-height: 1;
	}

	/* Belegungs-Balken: SENKRECHTER Stapel rechts neben der Zahl (FINALE Spec
	   Punkt 2 — ersetzt die quere Tagesleiste, die dadurch ganz entfällt).
	   Miniatur der Uhrzeiten-Liste: oben = morgens, unten = abends. */
	.day .state {
		position: absolute;
		top: 50%;
		right: 3px;
		transform: translateY(-50%);
	}

	.daybar {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1px;
	}

	/* Segmente als liegende Rechtecke, 2:1 (Fred-Entscheid 29.08.) */
	.daybar span {
		flex: none;
		height: clamp(2px, 6cqw, 4px);
		aspect-ratio: 2 / 1;
		background: var(--seg-busy);
	}

	.daybar span.f {
		background: var(--seg-free);
	}

	/* Balken nur auf wählbaren Kacheln (Punkt 3) */
	.day.free {
		background: var(--tile);
	}

	/* #555/#444 bewusst außerhalb der Kern-Farb-Treppe (Audit-Fix B8, Befund
	   dokumentiert statt umgefärbt): eigene abgestufte Grautöne für
	   deaktivierte Tages-Zustände (voll/wochenende-oder-Vergangenheit) — kein
	   Treppen-Token trifft genau diese beiden Abstufungen. */
	.day.full {
		color: #555;
		cursor: default;
	}

	.day.full .num {
		text-decoration: line-through;
	}

	.day.off {
		color: #444;
		cursor: default;
	}

	.day.off .state {
		display: none;
	}

	/* Gewählte Kachel: Balken invertiert — nur freie Fenster als dunkle
	   Marken, vergebene entfallen (Punkt 3) */
	.day.selected {
		background: var(--surface);
		color: var(--black);
	}

	.day.selected .daybar span {
		background: transparent;
	}

	.day.selected .daybar span.f {
		background: var(--seg-free-selected);
	}

	/* Uhrzeiten-Layout: IMMER Liste untereinander, volle Breite, gleiche
	   Schriftgröße (FINALE Spec Punkt 1) */
	.slots {
		display: grid;
		grid-template-columns: 1fr;
		gap: 6px;
	}

	.slot {
		border: none;
		background: var(--tile);
		/* --tile-text statt --white — gleicher Kontrast-Grund wie bei .day
		   oben (Audit-Fix B7/B8): Text auf --tile (#404040)-Fläche. */
		color: var(--tile-text);
		font-family: inherit;
		font-size: 1.05rem;
		font-weight: 700;
		padding: 14px 0;
		cursor: pointer;
	}

	.slot.selected {
		background: var(--surface);
		color: var(--black);
	}

	/* Belegte Uhrzeiten mit anzeigen, ausgegraut (Fred 2026-06-14): wiederholt
	   die Balken-Semantik der Tages-Kacheln (Raster sichtbar, Lücken ehrlich)
	   und macht Distanzen zwischen freien Zeiten sofort lesbar. Gleiche
	   Behandlung wie volle Tage: füllungslos, grau, durchgestrichen. */
	.slot.taken {
		background: none;
		color: #555;
		cursor: default;
		text-decoration: line-through;
	}

	/* Formular */
	.chosen {
		font-size: 1.15rem;
		font-weight: 800;
		margin-bottom: 14px;
	}

	.field {
		margin-bottom: 12px;
	}

	/* Honeypot (Audit-Fix A4): per CSS unsichtbar (nicht display:none/
	   visibility:hidden — manche Bots überspringen genau diese beiden
	   Eigenschaften gezielt), aber weiterhin Teil des DOM-Renderflows,
	   damit einfache Formular-Bots es trotzdem ausfüllen. */
	.hp-field {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.field label {
		display: block;
		font-size: 0.75rem;
		color: var(--gray);
		margin-bottom: 4px;
	}

	.field input,
	.field textarea {
		width: 100%;
		background: var(--panel);
		border: 1px solid var(--line);
		color: var(--white);
		font-family: inherit;
		font-size: 1rem;
		padding: 12px;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--white);
	}

	.privacy {
		font-size: 0.7rem;
		color: var(--gray);
		line-height: 1.5;
		margin: 14px 0 18px;
	}

	.privacy a {
		color: var(--gray);
	}

	.actions {
		display: flex;
		gap: 10px;
	}

	.btn-back {
		border: 1px solid var(--line);
		background: none;
		color: var(--gray);
		font-family: inherit;
		font-size: 0.95rem;
		padding: 14px 18px;
		cursor: pointer;
	}

	.btn-confirm {
		flex: 1;
		border: none;
		background: var(--surface);
		color: var(--black);
		font-family: inherit;
		font-size: 1rem;
		font-weight: 800;
		padding: 14px 0;
		cursor: pointer;
	}

	.btn-confirm:disabled {
		opacity: 0.5;
		cursor: default;
	}

	/* Bestätigung */
	.done {
		text-align: center;
		padding: 60px 0;
	}

	.done .flag {
		font-size: 2.5rem;
		margin-bottom: 16px;
	}

	.done h2 {
		font-size: 1.5rem;
		font-weight: 800;
		margin-bottom: 10px;
	}

	.done p {
		color: var(--gray);
		line-height: 1.5;
	}

	/* Direkt-Zeile */
	.direct {
		margin-top: 34px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
		font-size: 0.85rem;
		color: var(--gray);
		line-height: 1.6;
	}

	.direct a {
		color: var(--white);
		text-decoration: none;
		border-bottom: 1px solid var(--gray);
	}
</style>

<script>
	// Eigenbau-Kalender über die meetergo-API (via /api/slots, /api/book —
	// PAT bleibt server-seitig, siehe functions/). An astro:page-load
	// gekoppelt (Muster wie MenuTiles/PageWipe), damit ein Zurück-zu-/termin
	// per Client-Side-Navigation den Kalender frisch aufbaut. Der frühere
	// ?kalender-Schalter ist entfernt — der Kalender ist die Seite.
	function initTermin() {
		const monthsContainer = document.getElementById("monthsContainer");
		if (!monthsContainer) return; // nicht auf dieser Seite

		const stepDay = document.getElementById("stepDay") as HTMLElement;
		const stepTime = document.getElementById("stepTime") as HTMLElement;
		const stepForm = document.getElementById("stepForm") as HTMLElement;
		const stepDone = document.getElementById("stepDone") as HTMLElement;
		const loadingStatus = document.getElementById("loadingStatus") as HTMLElement;
		const slotsGrid = document.getElementById("slotsGrid") as HTMLElement;
		const slotsError = document.getElementById("slotsError") as HTMLElement;
		const timeDayLabel = document.getElementById("timeDayLabel") as HTMLElement;
		const chosenLabel = document.getElementById("chosenLabel") as HTMLElement;
		const doneLabel = document.getElementById("doneLabel") as HTMLElement;
		const formError = document.getElementById("formError") as HTMLElement;
		const nameInput = document.getElementById("f-name") as HTMLInputElement;
		const emailInput = document.getElementById("f-email") as HTMLInputElement;
		const messageInput = document.getElementById("f-message") as HTMLTextAreaElement;
		const websiteInput = document.getElementById("f-website") as HTMLInputElement;
		const btnBack = document.getElementById("btnBack") as HTMLButtonElement;
		const btnConfirm = document.getElementById("btnConfirm") as HTMLButtonElement;
		const sidePanel = document.getElementById("sidePanel") as HTMLElement;
		const sideForm = document.getElementById("sideForm") as HTMLElement;
		const sideHint = document.getElementById("sideHint") as HTMLElement;

		// Desktop-Spalten (Fred 2026-06-14): dieselben Schwellen wie im CSS.
		// ≥1150px: Uhrzeiten in die Seitenspalte, Formular in die DRITTE Spalte
		// (1 Tag · 2 Uhrzeit · 3 Daten nebeneinander). ≥900px: beide zusammen
		// in die Seitenspalte. Darunter (Mobil): inline unterm gewählten Monat.
		// Bei einem Wechsel (Fenster ziehen, Tablet drehen) docken die
		// Listener unten um.
		const desktopMq = window.matchMedia("(min-width: 900px)");
		const wideMq = window.matchMedia("(min-width: 1150px)");
		let chosenMonthMeta: { year: number; month: number; name: string } | null = null;

		function dockSteps() {
			const inline = chosenMonthMeta
				? document.getElementById("inline-" + chosenMonthMeta.year + "-" + chosenMonthMeta.month)
				: null;
			if (wideMq.matches) {
				sidePanel.appendChild(stepTime);
				sideForm.appendChild(stepForm);
			} else if (desktopMq.matches) {
				sidePanel.appendChild(stepTime);
				sidePanel.appendChild(stepForm);
			} else if (inline) {
				inline.appendChild(stepTime);
				inline.appendChild(stepForm);
			}
		}

		function redock() {
			if (chosenMonthMeta && !stepTime.classList.contains("hidden")) dockSteps();
		}
		desktopMq.addEventListener("change", redock);
		wideMq.addEventListener("change", redock);

		// 6 grobe Tagesabschnitte für den Balken (8–17 Uhr, Freds meetergo-
		// Verfügbarkeit — korrigiert 2026-06-14, vorher 9–18: der 8-Uhr-Slot
		// fiel in keinen Abschnitt). Ehrlich aus der echten Slot-Antwort
		// abgeleitet: ein Abschnitt gilt als frei, sobald mindestens ein
		// echter freier Termin hineinfällt.
		const BUCKETS = [
			[8 * 60, 9 * 60 + 30],
			[9 * 60 + 30, 11 * 60],
			[11 * 60, 12 * 60 + 30],
			[12 * 60 + 30, 14 * 60],
			[14 * 60, 15 * 60 + 30],
			[15 * 60 + 30, 17 * 60],
		];

		const timeFmt = new Intl.DateTimeFormat("de-DE", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/Berlin" });
		const monthFmt = new Intl.DateTimeFormat("de-DE", { month: "long", timeZone: "Europe/Berlin" });

		function pad(n: number) {
			return String(n).padStart(2, "0");
		}
		function isoDate(y: number, m: number, d: number) {
			return `${y}-${pad(m + 1)}-${pad(d)}`;
		}
		function berlinMinutesOfDay(date: Date) {
			const [h, m] = timeFmt.format(date).split(":").map(Number);
			return h * 60 + m;
		}

		function monthMeta(year: number, month: number) {
			const first = new Date(year, month, 1);
			const numDays = new Date(year, month + 1, 0).getDate();
			const startWeekday = (first.getDay() + 6) % 7; // Mo=0…So=6
			return { year, month, numDays, startWeekday, name: monthFmt.format(first) };
		}

		const today = new Date();
		today.setHours(0, 0, 0, 0);
		const thisMonth = monthMeta(today.getFullYear(), today.getMonth());
		const nextMonthFirst = new Date(today.getFullYear(), today.getMonth() + 1, 1);
		const nextMonth = monthMeta(nextMonthFirst.getFullYear(), nextMonthFirst.getMonth());
		const MONTHS = [thisMonth, nextMonth];

		const windowEnd = new Date(nextMonth.year, nextMonth.month, nextMonth.numDays, 23, 59, 59);

		let datesByIso = new Map<string, Array<{ startTime: string }>>();
		let chosenIso = "";
		let chosenLabelText = "";
		let chosenStart = "";

		// Das praktizierte Stunden-Raster des Fensters (Fred 2026-06-14):
		// Union aller angebotenen Startzeiten über alle Tage. Dient der
		// Uhrzeiten-Liste als Grundgerüst — pro Tag werden ALLE Raster-Zeiten
		// gezeigt, die nicht verfügbaren ausgegraut (siehe renderSlots).
		let hourGrid: string[] = [];

		async function fetchSlots(refresh: boolean) {
			const params = new URLSearchParams({
				start: today.toISOString(),
				end: windowEnd.toISOString(),
			});
			if (refresh) params.set("refresh", "1");
			const res = await fetch(`/api/slots?${params.toString()}`);
			if (!res.ok) throw new Error(`slots_failed_${res.status}`);
			const data = await res.json();
			datesByIso = new Map((data.dates || []).map((d: any) => [d.date, d.spots || []]));
			const gridSet = new Set<string>();
			datesByIso.forEach((spots) => spots.forEach((s) => gridSet.add(timeFmt.format(new Date(s.startTime)))));
			hourGrid = [...gridSet].sort();
		}

		function cellState(year: number, month: number, day: number) {
			const date = new Date(year, month, day);
			const weekday = date.getDay(); // 0 So … 6 Sa
			const isWeekend = weekday === 0 || weekday === 6;
			const isPast = date < today;
			if (isWeekend || isPast) return { kind: "off" as const, spots: [] as Array<{ startTime: string }> };
			const spots = datesByIso.get(isoDate(year, month, day)) || [];
			if (spots.length === 0) return { kind: "full" as const, spots };
			return { kind: "free" as const, spots };
		}

		function dayBarHtml(spots: Array<{ startTime: string }>) {
			const flags = BUCKETS.map(([from, to]) =>
				spots.some((s) => {
					const min = berlinMinutesOfDay(new Date(s.startTime));
					return min >= from && min < to;
				}),
			);
			return '<span class="daybar">' + flags.map((f) => `<span${f ? ' class="f"' : ""}></span>`).join("") + "</span>";
		}

		function buildMonths() {
			// Schritt 2+3 vor dem Neuaufbau in Sicherheit bringen (stecken sonst
			// noch in einer inline-Andockstelle, die gleich neu erzeugt wird).
			stepDay.appendChild(stepTime);
			stepDay.appendChild(stepForm);
			stepTime.classList.add("hidden");
			stepForm.classList.add("hidden");
			monthsContainer.innerHTML = "";

			MONTHS.forEach((m) => {
				const title = document.createElement("p");
				title.className = "month";
				title.textContent = m.name;
				monthsContainer.appendChild(title);

				const dows = document.createElement("div");
				dows.className = "dows";
				dows.innerHTML = "<span>MO</span><span>DI</span><span>MI</span><span>DO</span><span>FR</span><span>SA</span><span>SO</span>";
				monthsContainer.appendChild(dows);

				const grid = document.createElement("div");
				grid.className = "days";
				grid.style.marginBottom = "18px";
				for (let i = 0; i < m.startWeekday; i++) grid.appendChild(document.createElement("div"));

				for (let d = 1; d <= m.numDays; d++) {
					const { kind, spots } = cellState(m.year, m.month, d);
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "day " + kind;
					if (kind === "off") {
						btn.disabled = true;
						btn.innerHTML = `<span class="num">${d}</span>`;
					} else if (kind === "full") {
						btn.disabled = true;
						btn.innerHTML = `<span class="num">${d}</span><span class="state"></span>`;
					} else {
						btn.innerHTML = `<span class="num">${d}</span><span class="state">${dayBarHtml(spots)}</span>`;
						btn.setAttribute("aria-label", `${d}. ${m.name}, ${spots.length} freie Termine`);
						btn.addEventListener("click", () => pickDay(btn, m, d, spots));
					}
					grid.appendChild(btn);
				}
				monthsContainer.appendChild(grid);

				// Andock-Stelle: Uhrzeiten + Formular erscheinen direkt UNTER dem
				// gewählten Monat (FINALE Spec: Auswahl und Antwort bleiben
				// beieinander, statt weit unten am Seitenende zu erscheinen).
				const inline = document.createElement("div");
				inline.id = "inline-" + m.year + "-" + m.month;
				monthsContainer.appendChild(inline);
			});
		}

		function pickDay(btn: HTMLButtonElement, m: { year: number; month: number; name: string }, d: number, spots: Array<{ startTime: string }>) {
			monthsContainer.querySelectorAll(".day.selected").forEach((x) => x.classList.remove("selected"));
			btn.classList.add("selected");
			chosenIso = isoDate(m.year, m.month, d);
			chosenLabelText = `${d}. ${m.name}`;
			chosenMonthMeta = m;

			sideHint.classList.add("hidden");
			dockSteps();

			timeDayLabel.textContent = chosenLabelText;
			slotsError.classList.add("hidden");
			renderSlots(spots);
			stepTime.classList.remove("hidden");
			stepForm.classList.add("hidden");
			// Nur mobil zum angedockten Schritt scrollen — auf Desktop steht die
			// Seitenspalte ohnehin im Blick (sticky).
			if (!desktopMq.matches) stepTime.scrollIntoView({ behavior: "smooth", block: "nearest" });
		}

		function renderSlots(spots: Array<{ startTime: string }>) {
			slotsGrid.innerHTML = "";
			const freeByTime = new Map(spots.map((s) => [timeFmt.format(new Date(s.startTime)), s.startTime]));
			const grid = hourGrid.length ? hourGrid : [...freeByTime.keys()].sort();
			grid.forEach((label) => {
				const startTime = freeByTime.get(label);
				const btn = document.createElement("button");
				btn.type = "button";
				btn.textContent = label;
				if (startTime) {
					btn.className = "slot";
					btn.addEventListener("click", () => pickSlot(btn, startTime));
				} else {
					btn.className = "slot taken";
					btn.disabled = true;
					btn.setAttribute("aria-label", `${label} Uhr — bereits vergeben`);
				}
				slotsGrid.appendChild(btn);
			});
		}

		function pickSlot(btn: HTMLButtonElement, startTime: string) {
			slotsGrid.querySelectorAll(".slot.selected").forEach((x) => x.classList.remove("selected"));
			btn.classList.add("selected");
			chosenStart = startTime;
			chosenLabel.textContent = `${chosenLabelText}, ${timeFmt.format(new Date(startTime))} Uhr · 30 Minuten`;
			formError.classList.add("hidden");
			stepForm.classList.remove("hidden");
			if (!desktopMq.matches) stepForm.scrollIntoView({ behavior: "smooth", block: "nearest" });
		}

		btnBack.addEventListener("click", () => {
			stepForm.classList.add("hidden");
		});

		// Client-seitiger Vorab-Check derselben Grenzen wie server-seitig
		// (Audit-Fix A4, siehe functions/api/book.js) — spart eine unnötige
		// Runde zum Server bei offensichtlich zu langen Eingaben. Die
		// eigentliche, verbindliche Prüfung bleibt server-seitig.
		const MAX_NAME = 200;
		const MAX_EMAIL = 254;
		const MAX_MESSAGE = 2000;
		const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

		btnConfirm.addEventListener("click", async () => {
			const fullname = nameInput.value.trim();
			const email = emailInput.value.trim();
			const message = messageInput.value.trim();
			const website = websiteInput?.value.trim() || "";
			formError.classList.add("hidden");

			if (!fullname || !email) {
				formError.textContent = "Bitte Name und E-Mail ausfüllen.";
				formError.classList.remove("hidden");
				return;
			}
			if (!EMAIL_RE.test(email)) {
				formError.textContent = "Bitte eine gültige E-Mail-Adresse eingeben.";
				formError.classList.remove("hidden");
				return;
			}
			if (fullname.length > MAX_NAME || email.length > MAX_EMAIL || message.length > MAX_MESSAGE) {
				formError.textContent = "Eine der Eingaben ist zu lang. Bitte kürzen.";
				formError.classList.remove("hidden");
				return;
			}
			if (!chosenStart) {
				formError.textContent = "Bitte zuerst eine Uhrzeit wählen.";
				formError.classList.remove("hidden");
				return;
			}

			btnConfirm.disabled = true;
			btnConfirm.textContent = "Wird gebucht …";

			try {
				const res = await fetch("/api/book", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ start: chosenStart, fullname, email, message, website }),
				});

				if (res.status === 400 || res.status === 409) {
					// Zwei mögliche Ursachen hinter 400/409, unterschieden über den
					// Error-Code im Body (Audit-Fix A4): unsere eigene server-seitige
					// Validierung (invalid_email/missing_fields/field_too_long) zeigt
					// die serverseitige Meldung direkt an; ein "upstream_error" kommt
					// von meetergo und bedeutet "Slot inzwischen weg" — dafür bleibt
					// der bisherige Refresh-Flow (Website-Brief: "bei Buchungs-400
					// Slots refreshen").
					let data: any = null;
					try {
						data = await res.json();
					} catch {
						/* kein JSON-Body, unten Fallback */
					}
					if (data && data.error && data.error !== "upstream_error") {
						formError.textContent = data.message || "Bitte Angaben prüfen.";
						formError.classList.remove("hidden");
						return;
					}
					formError.textContent = "Diese Uhrzeit ist gerade weggebucht worden. Bitte neu wählen.";
					formError.classList.remove("hidden");
					await fetchSlots(true);
					buildMonths();
					return;
				}
				if (!res.ok) {
					throw new Error(`book_failed_${res.status}`);
				}

				doneLabel.textContent = `${chosenLabelText}, ${timeFmt.format(new Date(chosenStart))} Uhr · 30 Minuten`;
				stepDay.classList.add("hidden");
				stepTime.classList.add("hidden");
				stepForm.classList.add("hidden");
				stepDone.classList.remove("hidden");
			} catch (err) {
				formError.textContent = "Das hat gerade nicht geklappt. Bitte gleich nochmal versuchen oder direkt anrufen/schreiben.";
				formError.classList.remove("hidden");
			} finally {
				btnConfirm.disabled = false;
				btnConfirm.textContent = "Gespräch buchen";
			}
		});

		(async () => {
			try {
				await fetchSlots(false);
				loadingStatus.classList.add("hidden");
				buildMonths();
			} catch (err) {
				loadingStatus.textContent = "Termine konnten nicht geladen werden. Bitte gleich nochmal versuchen oder direkt anrufen/schreiben.";
				loadingStatus.classList.add("error");
			}
		})();
	}

	document.addEventListener("astro:page-load", initTermin);
</script>
