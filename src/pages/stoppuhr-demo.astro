---
// PROBE-SEITE (Fred 21.09.): die beiden Kacheln zweimal untereinander,
// oben wie bisher (normale Uhr), unten als STOPPUHR (Krone + zwei
// Druecker an Stunde und allen kleinen Uhren) mit der neuen Bezugszeile
// „... messbarer Zuschauerzeit". Beide Fassungen kommen aus derselben
// Komponente (Prop `stoppuhr`), damit nichts auseinanderlaufen kann.
// ?a zeigt nur die Uhr, ?b nur die Stoppuhr — so laeuft nur EINE Sektion
// (beide zugleich im Bild verdoppeln die Animationslast, das verfaelscht
// den Ruckel-Eindruck; die Startseite hat immer nur eine).
// Nicht verlinkt. Die Startseite bleibt unveraendert, bis Fred waehlt.
import Layout from "../layouts/Layout.astro";
import MultiOutputKacheln from "../components/MultiOutputKacheln.astro";
---

<Layout title="Stoppuhr-Probe">
	<div class="fassung fassung--a">
		<p class="marke">A · wie bisher: Uhr</p>
		<MultiOutputKacheln />
	</div>
	<div class="fassung fassung--b">
		<p class="marke">B · Stoppuhr</p>
		<MultiOutputKacheln stoppuhr bezug2="Eine Stunde Aufnahme wird so zu mehr als 100 Stunden messbarer Zuschauerzeit." />
	</div>
</Layout>

<style>
	.marke {
		color: var(--gray);
		font-size: 0.95rem;
		margin: 0;
		padding: 40px clamp(16px, 3vw, 56px) 0;
	}
	:global(body.nur-a) .fassung--b,
	:global(body.nur-b) .fassung--a,
	:global(body.nur-a) .marke,
	:global(body.nur-b) .marke {
		display: none;
	}
</style>

<script>
	function fassung() {
		const p = new URLSearchParams(location.search);
		document.body.classList.toggle("nur-a", p.has("a"));
		document.body.classList.toggle("nur-b", p.has("b"));
	}
	fassung();
	document.addEventListener("astro:page-load", fassung);
</script>
