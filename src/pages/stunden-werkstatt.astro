---
// /stunden-werkstatt — GIF-WERKSTATT fuer die Stunden-Kachel (Fred 21.09.:
// „kriegen wir die Animation aus Kachel 2 als GIF fuer LinkedIn?").
// Schwester von /werkstatt (Fallblatt-Tafeln): DIESELBE BASIS wie die
// Website — Zeiten, Kurven, Kamera und Geometrie kommen aus
// src/lib/stunde.ts, aus dem auch MultiOutputKacheln.astro liest. Die
// Website bewegt SVG per Web Animations API; das GIF braucht Bitmaps und
// wird deshalb Bild fuer Bild mit einem Canvas-Painter aus denselben
// Zahlen gemalt (zustand(t) liefert Kamera, Deckkraft, Anteile).
// Vorschau = Export: die Vorschau ist derselbe Painter in Echtzeit.
// gif.js (MIT) liegt lokal unter public/werkzeug/ (Worker duerfen nur von
// derselben Herkunft laden). Nicht verlinkt.
import Layout from "../layouts/Layout.astro";
import { ZEIT, KAMERA, marken, uhren } from "../lib/stunde";
const m = marken();
const N = uhren().length;
---

<Layout title="Stunden-Werkstatt">
	<section class="wk">
		<h1 class="wk-titel">Stunden-Werkstatt</h1>
		<p class="wk-sub">
			Dieselbe Animation wie auf der Startseite, aus denselben Zahlen (src/lib/stunde.ts).
			Runde {m.RUNDE.toFixed(2)} s, {N} Uhren, Kamera {KAMERA.start} → {KAMERA.ende}, Rauszoomen {ZEIT.kameraRaus} s.
		</p>

		<div class="wk-buehne">
			<canvas data-vorschau width="400" height="500"></canvas>
		</div>

		<div class="wk-regler">
			<label class="wk-feld"><span>Breite Export, px</span>
				<input data-breite type="number" step="50" min="200" max="1600" value="800" /></label>
			<label class="wk-feld"><span>Bilder je Sekunde</span>
				<input data-fps type="number" step="1" min="8" max="50" value="25" /></label>
			<p class="wk-hinweis">GIF speichert Wartezeiten in Hundertstelsekunden: exakt gehen 25 (40 ms), 33 (30 ms) und 50 B/s (20 ms). 60 B/s gibt es im Format nicht; unter 20 ms bremsen Browser auf 100 ms.</p>
			<label class="wk-feld"><span>Grund</span>
				<select data-grund>
					<option value="kachel" selected>Kachel (#212121)</option>
					<option value="schwarz">Schwarz</option>
				</select></label>
			<label class="wk-feld"><span>Uhr</span>
				<select data-uhr>
					<option value="stoppuhr" selected>Stoppuhr (wie Website)</option>
					<option value="uhr">Uhr ohne Beschlag</option>
				</select></label>
			<label class="wk-feld"><span>Verlauf</span>
				<select data-modus>
					<option value="runde" selected>Ganze Runde (raus, rein, wie Website)</option>
					<option value="schnitt">Raus bis alle stehen, Schnitt auf Schwarz, von vorn (Probe)</option>
				</select></label>
			<label class="wk-feld"><span>Schwarz nach dem Schnitt, Sekunden</span>
				<input data-schwarz type="number" step="0.1" min="0" max="5" value="0.8" /></label>
			<label class="wk-feld"><span>Verschwinden der weißen Uhren</span>
				<select data-schnitt>
					<option value="weich" selected>Weich ausblenden (wie Website)</option>
					<option value="hart">Auf einen Schlag (Probe)</option>
				</select></label>
			<label class="wk-feld"><span>Minutenstriche der Stunde</span>
				<select data-striche>
					<option value="1" selected>60 (jede Minute, wie Website)</option>
					<option value="5">12 (alle fünf Minuten, Probe)</option>
				</select></label>
			<label class="wk-feld"><span>Graustufen an den Kanten</span>
				<select data-stufen>
					<option value="6" selected>6 (weich, Standard)</option>
					<option value="4">4 (etwas härter)</option>
					<option value="2">2 (keine, hart)</option>
				</select></label>
			<button class="wk-cta" data-export type="button">GIF bauen</button>
			<p class="wk-status" data-status>Bereit. Eine Runde = {m.RUNDE.toFixed(2)} s; bei 25 Bildern/s sind das {Math.ceil(m.RUNDE * 25)} Bilder.</p>
		</div>
	</section>
</Layout>

<script src="/werkzeug/gif.js" is:inline></script>

<script>
	import { GLYPHEN } from "../lib/stunde-glyphen";
	import { ZEIT, KAMERA, UHR, BLATT, STRICH, STOPPUHR, STUNDE_TEXT, stundeMinuten, knopfWinkel, VIEWBOX, marken, uhren, uhrenPlan, zustand } from "../lib/stunde";

	const KACHEL = "#212121";
	const WEISS = "#ffffff";
	const punkte = uhren();
	const N = punkte.length;
	// Marken und Plan haengen an ZEIT; die Probe-Regler unten schreiben ZEIT/
	// BLATT zur Laufzeit um (nur diese Seite, die Website liest zur Bauzeit)
	// und rechnen dann neu.
	let m = marken();
	let plan = uhrenPlan(N, m);
	function neuRechnen() { m = marken(); plan = uhrenPlan(N, m); }

	// ── Der Painter: malt den Zustand zur Zeit t auf einen Kontext ──────
	// Alles in viewBox-Einheiten (1000 x 1250), der Kontext wird davor auf
	// die Zielgroesse skaliert. Reihenfolge = Stapel wie im SVG.
	function tick(ctx: CanvasRenderingContext2D, cx: number, cy: number, innen: number, aussen: number, winkel: number) {
		const s = Math.sin(winkel), c = Math.cos(winkel);
		ctx.moveTo(cx + innen * s, cy - innen * c);
		ctx.lineTo(cx + aussen * s, cy - aussen * c);
	}
	function blatt(ctx: CanvasRenderingContext2D, cx: number, cy: number, farbe: string, minuten = true) {
		const r = UHR.r;
		ctx.strokeStyle = farbe;
		ctx.lineCap = "butt";
		// Minuten (die kleinen Uhren nur, wenn BLATT.kleineMinuten)
		if (minuten) {
			ctx.lineWidth = BLATT.minute.breite;
			ctx.beginPath();
			for (let i = 0; i < 60; i += BLATT.minute.schritt) if (i % 15) tick(ctx, cx, cy, r - 1 - BLATT.minute.laenge, r - 1, (i * Math.PI) / 30);
			ctx.stroke();
		}
		// Fuenf Minuten
		if (minuten) {
			ctx.lineWidth = BLATT.fuenf.breite;
			ctx.beginPath();
			for (let i = 0; i < 60; i += 5) if (i % 15) tick(ctx, cx, cy, r - 1 - BLATT.fuenf.laenge, r - 1, (i * Math.PI) / 30);
			ctx.stroke();
		}
		// Viertel
		ctx.lineWidth = BLATT.viertel.breite;
		ctx.beginPath();
		for (let i = 0; i < 4; i++) tick(ctx, cx, cy, r - 1 - BLATT.viertel.laenge, r - 1, (i * Math.PI) / 2);
		ctx.stroke();
	}
	// Stoppuhr-Beschlag (Probe): Krone (Hals + Kappe) oben, Druecker bei ±45°
	let stoppuhr = true;
	function beschlag(ctx: CanvasRenderingContext2D, cx: number, cy: number, farbe: string) {
		const r = UHR.r, S = STOPPUHR;
		ctx.fillStyle = farbe;
		const teil = (winkel: number, halsB: number, halsH: number, kappeB: number, kappeH: number) => {
			// ein T-Pfad statt zwei Rechtecke, sonst bleibt an der Kante eine Naht
			const kb = kappeB * r / 2, hb = halsB * r / 2, yK = -r - halsH * r - kappeH * r, yH = -r - halsH * r, yU = -r + 1;
			ctx.save(); ctx.translate(cx, cy); ctx.rotate((winkel * Math.PI) / 180);
			ctx.beginPath(); ctx.moveTo(-kb, yK); ctx.lineTo(kb, yK); ctx.lineTo(kb, yH); ctx.lineTo(hb, yH); ctx.lineTo(hb, yU); ctx.lineTo(-hb, yU); ctx.lineTo(-hb, yH); ctx.lineTo(-kb, yH); ctx.closePath(); ctx.fill();
			ctx.restore();
		};
		teil(0, S.hals.breite, S.hals.hoehe, S.kappe.breite, S.kappe.hoehe);
		for (const w of knopfWinkel()) teil(w, S.knopf.halsBreite, S.knopf.hals, S.knopf.breite, S.knopf.hoehe);
	}
	// Umriss-Schrift: Zeichenkette mittig um x, Grundlinie y, k = Schrift-Einheit → viewBox
	const pfadCache = new Map<string, Path2D>();
	// zelle > 0: Tabellenziffern (feste Zelle je Zeichen, mittig darin), sonst Vorschub
	function schrift(ctx: CanvasRenderingContext2D, s: string, satz: Record<string, { d: string; adv: number; xMin: number; xMax: number }>, x: number, y: number, k: number, zelle = 0) {
		const w = zelle ? zelle * s.length : s.split("").reduce((a, c) => a + satz[c].adv, 0);
		ctx.save(); ctx.translate(x, y); ctx.scale(k, -k); ctx.translate(-w / 2, 0);
		for (const c of s) { let p = pfadCache.get(satz[c].d); if (!p) { p = new Path2D(satz[c].d); pfadCache.set(satz[c].d, p); } ctx.save(); if (zelle) ctx.translate(zelle / 2 - (satz[c].xMin + satz[c].xMax) / 2, 0); ctx.fill(p); ctx.restore(); ctx.translate(zelle || satz[c].adv, 0); }
		ctx.restore();
	}
	const ZELLE = Math.max(...Object.values(GLYPHEN.zahl).map((g) => g.adv));
	function stueck(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number, anteil: number) {
		if (anteil <= 0) return;
		ctx.beginPath();
		if (anteil >= 1) { ctx.arc(cx, cy, r, 0, Math.PI * 2); }
		else { ctx.moveTo(cx, cy); ctx.arc(cx, cy, r, -Math.PI / 2, -Math.PI / 2 + anteil * Math.PI * 2); ctx.closePath(); }
		ctx.fill();
	}

	function male(ctx: CanvasRenderingContext2D, t: number, W: number, H: number, grund: string) {
		const z = zustand(t, m, plan, N);
		ctx.setTransform(1, 0, 0, 1, 0, 0);
		ctx.fillStyle = grund;
		ctx.fillRect(0, 0, W, H);
		// viewBox „slice" auf die Flaeche: gleiche Proportion 4:5, also reine Skalierung
		const k = W / VIEWBOX.w;
		ctx.setTransform(k, 0, 0, k, 0, 0);
		// Kamera um die Bildmitte
		ctx.translate(UHR.cx, UHR.cy);
		ctx.scale(z.skala, z.skala);
		ctx.translate(-UHR.cx, -UHR.cy);

		// Die weissen Uhren samt dunklen Blaettern, gemeinsam ausgeblendet
		ctx.globalAlpha = z.deckkraft;
		ctx.fillStyle = WEISS;
		for (let i = 0; i < N; i++) stueck(ctx, punkte[i].x, punkte[i].y, UHR.r, z.anteile[i]);
		for (let i = 0; i < N; i++) if (z.anteile[i] > 0) blatt(ctx, punkte[i].x, punkte[i].y, KACHEL, BLATT.kleineMinuten);
		if (stoppuhr) for (let i = 0; i < N; i++) if (z.anteile[i] > 0) beschlag(ctx, punkte[i].x, punkte[i].y, WEISS);
		// Kein Zeiger auf den kleinen Uhren (Fred 21.09., s. lib).

		// Die Stunde: dunkle Fuellung und Rand (blenden mit aus), helles
		// Blatt und Speichen (bleiben stehen)
		ctx.fillStyle = KACHEL;
		stueck(ctx, UHR.cx, UHR.cy, UHR.r, z.stundeAnteil);
		if (z.stundeAnteil > 0) {
			ctx.strokeStyle = WEISS;
			ctx.lineWidth = STRICH;
			ctx.beginPath();
			ctx.arc(UHR.cx, UHR.cy, UHR.r, -Math.PI / 2, -Math.PI / 2 + Math.min(1, z.stundeAnteil) * Math.PI * 2);
			ctx.stroke();
		}
		ctx.globalAlpha = 1;
		if (stoppuhr) beschlag(ctx, UHR.cx, UHR.cy, WEISS);
		blatt(ctx, UHR.cx, UHR.cy, WEISS);
		// Zaehler „00 … 60 Min." mit dem Zeiger, immer sichtbar — als Umrisse
		// (stunde-glyphen.ts), identisch mit der Website
		ctx.fillStyle = WEISS;
		schrift(ctx, String(stundeMinuten(z.stundeAnteil)).padStart(2, "0"), GLYPHEN.zahl, UHR.cx, UHR.cy + UHR.r * STUNDE_TEXT.zahlDy, (UHR.r * STUNDE_TEXT.zahlGroesse) / GLYPHEN.upm, ZELLE);
		schrift(ctx, STUNDE_TEXT.einheit, GLYPHEN.einheit, UHR.cx, UHR.cy + UHR.r * STUNDE_TEXT.einheitDy, (UHR.r * STUNDE_TEXT.einheitGroesse) / GLYPHEN.upm);
		ctx.strokeStyle = WEISS;
		ctx.lineWidth = STRICH;
		ctx.beginPath();
		// kein fester Startstrich auf 12 (Fred 21.09.)
		tick(ctx, UHR.cx, UHR.cy, 0, UHR.r, z.stundeAnteil * Math.PI * 2);        // laufende Speiche
		ctx.stroke();
		void KAMERA;
	}

	// ── Vorschau in Echtzeit ────────────────────────────────────────────
	const vorschau = document.querySelector<HTMLCanvasElement>("[data-vorschau]")!;
	const vctx = vorschau.getContext("2d")!;
	const eingaben = {
		breite: document.querySelector<HTMLInputElement>("[data-breite]")!,
		fps: document.querySelector<HTMLInputElement>("[data-fps]")!,
		grund: document.querySelector<HTMLSelectElement>("[data-grund]")!,
		stufen: document.querySelector<HTMLSelectElement>("[data-stufen]")!,
		striche: document.querySelector<HTMLSelectElement>("[data-striche]")!,
		schnitt: document.querySelector<HTMLSelectElement>("[data-schnitt]")!,
		modus: document.querySelector<HTMLSelectElement>("[data-modus]")!,
		uhr: document.querySelector<HTMLSelectElement>("[data-uhr]")!,
		schwarz: document.querySelector<HTMLInputElement>("[data-schwarz]")!,
		status: document.querySelector<HTMLElement>("[data-status]")!,
		knopf: document.querySelector<HTMLButtonElement>("[data-export]")!,
	};
	const grundFarbe = () => (eingaben.grund.value === "schwarz" ? "#000000" : KACHEL);
	let start = performance.now();
	let laeuft = true;
	eingaben.striche.value = String(BLATT.minute.schritt);
	eingaben.striche.addEventListener("change", () => { BLATT.minute.schritt = Number(eingaben.striche.value) || 1; });
	eingaben.schnitt.addEventListener("change", () => { ZEIT.ausblenden = eingaben.schnitt.value === "hart" ? 0 : "wieRein"; neuRechnen(); });
	eingaben.uhr.addEventListener("change", () => { stoppuhr = eingaben.uhr.value === "stoppuhr"; });
	// Verlauf „schnitt" (Fred 21.09.): Rauszoomen, bis alle Uhren stehen
	// (standEnde), dann alles auf einen Schlag weg, kurz Schwarz, von vorn.
	const schnittModus = () => eingaben.modus.value === "schnitt";
	const schwarzDauer = () => Math.max(0, Number(eingaben.schwarz.value) || 0);
	const schleife = () => (schnittModus() ? m.standEnde + schwarzDauer() : m.RUNDE);
	function maleSchleife(ctx: CanvasRenderingContext2D, t: number, W: number, H: number, grund: string) {
		if (schnittModus() && t >= m.standEnde) { ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.fillStyle = grund; ctx.fillRect(0, 0, W, H); return; }
		male(ctx, t, W, H, grund);
	}
	function bild(jetzt: number) {
		if (!laeuft) return;
		const t = ((jetzt - start) / 1000) % schleife();
		maleSchleife(vctx, t, vorschau.width, vorschau.height, grundFarbe());
		requestAnimationFrame(bild);
	}
	requestAnimationFrame(bild);

	// ── Export: Bild fuer Bild, gif.js ──────────────────────────────────
	// Zwei Sparmassnahmen, sonst wird das GIF gross (176 Uhren mit
	// Blaettern = viel Kantenglaettung = viel Entropie fuer LZW):
	// 1. Grau auf STUFEN Werte zwischen Grund und Weiss runden, bevor das
	//    Bild an den Encoder geht (weniger verschiedene Pixel, gleicher Look).
	// 2. Bilder, in denen sich nichts bewegt (Standzeit), nicht wiederholen,
	//    sondern dem vorigen Bild die Wartezeit dazugeben.
	// Graustufen = die Zwischentoene an den KANTEN (Kantenglaettung), nicht
	// das Ausblenden. 2 = nur Grund und Weiss (Kanten hart, wie ohne
	// Glaettung), 4 = zwei Zwischentoene, 6 = fuenf (Standard). Das Ausblenden
	// selbst laeuft weiter ueber alle Werte, weil es Deckkraft vor dem
	// Runden ist: bei 2 Stufen kippt es allerdings hart, deshalb wird die
	// Deckkraft-Phase immer mit 6 Stufen gerundet.
	function stufen(bild: ImageData, grund: number, STUFEN: number) {
		const d = bild.data, span = 255 - grund, schritt = span / (STUFEN - 1);
		for (let i = 0; i < d.length; i += 4) {
			const v = grund + Math.round((d[i] - grund) / schritt) * schritt;
			d[i] = d[i + 1] = d[i + 2] = v;
		}
		return bild;
	}
	function signatur(t: number) {
		const z = zustand(t, m, plan, N);
		let s = 0; for (let i = 0; i < N; i++) s += z.anteile[i];
		return [z.skala.toFixed(5), z.deckkraft.toFixed(4), z.stundeAnteil.toFixed(5), s.toFixed(5)].join("|");
	}
	eingaben.knopf.addEventListener("click", () => {
		const W = Math.min(1600, Math.max(200, Math.round(Number(eingaben.breite.value) || 800)));
		const H = Math.round((W * VIEWBOX.h) / VIEWBOX.w);
		const fps = Math.min(50, Math.max(8, Number(eingaben.fps.value) || 25));
		const delay = Math.round(1000 / fps);
		const laenge = schleife();
		const frames = Math.ceil((laenge * 1000) / delay);
		const c = document.createElement("canvas");
		c.width = W; c.height = H;
		const ctx = c.getContext("2d")!;
		// @ts-expect-error gif.js kommt als globales Skript
		const gif = new GIF({ workers: 2, quality: 8, width: W, height: H, workerScript: "/werkzeug/gif.worker.js", dither: false });
		eingaben.knopf.disabled = true;
		eingaben.status.textContent = `Male ${frames} Bilder à ${W} × ${H} …`;
		const grund = grundFarbe();
		const grundWert = parseInt(grund.slice(1, 3), 16);
		const stufenWahl = Number(eingaben.stufen.value) || 6;
		let f = 0, letzte = "", gemalt = 0;
		const schritt = () => {
			const ende = Math.min(frames, f + 10);
			for (; f < ende; f++) {
				const t = (f * delay) / 1000;
				const sig = schnittModus() && t >= m.standEnde ? "schwarz" : signatur(t);
				if (sig === letzte && gif.frames.length) { gif.frames[gif.frames.length - 1].delay += delay; continue; }
				letzte = sig;
				maleSchleife(ctx, t, W, H, grund);
				const z = zustand(t, m, plan, N);
				const st = z.deckkraft > 0 && z.deckkraft < 1 ? Math.max(6, stufenWahl) : stufenWahl;
				gif.addFrame(stufen(ctx.getImageData(0, 0, W, H), grundWert, st), { delay });
				gemalt++;
			}
			if (f < frames) { eingaben.status.textContent = `Male Bild ${f} von ${frames} …`; setTimeout(schritt, 0); }
			else {
				eingaben.status.textContent = "Rechne das GIF …";
				gif.on("progress", (p: number) => { eingaben.status.textContent = `Rechne das GIF … ${Math.round(p * 100)} %`; });
				gif.on("finished", (blob: Blob) => {
					const url = URL.createObjectURL(blob);
					const a = document.createElement("a");
					a.href = url; a.download = `parley-stunde-${W}px-${fps}fps-${stufenWahl}stufen-${60 / BLATT.minute.schritt}striche-${eingaben.schnitt.value}-${eingaben.modus.value}-${eingaben.uhr.value}-${Date.now()}.gif`; a.click();
					eingaben.status.textContent = `Fertig: ${(blob.size / 1024 / 1024).toFixed(1)} MB, ${gemalt} Bilder (${frames - gemalt} Standbilder zusammengelegt), ${laenge.toFixed(2)} s Schleife.`;
					eingaben.status.dataset.fertig = String(blob.size);
					eingaben.knopf.disabled = false;
				});
				gif.render();
			}
		};
		schritt();
	});

	document.addEventListener("astro:before-swap", () => { laeuft = false; });
</script>

<style>
	.wk { max-width: var(--max-width); margin: 0 auto; padding: clamp(60px, 10vw, 140px) 24px 160px; }
	.wk-titel { font-weight: 900; text-transform: uppercase; line-height: 0.9; letter-spacing: -0.01em; font-size: clamp(2.5rem, 1rem + 7vw, 8rem); margin: 0 0 12px; }
	.wk-sub { color: var(--gray); font-size: 0.95rem; margin: 0 0 40px; max-width: 46rem; }
	.wk-buehne { display: grid; place-items: center; margin-bottom: 32px; }
	.wk-buehne canvas { width: min(100%, 400px); height: auto; background: #212121; }
	.wk-regler { display: grid; gap: 16px; max-width: 420px; }
	.wk-feld { display: grid; gap: 6px; color: var(--gray); font-size: 0.9rem; }
	.wk-feld input, .wk-feld select { background: var(--panel); color: var(--white); border: 1px solid var(--line); padding: 10px 12px; font: inherit; }
	.wk-cta { background: var(--tile-surface); color: var(--black); border: 0; padding: 14px 20px; font-weight: 900; text-transform: uppercase; cursor: pointer; }
	.wk-cta:disabled { opacity: 0.5; cursor: wait; }
	.wk-status { color: var(--gray); font-size: 0.9rem; margin: 0; }
	.wk-hinweis { color: var(--gray); font-size: 0.8rem; margin: -6px 0 0; }
</style>
