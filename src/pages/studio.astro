---
import Layout from "../layouts/Layout.astro";
---

{/* /studio — das Blickkontaktstudio bekommt einen eigenen Reiter (Fred
   2026-09-13). ERSTER AUFSCHLAG: Alle Sätze stammen aus gelocktem Material
   (Segment-2-Textspalte, Studios-Kachel) — die Seite ist bewusst schlank
   und wartet auf Freds Wording-/Ausbau-Runden (Kandidaten laut Brief:
   Interrotron-Herkunft, Fokusraum-Atmosphäre, Clip-Beweis aus dem Studio).
   PFLICHT-Regel (Memory "nie verengen"): die drei Studio-Formen — fest in
   Karlsruhe, mobil, Inhouse-Bau — stehen immer zusammen, das feste
   Blickkontaktstudio ist EINE von drei Formen, nie das Gesamtangebot. */}
<Layout title="Studio" description="Das Blickkontaktstudio von The Parley: echte Gespräche ohne sichtbare Kamera — filmreif und ohne Kamerastress. Fest in Karlsruhe, mobil bei euch oder als Inhouse-Studio.">
	<main class="studio">
		<h1>Das Blickkontaktstudio</h1>
		<p class="sub">Filmreif und ohne Kamerastress.</p>

		<p class="absatz">Mit einer Kamera kann man kein Gespräch führen. Deshalb sieht man in unserem Blickkontaktstudio keine.</p>
		<p class="absatz">Ihr sprecht mit eurem Gegenüber, entspannt im Gesprächsmodus. Der Zuschauer erlebt das Gespräch aus der echten Gesprächspartner-Perspektive.</p>
		<p class="absatz">Zuerst stellen wir das echte Gespräch her, dann läuft die Aufnahme. Im Blickkontaktstudio in Karlsruhe, mit dem mobilen Studio bei euch oder im Inhouse-Studio, das wir euch bauen.</p>

		<p class="fastlane">Erlebt es selbst: <a href="/termin">Formatberatung buchen →</a></p>
	</main>
</Layout>

<style>
	/* Typo-Grundmaße 1:1 von /termin bzw. /kontakt übernommen (h1 1.9rem,
	   .sub grau) — die Seite spricht die Unterseiten-Sprache, nicht die
	   Display-Sprache der Startseite. */
	.studio {
		max-width: 720px;
		margin: 0 auto;
		padding: 96px 16px 64px;
		min-height: 100dvh;
	}

	h1 {
		font-size: 1.9rem;
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.sub {
		color: var(--gray);
		margin-top: 6px;
		font-size: 1rem;
	}

	.absatz {
		margin-top: 24px;
		font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.35rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		max-width: 46rem;
	}

	.fastlane {
		margin-top: 40px;
		font-size: 1rem;
		color: var(--gray);
	}

	.fastlane a {
		color: var(--white);
	}
</style>
