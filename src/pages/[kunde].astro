---
/* KUNDENSEITE „AKTENEINSICHT“, VORLAGE (27.11.2026). Auftrag aus der Sitzung „Rastetter“ auf Rasuls Wort vom
   27.11.2026: „Ja, du kannst es doch selber übergeben an die Webseiteprogrammierung an das Gespräch.“ Anlass: Ein
   Kunde darf keine Links aus E-Mails anklicken und tippt die Adresse deshalb selbst ein (parleyfilm.com/hug-ka).
   Auftrag und Begründung im Marketing-Ordner: website/Uebergabe_Kundenseiten_2026-11.md und
   website/Website_Kundenseiten_Konzept_2026-11.md.

   EINE VORLAGE, EINE DATEI JE KUNDE: src/daten/kundenseiten/<slug>.md. Der Dateiname ist die Adresse. Was in der
   Datei steht und wie, erklärt src/daten/kundenseiten/_vorlage.md. Dateien, die mit _ anfangen, werden keine Seite.

   WO DIE SEITE IM BAU LIEGT (Umbau 27.11.2026, Rasul: „Ja, bau das“): nicht unter /<slug>/, sondern unter einem
   internen Pfad /a-<40 Zeichen>/, gerechnet aus dem Wert AKTE_PFAD und dem Slug (interneAdresse unten; dieselbe
   Rechnung steht in functions/_middleware.js, beide müssen gleich bleiben). functions/_middleware.js holt die Seite
   von dort, prüft das Passwort und liefert sie unter /<slug>/ aus. Grund: Lag die Datei unter /<slug>/, lieferte
   Cloudflare sie unter anders kodierten Adressen am Passwort vorbei aus (auf dev gemessen, siehe dort).
   Die Mittelschicht liest am <main> data-akte-schutz (passwort | offen) und data-akte (der Slug). Ohne die Angabe
   „passwort: nein“ in der Datei ist die Seite geschlossen.
   AKTE_PFAD kommt beim Bau aus der Umgebung (Cloudflare: gewöhnliche Variable; lokal: .dev.vars, eingelesen in
   astro.config.mjs). Fehlt der Wert im Bau, entstehen KEINE Kundenseiten, statt sie offen abzulegen.
   AUF localhost:4321 (astro dev) liegt die Seite unter /<slug> und ist offen: Dort läuft keine Mittelschicht.

   NICHT IM INDEX: noindex über Layout (Angabe noindex) und über die Kopfzeile X-Robots-Tag der Mittelschicht. Nicht
   in PAGES in sitemap.xml.ts eintragen.

   Weg zurück: diese Datei, src/daten/kundenseiten/, src/components/bausteine/KundenVideo.astro,
   functions/_middleware.js und den Abschnitt „kundenseiten“ in astro.config.mjs löschen; in Layout.astro die Angabe
   noindex. */
import Layout from "../layouts/Layout.astro";
import Seitentitel from "../components/bausteine/Seitentitel.astro";
import Rechtstext from "../components/bausteine/Rechtstext.astro";
import Knopf from "../components/bausteine/Knopf.astro";
import KundenVideo from "../components/bausteine/KundenVideo.astro";
import { createHmac } from "node:crypto";

export function getStaticPaths() {
	const dateien = import.meta.glob("../daten/kundenseiten/*.md", { eager: true }) as Record<string, any>;
	// Eine Kundenseite darf keine bestehende Seite verdecken und umgekehrt: Der Bau bricht ab, statt still eine der
	// beiden zu nehmen.
	const belegt = Object.keys(import.meta.glob("./*.{astro,ts}")).map((p) => p.replace(/^\.\//, "").replace(/\.(astro|ts)$/, "").replace(/\.[a-z]+$/, ""));
	const VERBOTEN = [...belegt, "login", "api", "filme", "fonts", "lab", "lokal", "parley", "test", "werkzeug", "index", "404"];
	return Object.entries(dateien)
		.map(([pfad, datei]) => ({ slug: pfad.split("/").pop()!.replace(/\.md$/, ""), datei }))
		.filter(({ slug }) => !slug.startsWith("_"))
		.map(({ slug, datei }) => {
			if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) throw new Error(`Kundenseite „${slug}“: Der Dateiname darf nur Kleinbuchstaben, Ziffern und Bindestriche enthalten.`);
			if (VERBOTEN.includes(slug)) throw new Error(`Kundenseite „${slug}“: Diese Adresse ist auf der Website schon belegt.`);
			return { slug, datei };
		})
		.flatMap(({ slug, datei }) => {
			// Im Dev-Server die Kundenadresse, im Bau der interne Pfad (ohne Schrägstriche: „a-“ und 40 Zeichen).
			if (import.meta.env.DEV) return [{ params: { kunde: slug }, props: { datei, slug } }];
			const geheim = process.env.AKTE_PFAD || "";
			if (!geheim) { console.warn(`Kundenseite „${slug}“ NICHT gebaut: Der Wert AKTE_PFAD fehlt.`); return []; }
			const intern = "a-" + createHmac("sha256", geheim).update("akteneinsicht-pfad:" + slug).digest("hex").slice(0, 40);
			return [{ params: { kunde: intern }, props: { datei, slug } }];
		});
}

const { datei, slug } = Astro.props as { datei: any; slug: string };
const f = datei.frontmatter ?? {};
const Zusammenhang = datei.Content;
// Geschlossen, solange die Datei nicht ausdrücklich „passwort: nein“ sagt (YAML liest nein/no/false als false).
const offen = f.passwort === false || f.passwort === "nein";
const videos: { stream: string; titel?: string }[] = Array.isArray(f.videos) ? f.videos.filter((v: any) => v && typeof v.stream === "string" && v.stream.trim()) : [];
const schritt: string = typeof f.naechster_schritt === "string" ? f.naechster_schritt : "";
const knopf: string = typeof f.knopf === "string" && f.knopf ? f.knopf : "Termin finden";
/* TITEL AUS DER KUNDENDATEI, NICHT MEHR „AKTENEINSICHT“ (Rasul 27.11.2026: „wir machen das Wort Akteneinsicht weg.
   … Je näher uns der Kunde kommt, desto weniger brauchen wir das. Und desto mehr wollen wir, dass der Kunde sich
   wohlfühlt. Bei dem Wort Akteneinsicht fühlt er sich nicht wohl. Wir schreiben da jetzt erstmal drüber
   Studiotour.“). Die Angabe titel in der Kundendatei setzt die Überschrift; fehlt sie, steht „Kundenbereich“ (Wahl
   der Programmierung). Eine weiche Trennstelle schreibt man als &shy; in die Angabe, einen festen Umbruch als -<br>. Vorher stand fest
   „Akten&shy;einsicht“ als Überschrift und „Akteneinsicht“ im Browser-Reiter. Die Namen im Code (data-akte, .akte,
   Cookie „akte“) bleiben, sie sieht kein Besucher außer dem Cookie-Namen in der Datenschutzerklärung.
   Weg zurück: titelRoh fest auf "Akten&shy;einsicht". */
// Ersatz-Überschrift „Backstage“ seit 27.11.2026 abends (Rasuls Namenswahl für den Bereich), vorher "Kunden&shy;bereich".
const titelRoh: string = typeof f.titel === "string" && f.titel.trim() ? f.titel.trim() : "Backstage";
// Fester Umbruch mit Trennstrich („Studio-<br>tour“, Rasul 27.11.2026: zweizeilig) zählt im Browser-Reiter nicht mit.
const titelGlatt = titelRoh.replace(/&shy;/g, "").replace(/-<br\s*\/?>/g, "").replace(/<[^>]*>/g, "");
const knopfZiel: string = typeof f.knopf_ziel === "string" && f.knopf_ziel ? f.knopf_ziel : "/termin";
---

<Layout title={titelGlatt} description={`${titelGlatt} bei Parley Film.`} noindex>
	<main class="akte" data-akte-schutz={offen ? "offen" : "passwort"} data-akte={slug}>
		{/* Weiche Trennstelle wie bei Impressum und Datenschutz: Die breite Schrift passt am Handy sonst nicht in die Zeile. */}
		<Seitentitel ebene="h1" titel={titelRoh} stufe="2xl" unter={typeof f.kunde === "string" ? f.kunde : undefined} />
		{/* LOGOUT (Rasul 27.11.2026: „ich müsste dann auf der Kundenseite auch einen Logout anbieten und nicht unten als
		   Knopf“, also hier auf der Seite und nicht als Kachel im Menü). Ein Formular, kein Verweis: POST /login/ mit
		   abmelden=1, functions/_middleware.js löscht das Cookie und führt auf /login/. Nur bei Seiten mit Passwort.
		   Platz und Form (kleine Zeile unter dem Titel, unterstrichen wie ein Verweis) sind ein Entwurf der
		   Programmierung, nicht abgenommen. AUF localhost:4321 geht das Absenden ins Leere (keine Mittelschicht).
		   Weg zurück: dieses Formular und die Stilregeln .akte__logout löschen, in der Mittelschicht abmelden(). */}
		{!offen && (
			<form method="post" action="/login/" class="akte__logout" data-astro-reload>
				<input type="hidden" name="abmelden" value="1" />
				<button type="submit">Logout</button>
			</form>
		)}
		<Rechtstext>
			<Zusammenhang />
		</Rechtstext>
		{videos.length > 0 && (
			<div class="akte__videos">
				{videos.map((v) => <KundenVideo stream={v.stream.trim()} titel={v.titel} />)}
			</div>
		)}
		{schritt && (
			<Rechtstext>
				<h2>Nächster Schritt</h2>
				<p>{schritt}</p>
				<p><Knopf href={knopfZiel} text={knopf} /></p>
			</Rechtstext>
		)}
	</main>
</Layout>

{/* Diese Seite speichert nichts im Browser (Rasul 27.11.2026: „Mach mal Rückweg 1.“). Vorher merkte sie sich den Slug
   in localStorage „parley-akte“ für die Menükachel; Begründung in MenuBBH.astro bei „KEIN RÜCKWEG“. */}

<style>
	/* Stapel wie Impressum und Datenschutz (.recht: Titel, dann Text, oben und unten --abstand-xl). Zwischen den
	   Blöcken hier --abstand-lg statt xl: Text, Video und nächster Schritt gehören enger zusammen als Titel und Rechtstext. */
	.akte { display: grid; gap: var(--abstand-lg); padding-block: var(--abstand-xl); }
	/* Sitzt dicht unter dem Titel: der Stapel hat sonst --abstand-lg zwischen den Blöcken. */
	.akte__logout { margin-top: calc(var(--abstand-lg) * -0.6); text-align: center; }
	.akte__logout button {
		font-family: var(--schrift-lesen); font-size: var(--text-base); letter-spacing: -0.02em; color: inherit;
		background: none; border: 0; padding: 0.4em 0.6em; cursor: pointer; text-decoration: underline; text-underline-offset: 0.2em;
	}
	.akte__logout button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
	.akte__videos {
		width: 100%;
		max-width: 1024px;
		margin: 0 auto;
		padding: 0 var(--rand);
		display: grid;
		gap: var(--abstand-md);
	}
</style>
