</style>

<style is:global>
	/* sf-grid-wandmass: Die beiden Seiten-Boards (Kontakt-Board im Paragraph,
	   Format-Board in der Formatfrage-Hälfte) übernehmen die KACHELGRÖSSE der
	   Multi-Output-Wand (--mo-k-Formel) statt der viewport-füllenden
	   SplitFlap-Automatik. is:global nötig: .sf-grid trägt kein Scope-Attribut
	   dieser Seite. */
	.paragraph .sf-grid,
	.ziel-format-tafel .sf-grid {
		--sf-tile-w: clamp(11px, 1.75vw, 30px);
		/* Schrift wie in der Multi-Output-Wand (Fred 14.09.: "Schrift wirkt
		   kleiner"): dieselbe von der Kachel ENTKOPPELTE Lead-Formel statt
		   der 0.62-Kachel-Kopplung der Komponente. */
		--sf-font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
	}
</style>

<script>
	// Tür FORMATBERATUNG: Wisch DIREKT ans Scrollen gekoppelt (Fred 14.09.
	// spät). Der Fortschritt der Aufwisch-Animation ist eine reine Funktion
	// der Position: Unterkante der Tür vs. Oberkante des Menüknopfs.
	// BAND px darüber beginnt die Übergangszone — beim Runterscrollen
	// wischt die Tür über diese Strecke auf, beim Zurückscrollen exakt
	// spiegelbildlich wieder zu. Kein Beobachter, keine Zeit-Animation,
	// kein Wettrennen gegen Scroll-Flicks. astro:page-load-Muster mit
	// Cleanup wie überall.
	let tuerCleanup: (() => void) | null = null;

	function mountTuer() {
		if (tuerCleanup) tuerCleanup();
		tuerCleanup = null;
		const tuer = document.querySelector<HTMLElement>("[data-format-tuer]");
		if (!tuer) return;
		const BAND = 160; // Wisch-Strecke in px (ungelockt, am Objekt tunen)
		// LUFT 140 statt 8 (Fred 14.09. spät, "beim schnellen Scrollen
		// schafft es das nicht"): Chromes Compositor-Scrolling ist dem
		// Skript bei Flicks 1-3 Frames voraus — die Tür wird mit altem
		// Clip-Stand mitgeschoben, bevor die Rechnung greift. Der
		// Sicherheitsabstand legt die Wisch-Zone so hoch, dass selbst der
		// Frame-Rückstand nie bis zum Menüknopf reicht: komplett weg ist
		// die Tür schon 140px über dessen Oberkante.
		const LUFT = 140;
		let angefordert = false;

		const update = () => {
			angefordert = false;
			const menue = document.querySelector<HTMLElement>(".menu-tile");
			const grenze = menue
				? menue.getBoundingClientRect().top - LUFT
				: window.innerHeight - 160;
			const unten = tuer.getBoundingClientRect().bottom;
			const p = Math.min(1, Math.max(0, (grenze - unten) / BAND));
			tuer.style.clipPath = `inset(${(1 - p) * 100}% 0 0 0)`;
			tuer.style.pointerEvents = p >= 1 ? "auto" : "none";
		};
		const anfordern = () => {
			if (!angefordert) {
				angefordert = true;
				requestAnimationFrame(update);
			}
		};

		window.addEventListener("scroll", anfordern, { passive: true });
		window.addEventListener("resize", anfordern);
		update();
		tuerCleanup = () => {
			window.removeEventListener("scroll", anfordern);
			window.removeEventListener("resize", anfordern);
		};
	}

	document.addEventListener("astro:page-load", mountTuer);
</script>
