</Layout>

<style>
	/* Aufbau-Variante: Abschnitte (bisher, Grundeinstellung) oder Kacheln (vier Kacheln zu Unterseiten) */
	/* Grundeinstellung seit 13.11.2026 „Kacheln“ (Rasul: „Kacheln“); ohne Angabe gilt Kacheln */
	:global(html[data-aufbau="abschnitte"]) .aufbau--kacheln { display: none; }
	:global(html:not([data-aufbau="abschnitte"])) .aufbau--abschnitte { display: none; }
	/* Satz-Vergleich: nur der gewählte Satz ist sichtbar (Grundeinstellung A) */
	.satz { display: none; margin: auto 0; }
	:global(html[data-satz="a"]) .satz--a,
	:global(html:not([data-satz])) .satz--y,
	:global(html[data-satz="g"]) .satz--g,
	:global(html[data-satz="h"]) .satz--h,
	:global(html[data-satz="i"]) .satz--i,
	:global(html[data-satz="j"]) .satz--j,
	:global(html[data-satz="k"]) .satz--k,
	:global(html[data-satz="l"]) .satz--l,
	:global(html[data-satz="m"]) .satz--m,
	:global(html[data-satz="n"]) .satz--n,
	:global(html[data-satz="o"]) .satz--o,
	:global(html[data-satz="p"]) .satz--p,
	:global(html[data-satz="q"]) .satz--q,
	:global(html[data-satz="r"]) .satz--r,
	:global(html[data-satz="s"]) .satz--s,
	:global(html[data-satz="t"]) .satz--t,
	:global(html[data-satz="u"]) .satz--u,
	:global(html[data-satz="v"]) .satz--v,
	:global(html[data-satz="w"]) .satz--w,
	:global(html[data-satz="x"]) .satz--x,
	:global(html[data-satz="y"]) .satz--y,
	:global(html[data-satz="f"]) .satz--f,
	:global(html[data-satz="e"]) .satz--e,
	:global(html[data-satz="d"]) .satz--d,
	:global(html[data-satz="b"]) .satz--b,
	:global(html[data-satz="c"]) .satz--c { display: block; }
	.satz :global(.haltung) { margin: 0; padding-block: var(--abstand-md); }
	.filmhero { display: none; }
	:global(html[data-hero="film"]) .filmhero { display: block; height: 100dvh; background: var(--black); }
	@media (orientation: portrait) {
		:global(html[data-hero="film"]) .filmhero { height: 133.333vw; }
	}

	/* Hero: erster Bildschirm = Logo + drei Zeilen; die erste Zeile des Erklärtexts lugt unten
	   hervor (Rasul 13.11.2026). */
	.hero__buehne {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: calc(100svh - var(--abstand-md) - 1.1 * var(--text-lg) - 24px);
		padding-top: 32px;
	}
	.hero__buehne :global(h1) { margin: auto 0; padding-block: var(--abstand-md); }
	.hero__logo { display: block; color: var(--white); }
	.hero__logo :global(svg) { display: block; height: auto; }
	.hero__logo :global(.hero__logo--gross) { display: none; width: calc(2.8964 * 96px); }
	.hero__logo :global(.hero__logo--klein) { width: calc(2.8964 * 40px); }
	@media (min-width: 1024px) {
		.hero__logo :global(.hero__logo--gross) { display: block; }
		.hero__logo :global(.hero__logo--klein) { display: none; }
	}
	/* Abgleich mit BBH 13.11.2026: Schrift, Größe und Breite des kleinen Texts gleich wie BBH About (Geist
	   Medium, text-lg, Zeilenhöhe 1,1, Laufweite −0,04 em, max. 1024 px). */
	.hero :global(.kurzsaetze) { margin-top: var(--abstand-md); }
	/* Unter dem Film (Film-Hero) wie BBH: Statement und kleiner Text als Einheit mit genau lg Abstand
	   (Join Us: „Black Sheep Wanted“ → Intro, gemessen 160 px bei 2048 px). Ohne die Reserve der Text-Variante
	   (Mindesthöhe der Bühne) und ohne Innenabstand unter dem Statement. Vorher gemessen 218 px. */
	:global(html[data-hero="film"]) .hero__buehne { min-height: 0; }
	:global(html[data-hero="film"]) .satz :global(.haltung) { padding-bottom: 0; }
	/* Gleicher Abstand über und unter dem Satz (Rasul 13.11.2026 abends: „dass bei unserem Satz … der Abstand nach oben
	   und nach unten, also der schwarze Hintergrund, unterschiedlich ist, ist das Absicht?“ Nein: gemessen oben rund
	   100 px, unten 277 px, Rest aus der Zeit mit dem kleinen Text darunter). Jetzt oben und unten je lg. */
	:global(html[data-hero="film"]) .hero__buehne { padding-top: 0; }
	:global(html[data-hero="film"]) .hero__buehne :global(h1) { padding-top: var(--abstand-lg); padding-bottom: 0; margin: 0; }
	:global(html[data-hero="film"]) .aufbau--kacheln > .abschnitt:first-child { margin-top: var(--abstand-lg); }
	:global(html[data-hero="film"]) .hero :global(.kurzsaetze) { margin-top: var(--abstand-lg); }
	/* Unter dem Film steht nach BBHs Startseite nur das Statement mit Zeiger-Film; der kleine Text ist hier
	   ausgeblendet, nicht gestrichen (Rasul 13.11.2026: „den Text, der hatte ja eine Funktion. Also streichen
	   kümmert ihr nicht. Aber wir können dann daraus den nächsten Abschnitt vielleicht machen oder ihn in den
	   nächsten Abschnitt integrieren, das müssen wir uns dann angucken.“). Im Text-Hero bleibt er sichtbar. */
	:global(html[data-hero="film"]) .hero :global(.kurzsaetze) { display: none; }
	/* Zeiger-Film nur unter dem Film-Hero */
	:global(html:not([data-hero="film"])) .hero :global(.zeigerfilm) { display: none; }

	/* Abstände innerhalb eines Abschnitts (BBH: Text zu Medium lg, Überschrift zu Text md) */
	.kanaele { margin-top: var(--abstand-md); }
	.nach-band { margin-top: var(--abstand-lg); }
	.nach-textbild { margin-top: var(--abstand-lg); }
