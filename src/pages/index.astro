</Layout>

<style>
	/* Randabstand 1:1 von BBH übernommen (live gemessen): 16px bis 1024px
	   Breite, danach 32px — statt unserem vorherigen festen 24px ohne
	   Zwischenschritt. Gilt für .wrap UND .hero-headline, damit große Texte
	   nie ganz an den Bildschirmrand gehen. */
	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 1024px) {
		.wrap {
			padding: 0 32px;
		}
	}

	/* Ziel→Format-Tafel (Probe 13.09.): mittig, großzügige Luft; auf schmalen
	   Viewports scrollt die Tafel horizontal, statt das Raster zu brechen
	   (Probe-Kompromiss — die Mobil-Form ist eine eigene Objekt-Entscheidung,
	   Kandidat: zwei Zeilen übereinander statt links/rechts). */
	/* Sektions-Titel "Eine Frage des Formats": dasselbe Rezept wie die
	   anderen Sektionstitel (Einheitsgrößen-Prinzip); ohne Umlaut in der
	   Zeile reicht die enge 0.85er-Zeilenhöhe. */
	.format-split {
		width: 100%;
		max-width: 1728px;
		margin: 0 auto;
		display: flex;
		flex-direction: column-reverse;
		gap: 48px;
	}

	@media (min-width: 800px) {
		.format-split {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			/* BBH-BAUWEISE (Fred 14.09. nacht, aus deren About-Split
			   gemessen: w-1/2 + w-1/2 OHNE Gap — die Hälften stoßen an
			   der Mittellinie aneinander; Abstand entsteht nur durch die
			   Innen-Lage der Inhalte). Gilt für ALLE Split-Sektionen. */
			gap: 0;
			/* Beide Hälften vertikal auf EINER Mitte (Fred 20.09.): der
			   Titel-Turm rechts steht mittig zur gesamten Textspalte samt
			   Flipperband. Vorher: align-items start (beide oben bündig). */
			align-items: center;
		}

		/* Spiegel der BBH-Regel für die gespiegelte Sektion: der TEXT
		   (linke Hälfte) rückt mit seiner Spalte an die Mittellinie —
		   Block bündig rechts in der Hälfte, Text darin bleibt
		   linksbündig (wie BBHs rechte Textspalte, nur gespiegelt). */
		.tafel-kopf {
			width: min(46rem, 100%);
			margin-left: auto;
		}
	}

	/* TINTE STATT ZEILENRAUM (Fred 20.09.): der Titel-Turm trägt bei
	   line-height 0.9 oben und unten je ein Stück leeren Zeilenraum mit.
	   Dadurch ist sein Kasten 38px höher als die Textspalte daneben, und
	   die Sektion wirkt trotz exakter Mittenausrichtung schief. text-box
	   schneidet den Überhang ab: Kasten oben = Versalhöhe, unten =
	   Grundlinie. @supports-Wache für Browser ohne die Eigenschaft. */
	@supports (text-box: trim-both cap alphabetic) {
		.format-titel {
			text-box: trim-both cap alphabetic;
		}
	}

	.format-titel {
		margin: 0;
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.9; /* Fred 14.09. nacht: ALLE Sektionstitel einheitlich 0.9 */
		letter-spacing: -0.01em;
		font-size: var(--text-huge); /* = BBH huge (ehem. clamp(2.5rem, 1rem + 7vw, 8rem), 114 px bei 1400; jetzt 101) */;
		text-wrap: balance;
		text-align: center;
		align-self: center;
	}

	.tafel-kopf {
		display: flex;
		flex-direction: column;
		gap: 16px;
		/* Titel+Board rechts sind EINE Einheit (Fred 14.09. nacht) — der
		   Text hier steht vertikal MITTIG zu dieser Einheit. */
		align-self: center;
		/* Board linksbündig zum Text (Fred 20.09.): die Kinder der Spalte
		   beginnen alle an derselben linken Kante — sonst zentriert das
		   inline-flex-Board sich in der Spaltenbreite. */
		align-items: flex-start;
	}

	/* Die Zarge des Boards läuft um die Kacheln herum (Padding 0.24
	   Kachelbreiten). Damit die ERSTE KACHEL — und damit der Text im Board —
	   exakt auf der Textkante der Absätze beginnt (Fred 20.09.), wird das
	   Board um genau diese Zargenbreite nach links gezogen. */
	/* :global, weil .sf-board aus SplitFlap.astro stammt — Astros
	   Scoped-CSS würde den Selektor sonst nie treffen. */
	.tafel-kopf :global(.sf-grid) {
		margin-left: calc(var(--sf-tile-w) * -0.24);
	}


	.tafel-intro {
		font-size: var(--text-md); /* = BBH md (ehem. clamp 1.125rem…1.9444rem, war schon BBHs md) */;
		font-weight: var(--lesetext-gewicht);
		line-height: var(--lesetext-zeilenhoehe);
		letter-spacing: var(--lesetext-laufweite);
		font-optical-sizing: auto;
		max-width: 46rem;
		/* Linksbündig wie die Paragraph-Absätze oben (Fred 13.09.) — der
		   Block bleibt mittig in der Sektion, der Text darin läuft links. */
		text-align: left;
		margin: 0;
	}

	.ziel-format-tafel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(32px, 5vh, 56px);
		/* Oben BBHs Sektions-XL (Fred 14.09.: gleicher Abstand wie über der
		   Multi-Output-Sektion; die Wand darüber endet auf 0). */
		padding: var(--abstand-xl) 16px clamp(48px, 8vh, 96px);
		overflow-x: auto;
	}

	/* SZENE: Videogröße (07.11.2026). Gleiche Bauart wie die Schrift- und
	   Abstands-Tokens in Layout.astro (BBH-Rezept): linear in vw, oben bei
	   1728 px Fenster gedeckelt, damit das Video in Maßen bleibt und die
	   Fläche drumherum den Blasen gehört. Geeicht auf die Richtwerte aus
	   dem Browser-Modell: 1440 → 530, 1100 → 455. Untergrenze 400 px
	   (Tablet/Desktop anschaubar); darunter greift min() mit dem 16-px-Rand
	   der Seite, auf dem Handy also fast randvoll (375 → 343). Alles stetig:
	   kein Umschalten, nur Knicke, wo eine Grenze einsetzt.
	   Verlauf: ≤432 randvoll · 432–850 400 px · 850–1728 wachsend · ab 1728 594 px. */
	.szene {
		--szene-video-b: min(calc(100vw - 32px), clamp(400px, 212.4px + 22.06vw, 593.5px));
		display: flex;
		justify-content: center;
		padding: 0 16px;
	}

	.szene-video {
		display: block;
		width: var(--szene-video-b);
		aspect-ratio: 16 / 9;
		height: auto;
		object-fit: cover;
		background: var(--panel);
	}

	/* HERO (10.11.2026, Übergabe „Website · Gestaltung“, von Rasul
	   freigegeben). Ganz im BBH-System: Überschrift nach BBHs Hero-Regel
	   (BBH /about: text-[10vw], ohne Obergrenze, Zeilenhöhe 0,95), Text in
	   --text-lg, Abstände aus den Tokens. Überschrift und Text stehen
	   zusammen senkrecht mittig im ersten Bildschirm; ist der Block höher
	   (z. B. 1280 × 720), läuft er einfach über die Höhe hinaus. Der frühere
	   Versatz translateY(-2.5vh) und die Höhen-Deckel des Vierzeilers sind
	   raus (Verlauf in der Git-Historie). */
	.hero {
		min-height: 100svh;
		padding: var(--abstand-md) 0;
		display: flex;
		flex-direction: column;
	}

	.hero-headline {
		width: 100%;
		margin: auto;
		padding: 0 16px;
		text-align: center;
	}

	@media (min-width: 1024px) {
		.hero-headline {
			padding: 0 32px;
		}
	}

	.hero h1 {
		margin: 0;
		font-size: 10vw; /* auch auf dem Handy 10vw: jede Zeile bleibt einzeilig von 320 bis 2560 px (gemessen 10.11.) */
		font-weight: 900;
		line-height: 0.95;
		letter-spacing: 0.02em; /* nach Augenmaß an BBH angeglichen, Forma 900 läuft dichter */
		font-optical-sizing: auto;
	}

	/* Jede Zeile ein eigener Block (die Umbrüche sind Bedeutung). Die
	   Wisch-Animation bleibt an den Zeilen, wie beim vorherigen Hero:
	   clip-path legt von links frei, 800 ms, PageWipes BBH-Kurve. */
	.hero h1 > .hero-zeile {
		display: block;
		white-space: nowrap;
		animation: hero-line-wipe 800ms cubic-bezier(0.76, 0, 0.24, 1) 100ms both;
	}

	.hero h1 > .hero-zeile--grau {
		color: var(--gray);
	}

	/* Text unter der Überschrift: ein Block, so breit wie die Textspalte
	   der zweispaltigen Abschnitte (.paragraph-text im Plädoyer), damit
	   sich die Breite auf der Seite wiederholt: ab 800 px halbe Container-
	   breite (Container höchstens 1728 px, Innenabstand 16 px, ab 1024 px
	   32 px), darunter die volle Spalte. Block mittig, Text linksbündig. */
	.hero-text {
		max-width: 100%;
		margin: var(--abstand-md) auto 0;
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.01em;
		color: var(--white);
		text-align: left;
		text-wrap: pretty;
	}

	@media (min-width: 800px) {
		.hero-text {
			max-width: calc((min(100vw, 1728px) - 32px) / 2);
		}
	}

	@media (min-width: 1024px) {
		.hero-text {
			max-width: calc((min(100vw, 1728px) - 64px) / 2);
		}
	}

	@keyframes hero-line-wipe {
		/* Oben/unten -0.35em Luft im Zuschnitt (Fred-Befund 30.08. nachts):
		   die Zeilenhöhe (0.92) ist enger als die Schrift — Unterlängen wie
		   das g von "verteidigen" ragen aus der Satz-Box heraus, und ein
		   Zuschnitt auf exakt die Box (inset 0) schnitt sie ab: an der Stelle
		   erschien das Seiten-Schwarz "über" dem g. Mit negativem Inset
		   wischt der Effekt nur horizontal und lässt Über-/Unterlängen in
		   Ruhe — auch im Endzustand (fill: both). */
		from {
			clip-path: inset(-0.35em 100% -0.35em 0);
		}
		to {
			clip-path: inset(-0.35em 0 -0.35em 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero h1 > .hero-zeile {
			animation: none;
		}
	}

	/* "Der Paragraph" (Fred 2026-06-14, zweite Runde: "Container breiter,
	   zu abgeschnitten — über die ganze Breite"): bewusst KEIN .wrap und keine
	   max-width auf den Absätzen — die Zeilen laufen bis auf den BBH-Randabstand
	   an die Bildschirmkanten. Fred bricht selbst runter, wie weit das bleibt;
	   die 46rem-Lesebremse von .plaedoyer-text ist hier deshalb aufgehoben. */
	.paragraph {
		/* Unten 0 (BBH-Regel, live verifiziert 14.09.: zwischen Sektionen
		   liegt EXAKT ein --abstand-xl und sonst nichts — die Folgesektion
		   bringt den kompletten Abstand als eigenes padding-top mit). */
		padding: 56px 16px 0;
		/* Split-Deckel wie die alte Plädoyer-Spec: 1728px, mittig. */
		max-width: 1728px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	@media (min-width: 800px) {
		.paragraph {
			display: grid;
			/* BBH-Regel: Splits EXAKT 50/50 — minmax(0,1fr) gegen die
			   implizite min-width-Untergrenze der fr-Tracks. Fuge 0 =
			   BBH-Bauweise (s. Kommentar an .format-split). */
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 0;
			/* Beide Haelften auf EINER Mittelachse (Fred 28.09.): seit die drei
			   Absaetze kuerzer sind als der Turm, klebte der Text oben (start),
			   waehrend der Turm die Zeile fuellte. Jetzt zentriert sich die
			   kuerzere Haelfte an der laengeren, egal welche das ist. */
			align-items: center;
		}

	}

	/* Statement links: versal, Größe = BBHs text-2xl (Referenz für
	   Statements in Halbspalten, 30→80px), in der Hälfte horizontal UND
	   vertikal mittig; die zwei Sätze als Blöcke mit 0.5em Luft. */
	.paragraph-statement {
		margin: 0;
		font-weight: 900;
		text-transform: uppercase;
		/* EIN Überschriften-Stil (Fred 14.09. abends): Zeilenabstand wie
		   Multi-Output und Formatfrage (0.85) — der 0-Abstand über
		   text-box-trim ist raus. */
		line-height: 0.9; /* Fred 14.09. nacht: ALLE Sektionstitel einheitlich 0.9 */
		letter-spacing: -0.01em;
		/* Volle Sektionstitel-Größe (Fred 14.09.: "so groß wie Multi-Output,
		   auch wenn jedes Wort einzeln in der Zeile steht") — statt der
		   BBH-text-2xl-Halbspalten-Referenz. */
		font-size: var(--text-huge); /* = BBH huge (ehem. clamp(2.5rem, 1rem + 7vw, 8rem), 114 px bei 1400; jetzt 101) */;
		text-wrap: balance;
		/* Wieder MITTIG (Fred 14.09. nacht, Rechtsbündig-Probe verworfen);
		   die Kontakt-Zeile darunter bleibt rechtsbündig unterm Punkt. */
		text-align: center;
		align-self: center;
		/* Auf Turm-Breite eingeschnürt (Fred 14.09.): der Block ist genau so
		   breit wie die längste Zeile (ZEUGEN.) — damit kann die kleine
		   Unterzeile rechtsbündig exakt unter deren Punkt enden. Mittig in
		   der Hälfte bleibt er über die Auto-Ränder. */
		width: max-content;
		max-width: 100%;
		margin-left: auto;
		margin-right: auto;
	}

	/* Fette Absatz-Öffner (Fred 14.09. nacht, zweite Stufe: Standard-Fett
	   700 "reicht nicht"): 900 = die Fetteste der Variable-Achse, dasselbe
	   Gewicht wie die Versaltürme — Lauftext bleibt Regular 400. */
	.plaedoyer-text strong,
	.tafel-intro strong {
		font-weight: 900;
	}

	.statement-satz {
		display: block;
	}

	.paragraph-links {
		align-self: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* Turm-Block (Rückbau 19.09. auf Commit 2c977b4): exakt so breit wie
	   der Turm (max-content), darin die Kontakt-Zeile RECHTSBÜNDIG — sie
	   endet unter dem Punkt von ZEUGEN. Fuge 0, Turm-Zeilenabstände
	   unangetastet. */
	.turm-block {
		display: flex;
		flex-direction: column;
		gap: 0;
		width: max-content;
		max-width: 100%;
		margin: 0 auto;
	}

	.turm-block .kontakt-zeile {
		text-align: right;
	}

	/* ABSTAND = TURM-RHYTHMUS (Fred 14.09. nacht): zwischen ZEUGEN. und der
	   Kontakt-Zeile liegt exakt der sichtbare Tinten-Abstand zweier
	   Turm-Zeilen — bei Zeilenabstand 0.9 und Versal-Kappe 0.7 sind das
	   0.2 Turm-Em. Rechnung (mit text-box-trim an der Zeile): Turm-Überhang
	   −0.15 + gewünschte Lücke 0.2 = +0.05 Turm-Em. @supports-Wache:
	   Browser ohne text-box lassen die Zeile mit ähnlicher Luft stehen —
	   nie Überschneidung. */
	@supports (text-box: trim-both cap alphabetic) {
		.turm-block .kontakt-zeile {
			text-box: trim-both cap alphabetic;
			margin-top: calc(var(--text-huge) * 0.05);
		}
	}

	/* "Noch vor dem ersten Kontakt." als kleine Text-Zeile unterm Turm:
	   BBH-Lead-Referenz wie die Absätze rechts, normale Schreibung,
	   normales Gewicht. */
	.kontakt-zeile {
		margin: 0;
		font-size: var(--text-md); /* = BBH md (ehem. clamp 1.125rem…1.9444rem, war schon BBHs md) */;
		font-weight: var(--lesetext-gewicht);
		line-height: var(--lesetext-zeilenhoehe);
		letter-spacing: var(--lesetext-laufweite);
		font-optical-sizing: auto;
	}


	.format-rechts {
		display: flex;
		flex-direction: column;
		align-items: center;
		/* Fuge Titel→Board verdoppelt (Fred 14.09. nacht: "doppelt so
		   groß wie jetzt"): 28px statt der klebenden 14px. */
		gap: 28px;
		align-self: center;
	}

	.format-schluss {
		display: flex;
		justify-content: center;
		margin-top: clamp(40px, 6vh, 72px);
	}

	.format-schluss .format-cta {
		margin: 0;
		/* SCROLL-GEKOPPELTER WISCH (Fred 14.09. spät, dritte Bauform nach
		   Fade und Zeit-Wisch): das Script setzt den clip-path DIREKT aus
		   der Entfernung zum Menüknopf — die Tür wischt sich proportional
		   zur Annäherung weg, physikalisch immer synchron, egal wie
		   schnell gescrollt wird. Wer mitten in der Übergangszone stehen
		   bleibt, sieht eine halb aufgewischte Kachel — von Fred bewusst
		   abgenickt. KEINE clip-transition (Position steuert, Zeit nicht);
		   der Hover-Schleier bleibt animiert. */
		clip-path: inset(100% 0 0 0);
		pointer-events: none;
		transition: background-size 250ms ease-in-out;
	}

	.statement-zeile {
		display: block;
	}

	/* Variante (Fred 14.09.): "Noch vor dem ersten Kontakt." KLEIN unter
	   dem Turm — Größe nach der BBH-Lead-Referenz (dieselbe gemessene
	   Formel wie .plaedoyer-text und die Multi-Output-Subzeile), normale
	   Schreibung statt versal, normales Gewicht. */
	@media (min-width: 1024px) {
		.paragraph {
			padding: 56px 32px 0;
		}
	}

	/* Sichtungs-Runden (Fred, lokal — ab hier NICHT mehr pushen, Design wird
	   erst in HTML direkt geklärt): aktuell 50% der Breite, MITTIG im
	   Bildschirm zentriert. */
	.paragraph .plaedoyer-text {
		max-width: 46rem;
		margin-left: 0;
		margin-right: 0;
	}

	/* Mobil-Korrektur (Fred 14.09.: "sieht sehr schmal aus"): die 50%-
	   Halbspalte ist eine Desktop-Entscheidung — unterm Breakpoint läuft
	   der Text auf volle Breite (der BBH-Randabstand bleibt). */
	@media (max-width: 760px) {
		.paragraph .plaedoyer-text {
			max-width: 100%;
		}
	}

	/* Tür-Knopf unterm Paragraph: Kachel-Sprache des Menü-Systems (helle
	   Fläche, eckig, versal, BBH-Hover-Schleier), mittig unter der
	   50%-Textspalte. */
	.format-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		line-height: 1.1;
		/* EXAKT das Maß der aufgeklappten Menü-Zeilen (Fred 14.09. abends:
		   "so groß wie die anderen Knöpfe im Menü"): 272×88 (drei Kacheln
		   plus zwei Fugen), 28px-Versalwort, mittig — Tür und Menü sind
		   damit dasselbe Bedien-Material in derselben Konfektion. Wort
		   bleibt zweizeilig FORMAT/BERATUNG (einzeilig bräuchte ~293px). */
		width: min(calc(88px * 3 + 4px * 2), calc(100vw - 32px));
		box-sizing: border-box;
		height: 88px;
		margin: 40px auto 0;
		background: var(--tile-surface);
		color: var(--black);
		font-weight: 900;
		font-size: 28px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		background-image: linear-gradient(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.15));
		background-repeat: no-repeat;
		background-position: left center;
		background-size: 0% 100%;
		transition: background-size 250ms ease-in-out;
	}

	.format-cta:hover {
		background-size: 100% 100%;
	}

	.plaedoyer-text {
		max-width: 46rem;
		/* Referenz-Wechsel (Fred 30.08., Vergleich /offices/bbh-studios):
		   BBHs LEAD-Absätze sind größer als das About-Body-Rezept, das hier
		   vorher galt (20→26px) — live an zwei Breiten gemessen (921px:
		   23.38px / 1920px: 31.11px, Fluid-Deckel bei 1728) und daraus die
		   Gerade rekonstruiert: clamp(18px, 14.55px + 0.9583vw, 31.11px).
		   Zeilenhöhe dort 1.3 (nicht 1.2), Laufweite -0.02em unverändert. */
		font-size: var(--text-md); /* = BBH md (ehem. clamp 1.125rem…1.9444rem, war schon BBHs md) */;
		font-weight: var(--lesetext-gewicht);
		line-height: var(--lesetext-zeilenhoehe);
		letter-spacing: var(--lesetext-laufweite);
		font-optical-sizing: auto;
		color: var(--white);
	}

	/* Absatz-Abstand — Referenz-Korrektur (Fred 2026-06-14, "kommt mir zu
	   groß vor"): live auf BBHs /offices/bbh-studios nachgemessen — deren
	   Lead-Absatz-Gruppe nutzt ein flaches space-y-6 = 24px auf ALLEN
	   Breiten (bei 26,8px Schrift → Verhältnis 0,9), nicht das
	   space-y-5/md:space-y-8 (20/32px) der About-Seite, das hier vorher
	   galt. 32px ab Desktop war dadurch spürbar luftiger als das Original.
	   (Globales p{margin:0} in Layout.astro würde die Absätze sonst
	   zusammenkleben lassen.) */
	.plaedoyer-text + .plaedoyer-text {
		margin-top: var(--lesetext-absatz);
	}

	.proof {
		padding: 24px 0 64px;
		/* vollbreit: die Sektion liegt außerhalb von .wrap, das Video füllt
		   die komplette Viewport-Breite (BBH-Startseiten-Muster). */
	}

	.clip-placeholder {
		aspect-ratio: 16 / 9;
		width: 100%;
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gray);
		font-size: var(--text-sm); /* = BBH sm (ehem. 0.9rem) */
	}

	/* Bausteine-Sektion (Maße aus der Demo-Runde bausteine-demo.html, D2):
	   eigener Container auf Plädoyer-Deckelbreite 1728px; Kacheln = BBHs
	   visual-grid (16px Fuge), Panel-Grund, Hochformat 4:5; Kachel-Schrift
	   an der KACHELbreite (cqw), kalibriert auf "Redaktion" als längste
	   Zeile. Unter 800px stapeln die Kacheln. */
	.bausteine {
		max-width: 1728px;
		margin: 0 auto;
		padding: 24px 16px 96px;
	}

	@media (min-width: 1024px) {
		.bausteine {
			padding: 24px 32px 96px;
		}
	}

	.bausteine-titel {
		margin: 0 0 40px;
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.9; /* Fred 14.09. nacht: ALLE Sektionstitel einheitlich 0.9 */
		letter-spacing: -0.01em;
		font-size: var(--text-huge); /* = BBH huge (ehem. clamp(2.5rem, 1rem + 7vw, 8rem), 114 px bei 1400; jetzt 101) */;
	}

	.bausteine-grid {
		display: grid;
		gap: 16px;
	}

	@media (min-width: 800px) {
		.bausteine-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.baustein {
		background: var(--panel);
		aspect-ratio: 4 / 5;
		padding: clamp(18px, 2.2vw, 32px);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		container-type: inline-size;
	}

	.baustein h3 {
		margin: 0;
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.9; /* Fred 14.09. nacht: ALLE Sektionstitel einheitlich 0.9 */
		letter-spacing: -0.01em;
		font-size: 16.5cqw;
	}

	.baustein-sub {
		color: var(--gray);
		font-size: clamp(0.85rem, 3.2cqw, 1.05rem);
		margin: 10px 0 0;
	}

	.baustein-text {
		font-size: var(--text-base); /* = BBH base (ehem. clamp 0.95…1.1rem) */
		line-height: 1.3;
		letter-spacing: -0.01em;
		margin: 0;
	}

	footer {
		padding: 32px 0 64px;
	}

	footer nav {
		display: flex;
		gap: 24px;
		font-size: var(--text-sm); /* = BBH sm (ehem. 0.85rem) */
		color: var(--gray);
	}

	footer a {
		text-decoration: none;
		color: inherit;
	}


	/* ── STARTSEITE ALS DUMMY (11.11.2026, Übergabe „Website · Gestaltung“) ──
	   Werte aus der Werkstatt-Vorschau szenen-vorschau.html (Endstand der
	   Überschreibungen, Schriftsystem Punkte 14a und 15). Nur Tokens
	   --text-sm … --text-mega. Fett (900) nur im Großen, Mono für Labels und
	   Knöpfe, Hervorhebung über Weiß und Grau.
	   Raster nach BBH: Container höchstens 1728 px, Innenabstand 32 px
	   (unter 800 px 16 px), Abschnittsabstand --abstand-xl. */
	.ab,
	.fm {
		max-width: 1728px;
		margin: 0 auto;
		padding: var(--abstand-xl) 32px 0;
		box-sizing: border-box;
		color: var(--white);
		overflow-x: clip;
	}
	/* Abschnitt 2 hängt an der Szene: --abstand-md darunter statt --abstand-xl */
	.ab-zwei-text {
		max-width: none;
		padding: var(--abstand-md) 16px 0;
	}
	.ab-letzter {
		padding-bottom: var(--abstand-xl);
	}

	/* Label: Mono, Versalien, Stufe base, 400, +0,025 em, Zeilenhöhe 1,22, Grau */
	.ab-label {
		margin: 0 0 16px;
		text-align: center;
		font-family: "Forma DJR Mono", "Forma DJR", ui-monospace, monospace;
		text-transform: uppercase;
		font-size: var(--text-base);
		font-weight: 400;
		letter-spacing: 0.025em;
		line-height: 1.22;
		color: var(--gray);
	}

	/* Abschnittstitel: --text-2xl, Forma 900, 0 em, Zeilenhöhe 1,0 */
	.ab-titel {
		margin: 0;
		text-align: center;
		font-size: var(--text-2xl);
		font-weight: 900;
		letter-spacing: 0;
		line-height: 1;
		font-optical-sizing: auto;
		text-wrap: balance;
	}

	/* Lesetext: Tokens aus Layout.astro, Breite = Textspalte (wie .hero-text) */
	.ab-text {
		max-width: 100%;
		margin: var(--abstand-md) auto 0;
		font-size: var(--text-md);
		font-weight: var(--lesetext-gewicht);
		letter-spacing: var(--lesetext-laufweite);
		line-height: var(--lesetext-zeilenhoehe);
		font-optical-sizing: auto;
		text-align: left;
		text-wrap: pretty;
	}
	@media (min-width: 800px) {
		.ab-text { max-width: calc((min(100vw, 1728px) - 32px) / 2); }
	}
	@media (min-width: 1024px) {
		.ab-text { max-width: calc((min(100vw, 1728px) - 64px) / 2); }
	}

	.ab-inhalt {
		margin-top: var(--abstand-lg);
	}
	.ab-mitte {
		margin: 16px 0 0;
		text-align: center;
	}
	.ab-kachel {
		background: var(--panel);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Platzhalter-Markierung (gelb), wie in der Vorschau */
	.entwurf {
		display: inline-block;
		font: 600 12px/1.3 system-ui, sans-serif;
		letter-spacing: 0;
		text-transform: none;
		color: #f2a541;
		border: 1px solid #f2a541;
		border-radius: 6px;
		padding: 3px 8px;
	}

	/* ── 3 · Fließband ── */
	.fm {
		/* Kachelbreite: ein Drittel des Inhalts, 16 px Abstand */
		--fm-kb: calc((min(100vw, 1728px) - 64px - 32px) / 3);
	}
	.fm-index {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px 28px;
		margin: var(--abstand-lg) 0 0;
	}
	/* Namenszeile: Stufe sm, 430, +0,015 em, Zeilenhöhe 1,21; Kennbuchstabe weiß */
	.fm-index span {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		font-size: var(--text-sm);
		font-weight: 430;
		letter-spacing: 0.015em;
		line-height: 1.21;
		color: var(--gray);
		transition: color 0.4s;
	}
	.fm-index b { font-weight: inherit; }
	.fm-index em { font-style: normal; font-weight: 430; color: var(--white); margin-right: 0.3em; }
	.fm-index i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #404040;
		transition: background 0.4s, box-shadow 0.4s;
	}
	.fm-index span.aktiv { color: var(--white); }
	.fm-index span.aktiv i { background: var(--white); box-shadow: 0 0 8px rgba(255, 255, 255, 0.7); }

	.fm-band {
		margin: var(--abstand-md) -32px 0;
		overflow: hidden;
	}
	.fm-band-spur {
		display: flex;
		gap: 16px;
		width: max-content;
		padding-left: 32px;
		animation: fm-band 48s linear infinite;
	}
	@keyframes fm-band {
		to { transform: translateX(calc(-50% - 8px)); }
	}
	.fm-k {
		margin: 0;
		flex: none;
		width: var(--fm-kb);
	}
	.fm-flaeche {
		width: 100%;
		aspect-ratio: 4 / 3;
		background: var(--panel);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		container-type: size;
	}
	.fm-flaeche > * {
		display: block;
		flex: none;
		object-fit: cover;
	}
	.fm-169 .fm-flaeche > * { aspect-ratio: 16 / 9; height: auto; width: min(86cqw, 80cqh * 16 / 9); }
	.fm-916 .fm-flaeche > * { aspect-ratio: 9 / 16; height: 86cqh; width: auto; }
	.fm-11 .fm-flaeche > * { aspect-ratio: 1; height: 80cqh; width: auto; }
	.fm-45 .fm-flaeche > * { aspect-ratio: 4 / 5; height: 86cqh; width: auto; }

	/* Bildunterschrift: Stufe base, 400, +0,025 em, 1,22, Grau; Name weiß */
	.fm-k figcaption {
		max-width: 34em;
		margin-top: 16px;
		font-size: var(--text-base);
		font-weight: 400;
		letter-spacing: 0.025em;
		line-height: 1.22;
		color: var(--gray);
	}
	.fm-k figcaption b {
		display: block;
		color: var(--white);
		font-weight: 400;
		line-height: 1.2;
	}
	/* „Beweisstück A“ … in der kleinsten Stufe, grau */
	.fm-bs {
		display: block;
		margin-bottom: 4px;
		font-size: var(--text-sm);
		font-weight: 430;
		letter-spacing: 0.015em;
		line-height: 1.21;
	}

	/* Audio-Podcast: Cover (neutral grau statt Gast-Standbild) mit Wellenform */
	.fm-audio {
		display: flex;
		flex-direction: column;
		background: #000;
	}
	.fm-cover {
		flex: 1;
		background: #3a3a3a;
	}
	.fm-welle {
		height: 22%;
		display: flex;
		align-items: center;
		gap: 3%;
		padding: 0 6%;
	}
	.fm-welle i {
		flex: 1;
		background: var(--white);
		animation: fm-welle 1.3s ease-in-out infinite alternate;
		transform-origin: center;
	}
	@keyframes fm-welle {
		from { transform: scaleY(0.3); }
		to { transform: scaleY(1); }
	}

	/* Zitat: Hintergrund neutral grau statt Gast-Standbild, Satz im Stil der
	   Abschnittstitel (900, 0 em, 1,0), Größe an die Kachel gebunden */
	.fm-zitat {
		position: relative;
		display: flex;
		align-items: flex-end;
		background: #3a3a3a;
		container-type: inline-size;
	}
	.fm-zitat::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.1) 70%);
	}
	.fm-zitat q {
		position: relative;
		padding: 8%;
		font-size: 7.5cqw;
		font-weight: 900;
		letter-spacing: 0;
		line-height: 1;
		color: var(--white);
		quotes: "„" "“";
	}
	.fm-zitat-ph {
		position: absolute;
		top: 6%;
		left: 6%;
		z-index: 1;
	}

	/* Newsletter und Transkript auf Papier */
	.fm-papier {
		background: #ededed;
		padding: 8%;
		box-sizing: border-box;
		container-type: inline-size;
	}
	.fm-bild {
		height: 45%;
		background: #9a9a9a;
		margin-bottom: 8%;
	}
	.fm-zeilen i,
	.fm-zeilen em {
		display: block;
		height: 2.8cqw;
		margin: 0 0 3.6cqw;
		background: #9a9a9a;
		border-radius: 2px;
	}
	.fm-zeilen em {
		width: 22%;
		margin-top: 5cqw;
		background: #404040;
	}

	/* Kanalzeile: Lesetext-Stil, mittig */
	.fm-kanaele {
		margin: var(--abstand-md) 0 0;
		text-align: center;
		font-size: var(--text-md);
		font-weight: var(--lesetext-gewicht);
		letter-spacing: var(--lesetext-laufweite);
		line-height: var(--lesetext-zeilenhoehe);
	}

	@media (max-width: 799px) {
		.ab,
		.fm { padding-left: 16px; padding-right: 16px; }
		.fm { --fm-kb: calc(100vw - 64px); }
		.fm-band { margin-inline: -16px; }
		.fm-band-spur { padding-left: 16px; }
		/* Handy: nur die Punkte */
		.fm-index { gap: 10px; }
		.fm-index span { font-size: 0; gap: 0; }
	}

	/* ── 4 · Die Augenzeugen ── */
	/* Platzhalter in der Höhe der Grafik (Vorschau: 16 : 9, unter 800 px 4 : 5) */
	.az-platzhalter {
		aspect-ratio: 16 / 9;
	}
	@media (max-width: 799px) {
		.az-platzhalter { aspect-ratio: 4 / 5; }
	}
	/* Zahl: Stufe mega, 900, 0 em, Zeilenhöhe 0,82 */
	.ab-zahl {
		text-align: center;
		font-size: var(--text-mega);
		font-weight: 900;
		letter-spacing: 0;
		line-height: 0.82;
	}
	/* Zeile zur Zahl: Stufe lg, 510, +0,02 em, 1,1 */
	.ab-zahlzeile {
		margin: 16px auto 0;
		text-align: center;
		font-size: var(--text-lg);
		font-weight: 510;
		letter-spacing: 0.02em;
		line-height: 1.1;
	}
	/* Quelle: Stufe sm, 430, +0,015 em, 1,21, Grau */
	.ab-quelle {
		margin: 16px 0 0;
		text-align: center;
		font-size: var(--text-sm);
		font-weight: 430;
		letter-spacing: 0.015em;
		line-height: 1.21;
		color: var(--gray);
	}
	.ab-uhren {
		display: flex;
		justify-content: center;
	}
	.ab-uhren > :global(*) {
		width: 100%;
	}
	/* Hinweis: Stufe base, 400, +0,025 em, 1,22, Grau */
	.ab-hinweis {
		margin: var(--abstand-md) 0 0;
		text-align: center;
		font-size: var(--text-base);
		font-weight: 400;
		letter-spacing: 0.025em;
		line-height: 1.22;
		color: var(--gray);
	}

	/* ── 6 · Die Befragung, hell wie BBH Studios ── */
	.ab-hell {
		max-width: none;
		margin-top: var(--abstand-xl);
		padding-bottom: var(--abstand-xl);
		background: #fff;
		color: #000;
	}
	/* Akkordeon: ab 768 px 8 von 12 Rasterspalten (Abstand 16 px), mittig */
	.akk {
		max-width: 100%;
		margin: var(--abstand-md) auto 0;
		text-align: left;
	}
	@media (min-width: 768px) {
		.akk { max-width: calc((min(100vw, 1728px) - 32px - 176px) / 12 * 8 + 112px); }
	}
	@media (min-width: 1024px) {
		.akk { max-width: calc((min(100vw, 1728px) - 64px - 176px) / 12 * 8 + 112px); }
	}
	/* Wie in der Vorschau: je Frage zusätzlich 24 px oben und unten und eine
	   Linie --line darüber (in der Vorschau aus der älteren Fragenliste
	   .ab-fragen > div übernommen) */
	.akk-item {
		padding: 24px 0;
		border-top: 1px solid var(--line);
	}
	.akk-item:last-child {
		border-bottom: 1px solid var(--line);
	}
	.akk-kopf {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		width: 100%;
		padding: 24px 0;
		margin: 0;
		border: 0;
		border-bottom: 1px solid var(--gray);
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	/* Frage: Abschnittstitel-Stil (900, 0 em, 1,0) in xl */
	.akk-frage {
