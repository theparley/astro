---
import Layout from "../layouts/Layout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import SplitFlap from "../components/SplitFlap.astro";
// Fallblatt-WAND abgeloest (Fred 21.09.): die Startseite zeigt den
// Multi-Output jetzt als zwei Kacheln. MultiOutputTafel.astro bleibt als
// Datei im Repo, ist aber nirgends mehr eingebunden.
import MultiOutputKacheln from "../components/MultiOutputKacheln.astro";

// ZIEL→FORMAT-TAFEL (Fred 13.09., Probe-Einbau "nur dass ich es mal sehe"):
// Ziel links, Pfeil, Format rechts — BEWUSST EIN SplitFlap-Board statt zwei
// nebeneinander: zwei getrennte Boards laufen zeitlich auseinander (jeder
// Zustandswechsel dauert je nach Trommel-Distanz unterschiedlich lang), und
// dann stünde ein falsches Paar nebeneinander. Ein Board = immer synchron;
// die Zwei-Tafeln-Optik machen die festen Feldbreiten + der konstante Pfeil
// (nicht in der Trommel → klappert nie, steht wie eine Stanze in der Mitte).
// Ziel-Wortlaute = UNGELOCKTER Vorrat aus dem Website-Brief (Ziel→Format-
// Paare, MBS-Kaufmotive-Muster) — hier bewusst kurz gehalten, damit die
// Tafel nicht zu breit wird; am Objekt schärfen.
// Vierte Iteration (Fred 13.09. spät): Ziel-Zeilen und Pfeil VERWORFEN —
// die Tafel rattert NUR die Formate durch, eine Zeile. Dafür übernimmt sie
// die Aufzählungs-Funktion des Paragraph-Schlusssatzes (die Frage-Liste
// dort entfällt): mehr Formate ohne Satz-Platzkosten, und das Durchrattern
// selbst erzählt "es gibt mehr als eines". Liste = Sortiment + Kandidaten
// aus der Format-Recherche 13.09. (UNGELOCKT — Fred streicht/ergänzt).
// Fünfte Iteration (Fred 13.09. nacht, Wort-Diktat): Gattungs-Wörter, die
// jeder Leser sofort kennt — "Kundentestimonial" voll ausgeschrieben
// (Produktname), "Live-Webinar" statt Webinar (das "Live" adressiert Freds
// Billig-Vorbehalt und zieht die Grenze zur Folien-Konserve), "Interview"
// und "Online-Event" neu (Verstehens-Wörter; dass "Interview" kein
// SUCH-Begriff ist, ist hier egal — die Tafel ist eine Verstehens-Fläche).
// Sechste Iteration (Fred 13.09. nacht): Tafel MAXIMAL DREIZEILIG, bei
// Mehrwort-Formaten steht jedes Wort auf einer eigenen Zeile (Leerzeichen
// = Zeilentrenner; Bindestrich-Komposita bleiben EIN Wort/eine Zeile).
// padState() der Komponente zentriert kürzere Zustände vertikal im
// 3-Zeilen-Raster. "THOUGHT LEADER INTERVIEW" ersetzt das nackte
// "INTERVIEW" (Thought Leadership = bestätigtes Kunden-Vokabular).
const tafelFormate = [
	"VIDEOPODCAST",
	"KUNDENTESTIMONIAL",
	"LIVE-WEBINAR",
	"EXPERTENTALK",
	"ONLINE-EVENT",
	"RECRUITING-VIDEO",
	"LIVE Q&A-SESSION",
	"MITARBEITERINTERVIEW",
	"ONLINE-KURS", // Fred 28.09.: „nehmen nochmal hinzu: Online-Kurse"
];
// Zeilen-Aufteilung NEU (Fred 14.09.): Tafel wandert in die HALBE Spalte
// mit der Wand-Kachelgröße — dafür lange Wörter geteilt, max. DREI Zeilen,
// längste Zeile 11 Zeichen (TESTIMONIAL/MITARBEITER).
// EINZEILIG (Fred 20.09.): die Formatnamen stehen jetzt in EINER Zeile
// statt im Zweizeiler — das Board unter dem Text wird dadurch flach.
// Breiteste Zeile: MITARBEITER INTERVIEW (21 Kacheln).
const tafelZustaende = [
	["VIDEO PODCAST"],
	["KUNDEN TESTIMONIAL"],
	["LIVE WEBINAR"],
	["EXPERTEN TALK"],
	["ONLINE EVENT"],
	["RECRUITING VIDEO"],
	["LIVE Q&A SESSION"],
	["MITARBEITER INTERVIEW"],
	["ONLINE KURS"],
];

// Kontakt-Board unter dem Augenzeugen-Turm (Fred 14.09.): startet leer und
// flappt EINMAL "NOCH VOR DEM / ERSTEN KONTAKT." ein (loop=false hält den
// Endzustand; sr-only-Fallback der Komponente trägt den Lesetext).
// Produkte-Zeile (Website-Brief, gelockte Treppe 29.08. spät) — die vier
// buchbaren Formate als knappe Zeile nach dem Clip-Beweis. Noch keine
// Produktseiten live (Phase 1), deshalb reiner Text ohne Links.
const produkteZeile = "Videopodcast. Webinar. Clip. Kundentestimonial.";

// Essenz-Zeile in der zweiten Hälfte der Plädoyer-Sektion (Website-Brief,
// Fred 29.08. nachts): ausgeschriebener Satz statt Zahlen-Paar — "Ein
// Gespräch mit tausend Augenzeugen." ersetzt "1 Gespräch. 1000 Augenzeugen.",
// die Zahlen-Fassung bleibt als Vorrat für Beiträge/Splitflap dokumentiert.
// Reiner Wortlaut zur Referenz/für einen späteren Tausch — die tatsächliche
// Darstellung erzwingt jetzt manuelle Umbrüche (siehe Markup unten,
// Live-Feedback Fred), ist also nicht mehr ein reines Ein-Zeilen-Edit.
const soloLine = "Ein Gespräch mit tausend Augenzeugen.";
// Vorrat/Alternativen, noch nicht entschieden: "1 Gespräch. 1000 Augenzeugen."
// (Zahlen-Fassung, für Beiträge/Splitflap), "KI ist kein Augenzeuge."

// STARTSEITE ALS DUMMY (11.11.2026, Übergabe „Website · Gestaltung“).
// Alte Sektionen (Plädoyer, Multiplikation, Format-Tafel) bis zu Rasuls
// Bestätigung nur ausgeblendet, nicht gelöscht.
const ALTE_SEKTIONEN = false;
// Abschnitt 3: sechs Formate als Beweisstücke A bis F (Texte wörtlich aus der
// Werkstatt-Vorschau). Videopodcast und Clip zeigen das Testvideo.
const FORMATE = [
	{ buchstabe: "A", name: "Videopodcast", form: "169", art: "video", text: "Das ganze Gespräch, so wie es war. Für alle, die euch länger zuhören wollen." },
	{ buchstabe: "B", name: "Audio-Podcast", form: "11", art: "audio", text: "Dieselbe Folge zum Hören, unterwegs oder beim Laufen." },
	{ buchstabe: "C", name: "Clip", form: "916", art: "video", text: "Eine Frage, eine Antwort. Kurz genug für den Feed, lang genug, um zu zeigen, wie ihr denkt." },
	{ buchstabe: "D", name: "Zitat", form: "11", art: "zitat", text: "Ein Satz, der hängen bleibt. Zum Teilen und Zitieren." },
	{ buchstabe: "E", name: "Newsletter", form: "45", art: "newsletter", text: "Die Folge zum Lesen, direkt im Postfach eurer Kunden." },
	{ buchstabe: "F", name: "Transkript", form: "45", art: "transkript", text: "Jedes Wort zum Nachlesen, damit euch Suchmaschinen und KI-Assistenten finden." },
];
const WELLE = Array.from({ length: 28 }, (_, i) => ({ verz: ((i * 0.13) % 1.3).toFixed(2), hoehe: 30 + ((i * 37) % 60) }));
const papierZeilen = (n: number, kurz: number) => Array.from({ length: n }, (_, i) => (i === n - 1 ? kurz : 92 - (i % 3) * 9));
const FRAGEN = [
	["Wie viel Zeit kostet uns das?", "Unter zwei Stunden im Monat, davon eine im Gespräch. Vorher ein kurzes Telefonat zu Thema und Gast, danach die Freigabe am Rechner. Skript, Technik, Schnitt und Ausspielung übernehmen wir."],
	["Müssen wir etwas vorbereiten?", "Nein. Ihr redet über das, was ihr ohnehin wisst. Die Fragen stellen wir."],
	["Wir sind keine Creator. Passt das trotzdem?", "Genau dafür ist es gemacht. Ihr müsst euch nicht anpreisen, ihr werdet gefragt."],
	["Unser Thema haben doch schon alle besprochen.", "Gesagt haben es viele. Im Gespräch hört man, wie ihr darüber denkt. Das kann niemand kopieren."],
	["Was, wenn uns ein Satz nicht gefällt?", "Nichts geht raus, was ihr nicht freigegeben habt. Ihr bekommt eine Korrekturliste und entscheidet."],
	["Wo nehmen wir auf?", "Im Blickkontaktstudio in Karlsruhe, mit unserem mobilen Studio bei euch oder in einem eigenen Studio, das wir bei euch einrichten."],
	["Was kostet das?", "Ihr bezahlt kein Paket, sondern das, was ihr braucht: je Gespräch, je Beitrag und monatlich für die Formatredaktion, die euren Kanal führt. Die Preise stehen gleich darunter."],
];
const PREISE = [
	["Gespräch", "Die Aufnahme mit allem, was zur Folge gehört.", ""],
	["Beitrag", "Der fertige Ausschnitt samt Text.", ""],
	["Formatredaktion", "Redaktion, Ausspielung, Kommentare und Monatsbericht.", " je Monat"],
];
---

<Layout gateMenuBehindHero>
	<header class="hero">
		{/* Hero-Tausch (Fred 30.08. spät): der Dreizeiler aus der Essenz-Spalte
		   wird der Hero ("echt starker Hero"), "Kein Business ohne Witness."
		   wandert dafür in die Essenz-Spalte der Plädoyer-Sektion. Drei Sätze =
		   drei Zeilen (Spans mit display:block statt text-balance — die
		   Umbrüche sind hier Bedeutung, nicht Layout). */}
		<div class="hero-headline">
			{/* Hero-Rücktausch (Fred 2026-06-14): "Kein Business ohne Witness."
			   ist wieder der Hauptclaim groß oben — in den zwei bewährten
			   Zeilen. Der Dreizeiler ("Ihr habt die Expertise. / Wir
			   verteidigen sie. / Mit Augenzeugen.") ist raus; sein Inhalt lebt
			   sinngemäß im neuen Paragraph darunter ("Wir übernehmen die
			   Verteidigung eurer Expertise … Augenzeuge"). */}
			{/* Hero-Breakpoint (Fred 14.09.): unterm Schwellwert wird aus den
			   zwei Zeilen ein VIERZEILER — jedes Wort eine Zeile, die Schrift
			   darf dafür größer (kalibriert auf "Business" als längste
			   Zeile). Wort-Spans inline auf Desktop (unsichtbar), block am
			   Breakpoint; die Wipe-Animation bleibt an den ZEILEN-Spans. */}
		{/* PROBE LOKAL (Fred 23.09., nicht pushen): Hero und Turm getauscht —
		   „Kunden werden zu Augenzeugen." mit „Noch vor dem ersten Kontakt."
		   hier oben, „Kein Business ohne Witness." unten im Turm. */}
		{/* PROBE LOKAL (Fred 28.09.): Hero „Eure Expertise ist Programm.", Wort je
		   Zeile; „Kunden werden Augenzeugen." wandert zurueck in den Turm der
		   zweiten Sektion, die kleine Zeile geht mit. */}
		{/* P KLAPPT UM (Fred 29.09.): das P steht zuerst als normales Forma-P
		   (Umriss aus FormaDJRVariable.woff2, wght 900 / opsz 72, per fontTools
		   in den Favicon-Koordinatenraum gesetzt: 395 × 461 gegen 393 × 461 des
		   Favicons, derselbe Schnitt) und klappt nach dem Wisch wie eine
		   Fallblatt-Kachel auf das Parley-P mit dem Playbutton: obere Haelfte
		   faellt (zeigt ALT), untere schwingt hoch (zeigt NEU). Vier Schichten
		   wie in fallblatt.css, hier rein in CSS mit Verzoegerung. */}
		{/* DAS P VON PROGRAMM = das Parley-P (Fred 28.09.): dieselbe Form wie
		   das Favicon (Forma DJR Display Black P, Punze = Playbutton, s.
		   PARLEY_ZEICHEN.md), als Inline-SVG auf Versalhoehe (0,725 em) und
		   Grundlinie gesetzt; der Buchstabe steht fuer Vorleser unsichtbar
		   daneben. Pfad aus public/favicon.svg, Box 393 × 461 Einheiten. */}
		{/* NEUER HERO (Übergabe „Website · Gestaltung“ 10.11.2026, von Rasul
		   freigegeben): drei feste Zeilen, die erste im Grau der Palette;
		   darunter ein Textblock in der Breite der Textspalte. Herleitung im
		   Marketing-Ordner, website/Website_Startseite_Aufbau_Entwurf_2026-11.md
		   (Einträge 10.11.). Vorheriger Hero „Eure Expertise ist Programm.“
		   in der Git-Historie. */}
		<h1><span class="hero-zeile hero-zeile--grau">Überall Experten.</span><span class="hero-zeile">Zeit für den</span><span class="hero-zeile">Videobeweis.</span></h1>
		<p class="hero-text">Expertise beweist sich erst im echten Gespräch. Wir machen die Beweisaufnahme, filmreif und ohne Kamerastress. So werden Entscheider zu Augenzeugen eurer Kompetenz, noch vor dem ersten&nbsp;Kontakt.</p>
		{/* Vorrat (28.09., wieder raus auf Freds Wunsch): Erklaerungs-Zeile unterm
		   Hero in md-Groesse, zuletzt "Aus echten Gespraechen entwickeln wir
		   passende Formate, die das Vertrauen in eure Kompetenz greifbar
		   machen." Alternative Heros desselben Tages: "Das Gespraech ist
		   Programm.", "Euer Gespraech ist Programm." (Umlaut-Zeile brauchte
		   0,07 em Luft nach oben). */}
		</div>
		{/* Seit 26.10.2026 kein Logo unten mehr (Fahne „The Parley“ raus, Fred
		   10.10.); BrandLogo.astro ist nur noch der Schalter, der den
		   Menüknopf ab 50 px Scrollweg erscheinen lässt. Verlauf des Logos
		   (29.08. bis 11.10.) in der Git-Historie und im Zweig
		   archiv/markenbasis-parley-2026-10. */}
		<BrandLogo />
	</header>

	{/* SZENE (07.11.2026, Übergabe „Website · Gestaltung“): Video 16:9 unter
	   dem Hero, später mit Sprechblasen ringsum (nicht in diesem Schritt).
	   PROBE LOKAL mit neutralem Testvideo, nicht live vor Rasuls Abnahme. */}
	<section class="szene" aria-label="Szene">
		<video class="szene-video" src="/test/testvideo-16x9.mp4" autoplay muted loop playsinline></video>
	</section>

	{/* STARTSEITE ALS DUMMY (11.11.2026, Übergabe „Website · Gestaltung“,
	   website/Uebergabe_Startseite_Dummy_auf_dev_2026-11.md im Worktree
	   nice-davinci-84b273): Abschnitte 2, 3, 4, 6, 7, 8, 9 nach der
	   Werkstatt-Vorschau szenen-vorschau.html (ohne Parameter). Testvideo
	   statt Gast-Clips, gelbe Platzhalter bleiben sichtbar. Ab jetzt ist
	   localhost:4321 die Grundlage der Gestaltung. */}

	{/* 2 · Die Beweisaufnahme (die Szene darüber gehört dazu) */}
	<section class="ab ab-zwei-text" aria-labelledby="ab2-titel">
		<p class="ab-label">Die Beweisaufnahme</p>
		{/* Fassung P2 (Aufbau Rasul 12.11.2026, Probe auf localhost); vorher I, davor „Das echte Gespräch wird zu Filmmaterial.“ */}
		<h2 class="ab-titel" id="ab2-titel">Echte Gespräche.<br />Filmreif ohne Kamerastress.</h2>
		<p class="ab-text">Ein Video, dem man sich schwer entziehen kann, überzeugt nicht nur mit seinem Inhalt, sondern mit der Natürlichkeit eines echten Gesprächs wie am Küchentisch. Genau das macht eure Kompetenz spürbar, sogar durch den Bildschirm. Ihr seht keine Kamera, also müsst ihr auch nicht üben, hineinzuschauen. Ihr redet einfach. Wer euch so sieht, hat euch selbst erlebt. Das gibt dem Beweismaterial, das wir daraus bauen, eine andere&nbsp;Kraft.</p>
	</section>

	{/* 3 · Das Beweismaterial: Fließband mit sechs Formaten, endlos von
	   rechts nach links, hält nicht an. Darüber die Namenszeile mit Punkt;
	   Name und Punkt der mittleren Kachel werden weiß (Skript unten). */}
	<section class="fm" aria-labelledby="ab3-titel">
		<p class="ab-label">Das Beweismaterial</p>
		<h2 class="ab-titel" id="ab3-titel">Aus Filmmaterial wird Beweismaterial.</h2>
		<p class="ab-text">Unsere Formatredaktion macht aus der Aufnahme, was euer Format braucht: Videopodcast und Audio-Podcast, kurze Clips mit einer Frage und der Antwort darauf, Zitate, Newsletter und Transkript. Sendefertig für die Kanäle, auf denen eure Entscheider unterwegs sind: LinkedIn, eure Website, Newsletter und Vertrieb. Mit jeder Folge wächst ein Fundus an Beweisstücken, auf den ihr jederzeit zurückgreifen könnt. Im Feed dagegen geht ein einzelner Beitrag schnell unter. Entscheidend ist der Takt.</p>
		<div class="fm-index" data-fm-index>
			{FORMATE.map((f, n) => (
				<span data-n={n}><i></i><b><em>{f.buchstabe}</em>{f.name}</b></span>
			))}
		</div>
		<div class="fm-band" data-fm-band>
			<div class="fm-band-spur">
				{[0, 1].map((runde) => FORMATE.map((f) => (
					<figure class:list={["fm-k", `fm-${f.form}`]} aria-hidden={runde === 1 ? "true" : undefined}>
						<div class="fm-flaeche">
							{f.art === "video" && <video src="/test/testvideo-16x9.mp4" muted loop playsinline autoplay></video>}
							{f.art === "audio" && (
								<div class="fm-audio"><div class="fm-cover"></div><div class="fm-welle">{WELLE.map((w) => <i style={`animation-delay:${w.verz}s;height:${w.hoehe}%`}></i>)}</div></div>
							)}
							{f.art === "zitat" && (
								<div class="fm-zitat"><span class="entwurf fm-zitat-ph">Platzhalter: Zitat erst mit Freigabe</span><q>Ein Satz, der hängen bleibt.</q></div>
							)}
							{f.art === "newsletter" && (
								<div class="fm-papier"><div class="fm-bild"></div><div class="fm-zeilen">{papierZeilen(5, 55).map((b) => <i style={`width:${b}%`}></i>)}</div></div>
							)}
							{f.art === "transkript" && (
								<div class="fm-papier"><div class="fm-zeilen">
									<em></em>{papierZeilen(3, 70).map((b) => <i style={`width:${b}%`}></i>)}
									<em></em>{papierZeilen(4, 40).map((b) => <i style={`width:${b}%`}></i>)}
									<em></em>{papierZeilen(2, 60).map((b) => <i style={`width:${b}%`}></i>)}
								</div></div>
							)}
						</div>
						<figcaption><span class="fm-bs">Beweisstück {f.buchstabe}</span><b>{f.name}</b>{f.text}</figcaption>
					</figure>
				)))}
			</div>
		</div>
		<p class="fm-kanaele">LinkedIn · Website · Newsletter · Vertrieb</p>
		<p class="ab-mitte"><span class="entwurf">Dummy: Testvideo statt Kundenclips, keine Kundenfreigabe. Später ein echtes Kundenbeispiel mit Freigabe.</span></p>
	</section>

	{/* 4 · Die Augenzeugen: Grafik noch nicht entschieden → Platzhalter-Kachel */}
	<section class="ab" aria-labelledby="ab4-titel">
		<p class="ab-label">Die Augenzeugen</p>
		<h2 class="ab-titel" id="ab4-titel">Beweisstücke schaffen Augenzeugen.</h2>
		<p class="ab-text">Aus einem Gespräch im Monat wird ein Takt: Woche für Woche neue Ausschnitte, jeden Monat eine neue Folge. Jeden Tag kommen neue Augenzeugen dazu. Und je mehr Augenzeugen ihr habt, desto glaubwürdiger wird eure Expertise.</p>
		<div class="ab-inhalt"><div class="ab-kachel az-platzhalter"><span class="entwurf">Platzhalter: Augenzeugen-Grafik folgt</span></div></div>
		<div class="ab-inhalt">
			<div class="ab-zahl">41,8</div>
			<p class="ab-zahlzeile">Stunden Zuschauerzeit für ein einziges Format, in fünf Monaten.</p>
			<p class="ab-quelle">Industry Impact (Impact Strategies), LinkedIn, Clips vom 02.04. bis 01.09.2026.<br /><span class="entwurf">Platzhalter: nur mit Einverständnis von Impact Strategies</span></p>
		</div>
		<div class="ab-inhalt ab-uhren"><MultiOutputKacheln nurUhr /></div>
		<p class="ab-hinweis">Bleibt ihr im Takt, wird eure Stimme in der Branche mit der Zeit gehört.</p>
	</section>

	{/* 6 · Die Befragung: Akkordeon nach BBH /offices/bbh-studios, hell */}
	<section class="ab ab-hell" aria-labelledby="ab6-titel">
		<p class="ab-label">Die Befragung</p>
		<h2 class="ab-titel" id="ab6-titel">Was ihr uns oft fragt.</h2>
		<div class="akk" data-akk>
			{FRAGEN.map(([frage, antwort]) => (
				<div class="akk-item">
					<button type="button" class="akk-kopf" aria-expanded="false"><span class="akk-frage">{frage}</span><span class="akk-zeichen" aria-hidden="true">+</span></button>
					<div class="akk-inhalt"><div><p>{antwort}</p></div></div>
				</div>
			))}
		</div>
	</section>

	{/* 7 · Die Kosten */}
	<section class="ab" aria-labelledby="ab7-titel">
		<p class="ab-label">Die Kosten</p>
		<h2 class="ab-titel" id="ab7-titel">Ihr bezahlt, was ihr braucht.</h2>
		<p class="ab-text">Je Gespräch die Aufnahme mit allem, was zur Folge gehört. Je Beitrag der fertige Ausschnitt samt Text. Und monatlich die Formatredaktion, die euren Kanal führt: Redaktion, Ausspielung, Kommentare und Monatsbericht. Was das für euer Format heißt, rechnen wir am besten gemeinsam durch.</p>
		<div class="ab-inhalt ab-drei">
			{PREISE.map(([name, satz, je]) => (
				<div class="ab-preis"><b>{name}</b><span class="ab-betrag">[Preis offen]{je}</span><p>{satz}</p></div>
			))}
		</div>
		<p class="ab-mitte"><span class="entwurf">Platzhalter: Preise offen</span></p>
	</section>

	{/* 8 · Zur Person */}
	<section class="ab" aria-labelledby="ab8-titel">
		<p class="ab-label">Zur Person</p>
		<h2 class="ab-titel" id="ab8-titel">Ich stelle die Fragen.</h2>
		<p class="ab-text">Ich bin Fred Eric Eckert. Mit Parley Film bringe ich Experten ins Gespräch, im Blickkontaktstudio in Karlsruhe, mit dem mobilen Studio bei euch oder in einem Studio, das wir bei euch einrichten. Am liebsten lerne ich euch persönlich kennen.</p>
		<p class="ab-mitte"><span class="entwurf">Platzhalter: Ich-Text aus der Gesamtgeschichte einarbeiten</span></p>
		<div class="ab-inhalt ab-zwei">
			<div class="ab-kachel ab-foto"><span>[Foto Fred]</span><span class="entwurf">Platzhalter: Foto</span></div>
			<div class="ab-kachel ab-foto"><span>[Foto Studio Lotzbeckstraße]</span><span class="entwurf">Platzhalter: Foto</span></div>
		</div>
	</section>

	{/* 9 · Der Termin */}
	<section class="ab ab-letzter" aria-labelledby="ab9-titel">
		<p class="ab-label">Der Termin</p>
		<h2 class="ab-titel" id="ab9-titel">Euer Gespräch fängt hier an.</h2>
		<p class="ab-text">Kommt zum Studiotermin, schaut euch das Blickkontaktstudio an und erzählt uns, worüber ihr sprechen wollt. In 30 Minuten wisst ihr, welches Format zu euch passt. Online geht es auch.</p>
		<p class="ab-mitte ab-knopfzeile"><a class="ab-knopf" href="/termin">Let’s Parley</a></p>
	</section>

	{/* BIS ZUR BESTÄTIGUNG AUSGEBLENDET (Dummy 11.11.2026, offene Aufgaben 4
	   und 12 der Gestaltung): Plädoyer, „Die Multiplikation eines Gesprächs“
	   und die Format-Tafel stehen nicht mehr auf der Startseite, bleiben aber
	   im Code. Zurückholen: ALTE_SEKTIONEN = true. */}
	{ALTE_SEKTIONEN && (<Fragment>

	{/* "Der Paragraph" (Fred 2026-06-14): Fließtext über die ganze Breite,
	   Paragraph-Größe (gleiche BBH-Lead-Typo wie bisher) — ersetzt die
