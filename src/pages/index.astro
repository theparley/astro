---
import Layout from "../layouts/Layout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import SplitFlap from "../components/SplitFlap.astro";
import MultiOutputTafel from "../components/MultiOutputTafel.astro";

// ZIEL→FORMAT-TAFEL (Fred 13.09., Probe-Einbau "nur dass ich es mal sehe"):
// Ziel links, Pfeil, Format rechts — BEWUSST EIN SplitFlap-Board statt zwei
// nebeneinander: zwei getrennte Boards laufen zeitlich auseinander (jeder
// Zustandswechsel dauert je nach Trommel-Distanz unterschiedlich lang), und
// dann stünde ein falsches Paar nebeneinander. Ein Board = immer synchron;
// die Zwei-Tafeln-Optik machen die festen Feldbreiten + der konstante Pfeil
// (nicht in der Trommel → klappert nie, steht wie eine Stanze in der Mitte).
// Ziel-Wortlaute = UNGELOCKTER Vorrat aus dem Website-Brief (Ziel→Format-
// Paare, MBS-Kaufmotive-Muster) — hier bewusst kurz gehalten, damit die
// Tafel nicht zu breit wird; am Objekt schärfen.
// Vierte Iteration (Fred 13.09. spät): Ziel-Zeilen und Pfeil VERWORFEN —
// die Tafel rattert NUR die Formate durch, eine Zeile. Dafür übernimmt sie
// die Aufzählungs-Funktion des Paragraph-Schlusssatzes (die Frage-Liste
// dort entfällt): mehr Formate ohne Satz-Platzkosten, und das Durchrattern
// selbst erzählt "es gibt mehr als eines". Liste = Sortiment + Kandidaten
// aus der Format-Recherche 13.09. (UNGELOCKT — Fred streicht/ergänzt).
// Fünfte Iteration (Fred 13.09. nacht, Wort-Diktat): Gattungs-Wörter, die
// jeder Leser sofort kennt — "Kundentestimonial" voll ausgeschrieben
// (Produktname), "Live-Webinar" statt Webinar (das "Live" adressiert Freds
// Billig-Vorbehalt und zieht die Grenze zur Folien-Konserve), "Interview"
// und "Online-Event" neu (Verstehens-Wörter; dass "Interview" kein
// SUCH-Begriff ist, ist hier egal — die Tafel ist eine Verstehens-Fläche).
// Sechste Iteration (Fred 13.09. nacht): Tafel MAXIMAL DREIZEILIG, bei
// Mehrwort-Formaten steht jedes Wort auf einer eigenen Zeile (Leerzeichen
// = Zeilentrenner; Bindestrich-Komposita bleiben EIN Wort/eine Zeile).
// padState() der Komponente zentriert kürzere Zustände vertikal im
// 3-Zeilen-Raster. "THOUGHT LEADER INTERVIEW" ersetzt das nackte
// "INTERVIEW" (Thought Leadership = bestätigtes Kunden-Vokabular).
const tafelFormate = [
	"VIDEOPODCAST",
	"KUNDENTESTIMONIAL",
	"LIVE-WEBINAR",
	"EXPERTENTALK",
	"ONLINE-EVENT",
	"RECRUITING-VIDEO",
	"LIVE Q&A-SESSION",
	"MITARBEITERINTERVIEW",
];
const tafelZustaende = tafelFormate.map((format) => format.split(" "));

// Produkte-Zeile (Website-Brief, gelockte Treppe 29.08. spät) — die vier
// buchbaren Formate als knappe Zeile nach dem Clip-Beweis. Noch keine
// Produktseiten live (Phase 1), deshalb reiner Text ohne Links.
const produkteZeile = "Videopodcast. Webinar. Clip. Kundentestimonial.";

// Essenz-Zeile in der zweiten Hälfte der Plädoyer-Sektion (Website-Brief,
// Fred 29.08. nachts): ausgeschriebener Satz statt Zahlen-Paar — "Ein
// Gespräch mit tausend Augenzeugen." ersetzt "1 Gespräch. 1000 Augenzeugen.",
// die Zahlen-Fassung bleibt als Vorrat für Beiträge/Splitflap dokumentiert.
// Reiner Wortlaut zur Referenz/für einen späteren Tausch — die tatsächliche
// Darstellung erzwingt jetzt manuelle Umbrüche (siehe Markup unten,
// Live-Feedback Fred), ist also nicht mehr ein reines Ein-Zeilen-Edit.
const soloLine = "Ein Gespräch mit tausend Augenzeugen.";
// Vorrat/Alternativen, noch nicht entschieden: "1 Gespräch. 1000 Augenzeugen."
// (Zahlen-Fassung, für Beiträge/Splitflap), "KI ist kein Augenzeuge."
---

<Layout title="Start" gateMenuBehindHero>
	<header class="hero">
		{/* Hero-Tausch (Fred 30.08. spät): der Dreizeiler aus der Essenz-Spalte
		   wird der Hero ("echt starker Hero"), "Kein Business ohne Witness."
		   wandert dafür in die Essenz-Spalte der Plädoyer-Sektion. Drei Sätze =
		   drei Zeilen (Spans mit display:block statt text-balance — die
		   Umbrüche sind hier Bedeutung, nicht Layout). */}
		<div class="hero-headline">
			{/* Hero-Rücktausch (Fred 2026-06-14): "Kein Business ohne Witness."
			   ist wieder der Hauptclaim groß oben — in den zwei bewährten
			   Zeilen. Der Dreizeiler ("Ihr habt die Expertise. / Wir
			   verteidigen sie. / Mit Augenzeugen.") ist raus; sein Inhalt lebt
			   sinngemäß im neuen Paragraph darunter ("Wir übernehmen die
			   Verteidigung eurer Expertise … Augenzeuge"). */}
		<h1><span>Kein Business</span><span>ohne Witness.</span></h1>
		</div>
		{/* Logo bleibt Markenpräsenz OHNE Menü-Funktion (Website-Brief
		   "Entscheidung 29.08."), ist aber wieder fixiert unten Mitte und
		   klappt scroll-getrieben ein (Zweite Nachbesserung 29.08. spät,
		   siehe Kommentar in BrandLogo.astro) — die interaktive
		   Kachel-Menü-Verwandlung des Logos bleibt archiviert in
		   TileMenu.astro, nur die reine Scroll-Dock-Choreografie ist zurück. */}
		<BrandLogo />
	</header>

	{/* "Der Paragraph" (Fred 2026-06-14): Fließtext über die ganze Breite,
	   Paragraph-Größe (gleiche BBH-Lead-Typo wie bisher) — ersetzt die
	   zweigeteilte Plädoyer-Sektion (Akten-Form + Essenz-Spalte). "Kein
	   Business ohne Witness." ist zurück im Hero; die Akten-Fassung des
	   Plädoyers und der Dreizeiler leben in Brief-Fortschritt + Git-Historie
	   (bewusst kein Code-Vorrat). Wortlaut = Freds Diktat, wörtlich
	   (neue Fassung 2. Runde 14.06.: KI-Generalverdacht, videobasierte
	   Formate, Schluss verkürzt auf den Augenzeugen-Satz). */}
	<section class="paragraph">
		<p class="plaedoyer-text">Aus Kunden werden Augenzeugen eurer Expertise. Noch vor dem ersten Kontakt.</p>
		<p class="plaedoyer-text">Fachwissen als Texte, Slides und Videos gibt es heute auf Knopfdruck. Plötzlich ist jeder Experte.</p>
		<p class="plaedoyer-text">Der Kunde braucht einen Vertrauensbeweis: einen Moment gelebter Expertise. Den liefern echte Gespräche. Denn Kompetenz zeigt sich in unmittelbaren Antworten auf aktuelle Fragen.</p>
		{/* "ohne Kamerastress" statt "mit Video" (Fred 13.09. nacht): die
		   Kamera sagt Video, ohne es zu sagen — das Wort "Video" steht damit
		   wieder NUR auf der Knopfdruck-Seite (bewusste Eigenschaft, s. Brief);
		   zugleich steht die gelockte Formel "filmreif ohne Kamerastress"
		   wörtlich im Kopf und trägt beide Filmreif-Schichten (Umsetzung +
		   Situation der Sprecher). */}
		<p class="plaedoyer-text">Diese Momente fangen wir mit unserer Blickkontakt-Aufnahmetechnik ein, filmreif und ohne Kamerastress, und skalieren sie auf alle Kanäle.</p>
	</section>

	{/* FORMAT-TAFEL (Fred 13.09. spät, vierte Iteration): rattert die
	   Formate durch und ÜBERNIMMT die Aufzählungs-Funktion des Paragraph-
	   Schlusssatzes (die Frage-Liste dort ist raus) — mehr Formate ohne
	   Satz-Platz, das Durchrattern erzählt "mehr als eines". Der
	   Formatberatung-Knopf rutscht mit UNTER die Tafel (Fred): Satz → Tafel
	   (die Auswahl) → Knopf (die Tür). Wortlaute/Tempo ungelockt. */}
	{/* Multi-Output-Sektion (Fred 2026-09-13/14): "Was aus einer Stunde
	   Gespräch entstehen kann" — als MultiOutputTafel.astro portiert aus dem
	   abgenommenen Entwurf (Website-Brief: Sektion "Der Multi-Output echter
	   Gespräche" + BAU-ANWEISUNG). Erzähl-Reihenfolge: Paragraph (endet auf
	   dem Skalieren) → DIESE Sektion (das Ergebnis) → Formatfrage mit Tafel
	   + Formatberatung (der erste Schritt). */}
	<MultiOutputTafel />


	<section class="ziel-format-tafel">
		{/* Formatfrage-Zeile (Fred 2026-09-13, Wortlaut = ARBEITSSTAND aus
		   seinem Diktat "wer welches Gespräch mit wem führt ist eine
		   Formatfrage, die man im ersten Schritt klären muss"): */}
		<p class="tafel-intro">Wer führt welches Gespräch mit wem? Das ist eine Formatfrage. Und sie ist der erste Schritt.</p>
		{/* flipMs 30 (Fred 13.09.: "Flappern schneller") — Dauer EINER
		   Klapp-Bewegung; Default war 55. Noch schneller geht bis ~15,
		   darunter frisst der Browser Frames. */}
		<SplitFlap lines={tafelZustaende} flipMs={30} holdMs={2400} />
		{/* In-Flow-Tür (Fred 2026-09-13, "am Ende könnte ein Knopf stehen"):
		   "Formatberatung" löst "Die Wahl des passenden Formats ist der erste
		   Schritt" wörtlich ein. Wortlaut verspricht ein ERGEBNIS (Klarheit
		   übers Format), keinen Aufwand (Termin). Ziel /termin. */}
		<a class="format-cta" href="/termin">Formatberatung</a>
	</section>

	{/* Clip VOLLBREIT (Fred 2026-06-15, "übernehmen wir von BBH"): deren
	   Startseiten-Video läuft randlos von Kante zu Kante — kein .wrap, kein
	   Seitenabstand. */}
	<section class="proof">
		<div class="clip-placeholder">
			<span>Clip folgt</span>
		</div>
	</section>

	{/* Bausteine-Sektion (Fred 2026-06-15 abends, Demo-Runde bausteine-demo.html,
	   Entscheid "d2"): DREI Medien-Kacheln nebeneinander (BBHs visual-grid-Muster,
	   16px Fuge, auf drei verbreitert; Panel-Grund, 4:5) — nebeneinander liest
	   das Auge sie als EIN Ensemble, das ein Problem löst (Freds Beobachtung;
	   gestapelt wirkten sie als Abfolge). Große Sektions-Überschrift nach
	   BBH-Regel (KEINE Eyebrows — live verifiziert: BBH kennt nur große
	   Versal-Sektionszeilen ODER kleine Überschriften direkt am Text, nie
	   klein-über-groß). Namen ohne Artikel; "Studios" PLURAL (drei Formen:
	   Blickkontaktstudio Karlsruhe / mobiles Studio / Inhouse-Bau beim
	   Kunden — nie aufs feste Studio verengen, hat schon einen Auftrag
	   gekostet; "Aufnahme" als Name verworfen, Zuschalt-Fälle laufen unter
	   Regie). Unterschriften erzählen die Zeitachse: zuerst → live → danach.
	   Die Sektion beantwortet den Filmreif-Cliffhanger des Paragraphs. */}
	<section class="bausteine">
		<h2 class="bausteine-titel">Wie wir das machen</h2>
		<div class="bausteine-grid">
			<div class="baustein">
				<div>
					<h3>Studios</h3>
					<p class="baustein-sub">Das Gespräch zuerst</p>
				</div>
				<p class="baustein-text">Zuerst stellen wir das echte Gespräch her, dann läuft die Aufnahme. Im Blickkontaktstudio in Karlsruhe, mit dem mobilen Studio bei euch oder im Inhouse-Studio, das wir euch bauen.</p>
			</div>
			<div class="baustein">
				<div>
					<h3>Regie</h3>
					<p class="baustein-sub">Live, während ihr sprecht</p>
				</div>
				<p class="baustein-text">Während ihr sprecht, hält die Regie die Technik unsichtbar, den Inhalt auf Kurs und die Wirkung im Blick.</p>
			</div>
			<div class="baustein">
				<div>
					<h3>Redaktion</h3>
					<p class="baustein-sub">Die Formatredaktion danach</p>
				</div>
				<p class="baustein-text">Aus der Aufnahme werden eure Formate: Videopodcast, Webinar, Clip, Kundentestimonial. Jede Produktion liefert ihr Stück, inklusive Text.</p>
			</div>
		</div>
	</section>

	{/* Produkte-Zeile + In-Flow-CTA weiter draußen (Fred 30.08. nachts,
	   "erstmal komplett raus"); Wortlaut der Produkte-Zeile lebt in der
	   produkteZeile-Konstante oben (Vorrat), der CTA-Wortlaut im
	   Website-Brief (Konversions-Kapitel). Nächste Treppen-Stufen laut
	   Brief: Pakete, dann Tür. */}

</Layout>

<style>
	/* Randabstand 1:1 von BBH übernommen (live gemessen): 16px bis 1024px
	   Breite, danach 32px — statt unserem vorherigen festen 24px ohne
	   Zwischenschritt. Gilt für .wrap UND .hero-headline, damit große Texte
	   nie ganz an den Bildschirmrand gehen. */
	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 1024px) {
		.wrap {
			padding: 0 32px;
		}
	}

	/* Ziel→Format-Tafel (Probe 13.09.): mittig, großzügige Luft; auf schmalen
	   Viewports scrollt die Tafel horizontal, statt das Raster zu brechen
	   (Probe-Kompromiss — die Mobil-Form ist eine eigene Objekt-Entscheidung,
	   Kandidat: zwei Zeilen übereinander statt links/rechts). */
	.tafel-intro {
		font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		max-width: 46rem;
		text-align: center;
		margin: 0;
	}

	.ziel-format-tafel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(32px, 5vh, 56px);
		padding: clamp(48px, 8vh, 96px) 16px;
		overflow-x: auto;
	}

	.hero {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.hero-headline {
		/* Hero-Korrektur nach BBHs Statement-Rezept (Fred 30.08., live auf der
		   BBH-Startseite gemessen — deren Original-Hero ist ein vollbreites
		   Video, die SCHRIFT-Statements laufen aber nie bis an den Rand):
		   (1) site-container-Deckel 1728px, mittig — bei 1920er-Viewport
		   entstehen dadurch allein 96px Luft je Seite, plus 32px px-site-
		   Padding = 128px gemessener Zeilen-Einzug. (2) text-center (BBHs
		   Statements sind zentriert, nicht linksbündig — daher wirkte unseres
		   "bis an den Rand gezogen"). */
		width: 100%;
		max-width: 1728px;
		margin: auto;
		padding: 0 16px;
		text-align: center;
		/* Optischer Ausgleich (Fred 30.08.): geometrisch war der Block exakt
		   mittig (320px oben wie unten, gemessen), wirkte aber leicht zu tief —
		   Unterlängen wiegen unten schwerer, und das fixierte Logo füllt die
		   untere Bildhälfte zusätzlich. Leichter Hub nach oben, skaliert mit
		   der Viewport-Höhe (~16px bei 1080er-Höhe). */
		transform: translateY(-2.5vh);
		/* Schrift skaliert wieder mit dem CONTAINER (cqw), nicht dem Viewport —
		   dadurch füllt die Zeile die Deckel-Breite exakt aus (Fred 30.08.:
		   "größer, bis sie bei der Breite ist") und hört bei 1728px einfach
		   auf zu wachsen: ab da entsteht die BBH-Luft (96px Deckel-Rand + 32px
		   Padding = 128px Zeilen-Einzug bei 1920, exakt BBHs Messwert). */
		container-type: inline-size;
	}

	@media (min-width: 1024px) {
		.hero-headline {
			padding: 0 32px;
		}
	}

	.hero h1 {
		/* Wie auf bartleboglehegarty.com: text-wrap:balance statt fester <br>-Umbrüche.
		   Der Browser entscheidet selbst, wie viele Zeilen und welche Wortgruppen —
		   kein manuelles Umschalten zwischen Zeilenzahlen nötig.
		   Größe füllt die Zeilen auf die Container-Breite; der Container ist
		   bei 1728px gedeckelt, die Schrift wächst ab da nicht mehr mit und
		   die BBH-Randluft entsteht von selbst. Hero-Rücktausch (Fred
		   2026-06-14): "Kein Business / ohne Witness." ist zurück — damit gilt
		   wieder die historische Kalibrierung 15.6cqw (längste Zeile "Kein
		   Business", ~97% Container-Auslastung; für den zwischenzeitlichen
		   Dreizeiler galten 9.6cqw). Zeilenhöhe bleibt 0.92 statt BBHs 0.82:
		   deren Statements sind VERSAL (keine Unterlängen), unsere
		   Mischschrift würde bei 0.82 kollidieren. */
		font-size: 15.6cqw;
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.01em;
	}

	.hero h1 span {
		/* Beide Zeilen WISCHEN gemeinsam herein wie der Seitenübergang
		   (Fred 2026-06-14: "der ganze Text mit diesem schwarzen Swipe von
		   links nach rechts" — die frühere Von-oben-Animation der zweiten
		   Zeile ist raus): gleiche Technik (clip-path legt von links frei),
		   gleiche Dauer (800ms) und exakt PageWipes symmetrische BBH-Kurve. */
		display: block;
		animation: hero-line-wipe 800ms cubic-bezier(0.76, 0, 0.24, 1) 100ms both;
	}

	@keyframes hero-line-wipe {
		/* Oben/unten -0.35em Luft im Zuschnitt (Fred-Befund 30.08. nachts):
		   die Zeilenhöhe (0.92) ist enger als die Schrift — Unterlängen wie
		   das g von "verteidigen" ragen aus der Satz-Box heraus, und ein
		   Zuschnitt auf exakt die Box (inset 0) schnitt sie ab: an der Stelle
		   erschien das Seiten-Schwarz "über" dem g. Mit negativem Inset
		   wischt der Effekt nur horizontal und lässt Über-/Unterlängen in
		   Ruhe — auch im Endzustand (fill: both). */
		from {
			clip-path: inset(-0.35em 100% -0.35em 0);
		}
		to {
			clip-path: inset(-0.35em 0 -0.35em 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero h1 span {
			animation: none;
		}
	}

	/* "Der Paragraph" (Fred 2026-06-14, zweite Runde: "Container breiter,
	   zu abgeschnitten — über die ganze Breite"): bewusst KEIN .wrap und keine
	   max-width auf den Absätzen — die Zeilen laufen bis auf den BBH-Randabstand
	   an die Bildschirmkanten. Fred bricht selbst runter, wie weit das bleibt;
	   die 46rem-Lesebremse von .plaedoyer-text ist hier deshalb aufgehoben. */
	.paragraph {
		padding: 56px 16px 64px;
	}

	@media (min-width: 1024px) {
		.paragraph {
			padding: 56px 32px 64px;
		}
	}

	/* Sichtungs-Runden (Fred, lokal — ab hier NICHT mehr pushen, Design wird
	   erst in HTML direkt geklärt): aktuell 50% der Breite, MITTIG im
	   Bildschirm zentriert. */
	.paragraph .plaedoyer-text {
		max-width: 50%;
		margin-left: auto;
		margin-right: auto;
	}

	/* Tür-Knopf unterm Paragraph: Kachel-Sprache des Menü-Systems (helle
	   Fläche, eckig, versal, BBH-Hover-Schleier), mittig unter der
	   50%-Textspalte. */
	.format-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		width: min(272px, 100%);
		height: 88px;
		margin: 40px auto 0;
		background: var(--tile-surface);
		color: var(--black);
		font-weight: 900;
		font-size: 22px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		background-image: linear-gradient(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.15));
		background-repeat: no-repeat;
		background-position: left center;
		background-size: 0% 100%;
		transition: background-size 250ms ease-in-out;
	}

	.format-cta:hover {
		background-size: 100% 100%;
	}

	.plaedoyer-text {
		max-width: 46rem;
		/* Referenz-Wechsel (Fred 30.08., Vergleich /offices/bbh-studios):
		   BBHs LEAD-Absätze sind größer als das About-Body-Rezept, das hier
		   vorher galt (20→26px) — live an zwei Breiten gemessen (921px:
		   23.38px / 1920px: 31.11px, Fluid-Deckel bei 1728) und daraus die
		   Gerade rekonstruiert: clamp(18px, 14.55px + 0.9583vw, 31.11px).
		   Zeilenhöhe dort 1.3 (nicht 1.2), Laufweite -0.02em unverändert. */
		font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		line-height: 1.3;
		/* Laufweiten-Korrektur (Fred 2026-06-15, "minimal zu eng"): BBH fährt
		   -0.02em auf GEIST SANS — Forma DJR läuft von Haus aus enger zu,
		   dasselbe em-Maß drückt hier spürbar mehr. Halbe Stufe zurück. */
		letter-spacing: -0.01em;
		color: var(--white);
	}

	/* Absatz-Abstand — Referenz-Korrektur (Fred 2026-06-14, "kommt mir zu
	   groß vor"): live auf BBHs /offices/bbh-studios nachgemessen — deren
	   Lead-Absatz-Gruppe nutzt ein flaches space-y-6 = 24px auf ALLEN
	   Breiten (bei 26,8px Schrift → Verhältnis 0,9), nicht das
	   space-y-5/md:space-y-8 (20/32px) der About-Seite, das hier vorher
	   galt. 32px ab Desktop war dadurch spürbar luftiger als das Original.
	   (Globales p{margin:0} in Layout.astro würde die Absätze sonst
	   zusammenkleben lassen.) */
	.plaedoyer-text + .plaedoyer-text {
		margin-top: 1.5rem;
	}

	.proof {
		padding: 24px 0 64px;
		/* vollbreit: die Sektion liegt außerhalb von .wrap, das Video füllt
		   die komplette Viewport-Breite (BBH-Startseiten-Muster). */
	}

	.clip-placeholder {
		aspect-ratio: 16 / 9;
		width: 100%;
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gray);
		font-size: 0.9rem;
	}

	/* Bausteine-Sektion (Maße aus der Demo-Runde bausteine-demo.html, D2):
	   eigener Container auf Plädoyer-Deckelbreite 1728px; Kacheln = BBHs
	   visual-grid (16px Fuge), Panel-Grund, Hochformat 4:5; Kachel-Schrift
	   an der KACHELbreite (cqw), kalibriert auf "Redaktion" als längste
	   Zeile. Unter 800px stapeln die Kacheln. */
	.bausteine {
		max-width: 1728px;
		margin: 0 auto;
		padding: 24px 16px 96px;
	}

	@media (min-width: 1024px) {
		.bausteine {
			padding: 24px 32px 96px;
		}
	}

	.bausteine-titel {
