---
import Layout from "../layouts/Layout.astro";
import BrandLogo from "../components/BrandLogo.astro";

// Produkte-Zeile (Website-Brief, gelockte Treppe 29.08. spät) — die vier
// buchbaren Formate als knappe Zeile nach dem Clip-Beweis. Noch keine
// Produktseiten live (Phase 1), deshalb reiner Text ohne Links.
const produkteZeile = "Videopodcast. Webinar. Clip. Kundentestimonial.";

// Essenz-Zeile in der zweiten Hälfte der Plädoyer-Sektion (Website-Brief,
// Fred 29.08. nachts): ausgeschriebener Satz statt Zahlen-Paar — "Ein
// Gespräch mit tausend Augenzeugen." ersetzt "1 Gespräch. 1000 Augenzeugen.",
// die Zahlen-Fassung bleibt als Vorrat für Beiträge/Splitflap dokumentiert.
// Reiner Wortlaut zur Referenz/für einen späteren Tausch — die tatsächliche
// Darstellung erzwingt jetzt manuelle Umbrüche (siehe Markup unten,
// Live-Feedback Fred), ist also nicht mehr ein reines Ein-Zeilen-Edit.
const soloLine = "Ein Gespräch mit tausend Augenzeugen.";
// Vorrat/Alternativen, noch nicht entschieden: "1 Gespräch. 1000 Augenzeugen."
// (Zahlen-Fassung, für Beiträge/Splitflap), "KI ist kein Augenzeuge."
---

<Layout title="Start" gateMenuBehindHero>
	<header class="hero">
		{/* Hero-Tausch (Fred 30.08. spät): der Dreizeiler aus der Essenz-Spalte
		   wird der Hero ("echt starker Hero"), "Kein Business ohne Witness."
		   wandert dafür in die Essenz-Spalte der Plädoyer-Sektion. Drei Sätze =
		   drei Zeilen (Spans mit display:block statt text-balance — die
		   Umbrüche sind hier Bedeutung, nicht Layout). */}
		<div class="hero-headline">
			{/* Drei-Sätze-Fassung bestätigt (Fred 30.08. nachts, nach Probe der
		   Ein-Satz-Variante "Wir verteidigen eure Expertise mit Augenzeugen."
		   — die war "eindrucksvoller", aber die drei Sätze haben "die bessere
		   Wirkung"; Ein-Satz-Fassung bleibt Vorrat für Flächen mit nur einer
		   Zeile). */}
		<h1><span>Ihr habt die Expertise.</span><span>Wir verteidigen sie.</span><span>Mit Augenzeugen.</span></h1>
		</div>
		{/* Logo bleibt Markenpräsenz OHNE Menü-Funktion (Website-Brief
		   "Entscheidung 29.08."), ist aber wieder fixiert unten Mitte und
		   klappt scroll-getrieben ein (Zweite Nachbesserung 29.08. spät,
		   siehe Kommentar in BrandLogo.astro) — die interaktive
		   Kachel-Menü-Verwandlung des Logos bleibt archiviert in
		   TileMenu.astro, nur die reine Scroll-Dock-Choreografie ist zurück. */}
		<BrandLogo />
	</header>

	{/* "Das Plädoyer" (Website-Brief, GELOCKT 29.08. spät, FINAL 29.08. nachts
	   "zweiter Schliff: Anklage-Einstieg", Layout-Update 29.08. spät
	   ZWEIGETEILT) — eine Hälfte trägt den finalen 4-Satz-Wortlaut
	   (Anklage-Einstieg "Der Generalverdacht:", Anrede jetzt ihr/euch statt
	   du, siehe Brief-Begründung), die andere Hälfte die Essenz GROSS
	   (bisherige eigenständige Solo-Zeilen-Sektion, siehe soloLine oben —
	   entfällt dadurch als eigene Sektion). Reihenfolge im Markup =
	   Reihenfolge mobil (untereinander): Text vor Essenz, siehe Begründung
	   in der .plaedoyer-Regel unten.

	   Eyebrow-Label "Unser Eröffnungsplädoyer" ENTFERNT (spätes Auftrags-
	   Update, noch nicht im Brief nachgezogen zum Zeitpunkt dieses Commits —
	   siehe Fortschritts-Eintrag): "Eröffnungsplädoyer" ist im deutschen
	   Recht kein sauberer Begriff (ein Plädoyer ist der Schlussvortrag,
	   "Eröffnungsplädoyer" ein US-Import) — Fred will kein unsauberes
	   Rechtswort auf der Seite. Absatz beginnt jetzt direkt mit "Der
	   Generalverdacht: …", trägt den Gerichts-Register-Einstieg also
	   weiterhin im ersten Satz selbst. */}
	<section class="plaedoyer wrap">
		{/* Seiten-Tausch (Fred 31.08.): "Kein Business ohne Witness." wandert
		   nach LINKS, der Plädoyer-Text nach RECHTS — Markup-Reihenfolge =
		   mobile Stapel-Reihenfolge, die Essenz steht mobil also jetzt oben. */}
		<div class="plaedoyer-half plaedoyer-half--essence">
			{/* Rollentausch in der Essenz-Hälfte (Fred 30.08.): die
			   Anschlusszeile "Ihr habt die Expertise. Wir verteidigen sie."
			   wandert aus der Text-Spalte hierher und wird das GROSSE
			   Statement (zwei Sätze = zwei Zeilen); "Ein Gespräch mit tausend
			   Augenzeugen." rückt darunter als Unterschrift in klein. Der
			   frühere Dreizeiler ("Ein Gespräch" / "mit tausend" /
			   "Augenzeugen.") ist damit Geschichte — die Größen-Historie in
			   den Style-Kommentaren unten gilt sinngemäß weiter, nur mit
			   längeren Zeilen und deshalb neu kalibriertem cqw-Koeffizienten. */}
			{/* Finale Fassung (Fred 30.08.): "mit Augenzeugen" ins große
			   Statement, die Unterschrift "Ein Gespräch mit tausend
			   Augenzeugen." entfällt dafür ganz (bleibt als Vorrats-Zeile für
			   Beiträge/Splitflap dokumentiert, siehe soloLine oben). Drei
			   Zeilen mit bewusst gesetzten Umbrüchen; längste bleibt "Ihr habt
			   die Expertise.", die 8.3cqw-Kalibrierung gilt also weiter. */}
		{/* "Mit Augenzeugen." als EIGENER Satz (Fred-Zuruf direkt danach):
			   der Nachklapp bekommt Punkt + Großschreibung — drei vollwertige
			   Schläge statt Satz mit Umbruch. */}
		{/* Hero-Tausch (Fred 30.08. spät): der Dreizeiler ist zum Hero
			   aufgestiegen, "Kein Business ohne Witness." übernimmt dafür die
			   Essenz-Spalte — in den zwei Zeilen, in denen es als Hero
			   umbrach. Die Abwechsel-Regel bleibt gewahrt: beide Sätze stehen
			   nie auf derselben Fläche… jetzt eben in getauschten Rollen. */}
			<p class="essence-line">Kein Business</p>
			<p class="essence-line">ohne Witness.</p>
		</div>
		<div class="plaedoyer-half plaedoyer-half--text">
			{/* Neuer Dreiklang (Wording-Session 30.08.): echte Verfahrenslogik
			   Verdacht → Verteidigung → Urteil, alle drei in derselben Bauform
			   (Etikett, Doppelpunkt, Inhalt — Zeile 3 bricht die Form bewusst,
			   weil das Urteil kein Etikett trägt, sondern gefällt wird). Ersetzt
			   die 3-Satz-Fassung mit "…skalieren wir" — kein "wir" mehr in der
			   Treppe, The Parley tritt erst nach dem Urteil auf (Anschlusszeile
			   noch offen, Kandidaten in der Wording-Session besprochen). Die
			   »…«-Anführung der alten Zeile 1 ist der einheitlichen Bauform
			   gewichen — falls die Anklage wieder als Zitat markiert werden
			   soll, einfach wieder ergänzen. */}
		{/* Zweizeilige Bauform (Fred 30.08.): Etikett auf eigener Zeile,
			   Inhalt darunter — der Doppelpunkt wird zum Zeilenschluss, wie
			   eine Akten-Überschrift über ihrem Eintrag. */}
		{/* "Der Gegenbeweis" (Fred 30.08.): Verteidigung + Beweis zu EINER
			   Stufe verschmolzen — echtes Rechtswort, spiegelt den General-
			   verdacht direkt (Verdacht ↔ Gegenbeweis ↔ Urteil). Inhalt trägt
			   jetzt auch das Video, über die Gesetzesformel "in Bild und Ton"
			   (§ 58a/247a StPO) statt "videobasiert" (Lastenheft-Sprache). */}
		{/* Genitiv-Etiketten (Fred 30.08. spät): jede Stufe bekommt ihren
			   Akteur — der Markt verdächtigt, euer Marketing beweist, das
			   Publikum urteilt. Zeile 3 musste dafür umgebaut werden ("Fällen
			   die einzelnen Zuschauer" hätte das Publikum doppelt benannt). */}
		{/* Personalisierung (Fred 30.08. spät): durchgehende eure/eurer-
			   Anaphora — die Expertise, die Experten, das Marketing, das
			   Publikum, der Auftrag: alles gehört dem Leser. Beim Urteils-
			   Etikett bewusst "eures Publikums" statt "eurer Kunden" (Freds
			   Alternativ-Idee): das Urteil fällt VOR der Kundwerdung — wer da
			   urteilt, ist noch kein Kunde, sondern entscheidet gerade, ob er
			   einer wird. "Kunden" würde die Pointe vorwegnehmen und den
			   Urteilskreis auf Bestandskunden verengen. */}
		{/* Abschwächung (Fred 30.08. abends): "ist vorgetäuscht" sprach ein
			   fertiges Urteil — ein Verdacht ist aber gerade KEINE Tatsachen-
			   behauptung. "könnte … sein" macht die Zeile juristisch sauber
			   (Verdacht = Möglichkeit) und nimmt die Härte raus, ohne den
			   Stich zu verlieren. */}
		{/* Rollen-Umbau (Fred 30.08. nachts): das MARKETING wandert aus der
			   Verteidiger-Rolle in die Anklage ("durch Marketing mit KI
			   vorgetäuscht") — der Gegenbeweis kommt jetzt von den EXPERTEN
			   selbst, nicht von ihrem Marketing. Logisch schärfer: verdächtig
			   ist die Vermittlungsschicht, glaubwürdig der Mensch dahinter. */}
		{/* Satz-Varianten geprüft, Überschrift-Fassung bestätigt (Fred 31.08.).
			   Probe 1 (Akteur+Verb-Sätze: "Der Markt stellt jede behauptete
			   Expertise unter Generalverdacht. Auch eure könnte …") —
			   leserfreundlicher, aber "flutscht beim Lesen noch nicht".
			   Probe 2, Freds Diktat, als VORRAT für Fließtext-Flächen
			   (LinkedIn-Profil, Beiträge):
			   "Im Zeitalter von KI-Marketing steht die Behauptung eurer
			   Expertise unter Generalverdacht. Der Markt fordert den Gegenbeweis.
			   Das echte Gespräch eurer Experten, beweisbar festgehalten in
			   Bild und Ton, macht aus jedem Zuschauer einen Augenzeugen, der
			   eure Expertise unmittelbar erlebt." (2. Diktat: die BEHAUPTUNG
			   steht unter Verdacht, nicht die Expertise; "KI-Marketing" als
			   Ankläger; Singular-Augenzeuge. "Gegenbeweis" geprüft und
			   BEHALTEN, Fred 31.08.: streng juristisch richtet sich ein
			   Gegenbeweis gegen geführten Beweis, ein Verdacht wird nur
			   ausgeräumt — aber die feste Wendung "den Gegenbeweis antreten"
			   funktioniert auch gegen Vermutungen, niemand liest es falsch,
			   und das Wort ist stärker + spiegelt den Generalverdacht. Gilt
			   für Fließtext UND Seiten-Überschrift.) — flutscht, aber die Seite
			   behält die Akten-Form (Etikett + Eintrag).
			   Wort-Entscheide dieser Runde, gelten in BEIDEN Fassungen:
			   "beweisbar" statt "verlässlich" (eigenes Vokabular der
			   Verhandlungs-Bildwelt, Echo auf den Gegenbeweis — "darum geht
			   es"); "Urteilsbildung" statt "Urteil" (Vorgang statt Ergebnis,
			   Redewendung "sich ein Urteil bilden"); "unmittelbar" neu;
			   Schluss endet auf "Augenzeuge" (Kauf-Brücke "…, bevor er sich
			   für euch entscheidet und Kunde wird." komplett raus — "jeder
			   wird Kunde" wäre übertrieben, Rest-Vorrat). */}
			<p class="plaedoyer-text">Im Zeitalter von KI-Marketing steht die Behauptung eurer Expertise unter Generalverdacht. Der Markt fordert den Gegenbeweis.</p>
		{/* Urteil in zwei Sätzen (Fred 30.08.): Satz 1 = wer urteilt (jeder
			   einzelne Zuschauer, nicht mehr nur "Auftragsentscheider" — das
			   Urteil trifft auch die Unsichtbaren, Hidden-Buyer-Logik), Satz 2 =
			   die Dramatik der Frühe/Unsichtbarkeit. Anrede ihr/euch wie im
			   restlichen Block. "als Augenzeuge" ist hier rausgefallen — das
			   Wort trägt die Essenz-Spalte daneben ("Mit Augenzeugen."). */}
		{/* Satz 2 = die Marketing-Kurve (Fred 30.08.): raus aus der Gerichts-
			   sprache, rein in das, was den Geschäftsführer interessiert —
			   aus dem stillen Zuschauer-Urteil werden Aufträge. "Zuschauer"
			   statt "Auftragsentscheider" in Satz 1 bleibt bewusst (leichter
			   Einstieg), Satz 2 löst auf, warum das Urteil zählt. */}
		{/* Zeitliche Dimension zurück (Fred 30.08. spät): "Bevor er Kunde
			   wird…" löst das Kunden-Wort UND die Frühe in einem Zug — der
			   Zuschauer urteilt zuerst, Kunde wird er danach (oder nie). */}
		{/* "Zuschauer" bewusst benannt (Fred 30.08.): Schlüsselwort des
			   späteren Marketings (Zuschauerzahlen, Zuschauer pro Clip) — die
			   Seite soll das Wort früh setzen, damit die Messgrößen später
			   an eine eingeführte Figur andocken. */}
		{/* Verb-Schliff (Fred 30.08. nachts, "zweimal entscheiden"): Auftrag
			   wird VERGEBEN statt entschieden — löst die Dopplung, und "bevor
			   er sich entscheidet" braucht kein eigenes Glied, weil "fällt
			   sein Urteil" genau diese Entscheidung schon ist. */}
			<p class="plaedoyer-text">Das echte Gespräch eurer Experten wird zu eurer Verteidigung.</p>
			<p class="plaedoyer-text">Die beweisbare Aufzeichnung in Bild und Ton macht das Gespräch skalierbar und aus jedem Zuschauer einen Augenzeugen, der eure Expertise unmittelbar erlebt.</p>
		</div>

	</section>

	{/* Segment 2 "Das Gespräch" (Fred 31.08.): dieselbe zweigeteilte Bauform
	   wie das Plädoyer, GESPIEGELT — das große Statement steht diesmal
	   RECHTS ("Filmreif / ohne Kamerastress.", aus dem Tour-Claim, "echte
	   Gespräche" bewusst weggelassen: das Wort Gespräch trägt schon der
	   Plädoyer-Schluss darüber). Markup-Reihenfolge Text→Essenz = mobil
	   steht der Text oben (beim Plädoyer ist es andersrum — die beiden
	   Segmente wechseln sich auch mobil ab).
	   Textspalte (Wording-Runde 2026-06-14): Fred-gewordetes Material aus dem
	   Profiltext-Ast (LinkedIn_Profil_Strategie, About-Kandidat 27./28.08. —
	   die "Verzweigung", nach der Fred fragte). Der dortige Absatz endet
	   wörtlich auf "Filmreif, ohne Kamerastress" — hier weggelassen, weil das
	   Statement rechts daneben steht. "Blickkontaktstudio" im Singular (die
	   Website hat EIN Studio; der Profiltext nutzt den Plural als Kategorie). */}
	<section class="plaedoyer plaedoyer--gespraech wrap">
		<div class="plaedoyer-half plaedoyer-half--text">
			<p class="plaedoyer-text">Mit einer Kamera kann man kein Gespräch führen. Deshalb sieht man in unserem Blickkontaktstudio keine.</p>
			<p class="plaedoyer-text">Ihr sprecht mit eurem Gegenüber, entspannt im Gesprächsmodus — und der Zuschauer erlebt das Gespräch aus der echten Gesprächspartner-Perspektive.</p>
		</div>
		<div class="plaedoyer-half plaedoyer-half--essence">
			<p class="essence-line">Filmreif.</p>
			<p class="essence-line">Ohne Kamerastress.</p>
		</div>
	</section>

	<section class="proof wrap">
		<div class="clip-placeholder">
			<span>Clip folgt</span>
		</div>
	</section>

	{/* Produkte-Zeile + In-Flow-CTA entfernt (Fred 30.08. nachts, "erstmal
	   komplett raus"): die Seite ist auf drei Segmente reduziert — Hero,
	   Plädoyer+Essenz, Clip-Platzhalter — plus Footer. Wortlaut der Produkte-
	   Zeile lebt weiter in der produkteZeile-Konstante oben (Vorrat), der
	   CTA-Wortlaut im Website-Brief (Konversions-Kapitel). */}

</Layout>

<style>
	/* Randabstand 1:1 von BBH übernommen (live gemessen): 16px bis 1024px
	   Breite, danach 32px — statt unserem vorherigen festen 24px ohne
	   Zwischenschritt. Gilt für .wrap UND .hero-headline, damit große Texte
	   nie ganz an den Bildschirmrand gehen. */
	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 1024px) {
		.wrap {
			padding: 0 32px;
		}
	}

	.hero {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.hero-headline {
		/* Hero-Korrektur nach BBHs Statement-Rezept (Fred 30.08., live auf der
		   BBH-Startseite gemessen — deren Original-Hero ist ein vollbreites
		   Video, die SCHRIFT-Statements laufen aber nie bis an den Rand):
		   (1) site-container-Deckel 1728px, mittig — bei 1920er-Viewport
		   entstehen dadurch allein 96px Luft je Seite, plus 32px px-site-
		   Padding = 128px gemessener Zeilen-Einzug. (2) text-center (BBHs
		   Statements sind zentriert, nicht linksbündig — daher wirkte unseres
		   "bis an den Rand gezogen"). */
		width: 100%;
		max-width: 1728px;
		margin: auto;
		padding: 0 16px;
		text-align: center;
		/* Optischer Ausgleich (Fred 30.08.): geometrisch war der Block exakt
		   mittig (320px oben wie unten, gemessen), wirkte aber leicht zu tief —
		   Unterlängen wiegen unten schwerer, und das fixierte Logo füllt die
		   untere Bildhälfte zusätzlich. Leichter Hub nach oben, skaliert mit
		   der Viewport-Höhe (~16px bei 1080er-Höhe). */
		transform: translateY(-2.5vh);
		/* Schrift skaliert wieder mit dem CONTAINER (cqw), nicht dem Viewport —
		   dadurch füllt die Zeile die Deckel-Breite exakt aus (Fred 30.08.:
		   "größer, bis sie bei der Breite ist") und hört bei 1728px einfach
		   auf zu wachsen: ab da entsteht die BBH-Luft (96px Deckel-Rand + 32px
		   Padding = 128px Zeilen-Einzug bei 1920, exakt BBHs Messwert). */
		container-type: inline-size;
	}

	@media (min-width: 1024px) {
		.hero-headline {
			padding: 0 32px;
		}
	}

	.hero h1 {
		/* Wie auf bartleboglehegarty.com: text-wrap:balance statt fester <br>-Umbrüche.
		   Der Browser entscheidet selbst, wie viele Zeilen und welche Wortgruppen —
		   kein manuelles Umschalten zwischen Zeilenzahlen nötig.
		   Größe füllt die Zeilen auf die Container-Breite; der Container ist
		   bei 1728px gedeckelt, die Schrift wächst ab da nicht mehr mit und
		   die BBH-Randluft entsteht von selbst. Nach dem Hero-Tausch (Fred
		   30.08. spät) neu kalibriert: längste Zeile ist jetzt "Ihr habt die
		   Expertise." statt "Kein Business" — 9.6cqw statt 15.6 (gleiche
		   Auslastungs-Logik wie zuvor bei der Essenz-Spalte gemessen: diese
		   Zeile erreicht damit ~97% ihres Containers). Zeilenhöhe bleibt 0.92
		   statt BBHs 0.82: deren Statements sind VERSAL (keine Unterlängen),
		   unsere Mischschrift würde bei 0.82 kollidieren. */
		font-size: 9.6cqw;
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.01em;
	}

	.hero h1 span {
		/* Drei Sätze = drei Zeilen — die Umbrüche sind Bedeutung, kein
		   Balance-Layout. Beim Laden erscheinen sie ZEITVERSETZT und WISCHEN
		   herein wie der Seitenübergang (Fred 30.08. nachts: "wie die Seite
		   auch reinwischt, auf die einzelnen Sätze übertragen"): gleiche
		   Technik (clip-path legt von links frei), gleiche Dauer (800ms) und
		   exakt PageWipes symmetrische BBH-Kurve. Mehr Luft zwischen den
		   Sätzen als beim ersten Wurf — jeder Satz darf kurz allein stehen,
		   bevor der nächste antwortet. */
		display: block;
		animation: hero-line-wipe 800ms cubic-bezier(0.76, 0, 0.24, 1) both;
	}

	.hero h1 span:nth-child(1) {
		animation-delay: 100ms;
	}

	.hero h1 span:nth-child(2),
	.hero h1 span:nth-child(3) {
		/* Wisch-Achse gedreht (Fred 31.08., "wie wenn sie aus dem Text
		   rauskommen"): nur Zeile 1 wischt seitlich herein — Zeile 2 und 3
		   wischen VON OBEN NACH UNTEN auf, dieselbe Logik wie die
		   Menü-Zeilen (reiner clip-Wisch, gleiche Kurve, gleiche 800ms),
		   nur in Fallrichtung: jede Zeile materialisiert sich unter der
		   vorigen, als käme sie aus deren Text. */
		animation-name: hero-line-drop;
	}

	.hero h1 span:nth-child(2) {
		animation-delay: 1300ms;
	}

	.hero h1 span:nth-child(3) {
		/* Längere Pause vor der Pointe (Fred 30.08. nachts) — "Mit
		   Augenzeugen." darf sich ankündigen. */
		animation-delay: 2500ms;
	}

	@keyframes hero-line-wipe {
		/* Oben/unten -0.35em Luft im Zuschnitt (Fred-Befund 30.08. nachts):
		   die Zeilenhöhe (0.92) ist enger als die Schrift — Unterlängen wie
		   das g von "verteidigen" ragen aus der Satz-Box heraus, und ein
		   Zuschnitt auf exakt die Box (inset 0) schnitt sie ab: an der Stelle
		   erschien das Seiten-Schwarz "über" dem g. Mit negativem Inset
		   wischt der Effekt nur horizontal und lässt Über-/Unterlängen in
		   Ruhe — auch im Endzustand (fill: both). */
		from {
			clip-path: inset(-0.35em 100% -0.35em 0);
		}
		to {
			clip-path: inset(-0.35em 0 -0.35em 0);
		}
	}

	/* Vertikale Variante für Zeile 2+3: von oben nach unten freilegen.
	   Gleiche negative Seiten-Puffer wie beim horizontalen Wisch, damit
	   Über-/Unterlängen und der letzte Buchstabe nie angeschnitten werden
	   (line-height 0.92 < Glyphen-Ausdehnung, siehe hero-line-wipe). */
	@keyframes hero-line-drop {
		from {
			clip-path: inset(-0.35em -0.05em 100% -0.05em);
		}
		to {
			clip-path: inset(-0.35em -0.05em -0.35em -0.05em);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero h1 span {
			animation: none;
		}
	}

	/* Plädoyer-Sektion, ZWEIGETEILT (Website-Brief, Layout-Update 29.08. spät:
	   "das Split-Muster von Nuxt-Seite und BBH" — eine Hälfte der 4-Satz-Text,
	   die andere die Essenz groß; das ursprünglich geplante Eyebrow-Label
	   "Unser Eröffnungsplädoyer" ist per spätem Auftrags-Update wieder
	   entfernt, siehe Kommentar oben am Markup). Fließtext-Größe weiterhin
	   1:1 aus BBHs ausgeliefertem CSS gemessen (ea792231b42826ae.css, fetch +
	   Regex auf .text-*-original — die dortigen statischen px-Fallbacks der
