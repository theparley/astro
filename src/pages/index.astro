---
import Layout from "../layouts/Layout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import SplitFlap from "../components/SplitFlap.astro";
import MultiOutputTafel from "../components/MultiOutputTafel.astro";

// ZIEL→FORMAT-TAFEL (Fred 13.09., Probe-Einbau "nur dass ich es mal sehe"):
// Ziel links, Pfeil, Format rechts — BEWUSST EIN SplitFlap-Board statt zwei
// nebeneinander: zwei getrennte Boards laufen zeitlich auseinander (jeder
// Zustandswechsel dauert je nach Trommel-Distanz unterschiedlich lang), und
// dann stünde ein falsches Paar nebeneinander. Ein Board = immer synchron;
// die Zwei-Tafeln-Optik machen die festen Feldbreiten + der konstante Pfeil
// (nicht in der Trommel → klappert nie, steht wie eine Stanze in der Mitte).
// Ziel-Wortlaute = UNGELOCKTER Vorrat aus dem Website-Brief (Ziel→Format-
// Paare, MBS-Kaufmotive-Muster) — hier bewusst kurz gehalten, damit die
// Tafel nicht zu breit wird; am Objekt schärfen.
// Vierte Iteration (Fred 13.09. spät): Ziel-Zeilen und Pfeil VERWORFEN —
// die Tafel rattert NUR die Formate durch, eine Zeile. Dafür übernimmt sie
// die Aufzählungs-Funktion des Paragraph-Schlusssatzes (die Frage-Liste
// dort entfällt): mehr Formate ohne Satz-Platzkosten, und das Durchrattern
// selbst erzählt "es gibt mehr als eines". Liste = Sortiment + Kandidaten
// aus der Format-Recherche 13.09. (UNGELOCKT — Fred streicht/ergänzt).
// Fünfte Iteration (Fred 13.09. nacht, Wort-Diktat): Gattungs-Wörter, die
// jeder Leser sofort kennt — "Kundentestimonial" voll ausgeschrieben
// (Produktname), "Live-Webinar" statt Webinar (das "Live" adressiert Freds
// Billig-Vorbehalt und zieht die Grenze zur Folien-Konserve), "Interview"
// und "Online-Event" neu (Verstehens-Wörter; dass "Interview" kein
// SUCH-Begriff ist, ist hier egal — die Tafel ist eine Verstehens-Fläche).
// Sechste Iteration (Fred 13.09. nacht): Tafel MAXIMAL DREIZEILIG, bei
// Mehrwort-Formaten steht jedes Wort auf einer eigenen Zeile (Leerzeichen
// = Zeilentrenner; Bindestrich-Komposita bleiben EIN Wort/eine Zeile).
// padState() der Komponente zentriert kürzere Zustände vertikal im
// 3-Zeilen-Raster. "THOUGHT LEADER INTERVIEW" ersetzt das nackte
// "INTERVIEW" (Thought Leadership = bestätigtes Kunden-Vokabular).
const tafelFormate = [
	"VIDEOPODCAST",
	"KUNDENTESTIMONIAL",
	"LIVE-WEBINAR",
	"EXPERTENTALK",
	"ONLINE-EVENT",
	"RECRUITING-VIDEO",
	"LIVE Q&A-SESSION",
	"MITARBEITERINTERVIEW",
];
// Zeilen-Aufteilung NEU (Fred 14.09.): Tafel wandert in die HALBE Spalte
// mit der Wand-Kachelgröße — dafür lange Wörter geteilt, max. DREI Zeilen,
// längste Zeile 11 Zeichen (TESTIMONIAL/MITARBEITER).
const tafelZustaende = [
	["VIDEO", "PODCAST"],
	["KUNDEN", "TESTIMONIAL"],
	["LIVE", "WEBINAR"],
	["EXPERTEN", "TALK"],
	["ONLINE", "EVENT"],
	["RECRUITING", "VIDEO"],
	["LIVE Q&A", "SESSION"],
	["MITARBEITER", "INTERVIEW"],
];

// Kontakt-Board unter dem Augenzeugen-Turm (Fred 14.09.): startet leer und
// flappt EINMAL "NOCH VOR DEM / ERSTEN KONTAKT." ein (loop=false hält den
// Endzustand; sr-only-Fallback der Komponente trägt den Lesetext).
// Produkte-Zeile (Website-Brief, gelockte Treppe 29.08. spät) — die vier
// buchbaren Formate als knappe Zeile nach dem Clip-Beweis. Noch keine
// Produktseiten live (Phase 1), deshalb reiner Text ohne Links.
const produkteZeile = "Videopodcast. Webinar. Clip. Kundentestimonial.";

// Essenz-Zeile in der zweiten Hälfte der Plädoyer-Sektion (Website-Brief,
// Fred 29.08. nachts): ausgeschriebener Satz statt Zahlen-Paar — "Ein
// Gespräch mit tausend Augenzeugen." ersetzt "1 Gespräch. 1000 Augenzeugen.",
// die Zahlen-Fassung bleibt als Vorrat für Beiträge/Splitflap dokumentiert.
// Reiner Wortlaut zur Referenz/für einen späteren Tausch — die tatsächliche
// Darstellung erzwingt jetzt manuelle Umbrüche (siehe Markup unten,
// Live-Feedback Fred), ist also nicht mehr ein reines Ein-Zeilen-Edit.
const soloLine = "Ein Gespräch mit tausend Augenzeugen.";
// Vorrat/Alternativen, noch nicht entschieden: "1 Gespräch. 1000 Augenzeugen."
// (Zahlen-Fassung, für Beiträge/Splitflap), "KI ist kein Augenzeuge."
---

<Layout title="Start" gateMenuBehindHero>
	<header class="hero">
		{/* Hero-Tausch (Fred 30.08. spät): der Dreizeiler aus der Essenz-Spalte
		   wird der Hero ("echt starker Hero"), "Kein Business ohne Witness."
		   wandert dafür in die Essenz-Spalte der Plädoyer-Sektion. Drei Sätze =
		   drei Zeilen (Spans mit display:block statt text-balance — die
		   Umbrüche sind hier Bedeutung, nicht Layout). */}
		<div class="hero-headline">
			{/* Hero-Rücktausch (Fred 2026-06-14): "Kein Business ohne Witness."
			   ist wieder der Hauptclaim groß oben — in den zwei bewährten
			   Zeilen. Der Dreizeiler ("Ihr habt die Expertise. / Wir
			   verteidigen sie. / Mit Augenzeugen.") ist raus; sein Inhalt lebt
			   sinngemäß im neuen Paragraph darunter ("Wir übernehmen die
			   Verteidigung eurer Expertise … Augenzeuge"). */}
			{/* Hero-Breakpoint (Fred 14.09.): unterm Schwellwert wird aus den
			   zwei Zeilen ein VIERZEILER — jedes Wort eine Zeile, die Schrift
			   darf dafür größer (kalibriert auf "Business" als längste
			   Zeile). Wort-Spans inline auf Desktop (unsichtbar), block am
			   Breakpoint; die Wipe-Animation bleibt an den ZEILEN-Spans. */}
		<h1><span><span class="hero-wort">Kein</span> <span class="hero-wort">Business</span></span><span><span class="hero-wort">ohne</span> <span class="hero-wort">Witness.</span></span></h1>
		</div>
		{/* Logo bleibt Markenpräsenz OHNE Menü-Funktion (Website-Brief
		   "Entscheidung 29.08."), ist aber wieder fixiert unten Mitte und
		   klappt scroll-getrieben ein (Zweite Nachbesserung 29.08. spät,
		   siehe Kommentar in BrandLogo.astro) — die interaktive
		   Kachel-Menü-Verwandlung des Logos bleibt archiviert in
		   TileMenu.astro, nur die reine Scroll-Dock-Choreografie ist zurück. */}
		<BrandLogo />
	</header>

	{/* "Der Paragraph" (Fred 2026-06-14): Fließtext über die ganze Breite,
	   Paragraph-Größe (gleiche BBH-Lead-Typo wie bisher) — ersetzt die
	   zweigeteilte Plädoyer-Sektion (Akten-Form + Essenz-Spalte). "Kein
	   Business ohne Witness." ist zurück im Hero; die Akten-Fassung des
	   Plädoyers und der Dreizeiler leben in Brief-Fortschritt + Git-Historie
	   (bewusst kein Code-Vorrat). Wortlaut = Freds Diktat, wörtlich
	   (neue Fassung 2. Runde 14.06.: KI-Generalverdacht, videobasierte
	   Formate, Schluss verkürzt auf den Augenzeugen-Satz). */}
	<section class="paragraph">
		{/* Vorlese-Runde (Fred 13.09. nacht) + Korrektur direkt danach: das
	   probierte Anapher-Paar (Satz 1 „erstes Gespräch" / Absatz 2 öffnet
	   mit „Noch vor dem ersten Kontakt") ist VERWORFEN — „Gespräch" bleibt
	   als Wort fürs Produkt reserviert (echte Gespräche), der Erstkontakt
	   heißt Kontakt. Stand hier = die bewährte Fassung. */}
		{/* SPLIT-UMBAU (Fred 14.09., Optik-Probe paragraph-split-demo.html
		   übernommen): Zeile 1 als VERSAL-Statement in der linken Hälfte
		   (beide Achsen mittig, Sätze als eigene Blöcke mit 0.5em Luft),
		   die drei Absätze rechts. 50/50-Split nach BBH-Regel. */}
		{/* "Augenzeugen" als ZWEI Zeilen AUGEN / ZEUGEN (Fred 14.09.) — das
		   Wort war bei Sektionstitel-Größe die Sprengzeile der Halbspalte;
		   der Split liest sich versal als Doppel-Wort (AUGEN ZEUGEN). */}
		<div class="paragraph-links">
			{/* "Noch vor dem ersten Kontakt." UMGEZOGEN (Fred 15.09. früh):
			   die Zeile steht jetzt am ENDE von Absatz 2 (nach dem
			   fälschungssicheren Beweis). RÜCKBAU-ZEIGER für schnelles
			   Zurücktauschen (Fred: "merk dir die vorherige Lösung"):
			   Commit 2c977b4 = Zeile rechtsbündig unterm Punkt von ZEUGEN.,
			   im .turm-block (width max-content, gap 0), Abstand 0.2 Turm-Em
			   via text-box-trim + margin-top 0.05 Turm-Em (@supports-Wache).
			   Ein `git show 2c977b4 -- src/pages/index.astro` zeigt alles. */}
			<h2 class="paragraph-statement"><span class="statement-satz"><span class="statement-zeile">Kunden</span><span class="statement-zeile">werden</span><span class="statement-zeile">Augen</span><span class="statement-zeile">zeugen.</span></span></h2>
		</div>
		<div class="paragraph-text">
		{/* Indiz-Satz (Fred 13.09. nacht, Diktat; Drittfassung): „vor kurzem
	   noch/jetzt" erzählt den Kipp-Punkt der Entwertung; „ohne Nachweis"
	   (statt hart „wertlos" allein) sagt: für sich allein gestellt wertlos,
	   mit Nachweis wieder etwas wert — der Beweis wertet die Indizien auf,
	   ersetzt sie nicht. Zugleich Steigerungs-Treppe im Juristen-Register:
	   INDIZ (Satz 3) → NACHWEIS (fehlt) → BEWEIS (Absatz darunter). */}
	<p class="plaedoyer-text"><strong>Generierte Expertise</strong> gibt es auf Knopfdruck.<br />Jeder Text, jedes Bild, jedes Video steht unter Generalverdacht. Inhalte, die vor kurzem noch ein Indiz für Kompetenz waren, wirken nicht mehr.</p>
		{/* „Beweis" statt „Vertrauensbeweis" (Fred 13.09. nacht): das Kompositum
	   war ihm im Kopf zu schwer/feierlich — und seit „ohne Nachweis" im
	   Absatz darüber steht, trägt die Treppe rein: INDIZ → NACHWEIS → BEWEIS,
	   drei Stufen, ein Register, das kurze Wort als Hammerschlag. Das
	   Vertrauens-Thema ist im Kopf doppelt verankert (Hero-Witness +
	   „Vertrauen skalieren" im Schlusssatz). „Vertrauensbeweis" bleibt
	   Haus-Wort für Tiefenflächen (Kundenstimmen, Nach-Clip, Verkauf) —
	   Register-Staffelung, siehe Recherchedokument Vertrauensthese. */}
		{/* „in Augenschein nehmen" (Fred 13.09. nacht): holt das Auge-Wort in
	   den Beweis-Absatz (Familie Hero-Witness → Augenzeugen → Augenschein)
	   und ist juristisch exakt — der Augenschein ist im deutschen
	   Prozessrecht wörtlich eines der fünf Beweismittel, die unmittelbarste
	   Form: der Richter/Kunde prüft selbst statt über Berichte. „der
	   gelebten Expertise" (mit Artikel) trägt den Relativsatz. */}
		{/* Vorlese-Runde + Korrektur (Fred): „den er in Augenschein nehmen
	   kann" — Relativsatz hängt am MOMENT (natürlicher: man besichtigt die
	   Szene). „Diese Momente liefern …" hier VERWORFEN (zu viele Momente
	   in Folge — „Diese Momente" gehört exklusiv dem Absatz darunter als
	   Öffner); es bleibt beim knappen „Den liefern echte Gespräche." */}
		{/* „fälschungssicheren" (Fred 14.09., ersetzt sein „unfälschbaren"
	   von Minuten davor): das Costly-Signaling-Kriterium als Adjektiv —
	   die Umkehrungs-Regel („Was sich nicht fälschen lässt, wird mehr
	   wert") im Kopf. „fälschungssicher" = das etablierte Wort der
	   Dokumenten-Welt (Banknoten, Pässe, Urkunden — passt ins Juristen-
	   Register) und die verteidigbarere Stufe (sicher GEGEN Fälschung
	   statt absoluter Unmöglichkeit). Bewusst an der FORDERUNG des
	   Kunden verankert, nicht als Selbst-Behauptung — der Anspruch
	   definiert die Messlatte, das Gespräch erfüllt sie im nächsten
	   Satz. */}
		{/* Aufwertungs-Satz WIEDER RAUS (Fred 14.09., nach kurzem Probe-
	   Einbau): „Und je mehr generiert wird, desto wertvoller werden
	   solche Momente." bleibt VORRAT für die Nach-Clip-Fläche — dort
	   gehört er laut Einsatz-Regel ohnehin hin (hinter den gezeigten
	   Beweis); Objekt-Frage („Inhalte"/„Content"/ohne Objekt) blieb
	   ungelöst, Favorit war die objektlose Form. Herleitung:
	   Recherchedoc Vertrauensthese, Aufwertungs-Kleid. */}
		{/* PROBE (Fred 14.09. abends, Diktat): Absatz 2 öffnet mit der
		   Gegenthese zu Absatz 1 (generiert vs. gelebt), Dreischritt
		   Gespräch → Antworten beweisen Kompetenz → Momentaufnahme wird zum
		   Beweis. Diktat-Glättungen (geflaggt): "beweisen Sie die" →
		   "beweisen die" (Plural-Kongruenz zu "Antworten"),
		   "Fälschungssicheren" klein, Schlusspunkt ergänzt. Ersetzt die
		   Fassung "Der Kunde sucht einen fälschungssicheren Beweis. …
		   in Augenschein nehmen kann. Den liefern echte Gespräche. Denn
		   Kompetenz zeigt sich in unmittelbaren Antworten auf aktuelle
		   Fragen." (Vorrat in Git-Historie; "in Augenschein nehmen" und
		   "aktuelle Fragen" → "spontane Fragen" sind mit raus). */}
		<p class="plaedoyer-text"><strong>Gelebte Expertise</strong> zeigt sich im echten Gespräch.<br />Die unmittelbare Antwort auf eine spontane Frage beweist Kompetenz. Und die Momentaufnahme davon wird zum fälschungssicheren Beweis für den Kunden. Noch vor dem ersten Kontakt.</p>
		{/* "ohne Kamerastress" statt "mit Video" (Fred 13.09. nacht): die
		   Kamera sagt Video, ohne es zu sagen — das Wort "Video" steht damit
		   wieder NUR auf der Knopfdruck-Seite (bewusste Eigenschaft, s. Brief);
		   zugleich steht die gelockte Formel "filmreif ohne Kamerastress"
		   wörtlich im Kopf und trägt beide Filmreif-Schichten (Umsetzung +
		   Situation der Sprecher). */}
		{/* „mit der Aufnahmetechnik eines oscarprämierten Dokumentarfilms"
	   (Fred 13.09. nacht, dritte Stufe des Satzes): erst war das Kompositum
	   „Blickkontakt-Aufnahmetechnik" zu lang, das nackte „im Blickkontakt"
	   warf die Frage „mit wem?" auf, „speziell" war nur ein Adjektiv-
	   Versprechen — jetzt trägt GELIEHENER BEWEIS: Interrotron-Prinzip von
	   Errol Morris, dessen Doku „The Fog of War" 2004 den Oscar gewann
	   (Bester Dokumentarfilm). Bewusst „eines oscarprämierten
	   Dokumentarfilms", NICHT „oscarprämierte Technik" — der Oscar ging an
	   den Film, nicht die Technik; diese Fassung ist im Verkaufsgespräch
	   wörtlich verteidigbar. „Dokumentarfilm" zahlt zudem auf die
	   Echtheits-These ein (Kino, das Wirklichkeit filmt). Ortsneutral,
	   keine Studio-Verengung; WAS die Technik ist, löst „Wie wir das
	   machen" auf (Cliffhanger bleibt). */}
		{/* „mit unserer weiterentwickelten Aufnahmetechnik" (Fred 13.09.
	   nacht, Endstand der Nacht-Iteration): „unserer" holt den
	   Besitzanspruch explizit zurück; die Oscar-Nennung („mit der
	   Aufnahmetechnik eines oscarprämierten Dokumentarfilms") ist damit
	   aus dem KOPF raus — grammatisch geht „unserer" + „eines Films"
	   nicht zusammen. Der Oscar-Anker bleibt dokumentierter VORRAT
	   (Recherchedoc Vertrauensthese, Nachtrag 3: Interrotron/Errol
	   Morris/„The Fog of War" 2004) für Studios-Kachel, Produktseite,
	   Verkaufsgespräch. */}
		{/* Vorlese-Runde: Oscar ist ZURÜCK und mit „unserer" kombiniert
	   (Fred-Diktat; Konstruktion „unsere weiterentwickelte [Aufnahmetechnik
	   eines oscarprämierten Dokumentarfilms]" — die präziseste Langform
	   „mit der von uns weiterentwickelten …" liegt als Reserve im
	   Recherchedoc). „Filmreif und ohne Kamerastress." jetzt als eigener
	   Staccato-Satz. */}
		{/* Schlusssatz neu (Fred, Vorlese-Korrektur): „Mit dieser Wirkung
	   lässt sich jetzt Vertrauen skalieren" — „Wirkung" holt erstmals ein
	   Wort der Wirkungs-Säule in den Kopf (Bezug: filmreif + ohne
	   Kamerastress = die Wirkung, die skaliert wird). */}
		<p class="plaedoyer-text">Genau solche Gesprächsmomente fangen wir filmreif ein und bringen sie ins passende Format. Jetzt skalieren sie das Vertrauen in eure Marke. Auf allen Kanälen.</p>
		</div>
	</section>

	{/* NEUE SEITEN-REIHENFOLGE (Fred 14.09.): Hero → Kopf → CLIP →
	   Multi-Output → Wie wir das machen → Formatfrage als SEITENSCHLUSS.
	   Logik: Der Kopf endet auf der Wirkung, der Clip ZEIGT sie (Beweis
	   vor weiterer Behauptung — die dokumentierte Clip-unter-Kopf-Regel);
	   dann die Skalierung (Multi-Output), dann die Bedingungen ("Was
	   braucht er dafür?" = Wie wir das machen), und die Seite endet auf
	   der Tür (Formatberatung NACH allen Beweisen; Peak-End-Regel).
	   NACH-CLIP-SLOT: direkt hinter dem Clip wartet der Aufwertungs-Satz
	   ("Und je mehr generiert wird, desto wertvoller werden solche
	   Momente."), sobald der echte Clip da ist. */}
	{/* Clip VOLLBREIT (Fred 2026-06-15, "übernehmen wir von BBH"): deren
	   Startseiten-Video läuft randlos von Kante zu Kante — kein .wrap, kein
	   Seitenabstand. */}
	{/* AUSGEBLENDET fürs Notgedrungen-Live-Paket (Fred 14.09.): der
	   Clip existiert noch nicht — Sektion bleibt hier geparkt und wird
	   wieder einkommentiert, sobald der Clip da ist (dann auch den
	   Aufwertungs-Satz dahinter setzen, s. Kommentar oben). */}
	{/*
	<section class="proof">
		<div class="clip-placeholder">
			<span>Clip folgt</span>
		</div>
	</section>
	*/}

	{/* Multi-Output-Sektion (Fred 2026-09-13/14): "Was aus einer Stunde
	   Gespräch entstehen kann" — als MultiOutputTafel.astro portiert aus dem
	   abgenommenen Entwurf (Website-Brief: Sektion "Der Multi-Output echter
	   Gespräche" + BAU-ANWEISUNG). Erzähl-Reihenfolge (Fred 15.09. früh,
	   nach Hin-und-Zurück-Tausch bestätigt): Paragraph (endet auf "Auf
	   allen Kanälen") → DIESE Sektion (der Output auf den Kanälen) →
	   Formatfrage als Seitenschluss (endet auf der Tür Formatberatung). */}
	<MultiOutputTafel />


	

	

	{/* Bausteine-Sektion (Fred 2026-06-15 abends, Demo-Runde bausteine-demo.html,
	   Entscheid "d2"): DREI Medien-Kacheln nebeneinander (BBHs visual-grid-Muster,
	   16px Fuge, auf drei verbreitert; Panel-Grund, 4:5) — nebeneinander liest
	   das Auge sie als EIN Ensemble, das ein Problem löst (Freds Beobachtung;
	   gestapelt wirkten sie als Abfolge). Große Sektions-Überschrift nach
	   BBH-Regel (KEINE Eyebrows — live verifiziert: BBH kennt nur große
	   Versal-Sektionszeilen ODER kleine Überschriften direkt am Text, nie
	   klein-über-groß). Namen ohne Artikel; "Studios" PLURAL (drei Formen:
	   Blickkontaktstudio Karlsruhe / mobiles Studio / Inhouse-Bau beim
	   Kunden — nie aufs feste Studio verengen, hat schon einen Auftrag
	   gekostet; "Aufnahme" als Name verworfen, Zuschalt-Fälle laufen unter
	   Regie). Unterschriften erzählen die Zeitachse: zuerst → live → danach.
	   Die Sektion beantwortet den Filmreif-Cliffhanger des Paragraphs. */}
	{/* AUSGEBLENDET fürs Notgedrungen-Live-Paket (Fred 14.09.): der
	   Redaktionsteil ist noch nicht überarbeitet (u. a. fehlt die
	   Zeugen-Mechanik in der Regie-Kachel, s. Recherche-Feedback) —
	   Sektion bleibt geparkt, wieder einkommentieren nach Überarbeitung. */}
	{/*
	<section class="bausteine">
		<h2 class="bausteine-titel">Wie wir das machen</h2>
		<div class="bausteine-grid">
			<div class="baustein">
				<div>
					<h3>Studios</h3>
					<p class="baustein-sub">Das Gespräch zuerst</p>
				</div>
				<p class="baustein-text">Zuerst stellen wir das echte Gespräch her, dann läuft die Aufnahme. Im Blickkontaktstudio in Karlsruhe, mit dem mobilen Studio bei euch oder im Inhouse-Studio, das wir euch bauen.</p>
			</div>
			<div class="baustein">
				<div>
					<h3>Regie</h3>
					<p class="baustein-sub">Live, während ihr sprecht</p>
				</div>
				<p class="baustein-text">Während ihr sprecht, hält die Regie die Technik unsichtbar, den Inhalt auf Kurs und die Wirkung im Blick.</p>
			</div>
			<div class="baustein">
				<div>
					<h3>Redaktion</h3>
					<p class="baustein-sub">Die Formatredaktion danach</p>
				</div>
				<p class="baustein-text">Aus der Aufnahme werden eure Formate: Videopodcast, Webinar, Clip, Kundentestimonial. Jede Produktion liefert ihr Stück, inklusive Text.</p>
			</div>
		</div>
	</section>
	*/}

	{/* FORMAT-TAFEL (Fred 13.09. spät, vierte Iteration): rattert die
	   Formate durch und ÜBERNIMMT die Aufzählungs-Funktion des Paragraph-
	   Schlusssatzes (die Frage-Liste dort ist raus) — mehr Formate ohne
	   Satz-Platz, das Durchrattern erzählt "mehr als eines". Der
	   Formatberatung-Knopf rutscht mit UNTER die Tafel (Fred): Satz → Tafel
	   (die Auswahl) → Knopf (die Tür). Wortlaute/Tempo ungelockt. */}
	<section class="ziel-format-tafel">
		{/* Sektions-Kopf (Fred 2026-09-13 abends): große Überschrift "Eine
		   Frage des Formats" + Subclaim als Frage — ersetzt die frühere
		   Arbeitsstand-Zeile. Gleiche Bauform wie der Multi-Output-Kopf:
		   Titel im Sektions-Titel-Rezept, Sub in der Lead-Typo, beides mittig. */}
		{/* Split-Umbau (Fred 14.09.): wie die Paragraph-Sektion, GESPIEGELT —
		   kleiner Text LINKS, großes Statement RECHTS (beide Achsen mittig);
		   Tafel + Formatberatung laufen darunter weiter über die volle
		   Breite. */}
		<div class="format-split">
			<div class="tafel-kopf">
