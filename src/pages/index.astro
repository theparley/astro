	@media (min-width: 1024px) {
		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titellinks"], [data-spalten="titelbreit"])) .anlass--band .anlass__band-innen { grid-template-columns: 1fr 1fr; column-gap: 0; align-items: start; }
		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titellinks"], [data-spalten="titelbreit"])) .anlass--band .anlass__band-innen > * { grid-column: 1 / -1; }
		/* Die Animation ist ein eigener Baustein mit eigener Stilkennung; die Regel mit „> *“ erreicht sie nicht. Ohne
