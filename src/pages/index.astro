---
import Layout from "../layouts/Layout.astro";

const ebenen = [
	{
		name: "Identität",
		text: "Expertise beweisbar machen für die, die Aufträge entscheiden.",
	},
	{
		name: "Mittel",
		text: "Echte Gespräche, Blickkontaktstudios, Live-Regie, Formatredaktion.",
	},
	{
		name: "Produkte",
		text: "Videopodcast, Webinar, Clip, Kundentestimonial.",
	},
];
---

<Layout title="Start" menuStartCollapsed={false}>
	<header class="hero">
		<div class="hero-headline">
			<h1>Kein Business ohne Witness.</h1>
		</div>
	</header>

	{/* Video-Platzhalter: gibt der Seite Scroll-Strecke, um Scroll-Verhalten (Menü-Umwandlung
	   der Fahne) zu testen. */}
	<section class="proof wrap">
		<div class="clip-placeholder">
			<span>Clip folgt</span>
		</div>
	</section>

	{/* Vorerst weiter ausgeblendet — kommt später zurück.
	<section class="ebenen wrap">
		{ebenen.map((e) => (
			<div class="ebene">
				<h2>{e.name}</h2>
				<p>{e.text}</p>
			</div>
		))}
	</section>

	<section class="cta wrap">
		<a href="/buchen" class="button">Gespräch buchen →</a>
	</section>

	<footer class="wrap">
		<nav>
			<a href="/impressum">Impressum</a>
			<a href="/datenschutz">Datenschutz</a>
		</nav>
	</footer>
	*/}
</Layout>

<style>
	/* Randabstand 1:1 von BBH übernommen (live gemessen): 16px bis 1024px
	   Breite, danach 32px — statt unserem vorherigen festen 24px ohne
	   Zwischenschritt. Gilt für .wrap UND .hero-headline, damit große Texte
	   nie ganz an den Bildschirmrand gehen. */
	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 1024px) {
		.wrap {
			padding: 0 32px;
		}
	}

	.hero {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.hero-headline {
		container-type: inline-size;
		padding: 0 16px;
		margin: auto 0;
	}

	@media (min-width: 1024px) {
		.hero-headline {
			padding: 0 32px;
		}
	}

	.hero h1 {
		/* Wie auf bartleboglehegarty.com: text-wrap:balance statt fester <br>-Umbrüche.
		   Der Browser entscheidet selbst, wie viele Zeilen und welche Wortgruppen —
		   kein manuelles Umschalten zwischen Zeilenzahlen nötig. */
		font-size: 15.6cqw;
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.proof {
		padding: 24px 0 64px;
	}

	.clip-placeholder {
		aspect-ratio: 16 / 9;
		width: 100%;
		border: 1px solid #2a2a2a;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gray);
		font-size: 0.9rem;
	}

	.ebenen {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
		padding: 48px 0;
		border-top: 1px solid #2a2a2a;
	}

	.ebene h2 {
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray);
		margin-bottom: 12px;
	}

	.ebene p {
		font-size: 1.1rem;
		line-height: 1.4;
	}

	.cta {
		padding: 64px 0;
		text-align: center;
	}

	.button {
		display: inline-block;
		border: 1px solid var(--white);
		padding: 16px 32px;
		text-decoration: none;
		font-size: 1.1rem;
	}

	footer {
		padding: 32px 0 64px;
		border-top: 1px solid #2a2a2a;
	}

	footer nav {
		display: flex;
		gap: 24px;
		font-size: 0.85rem;
		color: var(--gray);
	}

	footer a {
		text-decoration: none;
		color: inherit;
	}

	@media (max-width: 700px) {
		.ebenen {
			grid-template-columns: 1fr;
		}
	}
</style>
