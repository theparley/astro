	:global(html[data-kopf="kachel"]) .anlass--kachel { display: block; }
	/* Mit dem Band heißt die Überschrift über den Kacheln „Beweis“ (Rasul 13.11.2026 abends: „so sieht es aus, das ist das,
	   was wir machen, und das ist das Problem, das wir sehen. Dann kämen unsere Kacheln und dann können wir auch Beweis
	   hinschreiben. Als Überschrift für die Kacheln.“). Ein Wort wie BBHs „Work“. */
	:global(.titel-beweis) { display: none; }
	:global(html[data-kopf="band"] .titel-beweis) { display: inline; }
	:global(html[data-kopf="band"] .titel-videobeweis) { display: none; }
	/* In der Probe „breite Kachel“ entfällt die Überschrift sichtbar; sie bleibt als Sprungziel des Menüs im Code. */
	:global(html[data-kopf="kachel"] #kap-titel) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	/* B6 hell (BBH theme:light): weiße Fläche, schwarze Schrift, Innenabstand lg */
	/* Innenabstand oben md statt lg, damit das Band mit Überschrift und Animation auf einen Bildschirm passt (13.11.2026) */
	/* oben ohne Innenabstand: die Animation beginnt an der Oberkante des Bandes und füllt am Rechner den Bildschirm */
	.anlass--band { background: var(--white); color: var(--black); padding: 0 0 var(--abstand-lg); margin-bottom: var(--abstand-lg); overflow-x: clip; }
	/* Abstände im Band klein (32 px), damit Überschrift, Animation und Lesetext auf einen Bildschirm passen (13.11.2026) */
	.anlass__band-innen { display: grid; gap: var(--abstand-md); }
	/* „Überall Experten.“ nah unter der Animation, der Nachsatz direkt darunter wie die nächste Zeile derselben Überschrift */
	/* mit .anlass--band davor, sonst gewinnt „.anlass__satz { margin: 0 auto }“, das später im Stil steht */
	/* direkt an der Unterkante der Animationsfläche: Dann ist der Abstand vom Videobeweis-Rahmen zum Text so groß wie
	   der Abstand des Rahmens zur Oberkante der Fläche (je 7 % der Flächenhöhe). Rasul 13.11.2026 abends: „Überall
	   Experten darf näher der Animation liegen. Du kannst als Maß nehmen … nach oben hin einen Abstand zur nächsten
	   Fläche und den kannst du auch nach unten hin machen zum Anfang vom Text.“ */
	.anlass--band .anlass__satz--eins { margin-top: calc(0px - var(--abstand-md)); }
	/* Einblenden wie BBHs Zeilen-Blende (Rasul 13.11.2026 abends: „Das Einblenden der Texte ist ein bisschen abrupt. Gibt
	   es da nicht eine Vorgabe bei BBH?“; Analyse research/BBH_Website_Analyse_2026-11/C_Bewegung_Interaktion.md 3.1):
	   nur Deckkraft, 1 s, ease-in-out, kein Hochrutschen. Vorher 700 ms mit 12 px Bewegung. */
	.anlass--band .anlass__nachsatz { margin-top: calc(0px - var(--abstand-md)); transition: opacity 1s ease-in-out; }
	:global(.anlass--band[data-phase="warten"] .anlass__nachsatz) { opacity: 0; }
	/* Probe (Rasul 14.11.2026: „wir probieren eins noch aus. Wenn der zweite Satz erscheint, blurr mal den ersten Satz
	   langsam“): „Überall Experten.“ wird unscharf, sobald „Zeit für den Videobeweis“ einblendet, langsamer als dessen Blende */
	/* Abgenommen (Rasul 14.11.2026: „finde ich gar nicht schlecht. Er wird mir nur zu dunkel, der Satz. Ich finde es schön,
	   wenn der so ein Blur und Grau kriegt wie die hinteren Reihen“): dazu heller, Deckkraft 0,35 wie die hintersten Reihen
	   der Animation (dort 1 − 0,6 × Tiefe, also bis etwa 0,4) */
	/* Seit 14.11.2026 an die Kamerafahrt gekoppelt: Unschärfe und Deckkraft setzt ExpertenAuswahl.astro je Bild */
	/* Textfolge „nacheinander“ (Probe, Rasul 14.11.2026: „der Text verschwindet, also ausgeblendet wird. Und die
	   Videobeweisanimation anfängt und fertig wird. Und dann unten drunter auf der Zeile, wo Überall Experten stand, die
	   beiden Sätze eingeblendet werden. Und zwar einer nach dem anderen“; Grund: „es darf nur eine Sache fürs Auge passieren“).
	   Nachsatz liegt in derselben Rasterzeile wie „Überall Experten.“; Ausblenden 0,6 s ab 1,6 s, fertig, wenn die Geste
	   beginnt (2,2 s); Zeilen nach dem Stillstand der Kamera (Phase „schluss“), je 1 s, die zweite nach der ersten. */
	:global(html:is([data-textfolge="nacheinander"], [data-textfolge="vorher"])) .anlass__band-innen > :first-child { grid-row: 1; }
	:global(html:is([data-textfolge="nacheinander"], [data-textfolge="vorher"])) .anlass--band .anlass__satz--eins,
	:global(html:is([data-textfolge="nacheinander"], [data-textfolge="vorher"])) .anlass--band .anlass__nachsatz { grid-row: 2; grid-column: 1; align-self: start; }
	:global(html:is([data-textfolge="nacheinander"], [data-textfolge="vorher"])) .anlass--band .anlass__text { grid-row: 3; }
	:global(html:is([data-textfolge="nacheinander"], [data-textfolge="vorher"]) .anlass--band:not([data-phase="warten"]) .anlass__satz--eins) { opacity: 0; transition: opacity 0.6s ease-in-out; }
	:global(html:is([data-textfolge="nacheinander"], [data-textfolge="vorher"]) .anlass--band .anlass__nachsatz) { opacity: 1; transition: none; }
	:global(html:is([data-textfolge="nacheinander"], [data-textfolge="vorher"]) .anlass--band .anlass__nachsatz > span) { opacity: 0; }
	:global(html[data-textfolge="nacheinander"] .anlass--band[data-phase="schluss"] .anlass__zeile1) { opacity: 1; transition: opacity 1s ease-in-out; }
