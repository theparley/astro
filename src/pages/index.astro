---
/* ═══════════════════════════════════════════════════════════════════════
   STARTSEITE · NEUSTART (Rasul 13.11.2026 nachts: „ich würde jetzt gerne
   einmal neu starten“). Zusammengesetzt aus den Bausteinen in
   src/components/bausteine/ nach BBHs Musterkatalog; Übersicht aller
   Bausteine auf /bausteine. Erster Vorschlag, welcher Baustein zu welchem
   Abschnitt passt; Rasul entscheidet je Abschnitt („Das machen wir dann
   gemeinsam“). Texte wörtlich aus der Textquelle im Marketing-Ordner
   (branding/aktiv/Parley_Website_Startseite_Texte_2026-11.md). Die alte
   Startseite steht im Zweig dev.
   ═══════════════════════════════════════════════════════════════════════ */
import Layout from "../layouts/Layout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import LogoBiss from "../components/LogoBiss.astro";
import MultiOutputKacheln from "../components/MultiOutputKacheln.astro";
import Haltung from "../components/bausteine/Haltung.astro";
import KurzSaetze from "../components/bausteine/KurzSaetze.astro";
import TextBild from "../components/bausteine/TextBild.astro";
import Textblock from "../components/bausteine/Textblock.astro";
import BlasenVideo from "../components/bausteine/BlasenVideo.astro";
import Platzhalter from "../components/bausteine/Platzhalter.astro";
import FilmKarussell from "../components/bausteine/FilmKarussell.astro";
import Band from "../components/bausteine/Band.astro";
import Kennzahlen from "../components/bausteine/Kennzahlen.astro";

// Sprechblasen zum Rohschnitt „Szene Beweisaufnahme“ v1 (Rasul 13.11.2026). Sätze aus
// website/video/Szene_Beweisaufnahme_Clipvorschlag_2026-11.md, Schnitte bei 4,5 · 9 · 18 · 24 s.
const BLASEN = [
	{ an: 0.4, aus: 4.4, stelle: "OR", text: "Es fühlt sich so natürlich an, hier zu sitzen." },
	{ an: 4.9, aus: 8.9, stelle: "OL", text: "Die gesamte Angst vor Kamera ist null." },
	{ an: 9.4, aus: 17.9, stelle: "OR", text: "… dass ich dir direkt in die Augen schaue und gleichzeitig der Zuschauer meinen Augenkontakt hat." },
	{ an: 18.4, aus: 23.9, stelle: "OL", text: "Er sitzt hier zwei Meter von mir weg in einem Display in Lebensgröße." },
	{ an: 24.3, aus: 26.6, stelle: "OL", text: "Wir können es sehr empfehlen, oder?" },
	{ an: 26.7, aus: 28.2, stelle: "OR", text: "Total." },
] as const;

const FORMATE = [
	{ buchstabe: "A", name: "Videopodcast", form: "169", art: "video", text: "Das ganze Gespräch, so wie es war. Für alle, die euch länger zuhören wollen." },
	{ buchstabe: "B", name: "Audio-Podcast", form: "11", art: "audio", text: "Dieselbe Folge zum Hören, unterwegs oder beim Laufen." },
	{ buchstabe: "C", name: "Clip", form: "916", art: "video", text: "Eine Frage, eine Antwort. Kurz genug für den Feed, lang genug, um zu zeigen, wie ihr denkt." },
	{ buchstabe: "D", name: "Zitat", form: "11", art: "zitat", text: "Ein Satz, der hängen bleibt. Zum Teilen und Zitieren." },
	{ buchstabe: "E", name: "Newsletter", form: "45", art: "newsletter", text: "Die Folge zum Lesen, direkt im Postfach eurer Kunden." },
	{ buchstabe: "F", name: "Transkript", form: "45", art: "transkript", text: "Jedes Wort zum Nachlesen, damit euch Suchmaschinen und KI-Assistenten finden." },
];

---

<Layout gateMenuBehindHero>
	{/* ── HERO ── Baustein B3 Haltungssatz (BBH: Hegarty-Statement auf Start und About), erster
	   Auftritt mit BBHs Masken-Wisch. Darüber das Logo mittig (Rasul 13.11.2026). Darunter der
	   Erklärtext als Baustein B4 Kurze Sätze (Regel R5: mehrere kurze Sätze → mittig). */}
	{/* DEMO Film-Hero (Rasul 13.11.2026: „machen wir doch jetzt mal kurz eine Demo, wo wir unser Video
	   Bildschirmflächen machen, voll machen und das Menü so drübersetzen wie BBH. Ich möchte es einmal
	   sehen“). Nur sichtbar mit ?hero=film bzw. Schalter „Hero · Film“; Vorbild BBH Hero H1
	   (Nachschlagewerk Seite 01): randlos, volle Fensterhöhe, im Hochformat 3:4, stumm, Schleife.
	   Video nur lokal (Freigaben der Gäste fehlen). */}
	<div class="filmhero" aria-hidden="true">
		{/* Filme im Wechsel wie BBH (Rasul 13.11.2026). Austauschen = Liste ändern. Alle drei nur lokal
		   (public/lokal ist nicht versioniert), Freigaben der Gäste fehlen. Welcher Film: offen. */}
		<FilmKarussell filme={[
			{ src: "/lokal/szene-beweisaufnahme.mp4", titel: "Szene Beweisaufnahme" },
			{ src: "/lokal/hagen-blickkontakt.mp4", titel: "Hagen: Blickkontakt" },
			{ src: "/lokal/hagen-empfehlung.mp4", titel: "Hagen: Empfehlung" },
		]} />
	</div>
	<header class="hero">
		<div class="hero__buehne rahmen">
			<a class="hero__logo" href="/" aria-label="parley Film, Startseite">
				<LogoBiss class="hero__logo--gross" stufe={1} />
				<LogoBiss class="hero__logo--klein" stufe={3} />
			</a>
			{/* Statement nach BBH (B3, „We create iconic brands using difference“). Rasul 13.11.2026: „der erste
			   Text unter dem Video doch ein anderer. Da müssen wir jetzt kein Problem mehr schildern. Da können
			   wir wie BBH groß und fett sagen, was wir machen. Wir bringen Menschen in echte Gespräche. Filmreif
			   ohne Kamerastress. Und anstatt Menschen könnten wir Experten sagen.“ Formel wörtlich, ohne „und“.
			   Stufe huge, freier ausgewogener Umbruch (gemessen: passt ab 375 px ohne Überlauf).
			   Vorher (Rasul 10.11.): „Überall Experten. / Zeit für den Videobeweis.“, archiviert in
			   branding/aktiv/Parley_Website_Startseite_Texte_2026-11.md. */}
			{/* OHNE SCHLUSSPUNKT (Rasul 13.11.2026: „Lass mal den Punkt weg.“), wie BBH. Bei B und E bleibt der
			   Punkt nach dem ersten Satz.
			   GRÖSSE (Rasul 13.11.2026: „Bei BBH ist die Schrift deutlich größer bei dem Satz.“): Stufe hero wie
			   BBH (text-hero), nicht mehr huge. Gemessen: längstes Wort „ENTSCHEIDERN.“ 9,4 em, Platz ab 375 px
			   mindestens 9,9 em; passt also ohne Überlauf, solange kein längeres Wort dazukommt.
			   REGEL (Rasul 13.11.2026): „Ja, es muss ein Satz sein, es dürfen keine zwei sein.“ Deshalb bei A, C, D
			   die zweite Zeile „Filmreif ohne Kamerastress.“ entfernt; B und E bleiben als Rasuls Wortlaut stehen,
			   erfüllen die Regel aber nicht.
			   VERGLEICH (Rasul 13.11.2026: „Oder könnte unser Satz doch funktionieren, überall Experten? Zeit für
			   den Videobeweis.“): drei Statements, umschaltbar mit „Satz · A · B · C“ oder ?satz=a|b|c (nur lokal
			   gedacht, bis Rasul entscheidet). A: neu 13.11.; B: Hero vom 10.11.; C: Kandidat „zu Bekannten“. */}
			<div class="satz satz--a"><Haltung ebene="p" aufdecken zeilen={["Wir bringen Experten in echte Gespräche"]} /></div>
			<div class="satz satz--b"><Haltung ebene="p" aufdecken zeilen={["Überall Experten.", "Zeit für den Videobeweis"]} /></div>
			<div class="satz satz--c"><Haltung ebene="p" aufdecken zeilen={["Wir machen Experten zu Bekannten"]} /></div>
			{/* D: Rasul 13.11.2026: „Wir bringen Experten auf den Schirm von Entscheidern.“ */}
			<div class="satz satz--d"><Haltung ebene="p" aufdecken zeilen={["Wir bringen Experten auf den Schirm von Entscheidern"]} /></div>
			{/* E: Rasul 13.11.2026: „Wir liefern den Videobeweis. Für Experten mit echten Gesprächen.“ */}
			<div class="satz satz--e"><Haltung ebene="p" aufdecken zeilen={["Wir liefern den Videobeweis.", "Für Experten mit echten Gesprächen"]} /></div>
			{/* F: Rasul 13.11.2026: „Wir geben eurer Expertise einen Videobeweis.“ */}
			<div class="satz satz--f"><Haltung ebene="p" aufdecken zeilen={["Wir geben eurer Expertise einen Videobeweis"]} /></div>
			{/* G: Rasul 13.11.2026: „Wir machen echte Gespräche zum Videobeweis.“ Favorit: „Den finde ich
			   eigentlich ziemlich gut.“ Deshalb Grundeinstellung und h1. */}
			<div class="satz satz--g"><Haltung ebene="h1" aufdecken zeilen={["Wir machen echte Gespräche zum Videobeweis"]} /></div>
			{/* H: Rasul 13.11.2026: „Wir liefern den Videobeweis mit echten Gesprächen.“ */}
			<div class="satz satz--h"><Haltung ebene="p" aufdecken zeilen={["Wir liefern den Videobeweis mit echten Gesprächen"]} /></div>
			{/* I: Rasul 13.11.2026: „Wir liefern Videobeweise aus echten Gesprächen.“ */}
			<div class="satz satz--i"><Haltung ebene="p" aufdecken zeilen={["Wir liefern Videobeweise aus echten Gesprächen"]} /></div>
		</div>
		<KurzSaetze saetze={["Expertise beweist sich erst im echten Gespräch. Wir machen die Beweisaufnahme, filmreif und ohne Kamerastress. So werden Entscheider zu Augenzeugen eurer Kompetenz, noch vor dem ersten&nbsp;Kontakt."]} />
		<BrandLogo />
	</header>

	{/* ── 2 · DIE BEWEISKRAFT ── Baustein B6 Text-Bild: das Video ist der Anker links, Text rechts
	   (Analyse Teil 3, 2.1). ACHTUNG: Rasul hat „Video links, Schrift rechts“ am 13.11. ausprobiert
	   und zurückgenommen; hier steht es als Vorschlag. Rückweg auf „Video über dem Text“: Baustein
	   Textblock mit dem Video darüber. Video nur lokal (Freigaben der Gäste fehlen). */}
	{/* TEST Blasen (Rasul 13.11.2026: „ausprobieren, ob das funktioniert, wenn wir das Video kleiner
	   machen, aber nicht wie vorher auf halbe Bildschirmbreite, sondern größer und sozusagen dann die
	   Blasen dazu machen, dass das sozusagen das Gesamtvideo gibt“). Video mittig, am Rechner zwei Drittel
	   der Breite, am Handy 74 %: die Blasen ragen links und rechts je rund 13 % der Videobreite über das
	   Video hinaus und haben so Platz. Text mittig darunter (Textblock, R9). Rückweg: die Fassung
	   „Text-Bild, Video links“ steht als Kommentar direkt darunter. */}
	<section class="abschnitt" aria-labelledby="ab2-titel">
		<div class="blasen-buehne">
			<BlasenVideo src="/lokal/szene-beweisaufnahme.mp4" blasen={BLASEN as any} />
		</div>
		<div class="nach-textbild">
			<Textblock id="ab2-titel" titelZeilen={["Die Beweiskraft", "echter Gespräche."]}>
				<p>Mit einer Kamera kann man kein Gespräch führen. Deshalb sieht man bei uns keine. Wir fangen Gespräche ein, die so natürlich sind wie Gespräche am Küchentisch.</p>
				<p>Denn Entscheider stellen sich zwei Fragen: Habt ihr die Expertise? Und passt es&nbsp;menschlich?</p>
			</Textblock>
		</div>
	</section>
	{/* RÜCKWEG (bis 13.11.2026 vormittags):
	<section class="abschnitt" aria-labelledby="ab2-titel">
		<TextBild id="ab2-titel" medium="voll" titelZeilen={["Die Beweiskraft", "echter Gespräche."]}>
			<BlasenVideo slot="medium" src="/lokal/szene-beweisaufnahme.mp4" blasen={BLASEN as any} />
			<p>Mit einer Kamera kann man kein Gespräch führen. Deshalb sieht man bei uns keine. Wir fangen Gespräche ein, die so natürlich sind wie Gespräche am Küchentisch.</p>
			<p>Denn Entscheider stellen sich zwei Fragen: Habt ihr die Expertise? Und passt es&nbsp;menschlich?</p>
		</TextBild>
	</section>
	*/}

	{/* ── 3 · DAS BEWEISVERFAHREN ── Baustein B6 Text-Bild, Grafik als Anker rechts (Seitenwechsel
	   gibt Rhythmus wie bei BBH). Grafik offen: WEBSITE.md 3j. */}
	<section class="abschnitt" aria-labelledby="ab3-titel">
		<TextBild id="ab3-titel" seite="rechts" titel="Das Beweisverfahren.">
			<Platzhalter slot="medium" format="4/5" text="Platzhalter: Grafik Beweisverfahren (Kick-off bis Messen), WEBSITE.md 3j" />
			<p>Echte Experten haben keine Zeit für Videos. Müssen sie auch nicht. Wir gehen den ganzen Weg mit euch: von der redaktionellen Vorbereitung über die Aufnahme im Gesprächsmodus inklusive Live-Regie bis zur Verteilung des&nbsp;Beweismaterials.</p>
		</TextBild>
	</section>

	{/* ── 4 · DIE BEWEISSTÜCKE ── Band (nach BBH-Karussell B8) über der Überschrift (Rasul 13.11.2026:
	   „Ich setze die Animation für die Beweisstücke über die Beweisstücke.“). Überschrift und Text
	   ohne Anker, deshalb nach BBH in der Mitte (Textblock, 6 von 12). Kanalzeile als kurzer Satz mittig. */}
	<section class="abschnitt" aria-labelledby="ab4-titel">
		<Band formate={FORMATE} />
		<div class="kanaele">
			<KurzSaetze klein saetze={["LinkedIn · Website · Newsletter · Vertrieb"]} />
		</div>
		<div class="nach-band">
			<Textblock id="ab4-titel" titel="Die Beweisstücke.">
				<p>Der Beweis ist das echte Gespräch. Daraus werden skalierbare Beweisstücke für jeden eurer&nbsp;Kanäle.</p>
				<p><span class="entwurf">Dummy: Kacheln ohne Kundenclips, keine Kundenfreigabe. Später ein echtes Kundenbeispiel mit Freigabe.</span></p>
			</Textblock>
		</div>
	</section>

	{/* ── 5 · DIE AUGENZEUGEN ── Baustein B6 Text-Bild (Grafik als Anker links), darunter
	   B18 Kennzahl als mittige Einheit (Analyse 2.2), die Uhr und der Hinweis als kurzer Satz. */}
	<section class="abschnitt abschnitt--letzter" aria-labelledby="ab5-titel">
		<TextBild id="ab5-titel" titel="Die Augenzeugen.">
			<Platzhalter slot="medium" format="4/5" text="Platzhalter: Augenzeugen-Grafik folgt" />
			<p>Unsere Beweisstücke machen aus Zuschauern Augenzeugen. Wir messen die Zuschauerzeit und justieren die Formate daran. Mit der richtigen Frequenz haben Entscheider euch dann aktiv auf dem Schirm, wenn sie einen Experten&nbsp;brauchen.</p>
		</TextBild>
		<div class="nach-textbild">
			<Kennzahlen gross zahlen={[{ wert: "41,8", zeile: "Stunden Zuschauerzeit für ein einziges Format, in fünf Monaten." }]} quelle={'Industry Impact (Impact Strategies), LinkedIn, Clips vom 02.04. bis 01.09.2026.<br /><span class="entwurf">Platzhalter: nur mit Einverständnis von Impact Strategies</span>'} />
		</div>
		<div class="uhr rahmen"><MultiOutputKacheln nurUhr /></div>
		<KurzSaetze klein saetze={["Bleibt ihr im Takt, wird eure Stimme in der Branche mit der Zeit gehört."]} />
	</section>
</Layout>

<style>
	/* Satz-Vergleich: nur der gewählte Satz ist sichtbar (Grundeinstellung A) */
	.satz { display: none; margin: auto 0; }
	:global(html[data-satz="a"]) .satz--a,
	:global(html:not([data-satz])) .satz--g,
	:global(html[data-satz="g"]) .satz--g,
	:global(html[data-satz="h"]) .satz--h,
	:global(html[data-satz="i"]) .satz--i,
	:global(html[data-satz="f"]) .satz--f,
	:global(html[data-satz="e"]) .satz--e,
	:global(html[data-satz="d"]) .satz--d,
	:global(html[data-satz="b"]) .satz--b,
	:global(html[data-satz="c"]) .satz--c { display: block; }
	.satz :global(.haltung) { margin: 0; padding-block: var(--abstand-md); }
	.filmhero { display: none; }
	:global(html[data-hero="film"]) .filmhero { display: block; height: 100dvh; background: var(--black); }
	@media (orientation: portrait) {
		:global(html[data-hero="film"]) .filmhero { height: 133.333vw; }
	}

	/* Hero: erster Bildschirm = Logo + drei Zeilen; die erste Zeile des Erklärtexts lugt unten
	   hervor (Rasul 13.11.2026). */
	.hero__buehne {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: calc(100svh - var(--abstand-md) - 1.1 * var(--text-lg) - 24px);
		padding-top: 32px;
	}
	.hero__buehne :global(h1) { margin: auto 0; padding-block: var(--abstand-md); }
	.hero__logo { display: block; color: var(--white); }
	.hero__logo :global(svg) { display: block; height: auto; }
	.hero__logo :global(.hero__logo--gross) { display: none; width: calc(2.8964 * 96px); }
	.hero__logo :global(.hero__logo--klein) { width: calc(2.8964 * 40px); }
	@media (min-width: 1024px) {
		.hero__logo :global(.hero__logo--gross) { display: block; }
		.hero__logo :global(.hero__logo--klein) { display: none; }
	}
	.hero :global(.kurzsaetze) { margin-top: var(--abstand-md); }

	/* Abstände innerhalb eines Abschnitts (BBH: Text zu Medium lg, Überschrift zu Text md) */
	.kanaele { margin-top: var(--abstand-md); }
	.nach-band { margin-top: var(--abstand-lg); }
	.nach-textbild { margin-top: var(--abstand-lg); }
	.uhr { margin-top: var(--abstand-lg); }   /* die Uhr bringt ihre Breite selbst mit: min(542 px, 100 %), mittig */
	.uhr + :global(.kurzsaetze) { margin-top: var(--abstand-md); }
	/* Blasen-Test: Video mittig, Platz für die überstehenden Blasen (oben rund ein Drittel der Videobreite) */
	.blasen-buehne { width: 74%; margin: calc(var(--abstand-lg) + 22vw) auto 0; }
	@media (min-width: 1024px) { .blasen-buehne { width: 66.666%; max-width: 1150px; margin-top: calc(var(--abstand-lg) + 14vw); } }
	.abschnitt--letzter { margin-bottom: var(--abstand-xl); }
</style>

