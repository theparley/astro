	:global(html[data-textfolge="vorher"]) .anlass--band .anlass__titel { display: block; grid-row: 1; margin: 0 0 calc(3rem - var(--abstand-md)); padding-top: var(--abstand-lg); text-align: center; text-wrap: balance; hyphens: manual; }
