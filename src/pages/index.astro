<script>
	const logo = document.querySelector<HTMLElement>(".hero-logo");

	// Zwei Scroll-Phasen — Timing hier tunen. Das Öffnen der Pille (--grow)
	// passiert automatisch, sobald "The Parley" verschwunden ist (.collapsed).
	const BANNER_START = 0;
	const BANNER_DISTANCE = 100;
	const TEXT_START = 0;
	const TEXT_DISTANCE = 100;

	let rafId = 0;
	// Einmal verwandelt, bleibt es verwandelt — auch beim Zurückscrollen nach
	// oben. Statt der aktuellen Scroll-Position nehmen wir den bisher weitesten
	// erreichten Stand: der kann nur wachsen, nie sinken, die Animation läuft
	// also nie rückwärts (Fred: man würde sonst beim Hochscrollen das schon
	// geöffnete Menü wieder verlieren).
	let maxScrollY = window.scrollY;

	function progress(start: number, distance: number) {
		return Math.max(0, Math.min(1, (maxScrollY - start) / distance));
	}

	function update() {
		if (!logo) return;
		maxScrollY = Math.max(maxScrollY, window.scrollY);
		const bannerCollapse = progress(BANNER_START, BANNER_DISTANCE);
		const textCollapse = progress(TEXT_START, TEXT_DISTANCE);
		logo.style.setProperty("--banner-collapse", String(bannerCollapse));
		logo.style.setProperty("--text-collapse", String(textCollapse));
		// Hover/Klick sollen erst wirken, wenn "The Parley" fertig verschwunden
		// ist — vorher bleibt die Maus wirkungslos (siehe .collapsed im <style>).
		logo.classList.toggle("collapsed", bannerCollapse >= 1 && textCollapse >= 1);
	}

	function onScroll() {
		if (rafId) return;
		rafId = requestAnimationFrame(() => {
			update();
			rafId = 0;
		});
	}

	update();
	window.addEventListener("scroll", onScroll, { passive: true });
	window.addEventListener("resize", onScroll, { passive: true });

	// Klick hält den Button offen (wie Zwetschkes .open-Klasse) statt zur
	// Startseite zu navigieren — echtes Menü-Ziel kommt später. Wirkt nur, wenn
	// bereits gescrollt genug wurde ("The Parley" ist verschwunden) — sonst
	// bliebe ein "vorgemerktes" Öffnen stehen, das erst beim späteren Erreichen
	// von .collapsed unerwartet aufploppt.
	logo?.addEventListener("click", (event) => {
		event.preventDefault();
		if (!logo.classList.contains("collapsed")) return;
		logo.classList.toggle("is-open");
	});

	// Transition erst kurz nach dem ersten Seitenaufbau aktivieren (siehe
	// Kommentar bei .transitions-ready im <style>).
	setTimeout(() => {
		logo?.classList.add("transitions-ready");
	}, 100);
</script>
