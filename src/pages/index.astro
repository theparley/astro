		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titelbreit"])) .anlass--band .anlass__band-innen { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
		:global(html[data-textfolge="ohne"][data-spalten="titelbreit"]) .anlass--band .anlass__band-innen > .anlass__titel { text-align: left; }
