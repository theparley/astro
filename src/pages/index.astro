		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titellinks"], [data-spalten="titelbreit"]) .anlass--band .anlass__band-innen > .experten) { grid-column: 1 / -1; }
		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titellinks"], [data-spalten="titelbreit"])) .anlass--band .anlass__band-innen > .anlass__satz--zusammen { grid-column: 1; grid-row: 3; margin: 0; text-align: left; }
		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titellinks"], [data-spalten="titelbreit"])) .anlass--band .anlass__band-innen > .anlass__text { grid-column: 2; grid-row: 3; margin: 0; max-width: none; padding-top: var(--abstand-md); }
		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titellinks"], [data-spalten="titelbreit"])) .anlass--band .anlass__band-innen > .anlass__text > * + *,
		:global(html[data-textfolge="ohne"]:is([data-spalten="mitte"], [data-spalten="titellinks"], [data-spalten="titelbreit"])) .anlass--band .anlass__band-innen > .anlass__text p.anlass__schluss { margin-top: 32px; }
		/* Wirklich gleiche Hälften: „1fr 1fr“ gibt nach, wenn ein Inhalt breiter sein will (gemessen 19.11.2026: links
