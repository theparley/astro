---
import Layout from "../layouts/Layout.astro";
import BrandLogo from "../components/BrandLogo.astro";

// Produkte-Zeile (Website-Brief, gelockte Treppe 29.08. spät) — die vier
// buchbaren Formate als knappe Zeile nach dem Clip-Beweis. Noch keine
// Produktseiten live (Phase 1), deshalb reiner Text ohne Links.
const produkteZeile = "Videopodcast. Webinar. Clip. Kundentestimonial.";

// Essenz-Zeile in der zweiten Hälfte der Plädoyer-Sektion (Website-Brief,
// Fred 29.08. nachts): ausgeschriebener Satz statt Zahlen-Paar — "Ein
// Gespräch mit tausend Augenzeugen." ersetzt "1 Gespräch. 1000 Augenzeugen.",
// die Zahlen-Fassung bleibt als Vorrat für Beiträge/Splitflap dokumentiert.
// Reiner Wortlaut zur Referenz/für einen späteren Tausch — die tatsächliche
// Darstellung erzwingt jetzt manuelle Umbrüche (siehe Markup unten,
// Live-Feedback Fred), ist also nicht mehr ein reines Ein-Zeilen-Edit.
const soloLine = "Ein Gespräch mit tausend Augenzeugen.";
// Vorrat/Alternativen, noch nicht entschieden: "1 Gespräch. 1000 Augenzeugen."
// (Zahlen-Fassung, für Beiträge/Splitflap), "KI ist kein Augenzeuge."
---

<Layout title="Start" gateMenuBehindHero>
	<header class="hero">
		{/* Hero-Tausch (Fred 30.08. spät): der Dreizeiler aus der Essenz-Spalte
		   wird der Hero ("echt starker Hero"), "Kein Business ohne Witness."
		   wandert dafür in die Essenz-Spalte der Plädoyer-Sektion. Drei Sätze =
		   drei Zeilen (Spans mit display:block statt text-balance — die
		   Umbrüche sind hier Bedeutung, nicht Layout). */}
		<div class="hero-headline">
			{/* Hero-Rücktausch (Fred 2026-06-14): "Kein Business ohne Witness."
			   ist wieder der Hauptclaim groß oben — in den zwei bewährten
			   Zeilen. Der Dreizeiler ("Ihr habt die Expertise. / Wir
			   verteidigen sie. / Mit Augenzeugen.") ist raus; sein Inhalt lebt
			   sinngemäß im neuen Paragraph darunter ("Wir übernehmen die
			   Verteidigung eurer Expertise … Augenzeuge"). */}
		<h1><span>Kein Business</span><span>ohne Witness.</span></h1>
		</div>
		{/* Logo bleibt Markenpräsenz OHNE Menü-Funktion (Website-Brief
		   "Entscheidung 29.08."), ist aber wieder fixiert unten Mitte und
		   klappt scroll-getrieben ein (Zweite Nachbesserung 29.08. spät,
		   siehe Kommentar in BrandLogo.astro) — die interaktive
		   Kachel-Menü-Verwandlung des Logos bleibt archiviert in
		   TileMenu.astro, nur die reine Scroll-Dock-Choreografie ist zurück. */}
		<BrandLogo />
	</header>

	{/* "Der Paragraph" (Fred 2026-06-14): Fließtext über die ganze Breite,
	   Paragraph-Größe (gleiche BBH-Lead-Typo wie bisher) — ersetzt die
	   zweigeteilte Plädoyer-Sektion (Akten-Form + Essenz-Spalte). "Kein
	   Business ohne Witness." ist zurück im Hero; die Akten-Fassung des
	   Plädoyers und der Dreizeiler leben in Brief-Fortschritt + Git-Historie
	   (bewusst kein Code-Vorrat). Wortlaut = Freds Diktat, wörtlich. */}
	<section class="paragraph wrap">
		<p class="plaedoyer-text">Alle sind plötzlich Experten. Wissen gibt es auf Knopfdruck. Das geschriebene Wort im Marketing steht damit unter Generalverdacht.</p>
		<p class="plaedoyer-text">Wir übernehmen die Verteidigung eurer Expertise. Mit Formaten aus echten Gesprächen, die den Beweis liefern.</p>
		<p class="plaedoyer-text">Der Zuschauer wird zum Augenzeugen eurer Expertise, noch vor dem ersten Kontakt.</p>
	</section>

	{/* Segment 2 "Das Gespräch" (Fred 31.08.): dieselbe zweigeteilte Bauform
	   wie das Plädoyer, GESPIEGELT — das große Statement steht diesmal
	   RECHTS ("Filmreif / ohne Kamerastress.", aus dem Tour-Claim, "echte
	   Gespräche" bewusst weggelassen: das Wort Gespräch trägt schon der
	   Plädoyer-Schluss darüber). Markup-Reihenfolge Text→Essenz = mobil
	   steht der Text oben (beim Plädoyer ist es andersrum — die beiden
	   Segmente wechseln sich auch mobil ab).
	   Textspalte (Wording-Runde 2026-06-14): Fred-gewordetes Material aus dem
	   Profiltext-Ast (LinkedIn_Profil_Strategie, About-Kandidat 27./28.08. —
	   die "Verzweigung", nach der Fred fragte). Der dortige Absatz endet
	   wörtlich auf "Filmreif, ohne Kamerastress" — hier weggelassen, weil das
	   Statement rechts daneben steht. "Blickkontaktstudio" im Singular (die
	   Website hat EIN Studio; der Profiltext nutzt den Plural als Kategorie). */}
	<section class="plaedoyer plaedoyer--gespraech wrap">
		<div class="plaedoyer-half plaedoyer-half--text">
			<p class="plaedoyer-text">Mit einer Kamera kann man kein Gespräch führen. Deshalb sieht man in unserem Blickkontaktstudio keine.</p>
			<p class="plaedoyer-text">Ihr sprecht mit eurem Gegenüber, entspannt im Gesprächsmodus — und der Zuschauer erlebt das Gespräch aus der echten Gesprächspartner-Perspektive.</p>
		</div>
		<div class="plaedoyer-half plaedoyer-half--essence">
			<p class="essence-line">Filmreif.</p>
			<p class="essence-line">Ohne Kamerastress.</p>
		</div>
	</section>

	<section class="proof wrap">
		<div class="clip-placeholder">
			<span>Clip folgt</span>
		</div>
	</section>

	{/* Produkte-Zeile + In-Flow-CTA entfernt (Fred 30.08. nachts, "erstmal
	   komplett raus"): die Seite ist auf drei Segmente reduziert — Hero,
	   Plädoyer+Essenz, Clip-Platzhalter — plus Footer. Wortlaut der Produkte-
	   Zeile lebt weiter in der produkteZeile-Konstante oben (Vorrat), der
	   CTA-Wortlaut im Website-Brief (Konversions-Kapitel). */}

</Layout>

<style>
	/* Randabstand 1:1 von BBH übernommen (live gemessen): 16px bis 1024px
	   Breite, danach 32px — statt unserem vorherigen festen 24px ohne
	   Zwischenschritt. Gilt für .wrap UND .hero-headline, damit große Texte
	   nie ganz an den Bildschirmrand gehen. */
	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 1024px) {
		.wrap {
			padding: 0 32px;
		}
	}

	.hero {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.hero-headline {
		/* Hero-Korrektur nach BBHs Statement-Rezept (Fred 30.08., live auf der
		   BBH-Startseite gemessen — deren Original-Hero ist ein vollbreites
		   Video, die SCHRIFT-Statements laufen aber nie bis an den Rand):
		   (1) site-container-Deckel 1728px, mittig — bei 1920er-Viewport
		   entstehen dadurch allein 96px Luft je Seite, plus 32px px-site-
		   Padding = 128px gemessener Zeilen-Einzug. (2) text-center (BBHs
		   Statements sind zentriert, nicht linksbündig — daher wirkte unseres
		   "bis an den Rand gezogen"). */
		width: 100%;
		max-width: 1728px;
		margin: auto;
		padding: 0 16px;
		text-align: center;
		/* Optischer Ausgleich (Fred 30.08.): geometrisch war der Block exakt
		   mittig (320px oben wie unten, gemessen), wirkte aber leicht zu tief —
		   Unterlängen wiegen unten schwerer, und das fixierte Logo füllt die
		   untere Bildhälfte zusätzlich. Leichter Hub nach oben, skaliert mit
		   der Viewport-Höhe (~16px bei 1080er-Höhe). */
		transform: translateY(-2.5vh);
		/* Schrift skaliert wieder mit dem CONTAINER (cqw), nicht dem Viewport —
		   dadurch füllt die Zeile die Deckel-Breite exakt aus (Fred 30.08.:
		   "größer, bis sie bei der Breite ist") und hört bei 1728px einfach
		   auf zu wachsen: ab da entsteht die BBH-Luft (96px Deckel-Rand + 32px
		   Padding = 128px Zeilen-Einzug bei 1920, exakt BBHs Messwert). */
		container-type: inline-size;
	}

	@media (min-width: 1024px) {
		.hero-headline {
			padding: 0 32px;
		}
	}

	.hero h1 {
		/* Wie auf bartleboglehegarty.com: text-wrap:balance statt fester <br>-Umbrüche.
		   Der Browser entscheidet selbst, wie viele Zeilen und welche Wortgruppen —
		   kein manuelles Umschalten zwischen Zeilenzahlen nötig.
		   Größe füllt die Zeilen auf die Container-Breite; der Container ist
		   bei 1728px gedeckelt, die Schrift wächst ab da nicht mehr mit und
		   die BBH-Randluft entsteht von selbst. Hero-Rücktausch (Fred
		   2026-06-14): "Kein Business / ohne Witness." ist zurück — damit gilt
		   wieder die historische Kalibrierung 15.6cqw (längste Zeile "Kein
		   Business", ~97% Container-Auslastung; für den zwischenzeitlichen
		   Dreizeiler galten 9.6cqw). Zeilenhöhe bleibt 0.92 statt BBHs 0.82:
		   deren Statements sind VERSAL (keine Unterlängen), unsere
		   Mischschrift würde bei 0.82 kollidieren. */
		font-size: 15.6cqw;
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.01em;
	}

	.hero h1 span {
		/* Drei Sätze = drei Zeilen — die Umbrüche sind Bedeutung, kein
		   Balance-Layout. Beim Laden erscheinen sie ZEITVERSETZT und WISCHEN
		   herein wie der Seitenübergang (Fred 30.08. nachts: "wie die Seite
		   auch reinwischt, auf die einzelnen Sätze übertragen"): gleiche
		   Technik (clip-path legt von links frei), gleiche Dauer (800ms) und
		   exakt PageWipes symmetrische BBH-Kurve. Mehr Luft zwischen den
		   Sätzen als beim ersten Wurf — jeder Satz darf kurz allein stehen,
		   bevor der nächste antwortet. */
		display: block;
		animation: hero-line-wipe 800ms cubic-bezier(0.76, 0, 0.24, 1) both;
	}

	.hero h1 span:nth-child(1) {
		animation-delay: 100ms;
	}

	.hero h1 span:nth-child(2),
	.hero h1 span:nth-child(3) {
		/* Wisch-Achse gedreht (Fred 31.08., "wie wenn sie aus dem Text
		   rauskommen"): nur Zeile 1 wischt seitlich herein — Zeile 2 und 3
		   wischen VON OBEN NACH UNTEN auf, dieselbe Logik wie die
		   Menü-Zeilen (reiner clip-Wisch, gleiche Kurve, gleiche 800ms),
		   nur in Fallrichtung: jede Zeile materialisiert sich unter der
		   vorigen, als käme sie aus deren Text. */
		animation-name: hero-line-drop;
	}

	.hero h1 span:nth-child(2) {
		animation-delay: 1300ms;
	}

	.hero h1 span:nth-child(3) {
		/* Längere Pause vor der Pointe (Fred 30.08. nachts) — "Mit
		   Augenzeugen." darf sich ankündigen. */
		animation-delay: 2500ms;
	}

	@keyframes hero-line-wipe {
		/* Oben/unten -0.35em Luft im Zuschnitt (Fred-Befund 30.08. nachts):
		   die Zeilenhöhe (0.92) ist enger als die Schrift — Unterlängen wie
		   das g von "verteidigen" ragen aus der Satz-Box heraus, und ein
		   Zuschnitt auf exakt die Box (inset 0) schnitt sie ab: an der Stelle
		   erschien das Seiten-Schwarz "über" dem g. Mit negativem Inset
		   wischt der Effekt nur horizontal und lässt Über-/Unterlängen in
		   Ruhe — auch im Endzustand (fill: both). */
		from {
			clip-path: inset(-0.35em 100% -0.35em 0);
		}
		to {
			clip-path: inset(-0.35em 0 -0.35em 0);
		}
	}

	/* Vertikale Variante für Zeile 2+3: von oben nach unten freilegen.
	   Gleiche negative Seiten-Puffer wie beim horizontalen Wisch, damit
	   Über-/Unterlängen und der letzte Buchstabe nie angeschnitten werden
	   (line-height 0.92 < Glyphen-Ausdehnung, siehe hero-line-wipe). */
	@keyframes hero-line-drop {
		from {
			clip-path: inset(-0.35em -0.05em 100% -0.05em);
		}
		to {
			clip-path: inset(-0.35em -0.05em -0.35em -0.05em);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero h1 span {
			animation: none;
		}
	}

	/* Plädoyer-Sektion, ZWEIGETEILT (Website-Brief, Layout-Update 29.08. spät:
	   "das Split-Muster von Nuxt-Seite und BBH" — eine Hälfte der 4-Satz-Text,
	   die andere die Essenz groß; das ursprünglich geplante Eyebrow-Label
	   "Unser Eröffnungsplädoyer" ist per spätem Auftrags-Update wieder
	   entfernt, siehe Kommentar oben am Markup). Fließtext-Größe weiterhin
	   1:1 aus BBHs ausgeliefertem CSS gemessen (ea792231b42826ae.css, fetch +
	   Regex auf .text-*-original — die dortigen statischen px-Fallbacks der
	   fluid()-Kette, siehe Fortschritts-Eintrag 2026-08-29 für die Rohwerte):
	   .text-base-original: clamp(18px,16.7952px+.3012vw,22px) → Fließtext.
	   Essenz-Zeile hat eine eigene, größere Stufe bekommen (siehe Kommentar
	   bei .essence-line unten, überschreibt die ursprünglich geplante
	   BBH-text-xl-Übernahme).

	   Gewichtung Desktop (Website-Brief, Layout-Spec 29.08. nachts: "Teilung
	   EXAKT 50/50 — nicht nach Schriftgröße gewichtet — Muster: alte
	   Nuxt-Seite/BBH"): grid-template-columns minmax(0, 1fr) minmax(0, 1fr).
	   Bugfix beim Bau: reines "1fr 1fr" reicht NICHT für exakt gleiche
	   Spalten — fr-Tracks haben implizit eine min-width:auto-Untergrenze, und
	   die Essenz-Zeile (bis 6.25rem, ein einzelnes langes Wort als
	   Min-Content) zwang ihre Spalte dadurch messbar breiter als die
	   Text-Spalte (487.9px vs. 535.3px bei 1280px Viewport, live in der
	   Browser-Pane nachgemessen statt nur angenommen). minmax(0, 1fr) setzt
	   die Untergrenze explizit auf 0 und erzwingt echte 50/50-Gleichheit,
	   unabhängig vom Inhalt. max-width:46rem auf .plaedoyer-text bleibt als
	   reine Lesbarkeits-Zeilenlängen-Bremse bestehen (verhindert nur zu lange
	   Zeilen innerhalb der 50%-Spalte, ändert nichts an der Spaltenbreite
	   selbst).

	   Mobil (< 800px): untereinander, Reihenfolge = Markup-Reihenfolge, Text
	   VOR Essenz (Entscheidung, dokumentiert im Website-Brief-Fortschritt):
	   das ist die gleiche Argument-vor-Fazit-Reihenfolge, die die Seite schon
	   als zwei getrennte Sektionen hatte (Plädoyer, danach Solo-Zeile) — der
	   4-Satz-Absatz ist als Treppen-Stufe (nicken → Stich → zweites Nicken →
	   Entlastung) auf Vorwissen angewiesen, das die Essenz erst zusammenfasst;
	   umgekehrt gelesen (Essenz zuerst) nimmt der Pointe die eigene Herleitung
	   vorweg. */
	.plaedoyer {
		padding: 56px 0 64px;
		/* BBH-Maß 1:1 (Fred 30.08., Vergleich /about): BBHs site-container
		   deckelt bei 1728px, nicht 1400 — mit 1400 blieb unsere Halbspalte
		   bei 1920er-Viewport ~200px schmaler als BBHs (~620 vs ~830px), und
		   die cqw-gekoppelte Essenz-Schrift entsprechend unter deren 80px-
		   Niveau (gemessen: 51px vs. 42px bei 921er-Pane). Mit 1728 trifft
		   9.6cqw × ~830px-Spalte fast exakt BBHs 80px-Maximum. */
		max-width: 1728px;
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	@media (min-width: 800px) {
		.plaedoyer {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: clamp(40px, 6vw, 96px);
			align-items: center;
		}
	}

	.plaedoyer-text {
		max-width: 46rem;
		/* Referenz-Wechsel (Fred 30.08., Vergleich /offices/bbh-studios):
		   BBHs LEAD-Absätze sind größer als das About-Body-Rezept, das hier
		   vorher galt (20→26px) — live an zwei Breiten gemessen (921px:
		   23.38px / 1920px: 31.11px, Fluid-Deckel bei 1728) und daraus die
		   Gerade rekonstruiert: clamp(18px, 14.55px + 0.9583vw, 31.11px).
		   Zeilenhöhe dort 1.3 (nicht 1.2), Laufweite -0.02em unverändert. */
		font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: var(--white);
	}

	/* Absatz-Abstand ebenfalls BBH (`space-y-5 md:space-y-8`): 1.25rem
	   mobil, 2rem ab Desktop — wirkt durch den dichten Zeilenfall kompakt.
	   (Globales p{margin:0} in Layout.astro würde die drei Absätze sonst
	   zusammenkleben lassen.) */
	.plaedoyer-text + .plaedoyer-text {
		margin-top: 1.25rem;
	}

	@media (min-width: 800px) {
		.plaedoyer-text + .plaedoyer-text {
			margin-top: 2rem;
		}
	}

	/* Essenz-Hälfte in sich MITTIG gesetzt (Website-Brief, Layout-Spec: "die
	   Essenz-Zeile in sich MITTIG gesetzt — text-align center in ihrer
	   Hälfte"), unabhängig vom linksbündigen Fließtext in der Nachbarspalte.
	   container-type:inline-size (Nachbesserung Fred): macht die Hälfte zum
	   Bezugsrahmen für cqw-Einheiten IHRER Kinder — die Essenz-Schrift skaliert
	   dadurch mit der tatsächlichen Spaltenbreite, nicht mehr mit dem
	   Viewport (siehe .essence-line-Kommentar unten für die Fehlerursache). */
	.plaedoyer-half--essence {
		text-align: center;
		container-type: inline-size;
	}

	/* Essenz-Zeile — Größen-Historie (kurz): erst an BBHs text-xl orientiert
	   (max 50px), dann auf eine vw-geclampte Zwischenstufe angehoben (zweite
	   Nachbesserung überlief bei breiten Monitoren, siehe unten), dann auf
	   cqw umgestellt (an die Spalte statt den Viewport gekoppelt).

	   ZWEITE Nachbesserung (Fred, Screenshot bei ~2000px Viewport): bei sehr
	   breiten Monitoren lief die Zeile rechts aus dem Bild, weil font-size
	   mit dem VIEWPORT skalierte (vw-Anteil im Clamp), während die Spalte
	   selbst bei --max-width:1100px gedeckelt ist. Fix: font-size in cqw,
	   bezogen auf .plaedoyer-half--essence als eigenen Query-Container
	   (container-type:inline-size dort) — skaliert seither mit der
	   TATSÄCHLICHEN Spaltenbreite, kann bei keiner Breite mehr überlaufen.

	   FÜNFTE Nachbesserung (Fred): bei jener Kalibrierung (7.3cqw, ~37px bei
	   1280px) war die Zeile "deutlich zu klein". Referenz-Recherche gegen
	   bartleboglehegarty.com (ausgeliefertes CSS-Bundle
	   ea792231b42826ae.css, live gefetcht + auf .text-*-original-Klassen
	   durchsucht, UND live im Markup verifiziert, welche Klasse BBH
	   tatsächlich für "große Statement-Zeilen in halbbreiten Sektionen"
	   einsetzt — nicht nur die CSS-Definition, sondern echte Verwendung):
	   auf /about steht in einem `w-full md:w-1/2`-Split (Signatur-Bild
	   links, Text rechts — strukturell fast identisch zu unserer
	   Plädoyer-Sektion) der Eröffnungssatz "We are a global creative
	   company…" in `text-2xl`. text-xl (die vorherige Referenz, max. 50px)
	   wird auf allen geprüften Case-Study-Seiten nur für Seitentitel/Stat-
	   Zahlen verwendet, NICHT für Statement-Fließtext — text-2xl ist die
	   richtigere Referenz. .text-2xl-original: clamp(30px,14.9398px+
	   3.7651vw,80px) → bei 1280px Viewport: 14.9398+3.7651*12.8 ≈ 63,1px.
	   Cqw-Koeffizient neu kalibriert, um diesen Zielwert bei unserer
	   Spaltenbreite (511.6px bei 1280px Viewport) zu treffen: 63.1/511.6*100
	   ≈ 12.3cqw — live gemessen ergibt das 62.93px (praktisch exakt der
	   BBH-Zielwert).
	   Bei dieser Größe passt "mit tausend Augenzeugen." nicht mehr einzeilig
	   in die Spalte (Fred: "Priorität hat die GRÖSSE") — auf Freds Anweisung
	   deshalb DREIZEILER mit bewusst gesetzten Umbrüchen im Markup ("Ein
	   Gespräch" / "mit tausend" / "Augenzeugen.", siehe dort), die frühere
	   "tausend Augenzeugen bleibt zusammen"-Regel ist damit aufgehoben.
	   Breiten-Check je Zeile bei 1280px (Spalte 511.6px): "Ein Gespräch"
	   382.5px, "mit tausend" 344.3px, "Augenzeugen." 415.6px (die breiteste,
	   ~81% der Spalte — komfortabler Puffer). line-height 1.05 unverändert
	   (weiterhin in Freds Spanne 1.05–1.15). Min-Bound weiterhin niedrig
	   (1.5rem): eine harte Mindestgröße würde bei sehr schmalen Spalten
	   wieder überlaufen — Passung hat Vorrang. */
	.essence-line {
		/* Deckel exakt auf BBHs text-2xl-Maximum (80px) statt vorher 100px —
		   „Stil von BBH übernehmen", Fred 30.08.
		   cqw-Koeffizient neu kalibriert für den Statement-Tausch (Fred 30.08.):
		   längste Zeile ist jetzt "Ihr habt die Expertise." (~23 Zeichen statt
		   12 beim alten "Augenzeugen.") — 12.3cqw würde weit überlaufen.
		   Startwert rechnerisch (12.3 × 12/23 ≈ 6.4, plus Luft) und dann live
		   nachgemessen, siehe Fortschritts-Protokoll. */
		/* GESETZTE REGEL (Fred 31.08.): ALLE großen Segment-Statements der
		   Seite teilen EINE Größe — sie dürfen zwischen den Segmenten nicht
		   variieren. Kalibriert wird diese eine Zahl auf die längste
		   Statement-Zeile des gesamten Auftritts; kommt später ein längerer
		   Text dazu, wird HIER global gesenkt (keine Sonderregeln pro
		   Segment!). Aktuell längste Zeile: "Ohne Kamerastress." (Segment 2,
		   Canvas-Messung: 9.34× Schriftgröße breit → Maximum 10.7cqw, gesetzt
		   10.5 mit Sicherheitsmarge). "Kein Business ohne Witness." füllt
		   damit ~66% seiner Spalte — die frühere Kantenfüllungs-Kalibrierung
		   (13.4cqw, Historie im Git) ist der Gleichheits-Regel gewichen.
		   Deckel bewusst 6.875rem (110px) statt BBHs text-2xl (80px). */
		font-size: clamp(1.5rem, 10.5cqw, 6.875rem);
