---
import Layout from "../layouts/Layout.astro";

const ebenen = [
	{
		name: "Identität",
		text: "Expertise beweisbar machen für die, die Aufträge entscheiden.",
	},
	{
		name: "Mittel",
		text: "Echte Gespräche, Blickkontaktstudios, Live-Regie, Formatredaktion.",
	},
	{
		name: "Produkte",
		text: "Videopodcast, Webinar, Clip, Kundentestimonial.",
	},
];
---

<Layout title="Start" hideHeader>
	<header class="hero">
		<div class="hero-headline">
			<h1>Kein Business ohne Witness.</h1>
		</div>
		<a href="/" aria-label="The Parley" class="hero-logo">
			<img src="/parley/parley-flag.svg" alt="" aria-hidden="true" class="hero-logo__flag" />
			<img src="/parley/parley-text.svg" alt="The Parley" class="hero-logo__text" />
		</a>
	</header>

	{/* Vorerst ausgeblendet — reine Splash-Startseite (Headline + Logo), Rest kommt später zurück.
	<section class="proof wrap">
		<div class="clip-placeholder">
			<span>Clip folgt</span>
		</div>
	</section>

	<section class="ebenen wrap">
		{ebenen.map((e) => (
			<div class="ebene">
				<h2>{e.name}</h2>
				<p>{e.text}</p>
			</div>
		))}
	</section>

	<section class="cta wrap">
		<a href="/buchen" class="button">Gespräch buchen →</a>
	</section>

	<footer class="wrap">
		<nav>
			<a href="/impressum">Impressum</a>
			<a href="/datenschutz">Datenschutz</a>
		</nav>
	</footer>
	*/}
</Layout>

<style>
	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 24px;
	}

	.hero {
		position: fixed;
		inset: 0;
		display: flex;
		flex-direction: column;
	}

	.hero-headline {
		container-type: inline-size;
		padding: 0 24px;
		margin: auto 0;
	}

	.hero h1 {
		/* Wie auf bartleboglehegarty.com: text-wrap:balance statt fester <br>-Umbrüche.
		   Der Browser entscheidet selbst, wie viele Zeilen und welche Wortgruppen —
		   kein manuelles Umschalten zwischen Zeilenzahlen nötig. */
		font-size: 15.6cqw;
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.hero-logo {
		/* 50% größer als der normale Header-Logo-Maßstab, nur hier im Hero. */
		--logo-h: calc(clamp(32px, 4.4vw, 56px) * 1.5);
		display: flex;
		justify-content: center;
		align-items: flex-end;
		padding: 0 24px;
		/* Ladeanimation wie bei theparley.de (dort: seitliches Reinwischen der
		   Hero-Headline), hier aber von unten — wächst aus dem Boden, passend
		   zum Andocken an der Bildschirmkante. */
		animation: hero-logo-rise 700ms cubic-bezier(0.22, 0.61, 0.36, 1) 150ms both;
	}

	@keyframes hero-logo-rise {
		from {
			clip-path: inset(100% 0 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-logo {
			animation: none;
		}
	}

	.hero-logo__flag {
		display: block;
		width: calc(var(--logo-h) * 1160.62 / 2018.08);
		height: var(--logo-h);
	}

	.hero-logo__text {
		display: block;
		height: calc(var(--logo-h) * 1057.41 / 2018.08);
		width: auto;
		margin-left: 4px;
	}

	.proof {
		padding: 24px 0 64px;
	}

	.clip-placeholder {
		aspect-ratio: 16 / 9;
		width: 100%;
		border: 1px solid #2a2a2a;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gray);
		font-size: 0.9rem;
	}

	.ebenen {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
		padding: 48px 0;
		border-top: 1px solid #2a2a2a;
	}

	.ebene h2 {
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray);
		margin-bottom: 12px;
	}

	.ebene p {
		font-size: 1.1rem;
		line-height: 1.4;
	}

	.cta {
		padding: 64px 0;
		text-align: center;
	}

	.button {
		display: inline-block;
		border: 1px solid var(--white);
		padding: 16px 32px;
		text-decoration: none;
		font-size: 1.1rem;
	}

	footer {
		padding: 32px 0 64px;
		border-top: 1px solid #2a2a2a;
	}

	footer nav {
		display: flex;
		gap: 24px;
		font-size: 0.85rem;
		color: var(--gray);
	}

	footer a {
		text-decoration: none;
		color: inherit;
	}

	@media (max-width: 700px) {
		.ebenen {
			grid-template-columns: 1fr;
		}
	}
</style>
