---
import Layout from "../layouts/Layout.astro";

const ebenen = [
	{
		name: "Identität",
		text: "Expertise beweisbar machen für die, die Aufträge entscheiden.",
	},
	{
		name: "Mittel",
		text: "Echte Gespräche, Blickkontaktstudios, Live-Regie, Formatredaktion.",
	},
	{
		name: "Produkte",
		text: "Videopodcast, Webinar, Clip, Kundentestimonial.",
	},
];
---

<Layout title="Start">
	<header class="hero">
		<div class="wrap">
			<h1>Kein Business<br />ohne Witness.</h1>
			<p class="sub">Echte Gespräche, filmreif ohne Kamerastress.</p>
			<p class="sub sub--dim">Als Videopodcast, Webinar, Clip oder Kundentestimonial.</p>
		</div>
	</header>

	<section class="proof wrap">
		<!-- TODO Phase 1: self-hosted mp4 + Poster statt Platzhalter, sobald Material freigegeben -->
		<div class="clip-placeholder">
			<span>Clip folgt</span>
		</div>
	</section>

	<section class="ebenen wrap">
		{ebenen.map((e) => (
			<div class="ebene">
				<h2>{e.name}</h2>
				<p>{e.text}</p>
			</div>
		))}
	</section>

	<section class="cta wrap">
		<a href="/buchen" class="button">Gespräch buchen →</a>
	</section>

	<footer class="wrap">
		<nav>
			<a href="/impressum">Impressum</a>
			<a href="/datenschutz">Datenschutz</a>
		</nav>
	</footer>
</Layout>

<style>
	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 24px;
	}

	.hero {
		/* Header ist bis zu 96px hoch (20px Padding + 56px Logo + 20px Padding, max. Breakpoint).
		   48px extra Puffer, damit sich Header und Headline nicht nur knapp nicht berühren. */
		padding: 144px 0 48px;
	}

	.hero .wrap {
		container-type: inline-size;
	}

	.hero h1 {
		font-size: clamp(2.4rem, 15.6cqw, 12rem);
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.01em;
		margin-bottom: 32px;
	}

	@media (min-width: 700px) {
		.hero h1 {
			white-space: nowrap;
		}
	}

	.sub {
		margin-top: 20px;
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		max-width: 34ch;
	}

	.sub--dim {
		color: var(--gray);
		margin-top: 8px;
	}

	.proof {
		padding: 24px 0 64px;
	}

	.clip-placeholder {
		aspect-ratio: 16 / 9;
		width: 100%;
		border: 1px solid #2a2a2a;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gray);
		font-size: 0.9rem;
	}

	.ebenen {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
		padding: 48px 0;
		border-top: 1px solid #2a2a2a;
	}

	.ebene h2 {
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray);
		margin-bottom: 12px;
	}

	.ebene p {
		font-size: 1.1rem;
		line-height: 1.4;
	}

	.cta {
		padding: 64px 0;
		text-align: center;
	}

	.button {
		display: inline-block;
		border: 1px solid var(--white);
		padding: 16px 32px;
		text-decoration: none;
		font-size: 1.1rem;
	}

	footer {
		padding: 32px 0 64px;
		border-top: 1px solid #2a2a2a;
	}

	footer nav {
		display: flex;
		gap: 24px;
		font-size: 0.85rem;
		color: var(--gray);
	}

	footer a {
		text-decoration: none;
		color: inherit;
	}

	@media (max-width: 700px) {
		.ebenen {
			grid-template-columns: 1fr;
		}
	}
</style>
