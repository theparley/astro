---
// PROBE-SEITE fuer die Multi-Output-Kacheln.
//
// Seit 21.09. haelt diese Seite den Bau NICHT mehr selbst — er ist nach
// MultiOutputKacheln.astro gezogen, weil er auf der Startseite steht.
// Die Seite ist nur noch ein Rahmen zum Anschauen und Umschalten, damit
// Probe und Startseite nicht auseinanderlaufen koennen (dieselbe Lehre wie
// bei der GIF-Werkstatt: EINE Basis, zwei Ansichten).
//
// ?liste zeigt statt des Fallblatts die statische Aufzaehlung.
// DIAGNOSE-SCHALTER (Fred 21.09., „mittendrin laeuft das Rauszoomen nicht
// smooth"): auf dem Handy laesst sich nicht messen, nur vergleichen. Die
// Schalter nehmen je einen Malaufwand aus Kachel 2 heraus (display:none,
// nichts wird gemalt), damit Fred sieht, welcher es ist:
//   ?ohne-zeiger    die 176 dunklen Zeiger der kleinen Uhren
//   ?ohne-minuten   die 60er-Minutenkraenze der kleinen Uhren
//   ?ohne-fuenf     die Fuenf-Minuten-Kraenze der kleinen Uhren
//   ?nur-viertel    beides (nur die vier Viertelstriche bleiben)
// Kombinierbar: ?ohne-zeiger&nur-viertel
import Layout from "../layouts/Layout.astro";
import MultiOutputKacheln from "../components/MultiOutputKacheln.astro";
---

<Layout title="Kacheln (Probe)">
	<section class="probe">
		<h1>Zwei Kacheln</h1>
		<p class="probe-sub">
			Probe-Rahmen. Der Bau selbst steht in MultiOutputKacheln.astro und
			laeuft seit 21.09. auf der Startseite. <code>?liste</code> schaltet
			Kachel 1 auf die statische Aufzaehlung.
		</p>

		<MultiOutputKacheln />

		<p class="probe-notiz">
			Kachel 2 rechnet nach Fläche: hundertfache Fläche = zehnfacher Durchmesser.
			Die dritte Kachel („1000 Zuschauer") ist am 20.09. entfallen — über
			Plattformen hinweg lässt sich nicht entdoppeln.
		</p>
	</section>
</Layout>

<style>
	/* Diagnose-Schalter, s. Kopf der Datei. */
	:global(body.ohne-zeiger .zeiger),
	:global(body.ohne-minuten .blatt--dunkel.minute),
	:global(body.ohne-fuenf .blatt--dunkel.fuenf) {
		display: none;
	}
	.probe {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: clamp(60px, 10vw, 140px) 24px 120px;
	}

	h1 {
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.9;
		letter-spacing: -0.01em;
		font-size: clamp(2.5rem, 1rem + 7vw, 8rem);
		margin: 0 0 12px;
	}

	.probe-sub,
	.probe-notiz {
		color: var(--gray);
		font-size: 0.95rem;
		margin: 0 0 48px;
	}

	.probe-notiz {
		margin: 40px 0 0;
	}
</style>

<script>
	// Umschalter ?liste — bewusst simpel, es ist eine Probe. Der Default
	// kommt jetzt serverseitig aus der Komponente (Fassung „brett"); hier
	// wird er nur fuer die Probe wieder abgeraeumt.
	function fassung() {
		const reihe = document.querySelector(".kachel-reihe");
		if (!reihe) return;
		const p = new URLSearchParams(location.search);
		reihe.classList.toggle("kacheln--brett", !p.has("liste"));
		document.body.classList.toggle("ohne-zeiger", p.has("ohne-zeiger"));
		document.body.classList.toggle("ohne-minuten", p.has("ohne-minuten") || p.has("nur-viertel"));
		document.body.classList.toggle("ohne-fuenf", p.has("ohne-fuenf") || p.has("nur-viertel"));
	}
	document.addEventListener("astro:page-load", fassung);
</script>
