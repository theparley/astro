---
// PROBE /kacheln — die Alternative zur Fallblatt-Wand (Fred-Diktat 20.09.
// abends). Drei Kacheln NEBENEINANDER statt drei Akte NACHEINANDER: die Wand
// zeigt die Verhältnisse in der Zeit, diese Reihe zeigt sie im Raum, der
// Leser vergleicht selbst statt zu warten. Kachelform übernommen von der
// Bausteine-Reihe der Startseite (4:5, container-type: inline-size).
//
// NICHT eingebunden — eigene Seite, damit die Startseite unberührt bleibt.
// Konzept steht im Website-Dokument über dem Wand-Kapitel.
import Layout from "../layouts/Layout.astro";
import { LOGOS } from "../lib/fallblatt";

// Die zehn Varianten als schlichte Liste (Fred 20.09. abends: "schreibt
// ihr einfach mal normal, untereinander"). Das Fallblatt-Board davor trug
// den Inhalt nicht — zehn Zeilen in Kachelschrift wurden in der kleinen
// Kachel unleserlich, und das Klappern lenkte von der Aufzählung ab.
//
// Woher die Zehn kommt: es sind die neun Zeilen, die schon auf der Wand
// stehen, plus die WEBSITE, die in Freds eigener Aufzählung vorkam und in
// der Wand fehlt. Namen sind auf die Plattform verkürzt (LINKEDIN statt
// LINKEDIN-BEITRÄGE), damit das Board in die Kachelbreite passt: längster
// Eintrag ist AUDIO-PODCAST mit 13 Zeichen.
// OFFEN: TRANSKRIPT und KI-ZITATE hat Fred als "keine Ausspielungen in dem
// Sinn" bezeichnet — sie stehen hier drin, weil die Zehn sonst nicht
// aufgeht. Sein Entscheid steht aus.
// Logo-Reihenfolge je Zeile wie in der Wand: die HÄUFIGSTE Plattform sitzt
// außen an der gemeinsamen rechten Kante (dort teilen sich alle Zeilen die
// Spalte), seltenere wandern nach innen.
const varianten: Array<[string, string, string[]]> = [
	["1", "Livestream", ["linkedin", "youtube"]],
	["1", "Videopodcast", ["web", "youtube"]],
	["1", "Audio-Podcast", ["spotify", "apple", "web"]],
	["10", "LinkedIn-Beiträge", ["linkedin"]],
	["10", "Clips", ["instagram", "tiktok", "linkedin", "youtube"]],
	["10", "Shorts", ["instagram", "tiktok", "youtube"]],
	["1", "Newsletter", ["mail"]],
	["1", "Landingpage", ["web"]],
	["1", "Transkript", ["web"]],
	// „KI-lesbar" war Freds Vorschlag, die Recherche spricht dagegen: es ist
	// ein Adjektiv („10 KI-lesbar" ist ungrammatisch, alle Nachbarzeilen
	// sind Substantive) und behauptet nur Maschinenlesbarkeit, also die
	// Eintrittsbedingung statt der Redaktionsleistung.
	["10", "Zitate für KI", ["chatgpt", "claude", "gemini"]],
];

// Männchen als Hintergrund-Kachelung (Kachel 3). Ein einziges DIV statt
// tausend Knoten: background-repeat macht aus EINER Figur beliebig viele,
// background-size ist der Zoom. Die Figur kommt aus dem gemeinsamen Modul,
// damit Wand und Kachelreihe dieselbe zeigen.
// ACHTUNG XML-NAMENSRAUM (Fehler gefunden 20.09. abends): im HTML ergänzt
// der Browser das xmlns von selbst, eine SVG-Datei als BILD braucht es aber
// zwingend. Ohne xmlns lädt die data-URI gar nicht — die Kachel blieb
// schwarz, während die Animation im Hintergrund brav lief und eine
// unsichtbare Größe verstellte. Genau Freds "funktioniert immer noch nicht".
// LUFT UM DIE FIGUR (Fred 20.09. abends: "die kleben alle aneinander"): die
// Material-Figur füllt ihre viewBox randlos aus, gekachelt stoßen die
// Männchen deshalb Schulter an Schulter und Kopf an Fuß. Hier bekommt sie
// eine eigene, größere Leinwand: 100 × 100 Einheiten, die Figur 72 davon,
// mittig — also 14 Einheiten Rand ringsum und rund 28 Prozent Abstand
// zwischen zwei Nachbarn. Die Zellenzahl ändert sich dadurch nicht, nur die
// Figur darin wird kleiner.
const personPfad = (LOGOS.person.match(/<path d="([^"]+)"/) || [])[1] ?? "";
// ZWEI FIGUREN IN EINER KACHELUNG (Fred 20.09. abends, dritter Anlauf:
// "du zoomst immer noch von der Seite"). Der Grund lag nicht am Versatz,
// sondern an der Bauform: eine Kachelung mit EINER Figur hat in ihrer Mitte
// entweder eine Figur (dann sieht man am Start drei) oder eine Fuge (dann
// muss der Versatz für jede Zellgröße neu gerechnet werden — und zwischen
// zwei Rechenpunkten wandert das Raster seitlich weg, genau der Eindruck).
// Eine Kachelung mit ZWEI Figuren nebeneinander löst beides: ihre Mitte
// liegt zwischen den beiden, und "background-position: center" hält diese
// Mitte bei JEDER Größe fest. Kein Versatz, kein Wandern, symmetrisch.
//
// Figuren schwarz mit weißem Saum wie der Punkt in Kachel 2.
// paint-order='stroke' legt den Strich unter die Füllung, sonst frisst er
// die Figur von innen auf.
const figur = (x: number, stil: string) =>
	"<g transform='translate(" + x + " 104) scale(0.1125)' " + stil + ">" +
	"<path d='" + personPfad + "'/></g>";
const doppel = (stil: string) =>
	"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100'>" +
	figur(-4, stil) +
	figur(96, stil) +
	"</svg>";
// ZWEI EBENEN (Fred 20.09. abends): die beiden, mit denen wir starten,
// bleiben SCHWARZ mit weißem Saum — alle anderen sind weiß. Oben liegt
// deshalb eine einzelne, nicht wiederholte Doppelfigur in Schwarz, darunter
// die weiße Menge als Kachelung. Beide sind mittig und werden gleich
// skaliert, die schwarze deckt also immer genau die zwei mittleren der
// Menge ab und zoomt mit ihnen mit.
const personSvgSchwarz = doppel(
	"fill='#0d0d0d' stroke='#ffffff' stroke-width='34' paint-order='stroke' " +
	"stroke-linejoin='round'",
).replace(/"/g, "'");
const personSvgWeiss = doppel("fill='#ffffff'").replace(/"/g, "'");
const uri = (svg: string) => `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;

---

<Layout title="Kacheln (Probe)">
	<section class="probe">
		<h1>Drei Kacheln</h1>
		<p class="probe-sub">
			Probe der Alternative zur Fallblatt-Wand. Nicht verlinkt, nicht eingebunden.
		</p>

		<div class="kachel-reihe">
			{/* ── Kachel 1: Gespräch → Ausspielungen ───────────────────────── */}
			<div class="feld">
				<div class="kachel-kopf">
					<p class="verhaeltnis">1 <span class="zu">zu</span> 10</p>
					<p class="bezug">Ein Gespräch im Monat. Zehn Varianten für alle Kanäle.</p>
				</div>
				<div class="kachel">
				<div class="kachel-mitte kachel-mitte--liste">
					<ul class="varianten">
						{varianten.map(([zahl, wort, kanaele]) => (
							<li>
								<span class="eintrag">
									<span class="anzahl">{zahl}</span>
									{wort}
								</span>
								<span class="kanaele">
									{kanaele.map((k) => (
										<span class="kanal" set:html={LOGOS[k]} />
									))}
								</span>
							</li>
						))}
					</ul>
				</div>
				</div>
			</div>

			{/* ── Kachel 2: Stunde → Zuschauerzeit ─────────────────────────── */}
			{/* Der Kreis wächst auf die HUNDERTFACHE FLÄCHE, also den
			   ZEHNFACHEN Durchmesser (Fred 20.09.: "berechnen das 100 mal nach
			   Fläche"). Hundertfacher Durchmesser wäre die zehntausendfache
			   Fläche — das Bild behauptete dann hundertmal mehr als die Zahl. */}
			<div class="feld">
				<div class="kachel-kopf">
					<p class="verhaeltnis">1 <span class="zu">zu</span> 100+</p>
					<p class="bezug">Eine Stunde Aufnahme im Monat zu mehr als hundert Stunden Zuschauerzeit.</p>
				</div>
				<div class="kachel">
				<div class="kachel-mitte">
					<div class="kreis-buehne" data-kreis>
						{/* Die weiße Fläche wächst, der schwarze Punkt in ihrer
						   Mitte bleibt (Fred 20.09. abends). Am Anfang liest sich
						   das als Punkt mit weißem Rand; am Ende steht dieselbe
						   Stunde als kleiner Punkt in einem hundertmal größeren
						   Feld. Die 1 verschwindet nicht, sie wird eingeholt. */}
						<span class="uhr uhr--gross">
							<span class="bogen"></span>
							<span class="speiche speiche--start"></span>
							<span class="speiche speiche--lauf"></span>
						</span>
						<span class="uhr uhr--klein">
							<span class="bogen"></span>
							<span class="speiche speiche--start"></span>
							<span class="speiche speiche--lauf"></span>
						</span>
					</div>
				</div>
				</div>
			</div>

			{/* ── Kachel 3: Experten → Zuschauer ───────────────────────────── */}
			{/* RAUSZOOMEN (Freds Bild): erst steht EINE Figur formatfüllend da,
			   wie durch ein Objektiv herangeholt. Dann fährt die Kamera zurück,
			   die Figur wird kleiner, und aus der Wiederholung entstehen erst
			   viele Menschen, am Ende fast Punkte. Technisch EIN Element:
			   background-repeat macht die Menge, background-size ist der Zoom
			   — kein einziger zusätzlicher Knoten für tausend Leute. */}
			<div class="feld">
				<div class="kachel-kopf">
					<p class="verhaeltnis">2 <span class="zu">zu</span> 1000+</p>
					<p class="bezug">Zwei Experten erreichen mehr als tausend Zuschauer.</p>
				</div>
				<div class="kachel">
				<div class="kachel-mitte">
					<div class="menge" data-menge>
						<span class="menge-lage menge-weiss" style={`--person: ${uri(personSvgWeiss)}`}></span>
						<span class="menge-lage menge-schwarz" style={`--person: ${uri(personSvgSchwarz)}`}></span>
					</div>
				</div>
				</div>
			</div>
		</div>

		<p class="probe-notiz">
			Kachel 2 rechnet nach Fläche: hundertfache Fläche = zehnfacher Durchmesser.
			Kachel 3 zoomt aus einer Figur auf rund tausend heraus.
		</p>
	</section>
</Layout>

<style>
	.probe {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: clamp(60px, 10vw, 140px) 24px 120px;
	}

	h1 {
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.9;
		letter-spacing: -0.01em;
		font-size: clamp(2.5rem, 1rem + 7vw, 8rem);
		margin: 0 0 12px;
	}

	.probe-sub,
	.probe-notiz {
		color: var(--gray);
		font-size: 0.95rem;
		margin: 0 0 48px;
	}

	.probe-notiz {
		margin: 40px 0 0;
	}

	.kachel-reihe {
		display: grid;
		gap: 16px;
	}

	@media (min-width: 800px) {
		.kachel-reihe {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/* Kachelform 1:1 aus der Bausteine-Reihe der Startseite. */
	/* SCHRIFT UEBER DIE KACHEL (Fred 20.09. abends): Verhaeltnis und
	   Bezugszeile stehen nicht mehr IN der Flaeche, sondern darueber. Die
	   Kachel ist damit reines Bild.
	   Der Container fuer die cqw-Einheiten bleibt auf der KACHEL — alle
	   Masse der Animationen sind daran bemessen. Der Kopf bekommt seinen
	   eigenen Container auf dem Feld, damit seine Schriftgroessen weiter
	   mit der Spaltenbreite wachsen. */
	.feld {
		container-type: inline-size;
		display: grid;
		grid-template-rows: auto auto;
		gap: clamp(10px, 1.4vw, 20px);
	}

	.kachel {
		position: relative;
		background: var(--panel);
		aspect-ratio: 4 / 5;
		/* Rand in cqw statt in Pixeln (20.09. abends): nur so bleibt das
		   Verhaeltnis zwischen Feldbreite und Kachel-Innenbreite ueber alle
		   Fensterbreiten konstant — und nur dann treffen die Schriftgroessen
		   in Kopf und Liste dauerhaft aufeinander (siehe .varianten). */
		padding: 2.5cqw;
		display: grid;
		grid-template-rows: 1fr;
		container-type: inline-size;
		overflow: hidden;
	}

	/* Überschrift ist das VERHÄLTNIS (Fred 20.09. abends): die Kachel sagt
	   zuerst die Relation, erst darunter steht klein, was ins Verhältnis
	   gesetzt wird — und zwar AUSGESCHRIEBEN, die Zahlen wiederholt
	   ("Ein Gespräch im Monat zu neun Ausspielungen."). Die Ziffern oben
	   sind das Signal, der Satz darunter die Auflösung; wer nur das
	   Verhältnis sieht, hat es schon, wer liest, bekommt es bestätigt.
	   Der Doppelpunkt ist ausgeschrieben (Fred 20.09. abends): "1 zu 9"
	   statt "1:9" — das Verhältnis wird damit selbst schon gesprochen und
	   nicht erst in der Zeile darunter. Kostet Größe: die längste Fassung
	   ist jetzt "2 zu 1000+", die Schrift musste entsprechend kleiner. */
	/* Nur der Kopf wird gestapelt. Die mittlere Zeile darf KEINE eigene
	   Positionierung bekommen — sonst wird sie der Bezug fuer die absolut
	   liegende Menge in Kachel 3, und die bleibt wieder im Rahmen stecken
	   (genau der Fehler, den Fred gemeldet hat). */
	.kachel-kopf {
		position: relative;
		z-index: 1;
	}

	.verhaeltnis {
		margin: 0;
		font-weight: 900;
		line-height: 0.85;
		letter-spacing: -0.03em;
		font-size: 21cqw;
		white-space: nowrap;
	}

	/* Das Bindewort steht in der dünnen Schrift (Fred 20.09. abends): die
	   Zahlen tragen, "zu" verbindet nur. Gleiche Bauform wie in der Wand,
	   wo die Beschriftungen leichter wiegen als die Zahlen. */
	.zu {
		font-weight: 300;
	}

	.bezug {
		margin: 8px 0 0;
		font-weight: 300;
		line-height: 1.15;
		font-size: 5.2cqw;
		color: var(--gray);
	}

	.kachel-mitte {
		display: grid;
		place-items: center;
		min-height: 0;
		/* KEIN position: relative — sonst wird diese Zeile der Bezug fuer
		   die absolut liegende Menge in Kachel 3, und die bleibt in der
		   Rasterzeile stecken statt die ganze Kachel zu fuellen. Die
		   Kreis-Buehne in Kachel 2 bringt ihren eigenen Bezug mit. */
	}

	/* Das Board muss in die Resthöhe der Kachel passen: zehn Zeilen mal
	   Kachelhöhe (Breite × 1,38) plus Fugen. 5,4cqw Kachelbreite ergibt
	   rund 75cqw Boardhöhe und 70cqw Breite bei 13 Spalten — beides sitzt
	   innerhalb der Kachel. */
	.kachel-mitte--liste {
		align-content: start;
		/* stretch statt start (Fred 20.09. abends): die Liste soll die volle
		   Kachelbreite einnehmen, damit die Zahlenspalte ganz links am Rand
		   sitzt und die Piktogramme ganz rechts am Anschlag. Vorher war die
		   Liste nur so breit wie ihr längster Eintrag und hing als Block in
		   der Mitte. */
		justify-items: stretch;
		overflow: hidden;
	}

	.varianten {
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		font-weight: 300;
		/* GENAUSO GROSS WIE DIE BEZUGSZEILE (Fred 20.09. abends). Die steht
		   im Feld (volle Spaltenbreite) auf 5,2cqw, die Liste steht in der
		   Kachel und misst ihre cqw an deren Innenbreite — die ist um den
		   Rand schmaler. 5,2 / 0,95 = 5,47cqw gleicht das aus. */
		font-size: 5.47cqw;
		line-height: 1.62;
		letter-spacing: -0.01em;
	}

	/* Zahlenspalte rechtsbündig wie in der Wand: die Einser fluchten unter
	   den Zehnern, die Wörter beginnen alle auf derselben Kante. */
	.varianten li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		/* Mindestabstand zwischen Namen und Piktogrammen. Der Kachelrand
		   allein war zu knapp (Fred 20.09. abends, zweite Sichtung: "sieht
		   immer noch zu eng aus") — bei dieser Schriftgröße sind 18 px
		   weniger als eine halbe Zeilenhöhe. Jetzt an der SCHRIFT bemessen,
		   nicht am Rand: 2,4 Zeichenhöhen, also rund das Doppelte. */
		gap: 2.4em;
	}

	/* Kanal-Piktogramme rechtsbündig an der gemeinsamen Kante, wie die
	   Logo-Kolonne der Wand. Größe an der Zeile ausgerichtet, damit sie die
	   Liste begleiten statt sie zu dominieren. */
	.kanaele {
		display: flex;
		align-items: center;
		gap: 0.3em;
		flex: none;
	}

	.kanal {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.05em;
		height: 1.05em;
	}

	.kanal :global(svg) {
		width: 100%;
		height: 100%;
		display: block;
	}

	/* LinkedIn ist bewusst Text („in"), kein SVG — dieselbe Setzung wie in
	   der Wand. Das Styling dafür lebt dort im globalen Block der
	   Wand-Komponente; die steht auf dieser Seite nicht, also hier nochmal. */
	.kanal :global(.mo-logo-text) {
		font-family: -apple-system, "Helvetica Neue", sans-serif;
		font-weight: 800;
		font-size: 0.95em;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	/* Spaltenbreite EXAKT zwei Ziffern (Fred 20.09. abends: "noch nicht weit
	   genug aussen"). Vorher waren es 2,2em — deutlich mehr, als "10"
	   braucht, weshalb selbst die Zehnerzeilen eingerueckt standen und die
	   Liste nicht auf der Textkante der Ueberschrift sass. "ch" ist die
	   Breite der Null, tabular-nums macht alle Ziffern gleich breit: damit
	   fluchtet "10" genau mit dem Text darueber, und die Einser stehen eine
	   Ziffer eingerueckt — dieselbe Zahlenspalte wie in der Wand. */
	.anzahl {
		display: inline-block;
		font-variant-numeric: tabular-nums;
		width: 2ch;
		margin-right: 0.45em;
		text-align: right;
		/* Kein Fettdruck (Fred 20.09. abends, nach Sichtung): die Zahlen
		   sollen die Spalte halten, nicht die Zeile beherrschen. Die
		   Überschrift der Kachel ist das Verhältnis — wenn die Liste
		   darunter auch noch fett zählt, bekommt die Kachel zwei laute
		   Stimmen. */
	}

	/* ── Kachel 2: Kreis ───────────────────────────────────────────────── */
	/* Die Buehne sitzt HOEHER als die Rasterzeile sie stellen wuerde (Fred
	   20.09. abends): der kleine Kreis soll auf derselben Hoehe stehen wie
	   die zwei Personen in Kachel 3.
	   Aus dem LAYOUT gerechnet, nicht aus einer Momentaufnahme der
	   Animation (die Buehne ist zeitweise zehnfach skaliert, ihre gemessenen
	   Kanten taugen dann nicht): die Buehne fuellt die mittlere
	   Rasterzeile, deren Mitte liegt bei 62,4 % der Kachelhoehe. Die Figuren
	   in Kachel 3 sitzen bei 53,7 % — Position 58 % auf eine Grafik im
	   Verhaeltnis 2:1, die ueber die ganze Kachel laeuft. Differenz 6,6 %
	   der Hoehe, bei 4:5 und cqw auf die Inhaltsbreite bezogen sind das
	   11,44cqw.
	   Der Versatz sitzt auf der BUEHNE, nicht auf den Kreisen: die Buehne
	   traegt den Zoom, und weil sie um ihre eigene Mitte skaliert, wandert
	   der Kreis dadurch bei jeder Zoomstufe mit — ein Versatz an den
	   Kreisen selbst wuerde dagegen mitskaliert und am Anfang zehnfach
	   ausschlagen. */
	.kreis-buehne {
		position: relative;
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
	}

	/* NUR DER RAND WAECHST, nicht die Flaeche (Fred 20.09. abends: "ich
	   will nicht, dass der Kuchen als Flaeche waechst, sondern dass der
	   Rand vom Kuchen waechst"). Eine gefuellte Scheibe behauptet Masse;
	   gesucht ist die LINIE, die das Stueck umfaehrt, waehrend es entsteht.
	   Drei Teile, alle aus demselben Winkel --fuell gespeist:
	     · der Bogen — ein Kreis, der NUR aus seiner Randlinie besteht, von
	       einer Kegel-Maske bis zum aktuellen Winkel freigelegt,
	     · die feste Speiche auf zwoelf Uhr, die Schnittkante, an der das
	       Stueck beginnt,
	     · die laufende Speiche, die mit dem Winkel mitdreht.
	   Zusammen eine geschlossene Kontur um das Stueck, wie nachgezogen —
	   innen bleibt alles schwarz.
	   --fuell ist im globalen Block als Winkel registriert, sonst waere die
	   Gradient-Stelle nicht animierbar und wuerde springen. */
	/* WICHTIG: die Maske sitzt auf dem BOGEN, nicht auf der ganzen Uhr.
	   Lag sie aussen, schnitt sie auch die Speichen mit ab — und
	   ausgerechnet die laufende Speiche liegt genau auf der Maskenkante,
	   wurde also halbiert oder ganz verschluckt. Genau der fehlende Strich
	   zur Mitte (Fred 20.09. abends: "der muesste ja auch noch eine
	   Verbindung zur Mitte haben"). */
	.uhr {
		position: absolute;
	}

	.bogen {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		box-sizing: border-box;
		border: var(--strich) solid #ffffff;
		-webkit-mask-image: conic-gradient(#000 var(--fuell, 0turn), transparent 0);
		mask-image: conic-gradient(#000 var(--fuell, 0turn), transparent 0);
	}

	.speiche {
		position: absolute;
		left: 50%;
		bottom: 50%;
		width: var(--strich);
		height: 50%;
		margin-left: calc(var(--strich) / -2);
		background: #ffffff;
		transform-origin: 50% 100%;
	}

	.speiche--lauf {
		transform: rotate(var(--fuell, 0turn));
	}

	/* Flaechenverhaeltnis 1:100 = Durchmesser 1:10.
	   Der GROSSE Kreis wird flaechig weiss (Fred 20.09. abends) — er ist das
	   Ergebnis, nicht die Zeichnung. Also keine Kontur, kein Speichenpaar,
	   sondern ein Kuchenstueck, das sich mit Weiss fuellt. */
	/* Durchmesser neu bemessen (Fred 20.09. abends): am Anfang ist nur der
	   Strich der Stunde zu sehen, und seine OBERKANTE soll auf Kopfhoehe der
	   Figuren in Kachel 3 liegen. Der Strich ist der Radius der kleinen
	   Stunde, zehnfach vergroessert — aus Figurenmitte (490 px) minus
	   Kopfoberkante (313 px) folgt ein Radius von 177 px, also 2,55cqw
	   unskaliert und 5,1cqw Durchmesser. Der grosse Kreis behaelt das
	   Verhaeltnis 1:10, ist also 51cqw breit.
	   ZOOMFAKTOR IM SCHEITEL 2,3 (Fred 20.09. abends, "noch weniger raus"):
	   der Kreis misst damit 815 px bei einer Kachel von 731 x 914 — er wird
	   links und rechts um je 42 px BESCHNITTEN, oben und unten bleiben je
	   50 px Luft. Er drueckt also gegen den Rahmen, statt in ihm zu sitzen.
	   Die Spanne: 2,06 passt genau hinein, 2,58 fuellt die Hoehe und
	   schneidet 92 px je Seite ab. */
	.uhr--gross {
		width: 51cqw;
		height: 51cqw;
		--strich: 0cqw;
	}

	.uhr--gross .bogen {
		border: none;
		background: #ffffff;
	}

	.uhr--gross .speiche {
		display: none;
	}

	/* Die kleine Stunde bekommt eine schwarze Fuellung. Auf der schwarzen
	   Kachel sieht man davon zunaechst nichts — sobald aber das weisse Feld
	   des grossen Kreises darunter durchlaeuft, bleibt sie als schwarze
	   Scheibe mit weissem Saum stehen (Fred: "wenn es geht, bleibt der
	   schwarze Kreis innen drin schwarz"). Dieselbe Maske wie die Kontur,
	   also erscheint die Fuellung im selben Takt wie der Rand. */
	.uhr--klein .bogen {
		background: var(--panel);
	}

	/* Strichstaerke am ZOOM bemessen: die kleine Stunde wird am Anfang
	   zehnfach vergroessert gezeigt, ihre Linie erscheint also zehnfach
	   dick. 0,12cqw sind im Zoom rund 8 px und spaeter, in Ruhe, noch knapp
	   ein Pixel — beides traegt. */
	.uhr--klein {
		width: 5.1cqw;
		height: 5.1cqw;
		--strich: 0.16cqw;
		z-index: 1;
	}

	/* ZOOM (Fred 20.09. abends): am Anfang steht die kleine Stunde GROSS im
	   Bild — die Bühne ist zehnfach vergrößert, die 7cqw-Scheibe füllt also
	   dieselbe Fläche, die später der große Kreis einnimmt. Sobald der
	   große entsteht, fährt die Kamera zurück. Dadurch sieht man zuerst die
	   Stunde als etwas Großes und erlebt erst beim Rauszoomen, wie klein
	   sie im Verhältnis ist. Genau die Umkehrung, um die es geht. */
	/* Der Zoom laeuft LANGSAMER und beidseitig weich (Fred 20.09. abends).
	   Zwei Stellschrauben: die Strecke (32 → 88 Prozent statt 32 → 70, also
	   gut anderthalbmal so lang) und die Kurve. cubic-bezier(0.65, 0, 0.35,
	   1) ist symmetrisch — gleich sanft am Anfang wie am Ende, waehrend die
	   vorherige Kurve zum Schluss hin stark abbremste und dadurch
	   ungleichmaessig wirkte. Die Kamera faehrt damit noch ein Stueck
	   weiter, nachdem der grosse Kreis bei 82 Prozent fertig ist: das Bild
	   kommt zur Ruhe, statt zu stoppen. */
	/* HIN UND ZURUECK, ABER NICHT SPIEGELBILDLICH (Fred 20.09. abends).
	   Der Rueckweg soll anders aussehen als der Hinweg: es zoomt wieder
	   heran, dabei blenden BEIDE Kreise aus — sie laufen nicht rueckwaerts
	   leer. Stehen bleibt allein der senkrechte Strich der Stunde, und der
	   ist der Wendepunkt, an dem die Runde neu beginnt.
	   Deshalb KEIN "alternate": das spielt exakt rueckwaerts und kann keinen
	   eigenen Rueckweg. Stattdessen beschreibt eine einzige, vorwaerts
	   laufende Runde von 14 Sekunden beides. Die Marken:
	     4 %  die Stunde beginnt zu zeichnen
	    16 %  sie steht, der grosse Kreis setzt an, die Kamera faehrt zurueck
	    38 %  der grosse Kreis ist voll
	    50 %  WENDEPUNKT — der Rueckweg beginnt
	    72,5–94 %  die Kreise blenden aus (synchron mit Kachel 3)
	    88 %  die Kamera ist wieder ganz herangefahren
	   Wer eine Marke verschiebt, muss die benachbarten mitnehmen.
	   GLEICHTAKT MIT KACHEL 3 (Fred 20.09. abends): beide Kacheln laufen in
	   14 Sekunden und wenden bei 50 %. Kachel 3 erreicht das ueber zwei
	   Haelften von je 7 Sekunden mit "alternate", diese hier ueber eine
	   durchlaufende Runde — die Zahlen muessen zusammen geaendert werden. */
	[data-kreis].laeuft {
		animation: kreis-zoom 14s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	[data-kreis].laeuft .uhr--klein {
		animation: uhr-klein 14s linear infinite;
	}

	[data-kreis].laeuft .uhr--gross {
		animation: uhr-gross 14s linear infinite;
	}

	/* Das Ausblenden trifft nur die KREISE, nicht die Speichen — der Strich
	   der Stunde bleibt stehen. */
	[data-kreis].laeuft .bogen {
		animation: bogen-aus 14s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}

	/* WENIGER WEIT RAUS (Fred 20.09. abends: "am Ende groesser machen, nur
	   so weit heraus, dass man gerade den Kreis erkennt"). Der grosse Kreis
	   misst 70cqw; bei Faktor 1,3 sind das 91 von 100 Kachelbreiten, er
	   misst im Ruhezustand 70cqw.
	   NUR das Ende ist groesser geworden, der Anfang bleibt bei Faktor 10
	   (Fred 20.09. abends). Endfaktor 1,5: der Kreis misst damit 730 px bei
	   731 px Kacheloberflaeche — er STOESST links und rechts an die Kante,
	   ohne angeschnitten zu werden. Mehr geht nicht, ohne dass er seine
	   Rundung verliert; der Wert ist damit keine Geschmacksfrage mehr,
	   sondern die Obergrenze.
	   Senkrecht geprueft: Mitte bei 53,7 % der Hoehe, oben 126 px, unten
	   856 px von 914 — passt. Der Zoomweg betraegt 10 zu 1,5, also 6,7. */
	/* ── BESTIMMUNGSPUNKTE DER BEIDEN KACHELN (Fred 20.09. abends) ──────
	   Damit spaetere Aenderungen nicht raten muessen, woran ausgerichtet
	   wird, sind die Ankerpunkte hier festgehalten:
	     Kachel 2 → der MITTELPUNKT DES KREISES.
	     Kachel 3 → der MITTELPUNKT ZWISCHEN DEN BEIDEN PERSONEN,
	                waagerecht wie senkrecht.
	   Beide muessen an zwei Momenten uebereinstimmen: am ANFANG und in der
	   MITTE der Animation (dem Wendepunkt bei 50 %). Nachgemessen bei einer
	   Kachel von 731 × 914 px:
	     Anfang  Kachel 2 (366 | 491)   Kachel 3 (366 | 490)
	     Mitte   Kachel 2 (366 | 457)   Kachel 3 (366 | 457)
	   Waagerecht ergibt sich die Deckung von selbst: beide Bilder sitzen
	   mittig, und weil die Kachelung der dritten Kachel ZWEI Figuren
	   enthaelt, liegt ihre Mitte zwischen den beiden. Senkrecht muss die
	   Buehne der zweiten Kachel dafuer mitfahren — siehe unten. ────────── */

	/* KEIN VERSATZ MEHR (Fred 20.09. abends, neue Regel): das Zentrum der
	   Kreise — es ist fuer beide dasselbe — sitzt zu JEDEM Zeitpunkt in der
	   Mitte der Kachel, waagerecht wie senkrecht. Am Anfang, im Scheitel und
	   am Ende.
	   Seit der Kopf ueber der Kachel steht, faellt die Ruhelage der Buehne
	   ohnehin mit der Kachelmitte zusammen — es genuegt also, gar nicht zu
	   verschieben und nur zu skalieren.
	   DAMIT ENTFAELLT die vorherige Regel, die Strichoberkante am Anfang auf
	   Kopfhoehe der Figuren in Kachel 3 zu legen: der Strich beginnt jetzt
	   bei 280 px, die Koepfe liegen bei 313. Die Kreisgroessen (5,1 und
	   51cqw) stammen noch aus jener Rechnung und koennen bleiben oder neu
	   bemessen werden.
	   MESS-WARNUNG: Werte nur an einer FRISCH GELADENEN Seite nachmessen.
	   Nach einem scrollIntoView liefert das Browser-Fenster hier andere
	   Kachelmasse (424 statt 457 Mitte). */
	@keyframes kreis-zoom {
		0%, 4% { transform: scale(10); }
		38%, 50% { transform: scale(2.3); }
		88%, 100% { transform: scale(10); }
	}

	/* Die Stunde zeichnet sich und bleibt dann voll — zurueck geht sie
	   nicht, sie blendet aus (siehe bogen-aus). */
	@keyframes uhr-klein {
		0%, 4% { --fuell: 0turn; }
		16%, 100% { --fuell: 1turn; }
	}

	@keyframes uhr-gross {
		0%, 16% { --fuell: 0turn; }
		38%, 100% { --fuell: 1turn; }
	}

	/* Das Ein- und Ausblenden der Schrift ist RAUS (Fred 20.09. abends).
	   Es war noetig, solange der Text IN der Kachel lag und dem Bild im Weg
	   war. Seit er darueber steht, stoert er nichts mehr — und eine Schrift,
	   die ohne Not verschwindet, kostet nur Lesezeit. */

	@keyframes bogen-aus {
		0%, 72.5% { opacity: 1; }
		94%, 100% { opacity: 0; }
	}

	/* ── Kachel 3: Rauszoomen ──────────────────────────────────────────── */
	/* Startgröße: EINE Figur füllt die Kachel. Endgröße: rund tausend
	   Figuren passen hinein — bei 4:5 sind das etwa 28 × 35 Zellen, also
	   Zellbreite = Kachelbreite / 28 ≈ 3,6 cqw. */
	/* UEBER DIE GANZE KACHEL (Fred 20.09. abends: "ich will, dass die
	   Person ueber die gesamte Kachel drei zu sehen ist"). Vorher lag die
	   Menge in der mittleren Rasterzeile und hatte dadurch einen unsichtbaren
	   Rahmen: oben die Ueberschrift, unten der Kachelrand. Jetzt liegt sie
	   absolut ueber der ganzen Kachel und wird nur von deren Kante
	   beschnitten; die Ueberschrift steht darueber. */
	.menge {
		position: absolute;
		inset: 0;
	}

	/* Beide Lagen liegen deckungsgleich und werden GLEICH skaliert: die
	   schwarze Doppelfigur einmal und mittig, die weiße Menge gekachelt.
	   Am Anfang ist die Kachelung größer als die Fläche — die zwei Experten
	   ragen also über den Rand hinaus und werden beschnitten (Fred 20.09.
	   abends: "man hat das Gefühl, es ist groß"). Die weiße Menge ist dabei
	   noch unsichtbar und blendet erst beim Rauszoomen ein. */
	.menge-lage {
		position: absolute;
		inset: 0;
		background-image: var(--person);
		background-position: center;
	}

	.menge-weiss {
		background-repeat: repeat;
		opacity: 0;
	}

	.menge-schwarz {
		background-repeat: no-repeat;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-kreis].laeuft,
		[data-kreis].laeuft .uhr--klein,
		[data-kreis].laeuft .uhr--gross,
		[data-kreis].laeuft .bogen {
			animation: none;
		}
		.uhr {
			--fuell: 1turn;
		}
		.kreis-buehne {
			transform: scale(2.3);
		}
	}
</style>

<script>
	// Animationen erst starten, wenn die Reihe im Blick ist — gleiche Regel
	// wie bei der Wand, damit niemand den Anfang verpasst.
	let ab: (() => void) | null = null;

	// Kachel 3 — Rauszoomen in ECHTEN PIXELN.
	// Start: eine Figur füllt die Kachel. Ende: rund tausend Figuren passen
	// hinein. Die Kachel ist 4:5, also ergibt eine Zellkante von
	// breite / 28 etwa 28 × 35 = 980 Figuren.
	// Zielmenge am Ende des Zooms. Eine Kachelung trägt ZWEI Figuren und ist
	// doppelt so breit wie hoch; bei Kachelbreite t passen also
	// (B/t) × (H/(t/2)) × 2 = 4·B·H/t² Figuren in die Fläche.
	const ZIEL_FIGUREN = 1000;
	// Wie weit die zwei Experten am Anfang über die Kachel hinausragen.
	// 1 = sie füllen sie genau, größer = sie werden beschnitten und wirken
	// nah. EIN Regler, hier wird getunt.
	const START_UEBERSTAND = 1.35;
	function zoomAnlegen(el: HTMLElement): Animation[] {
		const r = el.getBoundingClientRect();
		if (!r.width) return [];
		const weiss = el.querySelector<HTMLElement>(".menge-weiss");
		const schwarz = el.querySelector<HTMLElement>(".menge-schwarz");
		if (!weiss || !schwarz) return [];
		const startB = Math.round(r.width * START_UEBERSTAND);
		const startH = Math.round(startB / 2);
		// Die Kachelgröße wird nicht geschätzt, sondern nachgezählt: es
		// sollen wirklich GANZE Figuren in der geforderten Zahl im Bild
		// stehen — angeschnittene am Rand zählen nicht mit, und "mehr als
		// tausend" soll man abzählen können.
		const ganze = (t: number) =>
			Math.floor(r.width / t) * Math.floor(r.height / Math.round(t / 2)) * 2;
		let endeB = Math.max(8, Math.round(Math.sqrt((4 * r.width * r.height) / ZIEL_FIGUREN)));
		while (endeB > 8 && ganze(endeB) < ZIEL_FIGUREN) endeB--;
		const endeH = Math.round(endeB / 2);
		// WEICH IN BEIDE RICHTUNGEN (Fred 20.09. abends: "faengt schoen
		// smooth an, endet aber hart"). Die Ursache war die Stelle, an der
		// die Beschleunigung stand: als Takt-Angabe wirkt sie auf die GANZE
		// Runde, also auch auf die beiden Haltezeiten am Anfang und Ende —
		// die eigentliche Bewegung bekam davon nur ein schiefes Stueck ab
		// und blieb am Schluss mitten im schnellen Teil stehen.
		// Jetzt laeuft die Runde gleichmaessig, und die Weichzeichnung sitzt
		// auf dem BEWEGUNGS-Abschnitt selbst: sanft los, sanft an.
		const WEICH = "cubic-bezier(0.4, 0, 0.2, 1)";
		// MITTE BLEIBT MITTE (Fred 20.09. abends, neue Regel wie in Kachel 2):
		// der Punkt zwischen den beiden Personen sitzt zu jedem Zeitpunkt im
		// Zentrum der Kachel, waagerecht wie senkrecht. Die fruehere
		// Tieferlegung am Anfang (58 statt 50 Prozent) ist damit entfallen —
		// sie stammte aus der Zeit, als die Ueberschrift noch IN der Kachel
		// stand und den beiden zu nahe kam. Die Lage steht jetzt fest im CSS
		// (background-position: center) und wird gar nicht mehr animiert.
		const groesse = [
			{ backgroundSize: startB + "px " + startH + "px", offset: 0, easing: "linear" },
			{ backgroundSize: startB + "px " + startH + "px", offset: 0.12, easing: WEICH },
			{ backgroundSize: endeB + "px " + endeH + "px", offset: 1 },
		];
		// HIN UND ZURUECK (Fred 20.09. abends): kein Sprung zurueck auf den
		// Anfang, sondern derselbe Weg rueckwaerts — die Menge zieht sich
		// wieder auf die zwei Experten zusammen, und die Schrift kommt mit.
		// "alternate" spielt jede zweite Runde rueckwaerts; weil ALLE vier
		// Animationen dieselbe Takt-Angabe teilen, kehren sie gemeinsam um
		// und koennen nicht auseinanderlaufen. Eine volle Runde dauert damit
		// vierzehn Sekunden — im Gleichtakt mit Kachel 2.
		const takt = {
			// 7000 statt 6000 (Fred 20.09. abends): mit "alternate" ergibt
			// das eine Runde von 14 Sekunden mit Wendepunkt bei 50 % —
			// dieselbe Laenge und derselbe Wendepunkt wie Kachel 2. Beide
			// starten beim Einhaengen der Kacheln, laufen also im Gleichtakt.
			duration: 7000,
			iterations: Infinity,
			direction: "alternate",
			easing: "linear",
		} as const;
		return [
			schwarz.animate(groesse, takt),
			// BEIDE LAGEN BEKOMMEN EXAKT DIESELBE GROESSEN-KURVE. Die
			// Einblendung laeuft als EIGENE Animation auf demselben Element
			// (Fred 20.09. abends: "du zoomst die zwei Experten
			// unterschiedlich von den anderen"). Vorher steckte die Opazitaet
			// in denselben Keyframes — und weil ein zusaetzlicher
			// Zwischenschritt fuer die Einblendung noetig war, bekam die
			// weisse Lage dadurch eine andere Groessen-Kurve als die
			// schwarze. Getrennte Animationen koennen nicht auseinanderlaufen.
			weiss.animate(groesse, takt),
			weiss.animate(
				[
					{ opacity: 0, offset: 0, easing: "linear" },
					{ opacity: 0, offset: 0.12, easing: WEICH },
					{ opacity: 1, offset: 0.55, easing: "linear" },
					{ opacity: 1, offset: 1 },
				],
				takt,
			),
		];
	}

	function mount() {
		ab?.();
		const ziele = [
			...document.querySelectorAll<HTMLElement>("[data-kreis], [data-menge]"),
		];
		if (!ziele.length) return;

		// Zoom-Animationen je Mengen-Kachel, pausiert bis zur Sichtbarkeit;
		// bei Fensteränderung mit neuen Pixelwerten neu aufgesetzt.
		const mengen = ziele.filter((z) => z.hasAttribute("data-menge"));
		let zooms = new Map<HTMLElement, Animation[]>();
		const zoomsAnlegen = () => {
			zooms.forEach((as) => as.forEach((a) => a.cancel()));
			zooms = new Map();
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			mengen.forEach((el) => {
				const as = zoomAnlegen(el);
				if (as.length) {
					as.forEach((a) => a.pause());
					zooms.set(el, as);
				}
			});
		};
		zoomsAnlegen();
		let neuTimer = 0;
		const beiResize = () => {
			window.clearTimeout(neuTimer);
			neuTimer = window.setTimeout(() => {
				const liefen = new Set(
					[...zooms.entries()]
						.filter(([el, as]) => as[0].playState === "running" || el.classList.contains("laeuft"))
						.map(([el]) => el),
				);
				zoomsAnlegen();
				liefen.forEach((el) => anschalten(el));
			}, 200);
		};
		window.addEventListener("resize", beiResize);
		// STARTEN, NICHT WARTEN (Korrektur 20.09. abends, Fred: "die
		// Animation funktioniert immer noch nicht"): erst lief der Start
		// über eine Sichtbarkeits-SCHWELLE, und genau daran ist Kachel 3
		// hängengeblieben — eine Kachel, die höher ist als der Bildschirm,
		// überschreitet die Schwelle nie, der Beobachter meldet sich nicht,
		// die Animation bleibt für immer pausiert. Eine Schwelle, die nur
		// manchmal greift, ist als Startbedingung untauglich.
		// Jetzt laufen die Kacheln von Anfang an; der Beobachter PAUSIERT
		// sie nur, wenn sie GANZ aus dem Bild sind. Das kann nicht fehlen:
		// isIntersecting ist eindeutig, es braucht kein Verhältnis.
		// VON VORN, NICHT WEITER (Fehler 20.09. abends, Fred: "das sieht
		// nicht so aus, als ob die beiden Schriften synchron ein- und
		// ausblenden"). Die beiden Kacheln werden verschieden angetrieben:
		// Kachel 2 ueber CSS-Animationen an der Klasse .laeuft, Kachel 3
		// ueber die Web-Animations-API. Verschwindet die Reihe kurz aus dem
		// Bild und kommt zurueck, STARTET die CSS-Animation von vorn,
		// waehrend die andere dort weiterlaeuft, wo sie stehengeblieben ist
		// — ab da laufen sie gegeneinander, egal wie genau die Marken
		// stimmen. Deshalb wird beim Einschalten IMMER auf null gesetzt:
		// beide fangen dann zusammen an.
		const anschalten = (el: HTMLElement) => {
			el.classList.remove("laeuft");
			void el.offsetWidth; // Neustart der CSS-Animation erzwingen
			el.classList.add("laeuft");
			zooms.get(el)?.forEach((a) => {
				a.currentTime = 0;
				a.play();
			});
		};
		ziele.forEach(anschalten);
		const io = new IntersectionObserver(
			(eintraege) => {
				eintraege.forEach((e) => {
					const el = e.target as HTMLElement;
					if (e.isIntersecting) {
						if (!el.classList.contains("laeuft")) anschalten(el);
					} else {
						el.classList.remove("laeuft");
						zooms.get(el)?.forEach((a) => a.pause());
					}
				});
			},
			{ threshold: 0 },
		);
		ziele.forEach((z) => io.observe(z));
		ab = () => {
			io.disconnect();
			window.removeEventListener("resize", beiResize);
			window.clearTimeout(neuTimer);
			zooms.forEach((a) => a.cancel());
		};
	}

	document.addEventListener("astro:page-load", mount);
</script>

<style is:global>
	/* Registrierter Winkel: nur so laesst sich eine Farbstelle im
	   conic-gradient animieren — eine gewoehnliche Variable waere fuer den
	   Browser bloss ein Text und wuerde springen statt zu laufen.
	   @property gehoert auf Dokumentebene, deshalb hier im globalen Block. */
	/* MUSS vererben (Fehler 20.09. abends, Fred: "ich sehe nur noch einen
	   Strich"): der Winkel wird auf der Uhr animiert, gebraucht wird er
	   aber in ihren KINDERN — im Bogen als Maske und in der laufenden
	   Speiche als Drehung. Mit inherits:false bekamen die Kinder ihren
	   eigenen Anfangswert 0turn: die Maske gab nichts frei (Bogen
	   unsichtbar) und die Speiche drehte nie. Uebrig blieben genau die zwei
	   senkrechten Striche, die er gesehen hat. */
	@property --fuell {
		syntax: "<angle>";
		inherits: true;
		initial-value: 0turn;
	}

</style>
