---
/* Unterseite 03 Beweisstücke (13.11.2026, Variante Kachel-Startseite; Rasul: „Ja, mach's mal als Variante zum
   Ausprobieren“). Inhalt ist derselbe Baustein wie auf der Startseite (src/components/abschnitte/Beweisstuecke.astro).
   Noch nicht in der Sitemap, bis Rasul über den Aufbau entscheidet. */
import Layout from "../layouts/Layout.astro";
import Beweisstuecke from "../components/abschnitte/Beweisstuecke.astro";
import Kapitelende from "../components/abschnitte/Kapitelende.astro";
---
<Layout title="Beweisstücke" description="03 Beweisstücke: so arbeitet Parley Film.">
	<main class="kapitel">
		<Beweisstuecke />
		<Kapitelende weiter={{ href: "/augenzeugen", nr: "04", titel: "Augenzeugen" }} />
	</main>
</Layout>
<style>
	.kapitel { padding-top: 0; }   /* oben genügt der xl-Abstand des Abschnitts (BBH: Titel mit py-xl) */
	/* letzter Abschnitt der Startseite bringt unten xl mit; auf der Unterseite folgt noch das Kapitel-Ende */
	.kapitel :global(.abschnitt--letzter) { margin-bottom: 0; }
</style>
