---
// SplitFlap.astro — Fallblattanzeige (Split-Flap / Solari-Board-Effekt).
// Autonom gebaut (30.08., Astro-Session getrennt von der Design-Session,
// siehe Website-Brief "Session-Split"). Technik-Referenz für die
// Schichten-Idee (4 Ebenen pro Kachel, rotateX-Faltung): das MIT-lizenzierte
// Repo github.com/hardikpandya/solari-split-flap — NUR die Grundidee
// abgeschaut, Code, Trommel, Optik und Themes sind hier komplett eigen.
//
// SEIT 14.09. ABENDS: die eigentliche Klapp-Mechanik (Trommel, Lamellen-
// Physik, MAX_FLAPS-Deckel, Klacker-Sound) lebt NICHT mehr hier, sondern im
// gemeinsamen Modul src/lib/fallblatt.ts + src/styles/fallblatt.css —
// Freds Anweisung: EINE Logik hinter allen Boards (diese Sequenz-Boards,
// die Multi-Output-Wand, alle zukünftigen). Diese Komponente steuert nur
// noch die Zustands-Sequenz (was wann steht).
//
// Architektur-Entscheidung: Anders als eine "klassische" JS-Canvas-Lösung
// baut NICHT das Client-Skript die Kacheln, sondern Astro rendert das
// komplette Kachel-Raster bereits server-seitig (SSG) für den ERSTEN
// Zustand der Sequenz. Das Skript animiert danach nur noch Text-Inhalt und
// Transform bestehender Elemente. Vorteile: kein Layout-Sprung beim
// Hydrieren, funktioniert (statisch, ungeklappert) auch ganz ohne JS, und
// Screenreader/Crawler sehen von Anfang an echten Text statt eines leeren
// Containers.
//
// SEO/Barrierefreiheit: der LETZTE Zustand der Sequenz (die Pointe) steht
// zusätzlich als normaler Text in einem visuell verborgenen (sr-only)
// Absatz im HTML — das Kachel-Raster selbst ist aria-hidden (rein
// dekorativ, klappert ja munter durch die Zeichentrommel und ist als
// Lesetext ungeeignet).

import "../styles/fallblatt.css";
import { FLAP_STEP_MS } from "../lib/fallblatt";

interface Props {
	/** Sequenz von Tafel-Zuständen; jeder Zustand ist ein Array von Textzeilen. */
	lines: string[][];
	/** Dauer EINER einzelnen Klapp-Bewegung (ein Zeichen weiter in der Trommel), in ms. */
	flipMs?: number;
	/** Standzeit je Zustand, bevor zum nächsten weitergeklappert wird, in ms. */
	holdMs?: number;
	/** Standzeit PRO Zustand (gleicher Index wie lines) — überschreibt holdMs
	 * für den jeweiligen Zustand. Damit kann z. B. die Leertafel kurz und die
	 * Pointe lang stehen (Kontakt-Board: hin, stehen, weg, kurze Pause). */
	holdsMs?: number[];
	/** Endlosschleife durch die Sequenz. Bei false bleibt der letzte Zustand stehen. */
	loop?: boolean;
	/** Mindest-Spaltenzahl: das Raster wird mit Leerkacheln auf diese Breite
	 * aufgefüllt (Inhalte bleiben mittig). Fred 14.09. nacht: das
	 * Formatfrage-Board soll über die Kachel-Anzahl so breit sein wie der
	 * Titel-Text darüber. */
	minCols?: number;
	/** Mindest-Zeilenzahl, gleiches Prinzip vertikal (padState zentriert
	 * kürzere Zustände im Zeilenblock — bei 4 Zeilen steht ein Zweizeiler
	 * exakt mittig). */
	minRows?: number;
	/** Gehäuse-Zarge (Fred 14.09. nacht) — schmale dunkle Einfassung. */
	rahmen?: boolean;
	/** Textausrichtung IM Raster (Fred 20.09.): "mitte" (Standard, wie
	 * bisher) oder "links" — dann beginnt jede Zeile an der ersten Kachel,
	 * bündig mit dem Fließtext daneben. */
	ausrichtung?: "mitte" | "links";
	/** KLAPP-ART (Fred 29.09., aus der Probe public/fallblatt-direkt.html):
	 * true = jede Kachel faellt mit EINER Klappe direkt auf den Zielbuchstaben,
	 * statt durch die Trommel zu rattern (bis 6 Klappen). */
	direkt?: boolean;
	/** REIHENFOLGE bei einem Wechsel: "zufall" (Standard: alle Kacheln
	 * gleichzeitig, gestreut bis 350 ms) oder "alphabet" (Leerkacheln als
	 * eigener Schlag, die Buchstaben einzeln nacheinander: erst alle A, dann
	 * B …, bei gleichem Buchstaben von links nach rechts). */
	folge?: "zufall" | "alphabet";
	/** Bei folge="alphabet": Leerkacheln VOR den Buchstaben (true, Standard)
	 * oder danach. */
	schwarzZuerst?: boolean;
	/** Bei folge="alphabet": Pause zwischen Leer-Schlag und Buchstaben, ms. */
	pauseMs?: number;
}

// Default = der eine Tempo-Regler des Fallblatt-Moduls.
const { lines, flipMs = FLAP_STEP_MS, holdMs = 2600, holdsMs, loop = true, minCols = 1, minRows = 1, rahmen = false, ausrichtung = "mitte", direkt = false, folge = "zufall", schwarzZuerst = true, pauseMs = 0 } = Astro.props;

// Zeichentrommel — Build-Zeit-Kopie der Modul-Konstante (das Frontmatter
// läuft in Node, src/lib/fallblatt.ts wird ins Browser-Bundle importiert;
// hier braucht es die Trommel nur fürs Normalisieren gar nicht — nur die
// Versal-Regel bleibt).
function normalizeLine(line: string): string {
	// Kleinbuchstaben (inkl. äöü) auf Versalien mappen — die Trommel kennt
	// nur Großbuchstaben, echte Fallblattanzeigen kannten meist auch keine
	// Kleinbuchstaben.
	return line.toUpperCase();
}

const normalizedStates = lines.map((state) => state.map(normalizeLine));

// Gemeinsame Spalten-/Zeilenzahl über ALLE Zustände hinweg (nicht pro
// Zustand einzeln) — damit bleibt das Kachel-Raster über die ganze Sequenz
// hinweg fix an Ort und Stelle; nur die Zeichen darin wechseln. Das ist
// näher am Vorbild einer echten Bahnhofstafel (fixe Zeilen/Spalten, der
// Text darin wechselt) als ein Raster, das bei jedem Zustand neu umbricht.
const rows = Math.max(minRows, ...normalizedStates.map((state) => state.length));
const cols = Math.max(
	minCols,
	...normalizedStates.flatMap((state) => state.map((line) => line.length)),
);

// Füllt einen Zustand auf rows×cols auf: jede Zeile horizontal zentriert
// mit Leerzeichen, der Zeilenblock vertikal zentriert mit ganzen Leerzeilen.
// Rückgabe: Array von Zeilen-STRINGS (Länge cols) statt char[][] — kompakter
// fürs JSON, das ans Client-Skript übergeben wird.
function padState(state: string[]): string[] {
	const topPad = Math.floor((rows - state.length) / 2);
	const grid: string[] = [];
	for (let r = 0; r < rows; r++) {
		const lineIndex = r - topPad;
		const line = lineIndex >= 0 && lineIndex < state.length ? state[lineIndex] : "";
		const leftPad = ausrichtung === "links" ? 0 : Math.floor((cols - line.length) / 2);
		let rowStr = "";
		for (let c = 0; c < cols; c++) {
			const charIndex = c - leftPad;
			rowStr += charIndex >= 0 && charIndex < line.length ? line[charIndex] : " ";
		}
		grid.push(rowStr);
	}
	return grid;
}

const gridStates = normalizedStates.map(padState); // string[Zustand][Zeile]
const initialGrid = gridStates[0];
const fallbackText = lines[lines.length - 1].join("\n");

// Als JSON ans Client-Skript übergeben (pro Komponenten-Instanz, siehe
// is:inline unten). "<" escapen, damit kein "</script" im JSON-Text den
// umgebenden <script>-Tag vorzeitig beendet — bei unserer Zeichentrommel
// eigentlich nie relevant, aber billig genug, es trotzdem robust zu machen.
const statesJson = JSON.stringify(gridStates).replace(/</g, "\\u003c");
---

<div
	class={`sf-board${rahmen ? " sf-board--rahmen" : ""}`}
	data-sf-board
	data-flip-ms={flipMs}
	data-hold-ms={holdMs}
	data-holds-ms={holdsMs ? JSON.stringify(holdsMs) : undefined}
	data-loop={loop ? "1" : "0"}
	data-direkt={direkt ? "1" : "0"}
	data-folge={folge}
	data-schwarz-zuerst={schwarzZuerst ? "1" : "0"}
	data-pause-ms={pauseMs}
	style={`--sf-cols:${cols};--sf-rows:${rows};`}
>
	{/* sr-only: der finale Zustand als echter Lesetext, für Screenreader und
	   Suchmaschinen-Crawler. Bleibt IMMER im DOM, unabhängig von JS. */}
	<p class="sf-fallback">{fallbackText}</p>

	{/* Kachel-Raster: server-gerendert mit dem ERSTEN Zustand. Rein
	   dekorativ (aria-hidden) — der Lesetext kommt aus .sf-fallback oben.
	   Schichten-Struktur = LAYER_HTML aus src/lib/fallblatt.ts (SSG-Zwilling:
	   Klassen/data-layer müssen dort und hier identisch bleiben). */}
	<div class="sf-grid" aria-hidden="true" data-sf-grid>
		{initialGrid.map((rowStr, r) => (
			<div class="sf-row-line" data-row={r}>
				{[...rowStr].map((ch, c) => (
					<span class="sf-tile" data-r={r} data-c={c} data-char={ch}>
						<span class="sf-static sf-static--top">
							<span class="sf-glyph" data-layer="top-static">{ch}</span>
						</span>
						<span class="sf-static sf-static--bottom">
							<span class="sf-glyph" data-layer="bottom-static">{ch}</span>
						</span>
						<span class="sf-flap sf-flap--front" data-layer="front-flap">
							<span class="sf-glyph">{ch}</span>
						</span>
						<span class="sf-flap sf-flap--back" data-layer="back-flap">
							<span class="sf-glyph">{ch}</span>
						</span>
						<span class="sf-hinge"></span>
					</span>
				))}
			</div>
		))}
	</div>

	{/* is:inline: Astro darf dieses Script-Tag NICHT bündeln/dedupen — es
	   trägt die Zustandsdaten GENAU DIESER Instanz. Bei mehreren SplitFlap-
	   Komponenten auf einer Seite braucht jede ihr eigenes Datenpaket. */}
	<script type="application/json" data-sf-states set:html={statesJson} is:inline />
</div>

<script>
	// Sequenz-Steuerung für ALLE SplitFlap-Boards einer Seite (Astro bündelt
	// dieses Modul-Script über die Instanzen hinweg — es sucht sich per
	// querySelectorAll selbst alle Boards). Die Klapp-Mechanik selbst kommt
	// aus dem gemeinsamen Fallblatt-Modul.
	//
	// Muster astro:page-load (statt DOMContentLoaded) wie in PageWipe.astro:
	// feuert bei jedem Seitenaufruf, auch nach einem Client-Side-Wechsel via
	// ClientRouter. Cleanup ist nötig, weil loop:true sonst nach mehrfachem
	// Hin-und-Zurück-Navigieren verwaiste, unsichtbare Klapper-Schleifen auf
	// abgehängten DOM-Knoten weiterlaufen ließe (kleiner, aber echter Leak).
	import {
		type FlapTile,
		wireTileLayers,
		resetInstant,
		flapTo,
		flapOnce,
		DRUM,
		wait,
		reduceMotion,
		FLAP_STEP_MS,
	} from "../lib/fallblatt";

	// Organischer Versatz je Kachel (nicht als Prop gedacht, reine
	// Optik-Konstante): echte Fallblattanzeigen klappern nie im Gleichtakt.
	const STAGGER_MAX_MS = 350;

	interface BoardTile {
		tile: FlapTile;
		r: number;
		c: number;
	}

	function setupBoard(boardEl: HTMLElement): () => void {
		const gridEl = boardEl.querySelector("[data-sf-grid]");
		const statesScript = boardEl.querySelector('script[data-sf-states]');
		if (!gridEl || !statesScript) return () => {};

		let states: string[][];
		try {
			states = JSON.parse(statesScript.textContent || "[]");
		} catch {
			return () => {};
		}
		if (!Array.isArray(states) || states.length === 0) return () => {};

		const flipMs = Number(boardEl.dataset.flipMs) || FLAP_STEP_MS;
		const holdMs = Number(boardEl.dataset.holdMs) || 2600;
		const loop = boardEl.dataset.loop === "1";
		// Klapp-Art und Reihenfolge (Fred 29.09.), s. Props oben.
		const direkt = boardEl.dataset.direkt === "1";
		const folge = boardEl.dataset.folge || "zufall";
		const schwarzZuerst = boardEl.dataset.schwarzZuerst !== "0";
		const pauseMs = Number(boardEl.dataset.pauseMs) || 0;
		const klapp = (tile: FlapTile, ch: string) =>
			direkt ? flapOnce(tile, ch, Math.max(8, flipMs / 2)) : flapTo(tile, ch, flipMs);
		// Standzeit je Zustand (optional, Index = Zustands-Index); fehlt der
		// Eintrag, gilt die globale holdMs.
		let holds: number[] | null = null;
		try {
			holds = JSON.parse(boardEl.dataset.holdsMs || "null");
		} catch {
			holds = null;
		}
		const holdFor = (i: number) =>
			holds && typeof holds[i] === "number" ? holds[i] : holdMs;

		const tiles: BoardTile[] = Array.from(
			gridEl.querySelectorAll<HTMLElement>(".sf-tile"),
		).map((el) => ({
			tile: wireTileLayers(el),
			r: Number(el.dataset.r),
			c: Number(el.dataset.c),
		}));

		let cancelled = false;

		async function goToState(stateIndex: number, animate: boolean) {
			const grid = states[stateIndex];
			const ziel = ({ r, c }: BoardTile) => (grid[r] && grid[r][c]) || " ";
			if (animate && folge === "alphabet") {
				// NACH DEM ALPHABET (Fred 29.09., Werte aus der Probe uebernommen):
				// Leerkacheln als EIN Schlag (alle gleichzeitig), die Buchstaben
				// einzeln nacheinander in Trommel-Reihenfolge (A–Z, Umlaute,
				// Zeichen, Ziffern), bei gleichem Buchstaben von links nach
				// rechts. Kacheln ohne Aenderung bleiben unberuehrt.
				const gen = tiles[0]?.tile.gen ?? 0;
				const rang = (ch: string) => (ch === " " ? -1 : DRUM.indexOf(ch) === -1 ? 998 : DRUM.indexOf(ch));
				const aenderungen = tiles
					.map((bt) => ({ tile: bt.tile, c: bt.c, r: bt.r, ch: ziel(bt) }))
					.filter((x) => x.tile.current !== x.ch)
					.sort((a, b) => rang(a.ch) - rang(b.ch) || a.r - b.r || a.c - b.c);
				const leer = aenderungen.filter((x) => x.ch === " ");
				const buchstaben = aenderungen.filter((x) => x.ch !== " ");
				const schwarz = () => Promise.all(leer.map((x) => klapp(x.tile, x.ch)));
				const buchst = async () => {
					for (const x of buchstaben) {
						if (cancelled || x.tile.gen !== gen) return;
						await klapp(x.tile, x.ch);
					}
				};
				const pause = () => (leer.length && buchstaben.length ? wait(pauseMs) : Promise.resolve());
				if (schwarzZuerst) { await schwarz(); await pause(); await buchst(); }
				else { await buchst(); await pause(); await schwarz(); }
				return;
			}
			const jobs = tiles.map((bt) => {
				const targetChar = ziel(bt);
				if (!animate) {
					resetInstant(bt.tile, targetChar);
					return Promise.resolve();
				}
				const delay = Math.random() * STAGGER_MAX_MS;
				return wait(delay).then(() => klapp(bt.tile, targetChar));
			});
			await Promise.all(jobs);
		}

		async function run() {
			// prefers-reduced-motion: keine Klapperei, Endzustand steht sofort.
			if (reduceMotion()) {
				await goToState(states.length - 1, false);
				return;
			}
			// Der erste Zustand steht schon (server-gerendert) — erst die
			// Standzeit abwarten, dann weiterklappern.
			await wait(holdFor(0));
			let index = 0;
			while (!cancelled) {
				const next = index + 1;
				if (next >= states.length) {
					if (!loop) break;
					index = 0;
				} else {
					index = next;
				}
				await goToState(index, true);
				if (cancelled) break;
				await wait(holdFor(index));
			}
		}

		run();

		return () => {
			cancelled = true;
			// Generation hochzählen, damit gestreute flapTo-Aufträge auf dem
			// abgehängten Board sofort verhungern.
			tiles.forEach(({ tile }) => tile.gen++);
		};
	}

	let cleanupFns: Array<() => void> = [];

	function mountAll() {
		cleanupFns.forEach((fn) => fn());
		cleanupFns = [];
		document.querySelectorAll<HTMLElement>("[data-sf-board]").forEach((boardEl) => {
			cleanupFns.push(setupBoard(boardEl));
		});
	}

	document.addEventListener("astro:page-load", mountAll);
</script>

<style is:global>
	/* is:global + sf--Präfix (Astro-Falle, siehe buchen.astro): das Skript
	   ändert nur Text/Transform bestehender Elemente, aber die Wand baut
	   ihre Schichten CLIENT-seitig (buildTileLayers) — gescopte Selektoren
	   träfen solche Elemente nie (kein data-astro-cid-Attribut). Kachel-
	   Ebene liegt deshalb in src/styles/fallblatt.css (echter Import, von
	   beiden Tafel-Komponenten geteilt); hier nur die BOARD-Ebene dieser
	   Komponente.

	   Größenlogik: --sf-tile-w wird NICHT über feste Breakpoints, sondern
	   inhaltsbezogen berechnet (Spalten-/Zeilenzahl stehen als --sf-cols/
	   --sf-rows pro Board fest, aus dem Frontmatter). So passt sich JEDE
	   Zeichenkette automatisch an jede Viewport-Breite an, ohne dass man für
	   jeden Text im Component-Aufruf eigene Breakpoints nachpflegen müsste. */

	.sf-board {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
	}

	.sf-fallback {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: pre-line;
		border: 0;
	}

	.sf-grid {
		/* Kachelbreite: kleinster Wert aus (a) Breiten-Budget geteilt durch
		   Spaltenzahl, (b) Höhen-Budget geteilt durch Zeilenzahl, (c) einer
		   Obergrenze — nie kleiner als 12px. Bewusst NICHT in ch-Einheiten
		   (die Schrift ist proportional, ch würde je nach Zeichen unter-
		   schiedlich breite Kacheln erzeugen und beim Klappern das Raster
		   verspringen lassen). */
		--sf-tile-w: max(
			12px,
			min(
				calc((100vw - 48px) / var(--sf-cols, 1)),
				calc((90vh - 160px) / (var(--sf-rows, 1) * 1.38)),
				64px
			)
		);
		--sf-tile-h: calc(var(--sf-tile-w) * 1.38);
		--sf-font-size: calc(var(--sf-tile-w) * 0.62);
		/* Kachel-Fuge minimal (Fred 14.09. abends: "so klein wie möglich",
		   beide Achsen, alle Boards) — 1px Hairline statt mitwachsender
		   Fuge. */
		--sf-gap: 1px;
		display: flex;
		flex-direction: column;
		gap: var(--sf-gap);
	}

	.sf-row-line {
		display: flex;
		justify-content: center;
		gap: var(--sf-gap);
	}

	/* Gehäuse-Zarge, DUNKEL (Fred 14.09. nacht, dritte Farbrunde: #2a2a2a
	   war "zu farbig", gewünscht dunkler): #141414 = der Kachel-Grundwert
	   aus diesem Stylesheet, eine leise Stufe über der real gerenderten
	   Kachelfläche (--panel #0d0d0d) — Schattenkante statt Rahmenfarbe. */
	.sf-board--rahmen .sf-grid {
		/* Gefüllte Zarge (Fred 14.09. nacht, nach Umrandungs-Probe zurück:
		   "die Wand wieder rein") — Fläche in der BBH-Zwischenstufe
		   #1a1a1a, der geeinigte Ton der Farb-Treppe. */
		/* Zwei Token-Rollen in einem Element (Fred 14.09. nacht): der
		   content-box-Layer ist die WAND hinter den Kacheln (Fugen), der
		   border-box-Layer die ZARGE im Padding-Ring — Tokens in
		   Layout.astro. */
		padding: calc(var(--sf-tile-w) * 0.24); /* 0.16 + 50% (Fred 14.09. nacht) */
		background:
			linear-gradient(var(--tafel-wand, #1a1a1a), var(--tafel-wand, #1a1a1a)) content-box,
			var(--tafel-zarge, #1a1a1a) border-box;
	}
</style>

<style is:global>
	/* ── VARIANTE "OHNE KACHELN" (Fred 30.08. nachts, ?ohnekacheln auf der
	   Demo-Seite): nur die klappenden Buchstaben auf dem nackten Seiten-
	   Schwarz — Kachel-Flächen, Innenschatten, Scharnier-Linie und
	   Scharnier-Abdunklung aus. Die Klapp-Bewegung selbst bleibt komplett
	   erhalten (die Flächen sind transparent, aber sie klappen weiter). */
	.sf-bare .sf-tile {
		background: transparent;
		box-shadow: none;
	}

	.sf-bare .sf-static--top,
	.sf-bare .sf-static--bottom,
	.sf-bare .sf-flap--front,
	.sf-bare .sf-flap--back {
		background: transparent;
		box-shadow: none;
	}

	.sf-bare .sf-hinge {
		display: none;
	}
</style>
