---
import LogoBiss from "./LogoBiss.astro";
import ZeichenNeu from "./ZeichenNeu.astro";
import { ZEICHEN_NEU as ZEICHEN_NEU_DATEN } from "../daten/zeichenNeu";
import ParleyZeichen from "./ParleyZeichen.astro";
import { parleyZeichenMass, ZEICHEN_PFAD as PZ_PFAD, ZEICHEN_B as PZ_B, ZEICHEN_H as PZ_H } from "../daten/parleyZeichen";
/* PROBE „neues Zeichen“ im Fuß, NUR auf localhost (Rasul 18.11.2026: „Und auf der Webseite unten der Footer, den
   könnte man dann auch updaten, und der sollte gleichzeitig umschaltbar sein, wenn wir oben im Menü das umschalten.“).
   Hängt an html[data-zeichen] wie das Menü (MenuBBH.astro, ZEICHEN_NEU): film, parley oder alt.
   Seitenverhältnis samt Raum des Namens und Lage der Linkzeile (12 px über der Oberkante des Rechtecks, also
   100 / Höhe der viewBox) werden aus src/daten/zeichenNeu.ts gerechnet. Stand 18.11.2026 nach der Korrektur der
   Namenslage: „parley“ 209,83 : 120,65 = 1,7391 und 82,88 %, „parley Film“ 200,82 : 129,40 = 1,5519 und 77,28 %
   (Zeilen enger, Grundlinienabstand 0,833 em wie im bisherigen Zeichen).
   Rückweg zum bisherigen Zeichen: ZEICHEN_NEU auf false. */
/* Angenommen (Rasul 18.11.2026 nachmittags: „Es gilt für die Webseite jetzt erstmal der Name parley Film.“). Seitdem
   steht das neue Zeichen mit „parley Film“ auch im Bau, dort fest (Regeln an html:root, kein Skript). „parley“ allein,
   das bisherige Zeichen und das Umschalten bleiben localhost (ZEICHEN_PROBEN). */
const ZEICHEN_NEU = true;
const ZEICHEN_PROBEN = import.meta.env.DEV;
const ZEICHEN_ALT = !ZEICHEN_NEU || ZEICHEN_PROBEN;
const znMass = (f: "parley" | "film") => { const [, , b, h] = ZEICHEN_NEU_DATEN[f].viewBox.split(/\s+/).map(Number); return { v: (b / h).toFixed(4), o: (10000 / h).toFixed(2) }; };
const znP = znMass("parley"), znF = znMass("film");
const ZN_FILM = ZEICHEN_PROBEN ? 'html[data-zeichen="film"]' : "html:root";
const ZEICHEN_NEU_STIL = `
${ZN_FILM} .site-footer .site-footer__logo { width: min(100%, calc((100dvh - 60px - var(--fuss-oben) - var(--menue-raum)) * ${znF.v})); }
${ZN_FILM} .site-footer .site-footer__logo > nav { bottom: calc(${znF.o}% + 12px); }
` + (ZEICHEN_PROBEN ? `
html:is([data-zeichen="parley"], [data-zeichen="film"]) .site-footer__logo > svg.site-footer__wortmarke:not(.site-footer__zeichen-neu) { display: none; }
html:not([data-zeichen="parley"]):not([data-zeichen="film"]) .site-footer__logo > svg.site-footer__zeichen-neu,
html[data-zeichen="parley"] .site-footer__logo > svg.site-footer__zeichen-neu--film,
html[data-zeichen="film"] .site-footer__logo > svg.site-footer__zeichen-neu--parley { display: none; }
html[data-zeichen="parley"] .site-footer .site-footer__logo { width: min(100%, calc((100dvh - 60px - var(--fuss-oben) - var(--menue-raum)) * ${znP.v})); }
html[data-zeichen="parley"] .site-footer .site-footer__logo > nav { bottom: calc(${znP.o}% + 12px); }
` : "");
/* PROBE „parley Zeichen“ im Fuß, NUR auf localhost (Auftrag Website · Master 26.11.2026 nach Rasuls Wort, siehe
   MenuBBH.astro, PZ). Hängt an html[data-wortlage] wie das Menü: a, b, c oder aus. Das Seitenverhältnis kommt aus
   src/daten/parleyZeichen.ts (bis zur Unterkante der Tinte): A 4,627 : 1 · B 5,135 : 1,121 · C 1,775 : 1,467.
   Die Linkzeile steht 12 px über der Oberkante des Zeichens; die liegt bei allen drei Lagen an der Oberkante der
   Zeichnung, also 100 %.
   Seitenrand: Das bisherige Zeichen begann an der Bildschirmkante („die Blase selbst beginnt an der Bildschirmkante“).
   Das parley Zeichen mit Wort daneben ist bei A und B breiter als das Fenster hoch; an den Kanten säße links die
   Rundung des Zeichens und rechts das m von „Film“ ohne Luft am Glas. Deshalb hier um den Seitenrand (--rand) je
   Seite eingerückt, die Linkzeile bündig mit der linken Kante des Zeichens (left 0). Meine Wahl, nicht Rasuls Wort.
   Die Regeln liegen über denen von ZEICHEN_NEU und fassen sie nicht an. Rückweg: PZ auf false. */
/* OHNE TEXT (Rasul 26.11.2026: „Mach mal unten Parley Film erstmal raus im Footer den Text. Lass mal nur das Logo
   über die ganze Breite.“): neuer Wert „ohne“ am Schalter Wortlage, seitdem Grundeinstellung. Nur das Zeichen
   (142,85 : 100), ohne Einzug am Seitenrand, so breit wie das Fenster. Der Deckel über die Fensterhöhe bleibt wie
   bei allen Fassungen davor: Der Fuß klebt am unteren Rand und muss samt Linkzeile in den Bildschirm passen. An
   einem breiten Fenster ist das Zeichen deshalb schmaler als das Fenster und steht mittig (bei 1440 × 900: 970 px).
   Die Linkzeile steht bündig an der linken Kante des Zeichens, mindestens aber um den Seitenrand vom Glas.
   VOLLE BREITE (Rasul 26.11.2026, auf meine Frage, ob das Zeichen auch am Rechner die volle Breite bekommen und
   unten angeschnitten sein soll: „Volle Breite“): Das Zeichen ist immer so breit wie das Fenster. Der Kasten des
   Zeichens behält die Höhe des Deckels; was vom Zeichen darunter läge, ist abgeschnitten (clip-path, nach oben
   offen, damit die Linkzeile bleibt). Die Schnittkante liegt über der Menüzeile, nicht am Bildschirmrand: Dort
   stünde das helle Menü auf dem weißen Zeichen. Vorher am selben Tag: gedeckelt und mittig (955 px bei 1440 × 900);
   Weg dorthin: width wieder min(100%, Deckel × 1,4285), height und clip-path weg.
   Zurück zum Text: Wortlage a, b oder c. */
/* GANZ ZU SEHEN (Rasul 26.11.2026 nach dem Hochladen: „Wenn ich da ganz runter scroll zum Footer, kann ich das Logo
   gar nicht ganz sehen von uns.“): Das Zeichen bleibt so breit wie das Fenster, wird aber nicht mehr unten
   abgeschnitten. An einem breiten Fenster ist der Fuß damit höher als der Bildschirm (bei 2048 × 1064: Zeichen
   1434 px hoch). Deshalb klebt der Fuß dort nicht mehr mit der Unterkante am Bildschirm, sondern mit der Oberkante
   (bottom ist dann negativ, um das Stück, das der Fuß höher ist als das Fenster): Der Vorhang legt erst den oberen
   Teil frei, danach scrollt man durch das Zeichen bis zur Unterkante; darunter bleibt der Raum für die Menüzeile.
   Passt der Fuß ins Fenster (Handy, schmale Fenster), ändert sich nichts. 100vw statt der echten Breite: mit
   fester Bildlaufleiste liegt die Rechnung um rund 10 px daneben, das fällt in den schwarzen Raum über dem Zeichen.
   Vorher (seit „Volle Breite“ am selben Tag): height min(100vw × 0,70004, 100dvh − 60px − --fuss-oben −
   --menue-raum) und clip-path inset(-200px 0 0 0) am Logo, Fuß bottom 0. Weg zurück: diese Werte wieder setzen
   und die Zeile mit bottom entfernen. */
/* GERAHMT STATT RANDLOS (Rasul 26.11.2026, über Website · Master, nachdem er das Durchscrollen gesehen hatte: „Beim
   runterscrollen sehe ich immer noch nicht das ganze Logo als Footer. Es wird immer noch in der Höhe abgeschnitten.
   Du kannst es vielleicht mal doch nicht bis an den Bildrand machen, sondern ihn am Rand geben, wie das bei einem
   YouTube-Logo normal ist, diese 67%“). Die Regel steht in branding/aktiv/Parley_Logo_Videogeste_2026-11.md: Das
   Zeichen nimmt 67,4 % der Breite und 47,2 % der Höhe seines Behälters ein. Der Behälter ist hier ein Quadrat mit
   der kürzeren Fensterseite, min(100vw, 100dvh): So bleibt in beiden Richtungen Luft, am Querformat begrenzt die
   Höhe (2048 × 1064: Zeichen 717 × 502), am Handy die Breite (375: 253 × 177). Der Fuß ist so hoch wie dieses
   Quadrat, das Zeichen steht darin mittig; er passt damit immer in ein Fenster und klebt wieder mit bottom 0.
   Die Linkzeile steht bündig an der linken Kante des Zeichens.
   Am Handy wäre das Quadrat zu knapp: Das Zeichen endete 7 px über der Menüzeile (gemessen bei 375 × 812). Der Fuß
   ist dort deshalb mindestens Zeichenhöhe + 2 × --menue-raum + 48 px hoch (von mir gesetzt, nicht von Rasul); bei
   375 px sind das 433 statt 375 px, zwischen Zeichen und Menüzeile liegen dann rund 36 px.
   Damit entfallen „Volle Breite“ und „Ganz zu sehen“ (Durchscrollen) von oben; ihre Kommentare bleiben als Verlauf.
   Weg zurück zum Durchscrollen: Logo width 100%, die Zeile für .site-footer__inner weg, dafür
   .site-footer { bottom: min(0px, calc(100dvh - var(--fuss-oben) - var(--menue-raum) - 100vw * 0.70004)) }. */
/* RAND WIE IN DER MENÜKACHEL (Rasul 26.11.2026, nachdem der gerahmte Fuß online war: „jetzt ist er aber zu klein.
   Finde ich. Wir haben doch im Menü eine Kachel, wo wir unser Logo drin haben. Und da haben wir doch ein Verhältnis
   zum Abstand zum Rand von der Kachel. Den gleichen Abstand hätte ich gern zum Viewportrand.“): In der Kachel ist
   das Zeichen 67,4 % der Kachelbreite breit, links und rechts bleiben je 16,3 %. Dasselbe gilt jetzt zum Fenster:
   Zeichen 67,4 % der Fensterbreite. Damit es am breiten Fenster nicht wieder höher wird als der Bildschirm, gilt
   der alte Deckel über die Fensterhöhe (100dvh − 60 px Linkzeile − --fuss-oben − --menue-raum); wo er greift, ist
   der Rand links und rechts größer als 16,3 %. Der Fuß hat wieder die Polster oben und unten statt der festen Höhe.
   Vorher (GERAHMT, wenige Stunden online): Breite 0,674 × min(100vw, 100dvh), Fuß so hoch wie die kürzere
   Fensterseite, Zeichen senkrecht mittig. Weg zurück: Git, Commit 326f557. */
/* LUFT ÜBER DEM ZEICHEN: LG, FEST (Rasul 26.11.2026 im Gespräch „Website · Master“: „Die mittlere (lg)“, von dort
   als Bauanweisung weitergegeben). Über dem Zeichen steht --abstand-lg (60 bis 160 px) statt --fuss-oben, auch im
   Bau (PZ_OHNE). Begründung: Der Fuß stand zu nah am Abschnitt davor. Das Zeichen bleibt gleich groß, der Deckel
   rechnet weiter mit --fuss-oben. „rand“ und „bisher“ bleiben nur auf localhost als Vergleich (Schalter „Fußluft“).
   Weg zurück: in der Regel unten --pz-oben auf var(--fuss-oben) setzen. Es folgt der Vermerk zur Probe davor. */
/* PROBE, NUR LOCALHOST: LUFT ÜBER DEM ZEICHEN (Rasul 26.11.2026 zu Website · Master: „Der Footer braucht auch nach
   oben ein bisschen Platz, der ist jetzt sehr nah am nächsten Element dran.“). Schalter „Fußluft“
   (html data-fussluft = lg | rand | bisher), zwei Fassungen zum Vergleich, das Zeichen bleibt in beiden gleich groß:
   - lg:     über dem Zeichen --abstand-lg (60 bis 160 px, bei 1440 px 138 px). Grundeinstellung auf localhost.
   - rand:   über dem Zeichen so viel wie links und rechts davon (Vorschlag Website · Master: oben nicht weniger
             Luft als an den Seiten), mindestens --fuss-oben.
   - bisher: --fuss-oben (mindestens 48 px, sonst --abstand-md). Das gilt im Bau weiter, bis Rasul wählt.
   Der Deckel der Zeichenbreite rechnet weiter mit --fuss-oben, sonst würde das Zeichen wieder kleiner (Rasul fand
   es mittags zu klein). Der Fuß wird dadurch an breiten Fenstern höher als der Bildschirm. Er klebt dann mit der
   Oberkante statt mit der Unterkante (bottom negativ um die Überhöhe, wie bei „Ganz zu sehen“ oben): Der Vorhang
   legt erst die Luft und den oberen Teil frei, am Seitenende steht das Zeichen ganz im Bild über der Menüzeile und
   der Abschnitt davor ist aus dem Bild. Weg zurück: Schalter auf „bisher“ oder diese Regeln löschen. */
/* AUCH IM BAU (Rasul 26.11.2026: „den Footer und das Menü können wir jetzt auf dev hochladen“, gleich danach: „Und
   anschließend auch auf“ parleyfilm.com): Im Bau gilt fest „ohne Text, volle Breite“, die Regeln hängen dort an
   html:root. A, B, C und „aus“ bleiben localhost (PZ_PROBEN). */
const PZ = true;
const PZ_PROBEN = import.meta.env.DEV;
const PZ_LAGEN = ["a", "b", "c"] as const;
const PZ_AN = PZ_PROBEN ? 'html:is([data-wortlage="a"], [data-wortlage="b"], [data-wortlage="c"], [data-wortlage="ohne"])' : "html:root";
const PZ_OHNE = PZ_PROBEN ? 'html[data-wortlage="ohne"]' : "html:root";
const PZ_STIL = `
${PZ_AN} .site-footer__logo > svg.site-footer__wortmarke:not(.site-footer__pz) { display: none !important; }
${PZ_PROBEN ? `html:not(:is([data-wortlage="a"], [data-wortlage="b"], [data-wortlage="c"], [data-wortlage="ohne"])) .site-footer__logo > svg.site-footer__pz { display: none !important; }` : ""}
${PZ_OHNE} .site-footer__logo > svg.site-footer__pz:not(.site-footer__pz--ohne) { display: none !important; }
${PZ_OHNE} .site-footer__logo > svg.site-footer__pz--ohne { display: block !important; }
${PZ_OHNE} .site-footer .site-footer__logo.site-footer__logo { width: min(calc(100vw * 0.674), calc((100dvh - 60px - var(--fuss-oben) - var(--menue-raum)) * ${(PZ_B / PZ_H).toFixed(4)})); }
${PZ_OHNE} .site-footer .site-footer__logo.site-footer__logo > nav { bottom: calc(100% + 12px); left: 0; }
${PZ_OHNE} .site-footer { --pz-b: min(calc(100vw * 0.674), calc((100dvh - 60px - var(--fuss-oben) - var(--menue-raum)) * ${(PZ_B / PZ_H).toFixed(4)})); --pz-oben: var(--abstand-lg); bottom: min(0px, calc(100dvh - var(--pz-oben) - var(--pz-b) * ${(PZ_H / PZ_B).toFixed(5)} - var(--menue-raum))); }
${PZ_OHNE} .site-footer .site-footer__inner { padding-top: var(--pz-oben); }
${!PZ_PROBEN ? "" : `
html[data-wortlage="ohne"][data-fussluft="rand"] .site-footer { --pz-oben: max(var(--fuss-oben), calc((100vw - var(--pz-b)) / 2)); }
html[data-wortlage="ohne"][data-fussluft="bisher"] .site-footer { --pz-oben: var(--fuss-oben); }
`}
` + (!PZ_PROBEN ? "" : PZ_LAGEN.map((l) => { const m = parleyZeichenMass(l); return `
html[data-wortlage="${l}"] .site-footer__logo > svg.site-footer__pz:not(.site-footer__pz--${l}) { display: none !important; }
html[data-wortlage="${l}"] .site-footer__logo > svg.site-footer__pz--${l} { display: block !important; }
html[data-wortlage="${l}"] .site-footer .site-footer__logo.site-footer__logo { width: min(calc(100% - 2 * var(--rand)), calc((100dvh - 60px - var(--fuss-oben) - var(--menue-raum)) * ${(m.breite / m.hoehe).toFixed(4)})); }
html[data-wortlage="${l}"] .site-footer .site-footer__logo.site-footer__logo > nav { bottom: calc(100% + 12px); left: 0; }`; }).join(""));
---
{/* Sticky-Reveal-Footer (Fred 30.08. nachts, "bau den Footer") — exakt das
   BBH-Muster, das Maximilian auf der Nuxt-Seite 1:1 kopiert hat und das wir
   dort nachgemessen haben: der Footer klebt mit sticky/bottom:0 auf Ebene 0
   am Viewport-Boden, der gesamte Seiteninhalt liegt auf Ebene 10 darüber
   (Wrapper in Layout.astro) — beim Zuendescrollen legt der wegrutschende
   Inhalt den Footer frei wie ein Vorhang. Kein Skript, keine Animation,
   reine Stapel-Logik.

   Das große Zeichen ist aus unseren AKTUELLEN Logo-Assets gesetzt (Fahne +
   Wortmarke, Anordnung wie Header/BrandLogo) — das fertige sticky-logo.svg
   der Nuxt-Seite zeigt noch den alten Logo-Stand (Text über volle Höhe) und
   wurde deshalb bewusst NICHT übernommen.

   Wird von Layout.astro NACH dem Inhalts-Wrapper gerendert — Seiten binden
   den Footer nicht mehr selbst ein. */}
<footer class="site-footer">
	<div class="site-footer__inner">
		{/* Nur die Wortmarke, volle Breite (Fred 30.08. nachts: "Fahne weg" —
		   mit Fahne passte die Komposition nicht vollständig ins Bild). */}
		{/* aria-hidden liegt nur noch auf dem img (leeres alt) — der Container
		   trägt jetzt auch die Rechts-Links und darf nicht versteckt sein. */}
		<div class="site-footer__logo">
			{/* Pflicht-Links ÜBER dem Schriftzug, rechtsbündig (Rasul 26.10.2026:
			   „höher als die Oberkante vom l oder P“). Verlauf: seit Fred 31.08.
			   standen sie im Freiraum der Wortmarke rechts neben „The“, am
			   26.10. kurz über „ey“ (zu nah am y). Nur Impressum/Datenschutz
			   (Fred: "Start weg"). */}
			<nav aria-label="Rechtliches">
				<a href="/impressum">Impressum</a>
				<a href="/datenschutz">Datenschutz</a>
			</nav>
			{/* „Parley“ statt „The Parley“ (Rasul 26.10.2026, Namensregel: The
			   Parley ist jetzt das Studio). Text in Forma DJR Black statt des
			   alten Bilds public/parley/parley-text.svg (bleibt im Repo); eine
			   Zeile von Kante zu Kante. */}
			{/* Seit 13.11.2026 „parley“ über „Film“, mittig, wie der Name in der Blase des Logos (Rasul:
			   „Parley klein schreiben beziehungsweise parley Film nennen, die Variante, wo Film einen großen
			   Anfangsbuchstaben hat, mittig“). Zeilenabstand wie im Logo: Grundlinie zu Grundlinie
			   1,19 × Versalhöhe (0,70 em) = 0,833 em. */}
			{/* Neustart 13.11.2026: das Logo über die volle Breite wie bei BBH (dort die Wortmarke als SVG,
			   Analyse B_Seitenaufbau 6.2). Vorher „parley / Film“ als Text in Forma DJR Black; mit dem
			   Schriftwechsel (WEBSITE.md 3n) wäre der Text sonst in Geist gesetzt worden. Rückweg: Git. */}
			{/* Ohne Wortmarke, nur die Fläche (stufe 3), Rasul 13.11.2026 abends: „Ja, mach mal den Fuß ohne Wortmarke.“
			   Grund: Die Umrisse von „parley Film“ sind aus Forma DJR gebaut, die Lizenz ist offen (Marketing-Ordner
			   website/WEBSITE.md Punkt 18). Rückweg: stufe={1}. */}
			{/* „parley“ in der Blase (stufe 2), Rasul 16.11.2026: „parley in die Blase“. Das Wort ist in Geist 900 gesetzt
			   (frei), nicht in Forma; damit steht die offene Lizenz dem Fuß nicht mehr im Weg. War 13.11. bis 16.11.2026:
			   stufe={3}, nur die Fläche. Rückweg: stufe={3}.
			   Seit 17.11.2026 zeigt Stufe 2 „parley“ über „Film“ (Rasul gab das Logo als Figma-Datei: „das Logo für die
			   Website“; im Marketing-Ordner unter branding/aktiv/markenbasis-2026-10/von-rasul/). Am 16.11. kurz „parley“ allein. */}
			{ZEICHEN_ALT && <LogoBiss class="site-footer__wortmarke" stufe={2} titel="parley Film" />}
			{ZEICHEN_NEU && <style is:inline set:html={ZEICHEN_NEU_STIL}></style>}
			{ZEICHEN_NEU && ZEICHEN_PROBEN && <ZeichenNeu fassung="parley" class="site-footer__wortmarke site-footer__zeichen-neu site-footer__zeichen-neu--parley" />}
			{ZEICHEN_NEU && <ZeichenNeu fassung="film" class="site-footer__wortmarke site-footer__zeichen-neu site-footer__zeichen-neu--film" />}
			{PZ && <style is:inline set:html={PZ_STIL}></style>}
			{PZ_PROBEN && PZ_LAGEN.map((l) => <ParleyZeichen lage={l} class={`site-footer__wortmarke site-footer__pz site-footer__pz--${l}`} />)}
			{PZ && <svg class="site-footer__wortmarke site-footer__pz site-footer__pz--ohne" viewBox={`0 0 ${PZ_B} ${PZ_H}`} role="img" aria-label="parley Film" xmlns="http://www.w3.org/2000/svg"><path d={PZ_PFAD} fill="currentColor" /></svg>}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		/* Platz für die Menüzeile am unteren Rand (MenuBBH.astro): Kachel 90 px unter 768 px, sonst 88 px, plus 2 px
		   Fuge und 12 px Luft. Geht auch in den Deckel der Zeichenbreite ein, damit Zeichen und Freiraum zusammen in ein Fenster passen. */
		--menue-raum: 104px;
		/* Abstand über dem Zeichen: mindestens 48 px, sonst --abstand-md (bei 1440 px rund 69 px). Geht wie
		   --menue-raum in den Deckel der Zeichenbreite ein (dazu 60 px Linkzeile). */
		--fuss-oben: max(48px, var(--abstand-md));
		/* Das BBH-/Nuxt-Rezept, drei Klassen: sticky + bottom:0 + z-index:0.
		   overflow-clip wie beim Vorbild, damit nichts aus dem Footer ragt. */
		position: sticky;
		bottom: 0;
		z-index: 0;
		overflow: clip;
		background: var(--black);
	}

	@media (min-width: 768px) {
		.site-footer { --menue-raum: 102px; }
	}

	.site-footer__inner {
		/* Kein eigener Rahmen mehr (Fred 30.08. nachts, randlose Wortmarke):
		   der Content-Rahmen (max-width + Seitenpolster) liegt jetzt NUR auf
		   der Link-Zeile — die Wortmarke darunter läuft natürlich von Kante
		   zu Kante, ohne 100vw-Ausbrecher-Tricks (die um die Scrollbar-Breite
		   überschießen und die Glyphen anschneiden würden). */
		/* Luft zum Abschnitt davor (Rasul 18.11.2026: „Der Footer braucht auch nach oben hin zum nächsten Segment ein
		   bisschen Luft, sonst dotzt die Blase so direkt ans nächste Segment an.“). Vorher 24 px. */
		padding-top: var(--fuss-oben);
		/* Freiraum unter dem Zeichen für das Menü, das seit 18.11.2026 überall fest unten mittig sitzt (Rasul: „Dann
		   müssen wir unten im Footer auch ein bisschen Schwarzraum machen, dass das Menü aus dem letzten Bild, was unser
		   großes Logo ist, auch rausfahren kann.“). Vorher 12 px; das Menü lag dann als helle Kachel auf dem weißen
		   Rechteck. --menue-raum = Kachelhöhe + Fuge darunter + 12 px Luft darüber (siehe .site-footer). */
		padding-bottom: var(--menue-raum);
		display: flex;
		flex-direction: column;
		/* Einblenden beim Freilegen — Endwerte 1:1 aus BBHs Markup (versteckt:
		   opacity 0.2 + scale 1.015, offen: 1/1). WICHTIG (Fred 30.08. nachts,
		   "spiegelbildlich"): BBH nutzt KEINE CSS-Transition (live geprüft:
		   transition-duration 0s) — Opacity/Zoom werden pro Scroll-Frame
		   direkt aus dem Freilege-Fortschritt berechnet (Skript unten setzt
		   Inline-Werte). Dadurch ist die Bewegung eine reine Funktion der
		   Scroll-Position: rückwärts scrollen = exakt dieselben Werte
		   rückwärts, automatisch spiegelbildlich. Hier nur der Startzustand
		   für die Zeit vor dem ersten Skript-Frame. */
		opacity: 0.2;
		transform: scale(1.015);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__inner {
			opacity: 1 !important;
			transform: none !important;
		}
	}


	nav {
		/* Links über der weißen Sprechblase, linksbündig mit ihrer Kante (Rasul 13.11.2026 abends: „Impressum und
		   Datenschutz legt man auf die Höhe links über das weiße Quadrat.“). Vorher eigene Zeile rechts über dem
		   ganzen Logo; dort standen sie ganz oben im Fuß und wurden erst beim letzten Pixel freigelegt.
		   Lage: Die Blase beginnt bei y = 0 der viewBox (−60,32 bis 100), ihre Oberkante liegt also 100 / 160,32 =
		   62,4 % der Logohöhe über der Unterkante; die Links stehen 12 px darüber. */
		position: absolute;
		/* eingerückt um den Seitenrand wie der Inhalt darüber; die Blase selbst beginnt an der Bildschirmkante */
		left: var(--rand);
		bottom: calc(62.4% + 12px);
		z-index: 1;
		display: flex;
		gap: clamp(16px, 2vw, 32px);
		font-size: var(--text-sm);
		font-weight: 400;
		color: var(--gray);
	}


	a {
		text-decoration: none;
		color: inherit;
	}

	/* Nur die Wortmarke, randlos von Kante zu Kante (Fred 30.08. nachts,
	   "volle Breite, nicht den Content-Rahmen"); seit 26.10.2026 „Parley“
	   statt „The Parley“. */
	.site-footer__logo {
		/* So breit wie das Logo (Deckel über die Fensterhöhe, siehe unten), damit die Rechtslinks sich am Logo
		   ausrichten können. */
		position: relative;
		width: min(100%, calc((100dvh - 60px - var(--fuss-oben) - var(--menue-raum)) * 1.8066));
		margin: 0 auto;
	}

	/* Größe über die Containerbreite (cqw), damit „Parley“ von Kante zu
	   Kante läuft (Forma DJR Black, gemessen 26.10.: Tinte 2,95 em breit,
	   Versalhöhe 0,70 em, Unterlänge y 0,17 em). Deckel über die
	   Fensterhöhe wie beim alten Bild: Element ist 0,9 em hoch, plus 36 px
	   Innenpolster. Rand oben −0,1 em: bei line-height 1 liegt die
	   Versal-Oberkante 0,1 em unter der Elementkante; so sitzt sie genau
	   auf der Oberkante, und der Abstand zur Linkzeile darüber ist genau
	   deren margin-bottom. */
	/* Logo von Kante zu Kante (Breite des Inhalts), gedeckelt über die Fensterhöhe,
	   damit es samt Linkzeile (60 px) und Polster (36 px) in den Bildschirm passt.
	   Seitenverhältnis des Logos samt Schutzraum: 289,64 : 160,32. */
	:global(.site-footer__wortmarke) {
		display: block;
		width: 100%;
		height: auto;
		color: var(--white);
	}

</style>

<script>
	// Einblenden beim Freilegen (Nuxt-Muster): sobald der Sticky-Reveal den
	// Footer-Inhalt in den Viewport bringt, fadet er ein (Klasse statt
	// Inline-Style wie bei Maximilian — gleiche Optik, sauberer rückbaubar).
	// An astro:page-load gekoppelt wie alle Skripte (ClientRouter).
	let cleanup: (() => void) | null = null;

	function initFooterReveal() {
		cleanup?.();
		cleanup = null;

		const inner = document.querySelector<HTMLElement>(".site-footer__inner");
		const content = document.querySelector<HTMLElement>(".site-content");
		if (!inner || !content) return;

		// Dritter Anlauf (Fred 30.08. nachts, "es fehlt immer noch"):
		// 1. Observer auf dem Footer → feuerte sofort (sticky = geometrisch
		//    immer im Viewport).
		// 2. Observer auf einem Inhalts-Ende-Sentinel → feuerte, sobald der
		//    ERSTE Footer-Pixel frei wurde; die 800ms Fade waren durchgelaufen,
		//    lange bevor die große Wortmarke überhaupt sichtbar wurde — der
		//    Nutzer bekam vom Faden nie etwas zu sehen.
		// Jetzt: Scroll-Fortschritt selbst rechnen — wie viele Pixel des
		// Footers sind freigelegt (Viewport-Unterkante minus Inhalts-
		// Unterkante)? Erst wenn ~45% des Footers offen liegen (die Wortmarke
		// ist dann im Bild), startet der Fade — und passiert damit VOR den
		// Augen des Betrachters.
		const footer = inner.closest<HTMLElement>(".site-footer");
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let rafId = 0;
		const check = () => {
			rafId = 0;
			if (reduceMotion.matches) return; // CSS zeigt statisch den Endzustand
			// BBH-Prinzip (live nachgemessen, Fred 30.08. nachts
			// "spiegelbildlich"): KEINE getriggerte Animation — Opacity und
			// Zoom sind eine reine Funktion des Freilege-Fortschritts, pro
			// Scroll-Frame als Inline-Stil gesetzt. Fortschritt 0 = Footer
			// ganz zugedeckt (opacity 0.2, scale 1.015), Fortschritt 1 =
			// ganz freigelegt (1 / 1). Rückwärts scrollen durchläuft dieselben
			// Werte rückwärts — spiegelbildlich per Konstruktion.
			const uncovered = window.innerHeight - content.getBoundingClientRect().bottom;
			const footerH = footer?.offsetHeight ?? window.innerHeight;
			const p = Math.max(0, Math.min(1, uncovered / footerH));
			const opacity = 0.2 + p * 0.8;
			const scale = 1.015 - p * 0.015;
			inner.style.opacity = String(opacity);
			inner.style.transform = `scale(${scale})`;
		};
		const onScroll = () => {
			if (!rafId) rafId = requestAnimationFrame(check);
		};
		window.addEventListener("scroll", onScroll, { passive: true });
		check();
		cleanup = () => {
			window.removeEventListener("scroll", onScroll);
			if (rafId) cancelAnimationFrame(rafId);
		};
	}

	document.addEventListener("astro:page-load", initFooterReveal);
</script>
