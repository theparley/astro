<section class="mo-sektion">
	<div class="mo-kopf">
		{/* Überschrift FINAL (Fred 14.09.); Sub-Zeile = das gelockte
		   Zahlen-Staccato (der frühere Satz 2 mit Content-Output/Beispiel
		   ist seit 14.09. spät raus — VIDEOPODCAST steht in der Wand).
		   Kamera-Wort bleibt komplett draußen. Beide Zeilen NICHT ohne
		   Fred anfassen. */}
		{/* &#8209; = geschützter Bindestrich (Fred 14.09.: der Umbruch „DER
		   MULTI- / OUTPUT" mitten im Kompositum sah nicht schön aus) —
		   „Multi-Output" bricht damit auf keiner Breite mehr auseinander;
		   das &nbsp; hält wie gehabt „echter Gespräche" zusammen. Mögliche
		   Zeilenfälle nur noch: Einzeiler oder der gewollte Zweizeiler. */}
		{/* IMMER zweizeilig (Fred 14.09. nacht): der gewollte Zeilenfall
		   „Der Multi-Output / eines Gesprächs" ist jetzt fest gesetzt —
		   auch wenn Platz für einen Einzeiler wäre. */}
		{/* Punkt am Ende (Fred 21.09.): zieht den Titel mit dem zweiten
		   Sektionstitel der Seite gleich, „Eine Frage des Formats." hatte
		   ihn seit jeher. Ein Satzpunkt macht aus der Ueberschrift eine
		   Aussage statt einer Beschriftung. */}
		{/* AUGENZEUGEN-MUSTER (Fred 21.09., Fassung C aus /kopf-demo):
		   Ueberschrift und Unterzeile stehen in EINEM Block, der so breit ist
		   wie die Ueberschrift (width: max-content, mittig gestellt). Die
		   Unterzeile darin ist rechtsbuendig und endet damit exakt unter dem
		   Punkt von GESPRÄCHS. Dasselbe Muster wie der Augenzeugen-Turm oben
		   auf der Seite, wo „Noch vor dem ersten Kontakt." unter dem Punkt
		   von ZEUGEN endet. Vorher schwebte die Zeile mittig unter der
		   Ueberschrift und gehoerte optisch zu nichts.
		   OHNE FETTUNG (Fassung C gegen B): die Zahlwoerter standen auf 900.
		   Mittig gesetzt hatten sie einen Job — sie markierten die drei
		   Zahlen als gezaehlte Fakten. An der rechten Kante eines fetten
		   Blocks liest das Auge sie als Fortsetzung der Ueberschrift, die
		   Ecke wird unruhig. Und das Vorbild oben ist ebenfalls ungefettet —
		   die kleine Zeile ist dort bewusst leise, das ist der Reiz der
		   Anheftung. Die Position uebernimmt jetzt die Betonung. */}
		<div class="turm-block">
			<h2>Der Multi&#8209;Output<br />eines&nbsp;Gesprächs.</h2>
			<p>Ein Gespräch. Eine Stunde. Zwei Experten.</p>
		</div>
	</div>

	<div class:list={["kachel-reihe", fassung === "brett" && "kacheln--brett"]}>
		{/* ── Kachel 1: Gespräch → Ausspielungen ───────────────────────── */}
		<div class="feld">
			<div class="kachel-kopf">
				<p class="verhaeltnis">1 <span class="zu">zu</span> 10+</p>
				{/* „Mehr als zehn" statt „Zehn" (20.09. abends): die Ueberschrift
				   traegt seit Freds Aenderung ein Plus, und eine Zeile
				   darunter, die auf genau zehn festlegt, wuerde ihr
				   widersprechen. Wortlaut sonst unveraendert. */}
				{/* Wortlaut und Schreibweise wie von Fred getippt (20.09.
				   abends): „Deliveries" in englischer Pluralform und die
				   Zahl als Ziffer. Nach deutscher Regel waere es
				   „Deliverys" (Babys, Partys, Storys), und die beiden
				   anderen Kacheln schreiben ihre Zahlen aus. */}
				{/* MOEGLICHKEIT statt Zusage (Fred 21.09.): „Ein Gespräch im Monat
					   kann mehr als 10 Deliveries liefern. Sozusagen in der
					   Vollausbaustufe eines Gesprächs." Das Brett zeigt, was
					   maximal aus einer Aufnahme herausgeholt werden kann, nicht
					   was jeder Monat automatisch bringt — „liefert" hatte daraus
					   eine Mengenzusage gemacht.
					   OHNE VERB (Fred 21.09., „vielleicht lassen wir aus, wegen
					   Markengründen, einfach mal die Behauptung, dass es das
					   liefert"): der Satz nennt nur noch die beiden Groessen und
					   stellt sie nebeneinander. Kein „liefert", kein „kann
					   liefern" — also weder Zusage noch Rueckzieher. Das Verhaeltnis
					   steht schon in der Ueberschrift darueber; den Schluss zieht
					   der Leser selbst, und einen selbst gezogenen Schluss
					   bestreitet er nicht.
					   Nebenwirkung: die Ungleichheit zwischen den Kacheln („kann"
					   links gegen „wird zu" rechts) loest sich von selbst auf —
					   ohne Verb gibt es keinen Sicherheitsgrad, der auffallen
					   koennte. Die Bauform ist ausserdem Hausform: der Sektionskopf
					   direkt darueber steht im selben Nominal-Staccato („Ein
					   Gespräch. Eine Stunde. Zwei Experten.").
					   ZURUECK AUF „für alle Kanäle" (Fred 21.09., Entscheidung nach
					   drei Zwischenfassungen — „eure Kanäle", „jede für einen
					   Kanal"). Mein Einwand war, dass „alle" ein Absolutum ist und
					   das Brett nur acht Ziele zeigt. Freds Antwort entkraeftet ihn:
					   „wenn jemand behauptet, wir würden einen Kanal jetzt nicht
					   bespielen, dann bespielen wir den halt, ist ja für uns kein
					   Problem." Die Zusage ist einloesbar, also ist sie zulaessig —
					   das Studio produziert das Material einmal und schneidet es auf
					   jedes geforderte Ziel.
					   Die Zaehlung bleibt trotzdem auf den DELIVERIES und nicht auf
					   den Kanaelen: „mehr als 10 Kanäle" waere durch das Brett
					   direkt darunter widerlegbar (acht verschiedene Ziele, eins
					   davon die KI), und die Kanalzahl haengt ausserdem am Kunden,
					   die Deliverieszahl an der eigenen Arbeit.
					   VERB WIEDER DRIN (Fred 21.09., nach der verblosen Runde):
					   „liefert". Der fruehere Markengrund — keine Behauptung —
					   greift hier NICHT, und das ist beim Nebeneinanderlegen
					   sichtbar geworden: „liefert" ist eine Zusage ueber die EIGENE
					   Produktion, die vollstaendig im eigenen Griff liegt. Die
					   Vorsicht gehoerte auf die rechte Kachel, wo eine Vorhersage
					   ueber das Publikum steht — dort loest das „so" sie auf.
					   Mit „sendefertige" wird das Verb noch sicherer: gesagt ist,
					   was uebergeben wird, nicht was es bewirkt.
					   Nebeneffekt: beide Kacheln haben wieder ein Verb, die
					   Bauformen stimmen ueberein.
					   SENDEFERTIG (Fred 21.09., „oder ein ähnliches Wort"): das
					   Beiwort sagt, dass nichts mehr zu tun ist — der Unterschied
					   zu einer Agentur, die Rohdateien uebergibt. Es ist echtes
					   Sendehaus-Deutsch (wie druckfertig im Satz) und steht in
					   derselben Wortfamilie wie der Rest der Format-Lehre
					   (Sendeplatz, Sendung, abgesetzt).
					   Geprueft und verworfen: „veröffentlichungsfertig" (genau, aber
					   Amtsdeutsch), „startklar" (warm, aber unbestimmt),
					   „hochladefertig" (praezise, haesslich), „plattformfertig"
					   (passt zur Form-mal-Ziel-Logik, ist aber eine Neupraegung).
					   Schwachstelle von „sendefertig": Transkript und Shownotes
					   werden nicht gesendet. Traegt trotzdem, weil Bild und Ton das
					   Material dominieren.
					   Zahl bleibt Ziffer (Lock vom 20.09.), auch wenn Fred sie hier
					   ausgeschrieben getippt hat — sie spiegelt die Ueberschrift.
					   ZWEI SAETZE (Fred 21.09., getippt): „für alle Kanäle" wandert
					   aus dem Liefersatz in einen eigenen zweiten Satz —
					   „Vertrauensaufbau auf allen Kanälen." Der erste Satz sagt nur
					   noch, was uebergeben wird (Menge, Zustand), der zweite, wozu:
					   das Vertrauens-Wort aus der Vertrauensthese kommt damit in die
					   Kachel, und die Kanaele haengen am Zweck, nicht an der Zahl.
					   SENDEFERTIG ALS ZWEITER SATZ (Fred 21.09., dritte Fassung des
					   Tages, getippt): „Vertrauensaufbau" wieder raus, „sendefertig"
					   wandert aus dem Beiwort in den Nachsatz — „Sendefertig für alle
					   Kanäle." Der erste Satz ist damit nur noch Menge und Wort, der
					   zweite der Zustand plus Reichweite. Fred tippte „für alle
					   Kanälen"; gesetzt ist der Akkusativ „für alle Kanäle".
					   „FÜR JEDEN EINZELNEN KANAL" (Fred 21.09., getippt „Sende fertig
					   für jeden einzelnen Kanal"): das Absolutum „alle" wird durch
					   die Vereinzelung ersetzt. Damit sagt der Satz genau das, was
					   die Delivery-Definition meint — je Ziel eine eigene, fertige
					   Arbeit, kein Verteilen derselben Datei. Schreibung
					   zusammengesetzt „Sendefertig" (Beiwort, wie druckfertig). */}
					<p class="bezug">Ein Gespräch im Monat liefert mehr als 10 Deliveries. Sendefertig für jeden einzelnen Kanal.</p>
			</div>
			<div class="kachel">
			<div class="kachel-mitte kachel-mitte--brett">
				<SplitFlap lines={brettZeilen} holdMs={1800} minCols={13} minRows={3} />
			</div>
			<div class="kachel-mitte kachel-mitte--liste">
				<ul class="varianten">
					{varianten.map(([zahl, wort]) => (
						<li>
							<span class="anzahl">{zahl}</span>{wort}
						</li>
					))}
				</ul>
			</div>
			{/* LAUFBAND (Fred 20.09. abends): die Kanaele ziehen als Band
			   durch, und zur Mitte hin werden sie groesser. Drei Saetze
			   hintereinander, damit der Umlauf nahtlos ist; die Spur
			   wandert um genau einen Satz und beginnt von vorn. */}
			<div class="laufband" data-laufband>
				<div class="laufband-spur" data-spur>
					{[0, 1, 2].map(() =>
						kanalBand.map((k) => <span class="kanal" set:html={LOGOS[k]} />),
					)}
				</div>
			</div>
			</div>
		</div>

		{/* ── Kachel 2: Stunde → Zuschauerzeit ─────────────────────────── */}
		{/* Der Kreis wächst auf die HUNDERTFACHE FLÄCHE, also den
		   ZEHNFACHEN Durchmesser (Fred 20.09.: "berechnen das 100 mal nach
		   Fläche"). Hundertfacher Durchmesser wäre die zehntausendfache
		   Fläche — das Bild behauptete dann hundertmal mehr als die Zahl. */}
		<div class="feld">
			<div class="kachel-kopf">
				<p class="verhaeltnis">1 <span class="zu">zu</span> 100+</p>
				{/* „WIRD SO ZU" (Fred 21.09.): das Verb kommt zurueck, aber mit
				   Bedingung. Das kleine „so" zeigt auf die linke Kachel — Fred:
				   „das so heisst, wenn man die 10 Deliveries bespielt". Damit ist
				   die Zahl nicht mehr behauptet, sondern an eine Voraussetzung
				   gebunden, und zwar an eine, die direkt daneben steht. Das leistet
				   dasselbe wie ein „im Vollausbau", nur in einer Silbe.
				   Die beiden Kacheln stehen damit NICHT mehr in derselben Bauform,
				   und das ist jetzt richtig: links die Aufzaehlung dessen, was
				   rausgeht, rechts die Folge daraus. Der Unterschied ist eine
				   Ursache-Wirkung-Beziehung, kein unterschiedlicher Sicherheitsgrad.
				   „Im Monat" faellt hier weg (Fred getippt): die 100 Stunden
				   gehoeren zu EINER Aufnahme, nicht zu einem Monat — die
				   Monatstaktung steht links. Freds „100+%" ist als Tippfehler
				   gelesen und als „mehr als 100" gesetzt, passend zur
				   Nachbarzeile („mehr als 10").
				   „EINE STUNDE Aufnahme" statt „eine Aufnahme" (Fred 21.09.): erst
				   damit steht auf beiden Seiten des Satzes dieselbe Einheit —
				   eine Stunde wird zu hundert Stunden. Die Ueberschrift „1 zu
				   100+" ist dann keine Behauptung mehr, sondern die Kurzform des
				   Satzes darunter. Vorher musste der Leser raten, worauf sich die
				   Eins bezieht. */}
				{/* „MESSBARER Zuschauerzeit" (Fred 21.09., aus der Stoppuhr-Probe auf die
				   Startseite genommen): das Beiwort macht aus der Zahl eine Messgroesse
				   — die Stunden sind keine Schaetzung, sondern das, was die Plattformen
				   ausweisen (Kennzahlen-Glossar). Passt zur Stoppuhr-Bildwelt, traegt
				   aber auch bei der Uhr. */}
				<p class="bezug">{bezug2 ?? "Eine Stunde Aufnahme wird so zu mehr als 100 Stunden messbarer Zuschauerzeit."}</p>
			</div>
			<div class="kachel">
			<div class="kachel-mitte">
				{/* Aufbau: siehe Frontmatter (KACHEL 2). Kuchenstueck-Trick fuer
				   jede Uhr: Kreis mit halbem Radius, Strich so breit wie der
				   Radius, pathLength 1, stroke-dashoffset von 1,06 auf 0 gibt die
				   Scheibe als wachsendes Stueck frei; rotate(-90) legt den Start
				   auf zwoelf Uhr. Strich 1,04 lang: kein Splitter am Anfang, kein
				   Spalt am Ende. Reihenfolge = Stapel: die weissen Uhren samt
				   dunklen Blaettern in EINER Gruppe (die blendet am Ende aus), dann
				   die Stunde: Fuellung, helles Blatt, Rand, Speichen. */}
				{/* Slot „kachel2" (Probe 21.09.): eine andere Buehne fuer Kachel 2
				   (z. B. StoppuhrZaehler). Ohne Slot steht die Stunden-Buehne. */}
				<slot name="kachel2">
				<div class="kreis-buehne" data-kreis data-plan={plan}>
					<svg class="raster" viewBox="0 0 1000 1250" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
						<g class="kamera">
							<g class="weisse">
								{uhren.map((u, i) => (
									<circle class="scheibe" data-i={i} cx={u.x} cy={u.y} r={UHR.r / 2} pathLength="1" transform={`rotate(-90 ${u.x} ${u.y})`} />
								))}
								{uhren.map((u, i) => (
									<>
										{BLATT.kleineMinuten && <circle class="blatt blatt--dunkel minute" cx={u.x} cy={u.y} r={BLATT.minute.r} pathLength={striche} stroke-dasharray={`${dm} ${1 - dm}`} stroke-dashoffset={dm / 2} transform={`rotate(-90 ${u.x} ${u.y})`} />}
										<circle class="blatt blatt--dunkel fuenf" cx={u.x} cy={u.y} r={BLATT.fuenf.r} pathLength="12" stroke-dasharray={`${df} ${1 - df}`} stroke-dashoffset={df / 2} transform={`rotate(-90 ${u.x} ${u.y})`} />
										<circle class="blatt blatt--dunkel viertel" cx={u.x} cy={u.y} r={BLATT.viertel.r} pathLength="4" stroke-dasharray={`${dq} ${1 - dq}`} stroke-dashoffset={dq / 2} transform={`rotate(-90 ${u.x} ${u.y})`} />

										{stoppuhr && (
											<g class="beschlag beschlag--klein" data-i={i}>
												{beschlagStriche.map((b) => b.l.map((l) => <line pathLength="1" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke-width={l.w} transform={`translate(${u.x} ${u.y}) rotate(${b.rot})`} />))}
											</g>
										)}
									</>
								))}
							</g>
							<circle class="stunde-fuellung" cx={UHR.cx} cy={UHR.cy} r={UHR.r / 2} pathLength="1" transform={`rotate(-90 ${UHR.cx} ${UHR.cy})`} />
							<circle class="blatt blatt--hell minute" cx={UHR.cx} cy={UHR.cy} r={BLATT.minute.r} pathLength={striche} stroke-dasharray={`${dm} ${1 - dm}`} stroke-dashoffset={dm / 2} transform={`rotate(-90 ${UHR.cx} ${UHR.cy})`} />
							<circle class="blatt blatt--hell fuenf" cx={UHR.cx} cy={UHR.cy} r={BLATT.fuenf.r} pathLength="12" stroke-dasharray={`${df} ${1 - df}`} stroke-dashoffset={df / 2} transform={`rotate(-90 ${UHR.cx} ${UHR.cy})`} />
							<circle class="blatt blatt--hell viertel" cx={UHR.cx} cy={UHR.cy} r={BLATT.viertel.r} pathLength="4" stroke-dasharray={`${dq} ${1 - dq}`} stroke-dashoffset={dq / 2} transform={`rotate(-90 ${UHR.cx} ${UHR.cy})`} />
							<circle class="stunde-rand" cx={UHR.cx} cy={UHR.cy} r={UHR.r} pathLength="1" transform={`rotate(-90 ${UHR.cx} ${UHR.cy})`} />
							{/* Zaehler „00 … 60" (Fred 21.09.): mittig in der unteren Haelfte, ueber
							   dem Halbstundenstrich, zaehlt mit dem Zeiger hoch (Script liest die
							   Zeit der Speichen-Animation), steht dann auf 60; „Min." klein darunter.
							   Immer sichtbar. Als UMRISSE aus stunde-glyphen.ts, nicht als Text: Text
							   zitterte unter der Kamera-Skalierung, Pfade skalieren wie die Kreise.
							   Server-Stand = Endstand „60". */}
							<g class="stunde-zaehler" data-glyphen={glyphenJson}>
								<g class="stunde-zahl" transform={`translate(${UHR.cx} ${UHR.cy + UHR.r * ST.zahlDy}) scale(${zahlS} ${-zahlS})`}>
									{startZiffern.split("").map((c, i) => <path class="ziffer" data-slot={i} d={GLYPHEN.zahl[c as keyof typeof GLYPHEN.zahl].d} transform={`translate(${startLage[i]} 0)`} />)}
								</g>
								<g class="stunde-einheit" transform={`translate(${UHR.cx} ${UHR.cy + UHR.r * ST.einheitDy}) scale(${einheitS} ${-einheitS})`}>
									{einheitPfade.map((p) => <path d={p.d} transform={`translate(${p.x} 0)`} />)}
								</g>
							</g>
							<line class="speiche speiche--start" x1={UHR.cx} y1={UHR.cy} x2={UHR.cx} y2={UHR.cy - UHR.r} />
							<line class="speiche speiche--lauf" x1={UHR.cx} y1={UHR.cy} x2={UHR.cx} y2={UHR.cy - UHR.r} />
							{stoppuhr && (
								<g class="beschlag beschlag--stunde">
									{beschlag.map((b) => <path d={b.d} transform={`translate(${UHR.cx} ${UHR.cy}) rotate(${b.rot})`} />)}
								</g>
							)}
						</g>
					</svg>
				</div>
				</slot>
			</div>
			</div>
		</div>

		{/* ── Kachel 3 VORERST RAUS (Fred 20.09. abends) ───────────────
		   Sie behauptete „mehr als 1000 Zuschauer" und zeigte dazu tausend
		   einzelne Figuren. Die Zahl ist nach eigener Rechnung konservativ
		   (18.000 Views bei 100 Stunden Zuschauerzeit; um auf nur 1000
		   Personen zu kommen, muesste jede Person 18 Mal im Monat
		   geschaut haben — gemessen sind 2,2). Aber sie ist eine
		   Herleitung, keine Messung: plattformuebergreifend kann niemand
		   entdoppeln, auch keine Mediaagentur, und ein Figurenfeld
		   behauptet staerker als eine Zahl.
		   Dieselbe Entscheidung war beim Impact-Angebot schon einmal
		   gefallen: Stunden und Aufrufe auf die Kacheln, Personenzahl nur
		   in den Bericht. Herleitung und Spannen stehen dort, Zeiger im
		   Kennzahlen-Glossar.
		   Markup liegt in der Git-Historie (Stand 20.09.), samt der zwei
		   Hintergrund-Ebenen und dem Zoom aus der Mitte. */}
	</div>
</section>

<style>
	/* ACHTUNG beim Kopieren aus MultiOutputTafel.astro: dort steht direkt
	   ueber .mo-sektion die Zeile `<style is:global>`. Beim Umzug am 21.09.
	   ist sie mit in diesen Block gerutscht — eine Tag-Zeile mitten im CSS
	   laesst den Parser bis zur naechsten schliessenden Klammer springen
	   und verschluckt damit genau die erste Regel, .mo-sektion. Folge:
	   kein padding-top (--abstand-xl, 120–320px) und kein Flex-Gap — die
	   Ueberschrift klebte am Abschnitt darueber, die Kacheln am Kopf.
	   Der Rest des Stylesheets lief normal weiter, deshalb sah es nach
	   einem Abstands-Problem aus und nicht nach einem Syntaxfehler. */
	/* is:global + mo--Präfix (gleiche Astro-Falle wie bei SplitFlap.astro
	   dokumentiert): das Skript injiziert Logo-Markup (.mo-logo-text, svg)
	   zur Laufzeit — gescopte Selektoren träfen diese neu erzeugten Elemente
	   nie (kein data-astro-cid). Maße/Formeln 1:1 aus dem Entwurf. */
	.mo-sektion {
		/* Sektions-Abstand oben = BBHs Original-XL (Fred 14.09.: Übergang vom
		   Paragraph war zu eng; BBH fährt zwischen Sektionen 120–320px fluid —
		   Token --abstand-xl in Layout.astro). Unten bleibt das Entwurfs-Maß,
		   die Formatfrage-Sektion holt sich ihren eigenen Abstand. */
		padding: var(--abstand-xl) clamp(16px, 3vw, 56px) 0;
		display: flex;
		flex-direction: column;
		/* Abstand Kopf → Kacheln auf --abstand-md hoch (Fred 21.09.: „zu nah
		   zusammengequetscht"). Das Mass der Wand (28–56px) galt zwischen
		   Text und einer Grafik; jetzt steht unter dem Kopf wieder TEXT, und
		   zwar sehr grosser. Bei 36px hing das Zahlen-Staccato naeher an
		   „1 zu 10+" als an seiner eigenen Ueberschrift (h2-Rand 40px) —
		   die Gruppe las sich falsch herum. --abstand-md ergibt 63px bei
		   1280px Breite und stellt die Reihenfolge wieder her. */
		gap: var(--abstand-md);
	}

	/* Kopf MITTIG (Fred 13.09.) + Haus-Vorgaben statt Entwurfs-Maße:
	   Überschrift = EXAKT das Sektions-Titel-Rezept der Seite (identisch mit
	   .bausteine-titel "Wie wir das machen" — zwei Sektionstitel auf einer
	   Seite teilen EINE Größe, analog der Statement-Einheitsgröße-Regel);
	   Sub-Zeile = EXAKT die .plaedoyer-text-Lead-Typo (BBH-gemessen, weiß
	   statt des Entwurfs-Graus — "Helligkeit wie die Texte oben"). */
	.mo-kopf {
		text-align: center;
	}


	/* Block so breit wie die Ueberschrift, mittig gestellt; die Unterzeile
	   darin rechtsbuendig (Augenzeugen-Muster, s. Kommentar am Markup).
	   max-width: 100% als Schutz auf schmalen Schirmen. */
	.mo-kopf .turm-block {
		display: flex;
		flex-direction: column;
		gap: 0;
		width: max-content;
		max-width: 100%;
		margin: 0 auto;
		text-align: left;
	}

	.mo-kopf .turm-block p {
		text-align: right;
		max-width: none;
		margin: 0;
	}

	/* ABSTAND = TURM-RHYTHMUS, dieselbe Rechnung wie in index.astro: bei
	   Zeilenabstand 0.9 und Versal-Kappe 0.7 liegen zwei Turmzeilen
	   0.2 Turm-Em auseinander; mit text-box-trim bleiben davon +0.05
	   Turm-Em als Rand. Ohne text-box-Unterstuetzung ein fester Wert,
	   damit sich nie etwas ueberschneidet. */
	@supports (text-box: trim-both cap alphabetic) {
		.mo-kopf .turm-block p {
			text-box: trim-both cap alphabetic;
			margin-top: calc(clamp(2.5rem, 1rem + 7vw, 8rem) * 0.05);
		}
	}

	@supports not (text-box: trim-both cap alphabetic) {
		.mo-kopf .turm-block p {
			margin-top: 12px;
		}
	}

	.mo-kopf h2 {
		margin: 0;
		font-weight: 900;
		text-transform: uppercase;
		/* 0.9 — seit Fred 14.09. nacht der EINHEITLICHE Zeilenabstand
		   aller Sektionstitel (Regler-Runde 0.85 → 0.95 → 0.9). */
		line-height: 0.9;
		letter-spacing: -0.01em;
		font-size: clamp(2.5rem, 1rem + 7vw, 8rem);
		text-wrap: balance;
	}

	.mo-kopf p {
		font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--white);
		margin: 0 auto;
		max-width: 46rem;
	}

	/* Breite wie der uebrige Seiteninhalt (--max-width, 1100px). Die WAND
	   lief randlos von Kante zu Kante — das war ihr Trick, sie sollte wie
	   eine Anzeigetafel im Raum wirken. Kacheln sind Inhalt und stehen in
	   der Textspalte, sonst stehen sie breiter als die Ueberschrift darueber.
	   Ausserdem sind alle Masse in den Kacheln Container-Einheiten: bei
	   randloser Breite waechst die Schrift ueber das Mass der Bausteine-
	   Reihe hinaus, an der sie sich ausrichtet. */
	.kachel-reihe {
		display: grid;
		gap: 16px;
		/* width + align-self statt `margin: 0 auto` (Fehler vom 21.09.):
		   .mo-sektion ist ein FLEX-Container (Spalte). Ein auto-Rand auf der
		   Querachse hebt dort das Strecken auf, das Element schrumpft auf
		   seinen Inhalt — und weil die Spalten minmax(0, 1fr) sind, war das
		   0. Die Reihe stand mit 16px Breite da, die Kacheln mit 0.
		   Aufgefallen ist es erst, als der Sektions-Abstand repariert war:
		   vorher hatte ein verirrtes Tag die ganze .mo-sektion-Regel
		   verschluckt, also gab es gar kein Flex, und der auto-Rand tat
		   genau das, was man von ihm erwartet. Ein Fehler hat den anderen
		   verdeckt. */
		width: 100%;
		max-width: var(--max-width);
		align-self: center;
	}

	/* ZWEI statt drei Spalten (Fred 20.09. abends): seit Kachel 3 raus ist,
	   duerfen die verbliebenen beiden groesser werden. Alles in den Kacheln
	   ist in Container-Einheiten bemessen, waechst also mit — Schriften,
	   Kreise, Laufband und Brett brauchen keine eigene Anpassung. */
	@media (min-width: 800px) {
		.kachel-reihe {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Kachelform 1:1 aus der Bausteine-Reihe der Startseite. */
	/* SCHRIFT UEBER DIE KACHEL (Fred 20.09. abends): Verhaeltnis und
	   Bezugszeile stehen nicht mehr IN der Flaeche, sondern darueber. Die
	   Kachel ist damit reines Bild.
	   Der Container fuer die cqw-Einheiten bleibt auf der KACHEL — alle
	   Masse der Animationen sind daran bemessen. Der Kopf bekommt seinen
	   eigenen Container auf dem Feld, damit seine Schriftgroessen weiter
	   mit der Spaltenbreite wachsen. */
	.feld {
		container-type: inline-size;
		display: grid;
		grid-template-rows: auto auto;
		gap: clamp(10px, 1.4vw, 20px);
	}

	.kachel {
		position: relative;
		/* --kachel statt --panel (Fred 21.09., s. Layout.astro): heller als
		   die Panel-Stufe, damit sich die Kacheln auf dem Handy vom Grund
		   abheben. */
		background: var(--kachel);
		aspect-ratio: 4 / 5;
		/* Rand in cqw statt in Pixeln (20.09. abends): nur so bleibt das
		   Verhaeltnis zwischen Feldbreite und Kachel-Innenbreite ueber alle
		   Fensterbreiten konstant — und nur dann treffen die Schriftgroessen
		   in Kopf und Liste dauerhaft aufeinander (siehe .varianten). */
		padding: 2.5cqw;
		display: grid;
		grid-template-rows: 1fr;
		container-type: inline-size;
		overflow: hidden;
	}

	/* Überschrift ist das VERHÄLTNIS (Fred 20.09. abends): die Kachel sagt
	   zuerst die Relation, erst darunter steht klein, was ins Verhältnis
	   gesetzt wird — und zwar AUSGESCHRIEBEN, die Zahlen wiederholt
	   ("Ein Gespräch im Monat zu neun Ausspielungen."). Die Ziffern oben
	   sind das Signal, der Satz darunter die Auflösung; wer nur das
	   Verhältnis sieht, hat es schon, wer liest, bekommt es bestätigt.
	   Der Doppelpunkt ist ausgeschrieben (Fred 20.09. abends): "1 zu 9"
	   statt "1:9" — das Verhältnis wird damit selbst schon gesprochen und
	   nicht erst in der Zeile darunter. Kostet Größe: die längste Fassung
	   ist jetzt "2 zu 1000+", die Schrift musste entsprechend kleiner. */
	/* Nur der Kopf wird gestapelt. Die mittlere Zeile darf KEINE eigene
	   Positionierung bekommen — sonst wird sie der Bezug fuer die absolut
	   liegende Menge in Kachel 3, und die bleibt wieder im Rahmen stecken
	   (genau der Fehler, den Fred gemeldet hat). */
	.kachel-kopf {
		position: relative;
		z-index: 1;
	}

	.verhaeltnis {
		margin: 0;
		font-weight: 900;
		line-height: 0.85;
		letter-spacing: -0.03em;
		font-size: 21cqw;
		white-space: nowrap;
	}

	/* Das Bindewort steht in der dünnen Schrift (Fred 20.09. abends): die
	   Zahlen tragen, "zu" verbindet nur. Gleiche Bauform wie in der Wand,
	   wo die Beschriftungen leichter wiegen als die Zahlen. */
	.zu {
		font-weight: 300;
	}

	.bezug {
		margin: 8px 0 0;
		font-weight: 300;
		line-height: 1.15;
		font-size: 5.2cqw;
		/* Weiss wie der Lauftext (Fred 21.09.: „mach die mal weiss oder in der
		   Farbe, in der wir die normale Schrift auch haben"); vorher --gray. */
		color: var(--white);
	}

	.kachel-mitte {
		display: grid;
		place-items: center;
		min-height: 0;
		/* KEIN position: relative — sonst wird diese Zeile der Bezug fuer
		   die absolut liegende Menge in Kachel 3, und die bleibt in der
		   Rasterzeile stecken statt die ganze Kachel zu fuellen. Die
		   Kreis-Buehne in Kachel 2 bringt ihren eigenen Bezug mit. */
	}

	/* Das Board muss in die Resthöhe der Kachel passen: zehn Zeilen mal
	   Kachelhöhe (Breite × 1,38) plus Fugen. 5,4cqw Kachelbreite ergibt
	   rund 75cqw Boardhöhe und 70cqw Breite bei 13 Spalten — beides sitzt
	   innerhalb der Kachel. */
	/* Mehr Luft oben und unten (Fred 20.09. abends: "dass es nicht so ganz
	   am Bild dran haengt"). Nur senkrecht — die waagerechte Polsterung
	   haelt das Verhaeltnis, an dem die Schriftgroessen abgeglichen sind. */
	.kachel:has(.laufband) {
		grid-template-rows: 1fr auto;
		gap: 4cqw;
		padding-top: 12cqw;
		padding-bottom: 2.7cqw;
	}

	/* Die Liste ist ein LINKSBUENDIGER BLOCK, der als Ganzes in der
	   waagerechten Kachelmitte sitzt (Fred 20.09. abends). Nicht zu
	   verwechseln mit zentriertem Text: die Zeilen fluchten untereinander
	   links, nur der Block als solcher steht mittig. Moeglich wurde das,
	   seit die Piktogramme nicht mehr am rechten Rand haengen — vorher
	   musste die Liste die volle Breite spannen. */
	.kachel-mitte--liste {
		align-content: start;
		justify-items: center;
		overflow: hidden;
	}

	/* Umschalter: standardmaessig die Schriftfassung, mit ?board das
	   Fallblatt. Beide liegen im Dokument. */
	/* Senkrecht mittig (Fred 20.09. abends): das Brett ist deutlich
	   niedriger als der Platz zwischen Kachelkante und Laufband — oben
	   angeschlagen hing es in der Luft. */
	.kachel-mitte--brett {
		display: none;
		align-content: center;
		justify-items: center;
		overflow: hidden;
	}

	.kacheln--brett .kachel-mitte--liste {
		display: none;
	}

	.kacheln--brett .kachel-mitte--brett {
		display: grid;
	}

	/* In der Brett-Fassung steht das Band DIREKT UNTER dem Brett, nicht am
	   unteren Kachelrand (Fred 20.09. abends). Dafuer werden beide Zeilen
	   inhaltshoch und als Block gemeinsam in die Kachelmitte gesetzt —
	   sonst zieht die 1fr-Zeile das Brett nach oben und laesst das Band
	   unten allein stehen. Gilt nur fuer diese Fassung; die Listenfassung
	   braucht ihre volle Hoehe. */
	.kacheln--brett .kachel:has(.laufband) {
		grid-template-rows: auto auto;
		align-content: center;
		/* Gleiche Polsterung oben wie unten, sonst sitzt der Block nicht
		   wirklich mittig (Fred 20.09. abends): die Listenfassung braucht
		   oben mehr Luft (12cqw gegen 2,7), und diese Differenz wanderte
		   ungesehen in die Rechnung — gemessen 305 px ueber dem Brett
		   gegen 237 unter dem Band. */
		/* OPTISCH statt rechnerisch mittig (Fred 20.09. abends: "gefuehlt
		   koennte es noch ein bisschen hoeher"). Ein Block, der genau in
		   der Mitte sitzt, wirkt in einem stehenden Format zu tief — das
		   Auge nimmt die untere Kante staerker wahr. Die untere Polsterung
		   ist deshalb um 7,8cqw groesser, das hebt den Block um die Haelfte
		   davon, rund 27 px oder ein Zehntel des freien Raums. */
		padding-top: 2.7cqw;
		padding-bottom: 10.5cqw;
	}

	.kacheln--brett .laufband {
		align-self: start;
	}

	.varianten {
		width: max-content;
		max-width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		font-weight: 300;
		/* GENAUSO GROSS WIE DIE BEZUGSZEILE (Fred 20.09. abends). Die steht
		   im Feld (volle Spaltenbreite) auf 5,2cqw, die Liste steht in der
		   Kachel und misst ihre cqw an deren Innenbreite — die ist um den
		   Rand schmaler. 5,2 / 0,95 = 5,47cqw gleicht das aus.
		   ABGESENKT auf 4,2cqw (21.09.): die Liste traegt jetzt vierzehn
		   Zeilen statt zehn, und jede nennt zusaetzlich das Ziel. Bei
		   5,47cqw war sie 610px hoch bei 491px Platz — die letzten drei
		   Zeilen wurden abgeschnitten. 4,2cqw ergibt rund 469px. */
		font-size: 4.2cqw;
		line-height: 1.62;
		letter-spacing: -0.01em;
	}

	/* Zahlenspalte rechtsbündig wie in der Wand: die Einser fluchten unter
	   den Zehnern, die Wörter beginnen alle auf derselben Kante. */
	/* KEIN Flexbox mehr in der Zeile (Fehler 20.09. abends): als
	   Flex-Container wurden Zahl, Leerzeichen und Wort zu drei eigenen
	   Elementen, zwischen denen der alte Zeilen-Abstand von 32 px stand —
	   zweimal, macht mit dem Leerzeichen rund 91 px statt der 6 px, die ein
	   Leerzeichen dieser Schrift misst. Der Abstand kam also gar nicht von
	   der Zahlenspalte. Als gewoehnliche Textzeile setzt die Schrift ihn
	   selbst.
	   Der Zeilen-Abstand stammte aus der Zeit, als die Piktogramme rechts in
	   der Zeile standen; die stehen seit heute unten im Band. */
	.varianten li {
		display: block;
	}

	/* LAUFBAND am unteren Kachelrand (Fred 20.09. abends). Die Spur laeuft
	   gleichmaessig durch; die Groesse der einzelnen Zeichen steuert das
	   Skript, weil sie von der POSITION abhaengt und nicht von der Zeit
	   allein — in der Mitte gross, zu den Raendern hin klein. */
	.laufband {
		align-self: end;
		/* Luft fuer die Vergroesserung (Fred 20.09. abends: "oben und unten
		   ganz leicht angeschnitten"). Der Kasten ist nur so hoch wie ein
		   Zeichen in Normalgroesse; in der Bandmitte wachsen sie auf das
		   1,5-fache und ragten deshalb oben und unten heraus, wo das
		   overflow:hidden sie abschnitt. Die Polsterung gehoert zum
		   sichtbaren Bereich, schafft also genau den fehlenden Platz. */
		padding-block: 2.3cqw;
		overflow: hidden;
		/* Weiche Kanten: das Band soll nicht abgeschnitten wirken, sondern
		   auslaufen. */
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}

	.laufband-spur {
		display: flex;
		align-items: center;
		/* Mehr Abstand, weil die Zeichen in der Bandmitte WACHSEN (Fred
		   20.09. abends). Die Vergroesserung ist eine Transformation, der
		   Abstand dagegen Layout — er waechst also nicht mit. Bei Faktor
		   1,5 ragt ein Zeichen um knapp 2cqw je Seite ueber seinen Platz
		   hinaus; von 3cqw Abstand blieb in der Mitte fast nichts. Mit
		   10cqw bleiben in der Mitte rund 6. */
		gap: 10cqw;
		width: max-content;
		will-change: transform;
		/* Die Spur wird vom Skript gesetzt, nicht von CSS animiert. */
	}

	.kanal {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 7.5cqw;
		height: 7.5cqw;
		flex: none;
		transform-origin: center;
	}

	.kanal :global(svg) {
		width: 100%;
		height: 100%;
		display: block;
	}

	/* LinkedIn ist bewusst Text („in"), kein SVG — dieselbe Setzung wie in
	   der Wand. Das Styling dafür lebt dort im globalen Block der
	   Wand-Komponente; die steht auf dieser Seite nicht, also hier nochmal. */
	.kanal :global(.mo-logo-text) {
		font-family: -apple-system, "Helvetica Neue", sans-serif;
		font-weight: 800;
		font-size: 5.6cqw;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	/* Spaltenbreite EXAKT zwei Ziffern (Fred 20.09. abends: "noch nicht weit
	   genug aussen"). Vorher waren es 2,2em — deutlich mehr, als "10"
	   braucht, weshalb selbst die Zehnerzeilen eingerueckt standen und die
	   Liste nicht auf der Textkante der Ueberschrift sass. "ch" ist die
	   Breite der Null, tabular-nums macht alle Ziffern gleich breit: damit
	   fluchtet "10" genau mit dem Text darueber, und die Einser stehen eine
	   Ziffer eingerueckt — dieselbe Zahlenspalte wie in der Wand. */
	.anzahl {
		display: inline-block;
		font-variant-numeric: tabular-nums;
		width: 2ch;
		/* Abstand = GENAU EIN LEERZEICHEN dieser Schrift (Fred 20.09.
		   abends: "so wie wenn das nebeneinander geschrieben waere").
		   Nachgemessen sind das 5,87 px bei 37,99 px Schriftgroesse, also
		   0,155em. Vorher standen hier 0,28em, mehr als das Doppelte.
		   Ein echtes Leerzeichen im Text statt dieses Wertes waere die
		   naheliegende Loesung, funktioniert hier aber nicht: es wird zu
		   einem eigenen Element neben der Zahlenspalte, und dadurch
		   verschieben sich die Wortkanten zwischen Einser- und
		   Zehner-Zeilen. Mit dem festen Rand fluchten sie.
		   0,22em statt 0,155 (Fred 20.09. abends, nach Sichtung): ein
		   Leerzeichen allein war zu knapp, 0,28 war zu viel. */
		margin-right: 0.22em;
		text-align: right;
		/* Kein Fettdruck (Fred 20.09. abends, nach Sichtung): die Zahlen
		   sollen die Spalte halten, nicht die Zeile beherrschen. Die
		   Überschrift der Kachel ist das Verhältnis — wenn die Liste
		   darunter auch noch fett zählt, bekommt die Kachel zwei laute
		   Stimmen. */
	}

	/* ── Kachel 2: Kreis ───────────────────────────────────────────────── */
	/* Die Buehne sitzt HOEHER als die Rasterzeile sie stellen wuerde (Fred
	   20.09. abends): der kleine Kreis soll auf derselben Hoehe stehen wie
	   die zwei Personen in Kachel 3.
	   Aus dem LAYOUT gerechnet, nicht aus einer Momentaufnahme der
	   Animation (die Buehne ist zeitweise zehnfach skaliert, ihre gemessenen
	   Kanten taugen dann nicht): die Buehne fuellt die mittlere
	   Rasterzeile, deren Mitte liegt bei 62,4 % der Kachelhoehe. Die Figuren
	   in Kachel 3 sitzen bei 53,7 % — Position 58 % auf eine Grafik im
	   Verhaeltnis 2:1, die ueber die ganze Kachel laeuft. Differenz 6,6 %
	   der Hoehe, bei 4:5 und cqw auf die Inhaltsbreite bezogen sind das
	   11,44cqw.
	   Der Versatz sitzt auf der BUEHNE, nicht auf den Kreisen: die Buehne
	   traegt den Zoom, und weil sie um ihre eigene Mitte skaliert, wandert
	   der Kreis dadurch bei jeder Zoomstufe mit — ein Versatz an den
	   Kreisen selbst wuerde dagegen mitskaliert und am Anfang zehnfach
	   ausschlagen. */
	/* KEIN eigener Bezug mehr: das SVG liegt absolut auf der KACHEL (deren
	   Polsterung ist der Rand), nicht auf der Innenflaeche — sonst blieben
	   rundum 2,5cqw stehen und der Anschnitt der aeusseren Uhren fiele weg. */
	.kreis-buehne {
		position: static;
		width: 100%;
		height: 100%;
	}

	/* ── Die Stunde und ihre hundert ────────────────────────────────────
	   Bewegung kommt komplett aus dem Skript (Web Animations API, Zeiten aus
	   ZEIT im Frontmatter). Hier stehen nur Ruhezustaende und Masse. */
	.raster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	/* Kamera = Gruppe, die um die Bildmitte skaliert. transform-box: view-box
	   macht 50 % 50 % zur Mitte der viewBox (500, 625). Ruhe = Rundenanfang. */
	.kamera {
		transform-box: view-box;
		transform-origin: 50% 50%;
		transform: scale(7);
	}

	/* Kuchenstueck-Trick, anfangs leer (s. Markup). */
	/* „scheibe", nicht „feld": das Layout-DIV um die Kachel heisst schon
	   .feld, und stroke-dasharray VERERBT sich in SVG — die Regel traf das
	   DIV, und von dort erbten alle SVG-Kinder das Strichmuster, auch die
	   Speichen (Fred 21.09., live: „der Strich, der den Zeiger anzeigt, ist
	   jetzt gestrichelt"). */
	.scheibe,
	.stunde-fuellung,
	.stunde-rand {
		fill: none;
		stroke-dasharray: 1.04 2;
		stroke-dashoffset: 1.06;
	}
	.scheibe {
		stroke: #ffffff;
		stroke-width: 34;
	}
	/* Dunkle Fuellung der Stunde: auf Schwarz unsichtbar, bleibt als dunkle
	   Scheibe stehen, wenn die weissen Uhren um sie herum entstehen. */
	.stunde-fuellung {
		stroke: var(--kachel);
		stroke-width: 34;
	}
	/* Kontur und Speichen: 2,5 Einheiten — bei Kamera 7 rund 6 px auf einer
	   542er Kachel, in Ruhe knapp ein Pixel. Die Linie waechst mit der
	   Kamera, das ist gewollt. */
	.stunde-rand,
	.speiche {
		stroke: #ffffff;
		stroke-width: 2.5;
	}
	.speiche--lauf {
		transform-box: view-box;
		transform-origin: 50% 50%;
	}
	/* Dunkler Zeiger je weisser Uhr (Fred 21.09.): laeuft mit der Fuellung
	   einmal herum und bleibt auf 12 stehen, wie der weisse der Stunde.
	   Drehpunkt = Uhrmitte (inline transform-origin, view-box-Einheiten). */
	/* Stoppuhr-Beschlag (Probe). Stunde: T-Pfade als Flaeche, weiss, statisch.
	   Kleine Uhren: Striche (s. Frontmatter), ein- und ausgeschaltet ueber
	   stroke-dashoffset auf der GRUPPE (vererbt sich auf die Linien) — exakt
	   die Mechanik der Scheiben, kein Opacity, kein Visibility (beides
	   flackerte am Rundenwechsel, Fred 21.09.). Versatz 1 = unsichtbar. */
	.beschlag--stunde path {
		fill: #ffffff;
	}
	/* Zaehler: Umrisse (s. Markup), weiss wie das Blatt der Stunde. */
	.stunde-zaehler path {
		fill: #ffffff;
	}
	.beschlag--klein {
		fill: none;
		stroke: #ffffff;
		stroke-dasharray: 1 1;
		stroke-dashoffset: 1;
	}


	/* Ziffernblaetter (s. Frontmatter BLATT). Die dunklen liegen ueber den
	   weissen Scheiben und erscheinen in dem Mass, wie das Weiss darunter
	   waechst. */
	.blatt {
		fill: none;
	}
	.blatt.minute {
		stroke-width: 3.5;
	}
	.blatt.fuenf {
		stroke-width: 5;
	}

	.blatt.viertel {
		stroke-width: 7;
	}
	.blatt--hell {
		stroke: #ffffff;
	}
	.blatt--dunkel {
		stroke: var(--kachel);
	}

	/* Ohne Bewegung: das fertige Bild in Ruhe — Kamera draussen, alle Uhren
	   voll. Das Skript legt in dem Fall keine Animationen an. */
	@media (prefers-reduced-motion: reduce) {
		.kamera {
			transform: scale(1.15);
		}
		.beschlag--klein {
			stroke-dashoffset: 0;
		}


		.scheibe,
		.stunde-fuellung,
		.stunde-rand {
			stroke-dashoffset: 0;
		}
	}
</style>

<style is:global>
	/* Kachelgroesse des Fallblatts MUSS auf .sf-grid selbst stehen:
	   SplitFlap rechnet --sf-tile-w dort per eigener Formel und
	   ueberschreibt jede Vorgabe am Elternelement.
	   Dreizehn Spalten ueber die volle Breite. Die Zarge ist unsichtbar,
	   belegt aber weiter Platz (2 × 0,24 Kachelbreiten), es sind also 13,48
	   Kacheln fuer 100cqw Innenbreite — 7,4cqw je Kachel. */
	.kachel-mitte--brett .sf-grid {
		--sf-tile-w: 7.7cqw;
		/* BUCHSTABEN NAEHER ZUSAMMEN (Fred 20.09. abends). Der Abstand
		   kommt nicht von den Kacheln — die stossen mit einem Pixel Fuge
		   ohnehin fast aneinander —, sondern vom Verhaeltnis Schrift zu
		   Kachel: die Vorgabe der Komponente ist 0,62, ein Zeichen der
		   Mono-Schrift ist dabei nur rund ein Drittel so breit wie seine
		   Kachel, der Rest ist Luft. Die Kachelbreite bleibt, weil elf davon
		   die Reihe fuellen sollen — geaendert wird nur, wie weit das
		   Zeichen sie ausnutzt.
		   AM OBJEKT AUSGEMESSEN (Kachel 61,8 x 85,3 px):
		     0,62 → Zeichen 23 px, Luecke 39 px   (Vorgabe der Komponente)
		     1,0  → Zeichen 37 px, Luecke 25 px
		     1,2  → Zeichen 45 px, Luecke 17 px
		     1,4  → Zeichen 52 px, Luecke 10 px
		     1,5  → Zeichen 56 px, Luecke  6 px   ← gesetzt (Fred)
		     1,6  → Zeichen 59 px, Luecke  2,5 px
		     1,67 → Zeichen 62 px, Luecke  0      (Zeichen stossen an)
		   Senkrecht ist bis 1,67 alles frei: die Versalhoehe waechst dabei
		   auf 72 px und bleibt unter der Kachelhoehe von 85. Die Grenze ist
		   also die Waagerechte.
		   Fred hat 1,5 gewaehlt. 1,4 war mein Vorschlag als engste Stufe mit
		   klarem Abstand; ab 1,6 kleben die Zeichen, und die Kachelfugen
		   laufen dann durch beruehrende Buchstaben.
		   Die Kacheln selbst zu verschmaelern brachte nichts: dann
		   schrumpft die Schrift im selben Verhaeltnis mit, das Bild sieht
		   genauso aus, nur kleiner. */
		--sf-font-size: calc(var(--sf-tile-w) * 1.5);
	}

	/* NUR DIE SCHRIFT (Fred 20.09. abends): Wand, Kacheln, Zarge und
	   Scharnier werden unsichtbar, die Buchstaben bleiben — und mit ihnen
	   die Klapp-Bewegung, denn die steckt in den Schichten, nicht in der
	   Flaeche. Das Brett verliert damit seine Anmutung als Anzeigetafel und
	   wird zu Schrift, die sich umblaettert.
	   Alles hier ist Sichtbarkeit, keine Geometrie: Kachelgroessen,
	   Zeilenraster und Schriftgroesse bleiben, wie sie sind. */
	.kachel-mitte--brett .sf-grid,
	.kachel-mitte--brett .sf-board {
		background: none;
		padding: 0;
		box-shadow: none;
	}

	.kachel-mitte--brett .sf-tile {
		background: transparent;
		box-shadow: none;
	}

	/* SCHARNIER WIEDER SICHTBAR (Fred 21.09.: „den Querstrich wieder rein,
	   ohne den Kachelhintergrund, aber dass man versteht, dass es ein
	   Flipboard ist"). Die Kacheln bleiben transparent; die Naht ist ein
	   Strich in der KACHELFARBE, der durch die Buchstaben schneidet — wie
	   der Spalt zwischen Ober- und Unterklappe. Weil die Kacheln ohne
	   Abstand stehen, fuegen sich die Naehte zu einer Linie ueber die ganze
	   Zeile. Hoehe an der Kachelbreite bemessen (rund 2 px bei 40 px
	   Kacheln). Gilt auch auf dem Telefon — die Basis blendet das Scharnier
	   dort aus (Befund 20.09., dunkle Wand), hier ist es gewollt. */
	.kachel-mitte--brett .sf-hinge {
		display: block;
		background: var(--kachel);
		/* GANZ DUENN (Fred 21.09., zweite Runde: „wieder raus oder ganz
		   duenn"): 1 px, das duennste, was ueberall sicher gezeichnet wird —
		   auf Retina-Handys sind das 2–3 Geraetepixel, ein Haarstrich.
		   Vorher rund 2 px bei 1280 (5 % der Kachelbreite). */
		height: 1px;
		transform: translateY(-50%);
	}

	.kachel-mitte--brett .sf-static--top,
	.kachel-mitte--brett .sf-static--bottom,
	.kachel-mitte--brett .sf-flap--front,
	.kachel-mitte--brett .sf-flap--back {
		background: transparent;
		box-shadow: none;
	}

	.kachel-mitte--brett .sf-row-line {
		gap: 0;
	}

	.kachel-mitte--brett .sf-grid > * + * {
		margin-top: 0;
	}
</style>

<script>
	// Animationen erst starten, wenn die Reihe im Blick ist — gleiche Regel
	// wie bei der Wand, damit niemand den Anfang verpasst.
	let ab: (() => void) | null = null;

	// Kachel 3 — Rauszoomen in ECHTEN PIXELN.
	// Start: eine Figur füllt die Kachel. Ende: rund tausend Figuren passen
	// hinein. Die Kachel ist 4:5, also ergibt eine Zellkante von
	// breite / 28 etwa 28 × 35 = 980 Figuren.
	// Zielmenge am Ende des Zooms. Eine Kachelung trägt ZWEI Figuren und ist
	// doppelt so breit wie hoch; bei Kachelbreite t passen also
	// (B/t) × (H/(t/2)) × 2 = 4·B·H/t² Figuren in die Fläche.
	const ZIEL_FIGUREN = 1000;
	// Wie weit die zwei Experten am Anfang über die Kachel hinausragen.
	// 1 = sie füllen sie genau, größer = sie werden beschnitten und wirken
	// nah. EIN Regler, hier wird getunt.
	const START_UEBERSTAND = 1.35;
	function zoomAnlegen(el: HTMLElement): Animation[] {
		const r = el.getBoundingClientRect();
		if (!r.width) return [];
		const weiss = el.querySelector<HTMLElement>(".menge-weiss");
		const schwarz = el.querySelector<HTMLElement>(".menge-schwarz");
		if (!weiss || !schwarz) return [];
		const startB = Math.round(r.width * START_UEBERSTAND);
		const startH = Math.round(startB / 2);
		// Die Kachelgröße wird nicht geschätzt, sondern nachgezählt: es
		// sollen wirklich GANZE Figuren in der geforderten Zahl im Bild
		// stehen — angeschnittene am Rand zählen nicht mit, und "mehr als
		// tausend" soll man abzählen können.
		const ganze = (t: number) =>
			Math.floor(r.width / t) * Math.floor(r.height / Math.round(t / 2)) * 2;
		let endeB = Math.max(8, Math.round(Math.sqrt((4 * r.width * r.height) / ZIEL_FIGUREN)));
		while (endeB > 8 && ganze(endeB) < ZIEL_FIGUREN) endeB--;
		const endeH = Math.round(endeB / 2);
		// WEICH IN BEIDE RICHTUNGEN (Fred 20.09. abends: "faengt schoen
		// smooth an, endet aber hart"). Die Ursache war die Stelle, an der
		// die Beschleunigung stand: als Takt-Angabe wirkt sie auf die GANZE
		// Runde, also auch auf die beiden Haltezeiten am Anfang und Ende —
		// die eigentliche Bewegung bekam davon nur ein schiefes Stueck ab
		// und blieb am Schluss mitten im schnellen Teil stehen.
		// Jetzt laeuft die Runde gleichmaessig, und die Weichzeichnung sitzt
		// auf dem BEWEGUNGS-Abschnitt selbst: sanft los, sanft an.
		const WEICH = "cubic-bezier(0.4, 0, 0.2, 1)";
		// MITTE BLEIBT MITTE (Fred 20.09. abends, neue Regel wie in Kachel 2):
		// der Punkt zwischen den beiden Personen sitzt zu jedem Zeitpunkt im
		// Zentrum der Kachel, waagerecht wie senkrecht. Die fruehere
		// Tieferlegung am Anfang (58 statt 50 Prozent) ist damit entfallen —
		// sie stammte aus der Zeit, als die Ueberschrift noch IN der Kachel
		// stand und den beiden zu nahe kam. Die Lage steht jetzt fest im CSS
		// (background-position: center) und wird gar nicht mehr animiert.
		const groesse = [
			{ backgroundSize: startB + "px " + startH + "px", offset: 0, easing: "linear" },
			{ backgroundSize: startB + "px " + startH + "px", offset: 0.12, easing: WEICH },
			{ backgroundSize: endeB + "px " + endeH + "px", offset: 1 },
		];
		// HIN UND ZURUECK (Fred 20.09. abends): kein Sprung zurueck auf den
		// Anfang, sondern derselbe Weg rueckwaerts — die Menge zieht sich
		// wieder auf die zwei Experten zusammen, und die Schrift kommt mit.
		// "alternate" spielt jede zweite Runde rueckwaerts; weil ALLE vier
		// Animationen dieselbe Takt-Angabe teilen, kehren sie gemeinsam um
		// und koennen nicht auseinanderlaufen. Eine volle Runde dauert damit
		// vierzehn Sekunden — im Gleichtakt mit Kachel 2.
		const takt = {
			// 7000 statt 6000 (Fred 20.09. abends): mit "alternate" ergibt
			// das eine Runde von 14 Sekunden mit Wendepunkt bei 50 % —
			// dieselbe Laenge und derselbe Wendepunkt wie Kachel 2. Beide
			// starten beim Einhaengen der Kacheln, laufen also im Gleichtakt.
			duration: 7000,
			iterations: Infinity,
			direction: "alternate",
			easing: "linear",
		} as const;
		return [
			schwarz.animate(groesse, takt),
			// BEIDE LAGEN BEKOMMEN EXAKT DIESELBE GROESSEN-KURVE. Die
			// Einblendung laeuft als EIGENE Animation auf demselben Element
			// (Fred 20.09. abends: "du zoomst die zwei Experten
			// unterschiedlich von den anderen"). Vorher steckte die Opazitaet
			// in denselben Keyframes — und weil ein zusaetzlicher
			// Zwischenschritt fuer die Einblendung noetig war, bekam die
			// weisse Lage dadurch eine andere Groessen-Kurve als die
			// schwarze. Getrennte Animationen koennen nicht auseinanderlaufen.
			weiss.animate(groesse, takt),
			weiss.animate(
				[
					{ opacity: 0, offset: 0, easing: "linear" },
					{ opacity: 0, offset: 0.12, easing: WEICH },
					{ opacity: 1, offset: 0.55, easing: "linear" },
					{ opacity: 1, offset: 1 },
				],
				takt,
			),
		];
	}

	// ── Laufband der Kanal-Zeichen ────────────────────────────────────
	// Die Spur wandert um genau EINEN Satz und beginnt von vorn — bei drei
	// Saetzen im Markup ist der Umlauf dadurch nahtlos. Die Groesse haengt
	// an der Position, nicht an der Zeit: jedes Zeichen bekommt dieselbe
	// Groessen-Kurve (gross in der Mitte, klein aussen), aber mit dem
	// Phasenversatz, der zu seinem Startplatz gehoert. Dadurch genuegt EIN
	// Anwerfen; es laeuft kein Bild-fuer-Bild-Rechner mit.
	// ── Laufband ───────────────────────────────────────────────────────
	// Ein Zeichen pro SCHRITT-Dauer, aber nicht gleichfoermig: die Spur wird
	// langsamer, waehrend ein Zeichen die Mitte durchlaeuft, und wieder
	// schneller dazwischen (Fred 20.09. abends). Kein Halt — nur ein
	// Atmen. Umgesetzt ueber den Weg-Verlauf innerhalb eines Schritts:
	//     f(t) = t − a·sin(2πt)/(2π),  f'(t) = 1 − a·cos(2πt)
	// An den Schrittgrenzen (dort steht ein Zeichen genau mittig) ist die
	// Geschwindigkeit 1−a, in der Mitte dazwischen 1+a. Mit a = 0,7 heisst
	// das: gut ein Drittel Tempo im Scheitel, knapp doppeltes dazwischen.
	// Die Funktion ist an den Grenzen stetig UND gleich steil, deshalb gibt
	// es keinen Ruck beim Uebergang von Schritt zu Schritt.
	const BAND_SCHRITT_MS = 1800;
	// 0 = gleichmaessig durchfahren (Fred 20.09. abends, nach Sichtung:
	// "mach das Stoppen wieder weg"). Die Bremse bleibt als Regler stehen;
	// 0,7 war die Fassung mit dem Atmen im Scheitel.
	const BAND_BREMSE = 0;
	const BAND_GROSS = 1.5;
	const BAND_KLEIN = 0.45;
	function laufbandAnlegen(band: HTMLElement): { anims: Animation[]; stop: () => void } {
		const spur = band.querySelector<HTMLElement>("[data-spur]");
		if (!spur) return { anims: [], stop: () => {} };
		const zeichen = [...spur.children] as HTMLElement[];
		if (!zeichen.length) return { anims: [], stop: () => {} };
		const satz = zeichen.length / 3;
		const luecke = parseFloat(getComputedStyle(spur).columnGap) || 0;
		// LAYOUT-MASSE, KEINE GEZEICHNETEN (Fred 21.09., Handy: „als ob sie
		// nicht in der Mitte groesser werden, sondern am rechten Rand").
		// getBoundingClientRect liefert die Breite MIT Transformation — beim
		// ersten Anlegen steht jedes Zeichen auf Faktor 1, beim NEU-Anlegen
		// nach einem resize aber auf 0,45 bis 1,5. Dann stimmen Schritt,
		// Satzbreite und Versatz nicht mehr, die errechneten Positionen
		// laufen den echten davon, und der Scheitel wandert nach rechts.
		// Auf dem Handy feuert resize bei jedem Ein- und Ausfahren der
		// Adressleiste, also praktisch beim ersten Scrollen. offsetWidth und
		// clientWidth sind Layoutwerte und ignorieren Transformationen.
		// Reproduziert im Browser: Scheitel bei 252 px (Bandmitte 257), nach
		// einem resize-Ereignis bei 308.
		const breite = zeichen[0].offsetWidth;
		const schritt = breite + luecke;
		const satzBreite = schritt * satz;
		const halb = band.clientWidth / 2;
		// Versatz, damit an jeder Schrittgrenze wirklich ein Zeichen mittig
		// steht — sonst faellt die Verlangsamung neben den Scheitel.
		const versatz = ((breite / 2 - halb) % schritt + schritt) % schritt;
		const kurve = (d: number) => (1 + Math.cos(Math.min(1, d) * Math.PI)) / 2;
		let laeuft = true;
		let start = 0;
		const takt = (jetzt: number) => {
			if (!laeuft) return;
			if (!start) start = jetzt;
			const u = (jetzt - start) / BAND_SCHRITT_MS;
			const n = Math.floor(u);
			const t = u - n;
			const f = t - (BAND_BREMSE * Math.sin(2 * Math.PI * t)) / (2 * Math.PI);
			const x = (versatz + schritt * (n + f)) % satzBreite;
			spur.style.transform = "translateX(" + -x.toFixed(2) + "px)";
			for (let i = 0; i < zeichen.length; i++) {
				const mitte = i * schritt + breite / 2 - x;
				const d = Math.abs(mitte - halb) / halb;
				const sk = BAND_KLEIN + (BAND_GROSS - BAND_KLEIN) * kurve(d);
				zeichen[i].style.transform = "scale(" + sk.toFixed(3) + ")";
			}
			requestAnimationFrame(takt);
		};
		requestAnimationFrame(takt);
		return { anims: [], stop: () => { laeuft = false; } };
	}

	// KACHEL 2 — die Stunde und ihre hundert. Legt alle Animationen der
	// Kachel PAUSIERT an und gibt sie zurueck; Start/Stopp uebernimmt der
	// Sichtbarkeits-Beobachter unten (wie bei den frueheren Zoom-Kacheln).
	// Alle Zeiten kommen aus data-plan (ZEIT im Frontmatter).
	// Handy-Tauglichkeit: reine SVG-Vektoren, in jedem Bild in der noetigen
	// Aufloesung gezeichnet — keine gerasterte Ebene, die skaliert wird.
	// Rund 530 einfache Formen je Bild; alle Animationen haengen an EINER
	// Zeitachse (Document Timeline), koennen also nicht auseinanderlaufen,
	// auch nicht nach einem versteckten Tab. Ausserhalb des Bilds werden sie
	// pausiert (Akku), bei Sichtbarkeit von vorn gestartet.
	function bezier(x1: number, y1: number, x2: number, y2: number) {
		const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
		const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
		const X = (t: number) => ((ax * t + bx) * t + cx) * t;
		const Y = (t: number) => ((ay * t + by) * t + cy) * t;
		const dX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
		return (x: number) => {
			let t = x;
			for (let i = 0; i < 8; i++) { const dd = X(t) - x; if (Math.abs(dd) < 1e-6) break; t -= dd / dX(t); }
			return Y(Math.min(1, Math.max(0, t)));
		};
	}
	void bezier; // Loeser bleibt fuer kuenftige Kurven-Umkehrungen im Baukasten

	function stundenAnlegen(buehne: HTMLElement): Animation[] {
		const P = JSON.parse(buehne.dataset.plan!);
		const { ZEIT, KURVE, KURVE_RAUS, KURVE_KRIECH_RAUS, KURVE_KRIECH_REIN, KURVE_REIN, KAMERA, M, standEnde, reinStart, reinEnde, innenEnde, RUNDE, N } = P;
		const bz = (k: number[]) => `cubic-bezier(${k.join(", ")})`;
		const K = bz(KURVE), KR = bz(KURVE_RAUS), KKR = bz(KURVE_KRIECH_RAUS), KKI = bz(KURVE_KRIECH_REIN), KI = bz(KURVE_REIN);
		const S0 = `scale(${KAMERA.start})`, S1 = `scale(${KAMERA.ende})`;
		const SD = `scale(${(KAMERA.ende * (1 - (ZEIT.stand > 0 ? KAMERA.drift : 0))).toFixed(4)})`; // Ende des Kriechens draussen
		const SI = `scale(${(KAMERA.start * (1 + (ZEIT.innenStand > 0 ? KAMERA.drift : 0))).toFixed(4)})`; // Ende des Kriechens innen
		const ms = RUNDE * 1000;
		const o = (s: number) => s / RUNDE;
		const opt = { duration: ms, iterations: Infinity };
		const anims: Animation[] = [];

		// Kamera: raus (KURVE_RAUS), im selben Bild wieder rein (KURVE) —
		// kein Halt an den Wendepunkten (Fred 21.09.).
		const kamera = buehne.querySelector<SVGGElement>(".kamera")!;
		// Draussen kein Stopp, sondern ein Kriechen (KAMERA.drift): von S1 in
		// ZEIT.stand weich weiter nach SD, in ZEIT.kriechenRein genauso weich
		// zurueck nach S1, und erst dann zieht das Reinzoomen nach S0 an.
		anims.push(kamera.animate([
			{ transform: S0, offset: 0 },
			{ transform: S0, offset: o(M.kameraStart), easing: KR },
			{ transform: S1, offset: o(M.kameraEnde), easing: KKR },
			{ transform: SD, offset: o(standEnde), easing: KKI },
			{ transform: S1, offset: o(reinStart), easing: KI },
			// innen dasselbe Muster: mit Resttempo ankommen, naeher kriechen,
			// beschleunigend zurueck — die naechste Runde faehrt direkt weiter
			{ transform: S0, offset: o(reinEnde), easing: KKR },
			{ transform: SI, offset: o(innenEnde), easing: KKI },
			{ transform: S0, offset: 1 },
		], opt));

		// Ausblenden: nur die weissen Uhren (samt dunklen Blaettern) und die
		// Zeichnung der Stunde; Blatt und Startstrich der Stunde bleiben
		// stehen — die naechste Runde zeichnet direkt von dort los.
		// SICHERUNG GEGEN DEN BLITZER AM RUNDENWECHSEL (Fred 21.09., live:
		// „ein kurzer Blitzer, kurz bevor die Animation startet"): Deckkraft
		// laeuft im Browser auf dem Compositor-Thread, stroke-dashoffset auf
		// dem Haupt-Thread. Am Rundenwechsel koennen die beiden ein Bild
		// auseinanderliegen — ein Bild lang volle weisse Scheiben bei Deckkraft
		// 1, in der Nahaufnahme ein weisser Blitz. Deshalb: die Scheiben
		// leeren sich schon SCHUTZ Sekunden vor dem Rundenende (unsichtbar,
		// weil ausgeblendet), und die Deckkraft bleibt die ersten SCHUTZ
		// Sekunden der neuen Runde auf null (da ist ohnehin alles leer).
		const SCHUTZ = 0.06;
		const ausblenden = [
			{ opacity: 0, offset: 0 },
			{ opacity: 0, offset: o(SCHUTZ) },
			{ opacity: 1, offset: o(SCHUTZ * 1.5) },
			{ opacity: 1, offset: o(reinStart), easing: bz(P.KURVE_AUSBLENDEN) },
			{ opacity: 0, offset: o(reinStart + ZEIT.ausblenden) }, // ZEIT.ausblenden ist im Plan bereits aufgeloest
			{ opacity: 0, offset: 1 },
		];
		const leerVorEnde = o(RUNDE - SCHUTZ);
		buehne.querySelectorAll<SVGElement>(".weisse, .stunde-rand, .stunde-fuellung").forEach((el) => anims.push(el.animate(ausblenden, opt)));

		// Die Stunde zeichnet sich, der Zeiger dreht.
		// Zaehler: immer da, kein Ein-/Ausblenden (Fred 21.09.); am Rundenwechsel
		// springt er hart von 60 auf 00, wie eine Stoppuhr beim Nullstellen.
		const zeichnen = [
			{ strokeDashoffset: 1.06, offset: 0 },
			{ strokeDashoffset: 1.06, offset: o(M.halt), easing: K },
			{ strokeDashoffset: 0, offset: o(M.stundeEnde) },
			{ strokeDashoffset: 0, offset: leerVorEnde },
			{ strokeDashoffset: 1.06, offset: Math.min(1, leerVorEnde + 0.0001) },
			{ strokeDashoffset: 1.06, offset: 1 },
		];
		buehne.querySelectorAll<SVGCircleElement>(".stunde-rand, .stunde-fuellung").forEach((el) => anims.push(el.animate(zeichnen, opt)));
		const speiche = buehne.querySelector<SVGLineElement>(".speiche--lauf")!;
		anims.push(speiche.animate([
			{ transform: "rotate(0turn)", offset: 0 },
			{ transform: "rotate(0turn)", offset: o(M.halt), easing: K },
			{ transform: "rotate(1turn)", offset: o(M.stundeEnde) },
			{ transform: "rotate(1turn)", offset: 1 },
		], opt));
		// Zaehler „0 … 60": liest je Bild die Zeit der Speichen-Animation und
		// rechnet den Anteil mit derselben Kurve — exakt synchron zum Zeiger, ohne
		// zweite Zeitquelle. Die Schleife endet von selbst, wenn die Animation
		// abgeraeumt wird (playState idle, z. B. nach resize).
		// Ziffern als Umrisse: je Slot ein <path>, bei Wechsel d und Lage setzen
		// (zwei Ziffern mittig ueber ihre Vorschubbreiten).
		const zaehler = buehne.querySelector<SVGGElement>(".stunde-zaehler")!;
		const GL: Record<string, { d: string; adv: number }> = JSON.parse(zaehler.dataset.glyphen!);
		const slots = Array.from(zaehler.querySelectorAll<SVGPathElement>(".ziffer"));
		const setzeZahl = (s: string) => {
			const w = s.split("").reduce((a, c) => a + GL[c].adv, 0);
			let x = -w / 2;
			s.split("").forEach((c, i) => { slots[i].setAttribute("d", GL[c].d); slots[i].setAttribute("transform", `translate(${x} 0)`); x += GL[c].adv; });
		};
		const laufAnim = anims[anims.length - 1];
		const kurveK = bezier(P.KURVE[0], P.KURVE[1], P.KURVE[2], P.KURVE[3]);
		let zuletzt = -1;
		const zaehle = () => {
			if (laufAnim.playState === "idle") return;
			const t = ((laufAnim.currentTime as number) ?? 0) / 1000 % RUNDE;
			const u = Math.max(0, Math.min(1, (t - M.halt) / (M.stundeEnde - M.halt)));
			const n = t >= RUNDE - SCHUTZ ? 0 : Math.min(P.STUNDE_TEXT.bis, Math.floor(kurveK(u) * P.STUNDE_TEXT.bis + 1e-6));
			if (n !== zuletzt) { zuletzt = n; setzeZahl(String(n).padStart(2, "0")); } // „00" … „60" (Fred 21.09.)
			requestAnimationFrame(zaehle);
		};
		requestAnimationFrame(zaehle);

		// Die Uhren: Rate r(t) = r0 · e^(k·t), r0 = 1 / erster Abstand. Die
		// i-te Uhr startet, wenn die aufsummierte Rate i erreicht:
		// t_i = ln(1 + i·k/r0) / k. k per Bisektion, damit die letzte Uhr
		// genau bei uhrenEnde fertig ist. Dauer je Uhr = Abstand zur
		// naechsten geteilt durch naechsteBei, nach unten gedeckelt.
		const r0 = 1 / (ZEIT.ersteDauer * ZEIT.naechsteBei);
		const startBei = (i: number, k: number) => (k < 1e-9 ? i / r0 : Math.log(1 + (i * k) / r0) / k);
		const dauerVon = (luecke: number) => Math.max(ZEIT.dauerMin, luecke / ZEIT.naechsteBei);
		const gesamt = (k: number) => startBei(N - 1, k) + dauerVon(startBei(N - 1, k) - startBei(N - 2, k));
		let lo = 0, hi = 5;
		for (let s = 0; s < 80; s++) { const mid = (lo + hi) / 2; if (gesamt(mid) > ZEIT.uhrenDauer) lo = mid; else hi = mid; }
		const k = (lo + hi) / 2;
		const starts = Array.from({ length: N }, (_, i) => startBei(i, k));
		const dauern = starts.map((t, i) => dauerVon(i < N - 1 ? starts[i + 1] - t : t - starts[i - 1]));
		dauern[0] = ZEIT.ersteDauer; // die erste exakt so lang wie die Stunde

		const beschlaege = Array.from(buehne.querySelectorAll<SVGGElement>(".beschlag--klein[data-i]"));
		buehne.querySelectorAll<SVGCircleElement>(".scheibe[data-i]").forEach((el) => {
			const i = Number(el.dataset.i);
			const s = M.uhrenStart + starts[i];
			// Deckel auf den Rundenanteil, nicht auf die Sekunde — sonst laegen
			// spaete Marken vor ihrem Start und animate() wirft (Fehler 21.09.).
			const voll = Math.min(leerVorEnde, o(s + dauern[i]));
			const ab = Math.min(voll, o(s));
			anims.push(el.animate([
				{ strokeDashoffset: 1.06, offset: 0 },
				{ strokeDashoffset: 1.06, offset: ab, easing: K },
				{ strokeDashoffset: 0, offset: voll },
				{ strokeDashoffset: 0, offset: leerVorEnde },
				{ strokeDashoffset: 1.06, offset: Math.min(1, leerVorEnde + 0.0001) },
				{ strokeDashoffset: 1.06, offset: 1 },
			], opt));

				// Stoppuhr-Probe: der Beschlag schaltet sich mit dem Start der Fuellung
				// ein (Versatz 1 → 0, wie die Scheibe 1,06 → 0) und mit leerVorEnde aus.
				if (beschlaege[i]) anims.push(beschlaege[i].animate([
					{ strokeDashoffset: 1, offset: 0 },
					{ strokeDashoffset: 1, offset: ab },
					{ strokeDashoffset: 0, offset: Math.min(leerVorEnde, ab + 0.0001) },
					{ strokeDashoffset: 0, offset: leerVorEnde },
					{ strokeDashoffset: 1, offset: Math.min(1, leerVorEnde + 0.0001) },
					{ strokeDashoffset: 1, offset: 1 },
				], opt));
		});
		return anims;
	}

	function mount() {
		ab?.();
		const ziele = [
			...document.querySelectorAll<HTMLElement>("[data-kreis], [data-menge]"),
		];
		if (!ziele.length) return;

		// Zoom-Animationen je Mengen-Kachel, pausiert bis zur Sichtbarkeit;
		// bei Fensteränderung mit neuen Pixelwerten neu aufgesetzt.
		const mengen = ziele.filter((z) => z.hasAttribute("data-menge"));
		const stunden = ziele.filter((z) => z.hasAttribute("data-plan"));
		let zooms = new Map<HTMLElement, Animation[]>();
		const zoomsAnlegen = () => {
			zooms.forEach((as) => as.forEach((a) => a.cancel()));
			zooms = new Map();
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			mengen.forEach((el) => {
				const as = zoomAnlegen(el);
				if (as.length) {
					as.forEach((a) => a.pause());
					zooms.set(el, as);
				}
			});
			// Kachel 2 haengt am selben Mechanismus: pausiert anlegen, der
			// Beobachter startet und stoppt, ein resize legt neu an.
			stunden.forEach((el) => {
				const as = stundenAnlegen(el);
				as.forEach((a) => a.pause());
				zooms.set(el, as);
			});
		};
		zoomsAnlegen();
		let neuTimer = 0;
		const beiResize = () => {
			window.clearTimeout(neuTimer);
			neuTimer = window.setTimeout(() => {
				const liefen = new Set(
					[...zooms.entries()]
						.filter(([el, as]) => as[0].playState === "running" || el.classList.contains("laeuft"))
						.map(([el]) => el),
				);
				zoomsAnlegen();
				baenderAnlegen();
				liefen.forEach((el) => anschalten(el));
			}, 200);
		};
		window.addEventListener("resize", beiResize);
		// STARTEN, NICHT WARTEN (Korrektur 20.09. abends, Fred: "die
		// Animation funktioniert immer noch nicht"): erst lief der Start
		// über eine Sichtbarkeits-SCHWELLE, und genau daran ist Kachel 3
		// hängengeblieben — eine Kachel, die höher ist als der Bildschirm,
		// überschreitet die Schwelle nie, der Beobachter meldet sich nicht,
		// die Animation bleibt für immer pausiert. Eine Schwelle, die nur
		// manchmal greift, ist als Startbedingung untauglich.
		// Jetzt laufen die Kacheln von Anfang an; der Beobachter PAUSIERT
		// sie nur, wenn sie GANZ aus dem Bild sind. Das kann nicht fehlen:
		// isIntersecting ist eindeutig, es braucht kein Verhältnis.
		// VON VORN, NICHT WEITER (Fehler 20.09. abends, Fred: "das sieht
		// nicht so aus, als ob die beiden Schriften synchron ein- und
		// ausblenden"). Die beiden Kacheln werden verschieden angetrieben:
		// Kachel 2 ueber CSS-Animationen an der Klasse .laeuft, Kachel 3
		// ueber die Web-Animations-API. Verschwindet die Reihe kurz aus dem
		// Bild und kommt zurueck, STARTET die CSS-Animation von vorn,
		// waehrend die andere dort weiterlaeuft, wo sie stehengeblieben ist
		// — ab da laufen sie gegeneinander, egal wie genau die Marken
		// stimmen. Deshalb wird beim Einschalten IMMER auf null gesetzt:
		// beide fangen dann zusammen an.
		const anschalten = (el: HTMLElement) => {
			el.classList.remove("laeuft");
			void el.offsetWidth; // Neustart der CSS-Animation erzwingen
			el.classList.add("laeuft");
			zooms.get(el)?.forEach((a) => {
				a.currentTime = 0;
				a.play();
			});
		};
		ziele.forEach(anschalten);

		// Laufbaender: laufen unabhaengig von den Kachel-Animationen.
		let baender: Animation[] = [];
		let baenderStop: Array<() => void> = [];
		const baenderAnlegen = () => {
			baender.forEach((a) => a.cancel());
			baenderStop.forEach((f) => f());
			baender = [];
			baenderStop = [];
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			document.querySelectorAll<HTMLElement>("[data-laufband]").forEach((b) => {
				const { anims, stop } = laufbandAnlegen(b);
				baender.push(...anims);
				baenderStop.push(stop);
			});
		};
		baenderAnlegen();
		const io = new IntersectionObserver(
			(eintraege) => {
				eintraege.forEach((e) => {
					const el = e.target as HTMLElement;
					if (e.isIntersecting) {
						if (!el.classList.contains("laeuft")) anschalten(el);
					} else {
						el.classList.remove("laeuft");
						zooms.get(el)?.forEach((a) => a.pause());
					}
				});
			},
			{ threshold: 0 },
		);
		ziele.forEach((z) => io.observe(z));
		ab = () => {
			io.disconnect();
			window.removeEventListener("resize", beiResize);
			window.clearTimeout(neuTimer);
			zooms.forEach((a) => a.cancel());
		};
	}

	document.addEventListener("astro:page-load", mount);
	// Fallnetz: laedt das Modul erst NACH astro:page-load (z. B. spaet aus
	// dem Cache), wuerde mount nie laufen — dann sofort anlegen.
	if (document.readyState === "complete") mount();
</script>
