---
// MULTI-OUTPUT als ZWEI KACHELN (Fred 21.09.: „jetzt ist es an der Zeit, dass
// wir diese beiden Kacheln mit den Ueberschriften auf unsere Webseite nehmen
// und das Flipperboard dort rausschmeissen").
//
// Loest MultiOutputTafel.astro auf der Startseite ab. Die WAND bleibt als
// Datei im Repo (archiviert, nirgends mehr eingebunden) — sie hat Monate
// Feinarbeit in sich und laesst sich so zurueckholen, ohne sie aus der
// Historie zu graben.
//
// Was bleibt: der Sektionskopf. Ueberschrift und Zahlen-Staccato sind
// gelockter Wortlaut (Fred 14.09.: „Beide Zeilen NICHT ohne Fred anfassen")
// und passen unveraendert — sie kuendigen den Multi-Output an, nicht die
// Bauform, in der er gezeigt wird.
//
// Was neu ist: statt der 21-zeiligen Wand zwei Kacheln nebeneinander im
// 50/50-Raster (BBH-Muster), jede mit eigener Ueberschrift und Bezugssatz.
// Links das Fallblatt mit den Deliveries, rechts die Uhr mit der
// Zuschauerzeit. Die dritte Kachel („1000 Zuschauer") ist am 20.09. bewusst
// entfallen — plattformuebergreifend laesst sich nicht entdoppeln.
//
// FASSUNG: „brett" (Default) zeigt in Kachel 1 das durchrattende Fallblatt,
// „liste" die statische Aufzaehlung. Beide tragen denselben Datensatz
// (brettZeilen / varianten) und duerfen nie auseinanderlaufen.
// PROBE /kacheln — die Alternative zur Fallblatt-Wand (Fred-Diktat 20.09.
// abends). Drei Kacheln NEBENEINANDER statt drei Akte NACHEINANDER: die Wand
// zeigt die Verhältnisse in der Zeit, diese Reihe zeigt sie im Raum, der
// Leser vergleicht selbst statt zu warten. Kachelform übernommen von der
// Bausteine-Reihe der Startseite (4:5, container-type: inline-size).
//
// NICHT eingebunden — eigene Seite, damit die Startseite unberührt bleibt.
// Konzept steht im Website-Dokument über dem Wand-Kapitel.
import SplitFlap from "../components/SplitFlap.astro";
import { LOGOS } from "../lib/fallblatt";

// Die zehn Varianten als schlichte Liste (Fred 20.09. abends: "schreibt
// ihr einfach mal normal, untereinander"). Das Fallblatt-Board davor trug
// den Inhalt nicht — zehn Zeilen in Kachelschrift wurden in der kleinen
// Kachel unleserlich, und das Klappern lenkte von der Aufzählung ab.
//
// Woher die Zehn kommt: es sind die neun Zeilen, die schon auf der Wand
// stehen, plus die WEBSITE, die in Freds eigener Aufzählung vorkam und in
// der Wand fehlt. Namen sind auf die Plattform verkürzt (LINKEDIN statt
// LINKEDIN-BEITRÄGE), damit das Board in die Kachelbreite passt: längster
// Eintrag ist AUDIO-PODCAST mit 13 Zeichen.
// OFFEN: TRANSKRIPT und KI-ZITATE hat Fred als "keine Ausspielungen in dem
// Sinn" bezeichnet — sie stehen hier drin, weil die Zehn sonst nicht
// aufgeht. Sein Entscheid steht aus.
// Logo-Reihenfolge je Zeile wie in der Wand: die HÄUFIGSTE Plattform sitzt
// außen an der gemeinsamen rechten Kante (dort teilen sich alle Zeilen die
// Spalte), seltenere wandern nach innen.
// Kanal-Band unten in der Kachel (Fred 20.09. abends): die Piktogramme
// stehen nicht mehr neben ihrer Zeile, sondern als Reihe am unteren Rand.
// Reihenfolge nach Haeufigkeit in der Liste, wie in der Wand — was oft
// vorkommt, steht vorn.
const kanalBand = [
	"youtube",
	"linkedin",
	"web",
	"instagram",
	"tiktok",
	"spotify",
	"apple",
	"mail",
	"chatgpt",
	"claude",
	"gemini",
];

// FALLBLATT-FASSUNG (Fred 20.09. abends + 21.09.): dreizeiliges Brett, das
// die Auslieferungen durchrattert.
//     Zeile 1  die Zahl
//     Zeile 2  die FORM, im Wort der Plattform
//     Zeile 3  das ZIEL, also die Plattform selbst
//
// ACHSE (Fred 21.09., entscheidend): jede Zeile ist ein Paar aus FORM und
// ZIEL, und jedes Ziel kommt genau EINMAL vor. Die Form darf sich dabei
// wiederholen — ein LinkedIn-Beitrag ist auch ein Short, ein Reel ist auch
// einer. Genau deshalb steht hier nicht „Shortform": das waere ein
// Sammelwort, das die vier Orte unter einer Zahl versteckt. Vier Zeilen mit
// vier Zielen sind ehrlicher als eine Zeile mit „36 Clips".
//
// PLATTFORM-WORTE (Fred 21.09.): die Form heisst so, wie die Plattform sie
// nennt — SHORTS bei YouTube, REELS bei Instagram, BEITRAEGE bei LinkedIn,
// VIDEOS bei TikTok, FOLGE bei Spotify. Kein Agentur-Vokabular.
//
// DIE DREI JAS (Fred 21.09., „Ich sage dreimal ja"): Q&A ist jetzt ein
// fester Regie-Block in der Aufnahme, SHOWNOTES sind ein benannter Posten,
// und die Aufzeichnung fuer die Website ist ein EIGENER Schnitt. Damit sind
// es zehn Formate, nicht sieben.
//
// WEBSITE-ZEILE (Fred 21.09., „Video-Podcast-Aufzeichnungen Webseite"): die
// Website-Zeile heisst VIDEOPODCAST, nicht LANGFASSUNG — dasselbe Formwort
// wie die YouTube-Zeile, nur ein anderes Ziel. Das ist kein Versehen,
// sondern die Regel: die Form darf sich wiederholen, das Ziel nicht.
// „LANGFASSUNG" war ein Agenturwort und beschrieb ausserdem nur die Laenge.
// „VIDEOPODCAST-AUFZEICHNUNG" waere das vollstaendige Wort, passt mit 25
// Zeichen aber nicht in die dreizehn Spalten; die Listen-Fassung schreibt
// es aus.
//
// Die frueheren Zeilen „LANDINGPAGE" und
// „AUDIO-PODCAST" sind ersetzt: geliefert wird das Video fuer die
// Landingpage, nicht die Seite, und der Podcast heisst bei Spotify FOLGE.
//
// NEWSLETTER (Fred 21.09.): steht bewusst NICHT in der Textspalte — er
// traegt das Video mit, ist also eine Ausspielung und keine Zusammenfassung.
//
// Stueckzahlen: alles, was Clip ist, steht auf NEUN (Fred 20.09. abends).
// Eine Zahl fuer alle vier macht sichtbar, dass es dieselbe Arbeit an vier
// Orten ist. Die uebrigen Zahlen sind fortgeschrieben.
// DREIZEHN Spalten: PODCAST-FOLGE hat dreizehn Zeichen und ist der
// breiteste Eintrag.
// Aufrufbar unter /kacheln?board; beide Fassungen liegen im Dokument.
// SORTIER-REGEL (Fred 21.09.): in keiner Spalte duerfen zwei gleiche Werte
// direkt untereinander stehen — kein „LIVESTREAM YOUTUBE" gefolgt von
// „LIVESTREAM LINKEDIN". Der Grund ist mechanisch: eine Spalte, deren Wert
// sich nicht aendert, KLAPPT NICHT. Steht zweimal dasselbe Wort hinterein-
// ander, steht die mittlere Zeile still, waehrend links und rechts fallen —
// das sieht nach Fehler aus, nicht nach Rhythmus.
// Geprueft ueber den Rand hinweg: die letzte Zeile geht wieder in die erste
// ueber, also zaehlt auch dieses Paar.
// Formen und Ziele sind vollstaendig entzerrt, auch ueber den Rand. Die
// ZAHLEN nicht ganz: acht der vierzehn Zeilen tragen die 1, dem stehen
// sechs Trenner gegenueber — zwei Beruehrungen sind damit das rechnerische
// Minimum (8 minus 6), und genau zwei sind es.
// Die Reihenfolge ist nicht von Hand gelegt, sondern gesucht: der
// Loesungsraum ist zu gross, um ihn im Kopf zu pruefen, sobald drei
// Spalten gleichzeitig kollisionsfrei sein sollen. Wer Zeilen aendert,
// muss die Pruefung wiederholen (drei Spalten, zyklisch, letzte gegen
// erste) und nicht nur die geaenderte Zeile ansehen.
// VIERTE BEDINGUNG: die zwei Zahl-Beruehrungen duerfen sich nicht
// beruehren. Drei gleiche Zahlen hintereinander waeren schlimmer als
// zwei getrennte Paare — die Zahlenspalte stuende dann zwei Takte still
// statt einen. Die erste gefundene Loesung hatte genau diesen Dreierblock
// (Zeilen 6-7-8) und wurde deshalb verworfen.
// KI IST KEIN ZIEL MEHR (Fred 21.09.): die frueheren Zeilen „ZITATE / KI"
// und „TRANSKRIPT / KI" behaupteten die KI als Kanal. Jetzt heisst die
// Zeile „ZITATE FÜR KI / WEBSITE" — Kanal ist die Website, die KI ist das
// Publikum. Damit sinkt die Zahl der Ziele von acht auf sieben, und
// WEBSITE kommt dreimal vor.
// PREIS DIESER SORTIERUNG: die Reihe ist damit nicht mehr nach Laenge
// geordnet (lang → kurz). Das war vorher ein System, jetzt ist es eine
// Mischung. Fuer ein durchlaufendes Brett ist das eher ein Gewinn — es
// verhindert, dass jemand Bloecke als „Kategorien" liest und nachzaehlt.
const brettZeilen = [
	["12", "Q&A", "YOUTUBE"],
	["1", "TRANSKRIPT", "WEBSITE"],
	["9", "REELS", "INSTAGRAM"],
	["1", "SHOWNOTES", "SPOTIFY"],
	["1", "LIVESTREAM", "YOUTUBE"],
	["9", "BEITRÄGE", "LINKEDIN"],
	["1", "PODCAST-FOLGE", "SPOTIFY"],
	["9", "VIDEOS", "TIKTOK"],
	["1", "LIVESTREAM", "LINKEDIN"],
	["1", "VIDEOPODCAST", "YOUTUBE"],
	["12", "ZITATE FÜR KI", "WEBSITE"],
	["1", "NEWSLETTER", "E-MAIL"],
	["9", "SHORTS", "YOUTUBE"],
	["1", "VIDEOPODCAST", "WEBSITE"],
];

// Die Listen-Fassung von Kachel 1 (ohne Brett) traegt dieselben Paare —
// beide Fassungen duerfen nie auseinanderlaufen.
const varianten: Array<[string, string, string[]]> = [
	["12", "Q&A für YouTube", ["youtube"]],
	["1", "Transkript für die Website", ["web"]],
	["9", "Reels für Instagram", ["instagram"]],
	["1", "Shownotes für Spotify", ["spotify"]],
	["1", "Livestream für YouTube", ["youtube"]],
	["9", "Beiträge für LinkedIn", ["linkedin"]],
	["1", "Podcast-Folge für Spotify", ["spotify"]],
	["9", "Videos für TikTok", ["tiktok"]],
	["1", "Livestream für LinkedIn", ["linkedin"]],
	["1", "Videopodcast für YouTube", ["youtube"]],
	// ZITATE FÜR KI statt „KI-lesbares Transkript" (Fred 21.09.), und das
	// Ziel ist jetzt die WEBSITE statt „KI". Das loest den Einwand, dass
	// die KI kein Kanal ist: der Kanal ist die Website, die KI das
	// Publikum. Die Form traegt ihr „für KI" selbst — die einzige Zeile
	// mit einer Praeposition im Formwort, und genau deshalb verstaendlich.
	["12", "Zitate für KI auf der Website", ["chatgpt", "claude", "gemini"]],
	["1", "Newsletter per Mail", ["mail"]],
	["9", "Shorts für YouTube", ["youtube"]],
	["1", "Videopodcast-Aufzeichnung für die Website", ["web"]],
