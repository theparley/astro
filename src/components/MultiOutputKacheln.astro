// Männchen als Hintergrund-Kachelung (Kachel 3). Ein einziges DIV statt
// tausend Knoten: background-repeat macht aus EINER Figur beliebig viele,
// background-size ist der Zoom. Die Figur kommt aus dem gemeinsamen Modul,
// damit Wand und Kachelreihe dieselbe zeigen.
// ACHTUNG XML-NAMENSRAUM (Fehler gefunden 20.09. abends): im HTML ergänzt
// der Browser das xmlns von selbst, eine SVG-Datei als BILD braucht es aber
// zwingend. Ohne xmlns lädt die data-URI gar nicht — die Kachel blieb
// schwarz, während die Animation im Hintergrund brav lief und eine
// unsichtbare Größe verstellte. Genau Freds "funktioniert immer noch nicht".
// LUFT UM DIE FIGUR (Fred 20.09. abends: "die kleben alle aneinander"): die
// Material-Figur füllt ihre viewBox randlos aus, gekachelt stoßen die
// Männchen deshalb Schulter an Schulter und Kopf an Fuß. Hier bekommt sie
// eine eigene, größere Leinwand: 100 × 100 Einheiten, die Figur 72 davon,
// mittig — also 14 Einheiten Rand ringsum und rund 28 Prozent Abstand
// zwischen zwei Nachbarn. Die Zellenzahl ändert sich dadurch nicht, nur die
// Figur darin wird kleiner.
const personPfad = (LOGOS.person.match(/<path d="([^"]+)"/) || [])[1] ?? "";
// ZWEI FIGUREN IN EINER KACHELUNG (Fred 20.09. abends, dritter Anlauf:
// "du zoomst immer noch von der Seite"). Der Grund lag nicht am Versatz,
// sondern an der Bauform: eine Kachelung mit EINER Figur hat in ihrer Mitte
// entweder eine Figur (dann sieht man am Start drei) oder eine Fuge (dann
// muss der Versatz für jede Zellgröße neu gerechnet werden — und zwischen
// zwei Rechenpunkten wandert das Raster seitlich weg, genau der Eindruck).
// Eine Kachelung mit ZWEI Figuren nebeneinander löst beides: ihre Mitte
// liegt zwischen den beiden, und "background-position: center" hält diese
// Mitte bei JEDER Größe fest. Kein Versatz, kein Wandern, symmetrisch.
//
// Figuren schwarz mit weißem Saum wie der Punkt in Kachel 2.
// paint-order='stroke' legt den Strich unter die Füllung, sonst frisst er
// die Figur von innen auf.
const figur = (x: number, stil: string) =>
	"<g transform='translate(" + x + " 104) scale(0.1125)' " + stil + ">" +
	"<path d='" + personPfad + "'/></g>";
const doppel = (stil: string) =>
	"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100'>" +
	figur(-4, stil) +
	figur(96, stil) +
	"</svg>";
// ZWEI EBENEN (Fred 20.09. abends): die beiden, mit denen wir starten,
// bleiben SCHWARZ mit weißem Saum — alle anderen sind weiß. Oben liegt
// deshalb eine einzelne, nicht wiederholte Doppelfigur in Schwarz, darunter
// die weiße Menge als Kachelung. Beide sind mittig und werden gleich
// skaliert, die schwarze deckt also immer genau die zwei mittleren der
// Menge ab und zoomt mit ihnen mit.
const personSvgSchwarz = doppel(
	"fill='#0d0d0d' stroke='#ffffff' stroke-width='34' paint-order='stroke' " +
	"stroke-linejoin='round'",
).replace(/"/g, "'");
// AUGEN WIEDER RAUS (Fred 20.09. abends: "das wird ja bedrohlich"). Ein
// Feld aus tausend Augen liest sich als Ueberwachung, nicht als Publikum —
// die Bedeutung stimmte, die Wirkung nicht. Die Menge sind wieder Figuren.
// Damit steht allerdings die Frage wieder offen, die zum Auge gefuehrt
// hatte: tausend Figuren behaupten tausend verschiedene Menschen, gemessen
// sind aber Blicke. Freds Zahlen (160 je Beitrag gemessen, 400 bis 500
// rekonstruiert) tragen die Tausend als PERSONEN nicht ohne Addition, und
// beim Addieren kommt die Doppelzaehlung zurueck.
const personSvgWeiss = doppel("fill='#ffffff'").replace(/"/g, "'");
const uri = (svg: string) => `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;


// ── KACHEL 2: DIE STUNDE UND IHRE HUNDERT ──────────────────────────────
// Zeiten, Kurven, Kamera und Geometrie kommen aus src/lib/stunde.ts — EINE
// BASIS fuer Website und GIF-Werkstatt (/stunden-werkstatt), wie bei den
// Fallblatt-Tafeln. Wer eine Zahl aendern will, aendert sie dort.
import { GLYPHEN } from "../lib/stunde-glyphen";
import { ZEIT, KURVE, KURVE_RAUS, KURVE_KRIECH_RAUS, KURVE_KRIECH_REIN, KURVE_REIN, KURVE_AUSBLENDEN, KAMERA, UHR, BLATT, STOPPUHR, STUNDE_TEXT, knopfWinkel, marken, uhren as uhrenGeometrie } from "../lib/stunde";
const uhren = uhrenGeometrie();
// Zeiger-Sektor: Versatz der Scheibe o laeuft 1,06 → 0, Vorderkante bei
// L = 1,04 − o. Der Sektor [L − w, L] braucht Versatz o + w − 1,04, um eine
// Periode (2) verschoben, damit er positiv bleibt: 2,02 + w → 0,96 + w.
// Kein Zeiger auf den kleinen Uhren (Fred 21.09., s. lib): die wachsende
// weisse Flaeche ist die Information.
// Zaehler „00 … 60 Min." als Umrisse (stunde-glyphen.ts): Server-Stand = „60".
const ST = STUNDE_TEXT;
const zahlS = (UHR.r * ST.zahlGroesse) / GLYPHEN.upm;      // Schrift-Einheit → viewBox
const einheitS = (UHR.r * ST.einheitGroesse) / GLYPHEN.upm;
const zifferLage = (s: string) => { const b = s.split("").map((c) => GLYPHEN.zahl[c as keyof typeof GLYPHEN.zahl].adv); const w = b.reduce((a, c) => a + c, 0); let x = -w / 2; return b.map((adv) => { const hier = x; x += adv; return hier; }); };
const startZiffern = String(ST.bis).padStart(2, "0");
const startLage = zifferLage(startZiffern);
const einheitBreite = ST.einheit.split("").reduce((a, c) => a + GLYPHEN.einheit[c as keyof typeof GLYPHEN.einheit].adv, 0);
let einheitX = -einheitBreite / 2;
const einheitPfade = ST.einheit.split("").map((c) => { const g = GLYPHEN.einheit[c as keyof typeof GLYPHEN.einheit]; const x = einheitX; einheitX += g.adv; return { d: g.d, x }; });
const glyphenJson = JSON.stringify(GLYPHEN.zahl);
const M = marken();
const striche = 60 / BLATT.minute.schritt; // Minutenstriche je Umlauf (60 oder 12)
const dm = +((BLATT.minute.breite / (2 * Math.PI * BLATT.minute.r)) * striche).toFixed(4);
const df = +((BLATT.fuenf.breite / (2 * Math.PI * BLATT.fuenf.r)) * 12).toFixed(4);
const dq = +((BLATT.viertel.breite / (2 * Math.PI * BLATT.viertel.r)) * 4).toFixed(4);
const plan = JSON.stringify({ ZEIT: { ...ZEIT, uhrenDauer: M.uhrenDauer, kameraRein: M.kameraRein, ausblenden: M.ausblenden }, KURVE, KURVE_RAUS, KURVE_KRIECH_RAUS, KURVE_KRIECH_REIN, KURVE_REIN, KURVE_AUSBLENDEN, KAMERA, M, standEnde: M.standEnde, reinStart: M.reinStart, reinEnde: M.reinEnde, innenEnde: M.innenEnde, RUNDE: M.RUNDE, N: uhren.length, STUNDE_TEXT });

interface Props {
	fassung?: "brett" | "liste";
	// Stoppuhr (Fred 21.09., seit abends Standard): Krone + Druecker rechts
	// an Stunde und allen kleinen Uhren (lib STOPPUHR); false = schlichte
	// Uhr. bezug2 ersetzt die Bezugszeile von Kachel 2.
	stoppuhr?: boolean;
	bezug2?: string;
}
const { fassung = "brett", stoppuhr = true, bezug2 } = Astro.props;
// Beschlag als drei T-Pfade (Krone, Druecker links, Druecker rechts),
// relativ zur Uhrmitte, je mit Drehung. EIN Pfad je T, nicht zwei
// Rechtecke: an der gemeinsamen Kante zweier Rechtecke bleibt sonst eine
// sichtbare Naht aus der Kantenglaettung (Fred 21.09.: „ich sehe die
// Linie dazwischen"). Der Hals reicht 1 Einheit in den Kreis hinein.
const SP = STOPPUHR;
const rr = UHR.r;
const tPfad = (halsB: number, halsH: number, kappeB: number, kappeH: number) => {
	const kb = kappeB * rr / 2, hb = halsB * rr / 2, yK = -rr - halsH * rr - kappeH * rr, yH = -rr - halsH * rr, yU = -rr + 1;
	return `M${-kb},${yK}H${kb}V${yH}H${hb}V${yU}H${-hb}V${yH}H${-kb}Z`;
};
const beschlag = [
	{ d: tPfad(SP.hals.breite, SP.hals.hoehe, SP.kappe.breite, SP.kappe.hoehe), rot: 0 },
	...knopfWinkel().map((w) => ({ d: tPfad(SP.knopf.halsBreite, SP.knopf.hals, SP.knopf.breite, SP.knopf.hoehe), rot: w })),
];
// Die kleinen Uhren bekommen den Beschlag als STRICHE (zwei Linien je T:
// Hals und Kappe, Breite = Strichbreite), nicht als Flaeche. Grund: so
// laesst er sich mit derselben Mechanik wie die Scheiben ein- und
// ausschalten — stroke-dashoffset auf der Gruppe, pathLength 1, Versatz
// 1 → 0 — auf dem Haupt-Thread, ohne Compositor-Ebene und ohne Deckkraft
// oder Visibility (beides flackerte am Rundenwechsel, Fred 21.09.). Der
// Hals reicht bis in die Kappenmitte, damit keine Naht entsteht.
const tStriche = (halsB: number, halsH: number, kappeB: number, kappeH: number) => {
	const yKm = -rr - halsH * rr - kappeH * rr / 2;
	return [
		{ x1: 0, y1: -rr + 1, x2: 0, y2: yKm, w: halsB * rr },
		{ x1: -kappeB * rr / 2, y1: yKm, x2: kappeB * rr / 2, y2: yKm, w: kappeH * rr },
	];
};
const beschlagStriche = [
	{ l: tStriche(SP.hals.breite, SP.hals.hoehe, SP.kappe.breite, SP.kappe.hoehe), rot: 0 },
	...knopfWinkel().map((w) => ({ l: tStriche(SP.knopf.halsBreite, SP.knopf.hals, SP.knopf.breite, SP.knopf.hoehe), rot: w })),
];
