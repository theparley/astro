---
/* Video-Kacheln nach BBH B7W (Projektraster der Startseite; Nachschlagewerk Kapitel 2, Analyse B 3 B7).
   Rasul 13.11.2026: „lass uns erstmal die Kacheln von BBH übernehmen, die großen. Das probieren wir mal. Und die
   schreiben ja groß drüber Work. Und da könnten wir doch Beweisaufnahme drüberschreiben. Und dann gibt es Kacheln,
   die sich thematisch mit dem Thema Beweisaufnahmen beschäftigen.“
   Wie BBH:
   - Kopf: Titel Bartle huge links, Knopf-Link rechts auf der Grundlinie (am Handy darunter, wenn kein Platz).
   - Raster zwei Spalten, 16 px Fuge, am Handy eine Spalte. Kachel 4:3, leicht abgerundet.
   - BBH: in jeder Kachel läuft der Film stumm in Schleife. Bei uns NICHT (Rasul 13.11.2026: „In den Kacheln dürfen
     die Videos noch nicht laufen. Das erschlägt einem, das ist zu hektisch.“): Standbild mit Blase, Film erst per Klick.
   - Darunter zwei kurze Zeilen: Titel, grau eine zweite Zeile (bei BBH der Kunde).
   - Darüberfahren: Bild 3 % größer und −0,25° gedreht, Kachel etwas blasser (BBH, 400 ms).
   Abweichung: Klick öffnet den Film groß auf derselben Seite (BBHs Player vom Statement), nicht eine eigene Seite;
   startet stumm wie bei BBH, Ton über die Steuerleiste. Die Blase sitzt innen in der Kachel (blasenlage innen).
   Titel darf ein &shy; enthalten (BEWEIS-/AUFNAHME passt in Bartle huge nur getrennt, gemessen 13.11.2026). */
import BlasenVideo from "./BlasenVideo.astro";
import Knopf from "./Knopf.astro";
import LogoBiss from "../LogoBiss.astro";
interface Blase { an: number; aus: number; stelle: "OL" | "OR"; text: string }
/* plakat (13.11.2026, Rasul: „ob wir nicht … unsere Blasenidee nehmen … jede Kachel designen wie ein Plakat von
   Graphéine“ und „Ja, du sollst.“): Kachel als Plakat nach Graphéines Sup-de-Com-Plakaten (Moodboard
   branding/aktiv/Parley_Moodboard_Grapheine_Anzeigen_Referenz_2026-10.html, Bilder 17 bis 19): weißer Grund,
   großer blauer Ball läuft oben links aus dem Format, darin der Satz weiß und fett, ein Wort in [eckigen
   Klammern] hellblau; das Standbild als Band; weiße Blase greift über den oberen Fotorand (dort #RévèleToi,
   bei uns marke); unten rechts das Logo klein. */
interface Plakat { satz: string; marke: string; bild: number }
/* href (13.11.2026, Kachel-Startseite): Kachel ist ein Link zu einer Unterseite wie bei BBH, kein Player. */
/* schritt und spalten (Rasul 14.11.2026, Segment „Beweis“: „Und es wäre jetzt unser Fangen veredeln verteilen … Mach mir
   dafür mal einen Vorschlag und orientiere dich an BBH-Design.“): drei gleichrangige Schritte nebeneinander wie BBHs
   Karten mit drei Spalten (Analyse B, R13 und R14); in der ersten Zeile Nummer und Verb (Schritt), grau darunter der Name
   aus der Beweis-Bildwelt und die Zeile. */
interface Kachel { nr: string; titel: string; zeile: string; src: string; von?: number; bis?: number; blasen?: Blase[]; plakat?: Plakat; href?: string; schritt?: string }
interface Props { titel?: string; titelStufe?: "2xl"; id?: string; link?: { href: string; text: string }; einleitung?: string; kacheln: Kachel[]; spalten?: 2 | 3 }
const { titel, titelStufe, id, link, einleitung, kacheln, spalten = 2 } = Astro.props;
---
<div class:list={["videokacheln rahmen", spalten === 3 && "videokacheln--drei"]}>
	{(titel || link) && (
		<div class="videokacheln__kopf">
			{titel && <h2 class:list={["t-abschnitt videokacheln__titel", titelStufe && `videokacheln__titel--${titelStufe}`]} id={id} set:html={titel} />}
			{link && <div class="videokacheln__link"><Knopf href={link.href} text={link.text} /></div>}
		</div>
	)}
	{einleitung && <p class="t-lesen videokacheln__einleitung" set:html={einleitung} />}
	<div class="videokacheln__raster">
		{kacheln.map((k) => { const Tag = k.href ? "a" : "button"; return (
			<Tag href={k.href} type={k.href ? undefined : "button"} class="videokachel" data-src={k.href ? undefined : k.src} data-von={k.von} data-bis={k.bis} aria-label={k.href ? `${k.nr} ${k.titel}` : `${k.nr} ${k.titel}: Film groß ansehen`}>
				{k.plakat ? (
					<span class="videokachel__bild plakat">
						<span class="plakat__foto"><video src={k.src} muted playsinline preload="metadata" data-standbild={k.plakat.bild}></video></span>
						<span class="plakat__ball" aria-hidden="true"></span>
						<span class="plakat__satz" set:html={k.plakat.satz.replace(/\[(.+?)\]/g, '<em>$1</em>')} />
						<span class="plakat__marke"><span>{k.plakat.marke}</span></span>
						<span class="plakat__logo"><LogoBiss stufe={1} titel="parley Film" /></span>
					</span>
				) : (
					<span class="videokachel__bild">
						<BlasenVideo src={k.src} von={k.von} bis={k.bis} blasen={(k.blasen ?? []) as any} format="4/3" blasenlage="innen" stillbild />
					</span>
				)}
				<span class="videokachel__text">
					<span class="videokachel__titel"><span class="videokachel__nr">{k.nr}</span> {k.schritt ?? k.titel}</span>
					<span class="videokachel__zeile" set:html={k.schritt ? `${k.titel}. ${k.zeile}` : k.zeile} />
				</span>
			</Tag>
		); })}
	</div>
</div>
<div class="videokacheln__gross" data-videokacheln-gross hidden>
	<button type="button" class="videokacheln__zu" aria-label="Film schließen">Schließen</button>
	<video controls playsinline></video>
</div>

<style>
	.videokacheln__kopf { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 8px 16px; margin-bottom: 48px; }
	/* Titel nur so breit wie nötig, damit der Link rechts daneben auf der Grundlinie stehen kann (BBH) */
	.videokacheln__titel { flex: 0 1 auto; width: min-content; max-width: 100%; hyphens: manual; }
	.videokacheln__link { flex: none; }
	/* Sprungziel aus dem Menü („Videobeweis“, 13.11.2026): Luft über der Überschrift beim Ankommen. Am Rechner steht
	   das Menü oben links (Kachel 88 px), daher dort mehr; am Handy steht es unten. */
	.videokacheln__titel { scroll-margin-top: 32px; }
	@media (min-width: 1024px) { .videokacheln__titel { scroll-margin-top: 136px; } }
	.videokacheln__einleitung { max-width: 46ch; margin: -16px 0 48px; }
	.videokacheln__raster { display: grid; grid-template-columns: 1fr; gap: 32px 16px; }
	@media (min-width: 1024px) { .videokacheln__raster { grid-template-columns: 1fr 1fr; } }
	/* drei Spalten ab 1024 px (BBH News und Join Us: md:grid-cols-3), am Handy eine Spalte */
	@media (min-width: 1024px) { .videokacheln--drei .videokacheln__raster { grid-template-columns: 1fr 1fr 1fr; } }
	/* Plakat in der schmaleren Kachel: Satz eine Stufe kleiner */
	@media (min-width: 1024px) { .videokacheln--drei .plakat__satz { font-size: var(--text-md); } }
	a.videokachel { text-decoration: none; }
	.videokachel { display: block; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; font: inherit; transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1), transform 50ms; }
	.videokachel:active { transform: scale(0.99); }
	.videokachel__bild { display: block; border-radius: 4px; overflow: hidden; }
	.videokachel__bild :global(.blasenvideo) { transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1); }
	.videokachel__bild :global(video) { border-radius: 0; }
	@media (hover: hover) {
		.videokachel:hover { opacity: 0.8; }
		.videokachel:hover .videokachel__bild :global(.blasenvideo) { transform: scale(1.03) rotate(-0.25deg); }
	}
	/* Plakat */
	.plakat { position: relative; aspect-ratio: 4 / 3; background: #fff; color: #000; container-type: inline-size; }
	.plakat__foto { position: absolute; left: 0; right: 0; top: 46%; height: 40%; overflow: hidden; }
	.plakat__foto video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
	.plakat__ball { position: absolute; left: -14%; top: -34%; width: 80%; aspect-ratio: 1.4; border-radius: 50%; background: #0379A6; }
	.plakat__satz { position: absolute; left: 6%; top: 7%; width: 54%; color: #fff; font-family: var(--schrift-lesen); font-weight: 700; font-size: var(--text-md); line-height: 1.12; letter-spacing: -0.02em; text-wrap: balance; }
	@media (min-width: 1024px) { .plakat__satz { font-size: var(--text-lg); } }
	.plakat__satz :global(em) { font-style: normal; color: #9fdcf3; }
	.plakat__marke { position: absolute; right: 6%; top: 39%; }
	.plakat__marke span { position: relative; display: block; padding: 0.55em 0.9em; background: #fff; border-radius: 0.5em; font-family: var(--schrift-lesen); font-weight: 700; font-size: var(--text-base); letter-spacing: -0.02em; white-space: nowrap; }
	.plakat__marke span::after { content: ""; position: absolute; right: 18%; bottom: -0.7em; border-left: 0.7em solid transparent; border-top: 0.8em solid #fff; }
	.plakat__logo { position: absolute; right: 4%; bottom: 3.5%; width: 17%; color: #000; }
	.plakat__logo :global(svg) { display: block; width: 100%; height: auto; }
	.videokachel__text { display: flex; flex-direction: column; gap: 4px; margin-top: 16px; font-family: var(--schrift-lesen); font-size: var(--text-base); line-height: 1.3; letter-spacing: -0.02em; }
	.videokachel__nr { font-family: var(--schrift-mono, ui-monospace, monospace); margin-right: 4px; }
	.videokachel__zeile { color: var(--grey, #999894); }

	.videokacheln__gross { position: fixed; inset: 0; z-index: 2000; background: rgba(0, 0, 0, 0.92); display: grid; place-items: center; animation: vk-auf 300ms ease-in-out both; }
	.videokacheln__gross[hidden] { display: none; }
	.videokacheln__gross video { width: min(100vw, calc(100dvh * 16 / 9)); max-height: 100dvh; }
	.videokacheln__zu { position: absolute; top: 16px; right: 16px; z-index: 1; font: inherit; font-size: var(--text-sm); color: var(--white); background: transparent; border: 1px solid rgba(255, 255, 255, 0.4); padding: 6px 12px; cursor: pointer; }
	@keyframes vk-auf { from { opacity: 0; filter: blur(4px); } to { opacity: 1; filter: none; } }
	/* Sehr schmale Handys (unter 420 px): eine Stufe kleiner, sonst läuft „VERFAHREN“ (11,7 em) über den Rand
	   (Platz bei 375 px: 11,5 em; gemessen 13.11.2026). Gilt für alle großen Abschnittsköpfe gleich. */
	@media (max-width: 419px) { .videokacheln__titel { font-size: var(--text-2xl); line-height: var(--zeile-2xl); } }
	/* titelStufe="2xl" (Rasul 13.11.2026 abends: „kriegst du Videobeweis in eine Zeile?“): „VIDEOBEWEIS“ ist in der
	   Bartle 15 em breit und passt in Abschnittsgröße (huge) bei keiner Fensterbreite. Eine Stufe kleiner (2xl) passt
	   es ab etwa 640 px Fensterbreite in eine Zeile; Breite automatisch statt min-content, damit das Wort nicht an der
	   Trennstelle bricht, solange Platz ist. Darunter trennt es wie bisher (VIDEO-/BEWEIS). */
	.videokacheln__titel--2xl { width: auto; font-size: var(--text-2xl); line-height: var(--zeile-2xl); }
</style>

<script>
	let weg: (() => void)[] = [];
	function videokacheln() {
		weg.forEach((f) => f()); weg = [];
		// Plakat-Standbilder: auf die gewünschte Sekunde springen, nie abspielen
		document.querySelectorAll<HTMLVideoElement>("video[data-standbild]").forEach((v) => {
			const t = parseFloat(v.dataset.standbild || "1");
			const hin = () => { v.currentTime = t; };
			if (v.readyState >= 1) hin(); else v.addEventListener("loadedmetadata", hin, { once: true });
		});
		// Jede Kachel öffnet den Player ihres eigenen Bausteins (es kann mehrere auf einer Seite geben)
		let offen: HTMLElement | null = null;
		const zu = () => {
			if (!offen) return;
			offen.hidden = true; offen.querySelector("video")!.pause();
			document.documentElement.style.overflow = ""; offen = null;
		};
		const auf = (k: HTMLElement) => {
			const gross = k.closest(".videokacheln")?.nextElementSibling as HTMLElement | null;
			if (!gross || !gross.matches("[data-videokacheln-gross]")) return;
			const film = gross.querySelector("video")!;
			const von = k.dataset.von ? parseFloat(k.dataset.von) : 0;
			const bis = k.dataset.bis ? parseFloat(k.dataset.bis) : null;
			film.ontimeupdate = () => { if (bis !== null && film.currentTime >= bis) { film.pause(); film.currentTime = von; } };
			film.src = k.dataset.src!;
			film.muted = true; // wie BBH: auch der große Player startet stumm
			film.addEventListener("loadedmetadata", () => { film.currentTime = von; film.play().catch(() => {}); }, { once: true });
			gross.hidden = false; offen = gross;
			document.documentElement.style.overflow = "hidden";
		};
		const klick = (e: Event) => {
			const ziel = e.target as HTMLElement;
			if (ziel.closest(".videokacheln__zu") || (ziel.matches("[data-videokacheln-gross]"))) { zu(); return; }
			const k = ziel.closest<HTMLElement>("button.videokachel"); if (k) auf(k);
		};
		const taste = (e: KeyboardEvent) => { if (e.key === "Escape") zu(); };
		document.addEventListener("click", klick);
		document.addEventListener("keydown", taste);
		weg.push(() => { document.removeEventListener("click", klick); document.removeEventListener("keydown", taste); zu(); });
	}
	document.addEventListener("astro:page-load", videokacheln);
</script>
