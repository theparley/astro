---
/* Video auf einer Kundenseite (27.11.2026, Vorlage src/pages/[kunde].astro). Quelle ist Cloudflare Stream, keine
   Datei im Repo. Angabe stream = die Kennung des Videos in Stream (32 Zeichen).
   Geladen wird erst beim Abspielen: Vorgeladenes zählt bei Stream als ausgeliefert (Starter Bundle, 5.000 Minuten im
   Monat). Vor dem Abspielen kommt nur das Standbild (bis 27.11.2026 auch das Manifest, siehe unten im Skript).
   Weg wie im Band der Startseite (ExpertenAuswahl.astro): hls.js, wo es läuft, sonst das HLS des Browsers (iPhone),
   bei einem Fehler die MP4 von Stream (nur, wenn dort „Download“ für das Video eingeschaltet ist).
   OFFEN: Schutz der Videoadresse (erlaubte Herkunft oder signierte Adressen), siehe website/WEBSITE.md. */
interface Props { stream: string; titel?: string }
const { stream, titel } = Astro.props;
const BASIS = `https://customer-cmrkt3xxgowav3v1.cloudflarestream.com/${stream}`;
---
<figure class="kundenvideo">
	{/* STARTKNOPF STATT BEDIENLEISTE (27.11.2026): Bis zum ersten Abspielen hat das Video keine Quelle (siehe Skript).
	   Die Bedienleiste des Browsers zeigt dann einen ausgegrauten Abspielknopf. Deshalb liegt bis dahin ein eigener
	   Knopf über dem Standbild, die Leiste (controls) kommt erst mit dem Abspielen. Form des Knopfs: Entwurf der
	   Programmierung, nicht abgenommen. Weg zurück: Knopf und Hülle löschen, controls wieder ans <video>. */}
	<div class="kundenvideo__rahmen">
	<video
		playsinline
		preload="none"
		poster={`${BASIS}/thumbnails/thumbnail.jpg?time=1s&height=720`}
		data-kundenvideo
		data-hls={`${BASIS}/manifest/video.m3u8`}
		data-mp4={`${BASIS}/downloads/default.mp4`}
		aria-label={titel}
	></video>
	<button type="button" class="kundenvideo__start" aria-label={titel ? `Abspielen: ${titel}` : "Abspielen"}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
	</button>
	</div>
	{titel && <figcaption class="t-lesen">{titel}</figcaption>}
</figure>

<style>
	.kundenvideo { margin: 0; }
	.kundenvideo video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
	.kundenvideo__rahmen { position: relative; }
	.kundenvideo__start {
		position: absolute; inset: 0; margin: auto; width: 4.5em; height: 4.5em; padding: 1.1em; cursor: pointer;
		color: var(--black); background: var(--white); border: 0; border-radius: 0;
	}
	.kundenvideo__start svg { display: block; width: 100%; height: 100%; }
	.kundenvideo__start:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
	.kundenvideo__start[hidden] { display: none; }
	.kundenvideo figcaption { margin-top: 0.6em; }
</style>

<script>
	const einrichten = () => {
		document.querySelectorAll<HTMLVideoElement>("video[data-kundenvideo]:not([data-bereit])").forEach((v) => {
			v.dataset.bereit = "1";
			const hlsAdresse = v.dataset.hls!, mp4 = v.dataset.mp4!;
			const zurMp4 = () => { const lief = !v.paused; v.src = mp4; v.load(); if (lief) v.play().catch(() => {}); };
			const selbst = () => { if (v.canPlayType("application/vnd.apple.mpegurl")) v.src = hlsAdresse; else v.src = mp4; };
			/* ERST BEIM ERSTEN ABSPIELEN ANSCHLIESSEN (Rasul 27.11.2026: „dass der Kringel immer in der Mitte zu arbeiten
			   scheint“). Vorher wurde hls.js gleich beim Laden der Seite an das Video gehängt, mit autoStartLoad:false.
			   Chrome zeigte dann dauerhaft sein Ladezeichen über dem Standbild: Das Video hatte eine Quelle, bekam aber
			   keine Daten. Jetzt hat das Video bis zum ersten Abspielen keine Quelle, nur das Standbild; das Skript
			   hls.js wird schon vorher geholt, damit der erste Klick nicht wartet. Gemessen in Chrome am 27.11.2026.
			   Weg zurück: den Block durch die Fassung aus Commit 82a0320 ersetzen. */
			const geholt = import("hls.js").then((m) => m.default).catch(() => null);
			let Fertig: any; geholt.then((H) => { Fertig = H; });
			let begonnen = false;
			const knopf = v.parentElement?.querySelector<HTMLButtonElement>(".kundenvideo__start");
			const anschliessen = (Hls: any) => {
				if (!Hls || !Hls.isSupported()) { selbst(); v.play().catch(() => {}); return; }
				const h = new Hls({ maxBufferLength: 15, maxMaxBufferLength: 30 });
				h.loadSource(hlsAdresse);
				h.attachMedia(v);
				h.on(Hls.Events.MANIFEST_PARSED, () => { v.play().catch(() => {}); });
				h.on(Hls.Events.ERROR, (_e: any, d: any) => { if (d.fatal) { h.destroy(); zurMp4(); } });
				document.addEventListener("astro:before-swap", () => h.destroy(), { once: true });
			};
			const beginnen = () => {
				if (begonnen) return;
				begonnen = true;
				v.controls = true;
				if (knopf) knopf.hidden = true;
				// Ist das Skript schon da, läuft alles noch im Klick (das iPhone verlangt das für play()).
				if (Fertig !== undefined) anschliessen(Fertig); else geholt.then(anschliessen);
			};
			v.addEventListener("play", beginnen);
			v.addEventListener("click", beginnen);
			knopf?.addEventListener("click", beginnen);
		});
	};
	document.addEventListener("astro:page-load", einrichten);
</script>
