---
/* B21 Knopf-Link (BBH-Markenknopf). Kleines Quadrat links, wächst beim Darüberfahren,
   dahinter füllt sich eine 15-%-Fläche von links. Steht im Fluss, nie als Fläche.
   Analyse: research/BBH_Website_Analyse_2026-11/B_Seitenaufbau.md, B21. */
interface Props { href: string; text: string }
const { href, text } = Astro.props;
---
<a class="knopf" href={href}>{text}</a>
<style>
	.knopf {
		position: relative;
		display: inline-block;
		padding: 0.4em 0.6em 0.4em 0.75em;
		font-size: var(--text-base);
		line-height: 0.9;
		text-decoration: none;
		color: inherit;
		isolation: isolate;
	}
	.knopf::after {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		width: 0.18em;
		height: 0.18em;
		background: currentColor;
		transform: translateY(-50%);
		transition: width var(--tempo) var(--kurve), height var(--tempo) var(--kurve);
	}
	.knopf::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: currentColor;
		opacity: 0.15;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--tempo) var(--kurve);
	}
	@media (hover: hover) {
		.knopf:hover::after { width: 0.54em; height: 0.54em; }
		.knopf:hover::before { transform: scaleX(1); }
	}
	.knopf:active { transform: scale(0.97); transition: transform 50ms; }
</style>
