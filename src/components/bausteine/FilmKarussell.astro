---
/* Film-Karussell nach BBH (Hero H1, Nachschlagewerk Seite 01; gemessen 13.11.2026, Marketing-Ordner
   research/BBH_Website_Analyse_2026-11/C_Bewegung_Interaktion.md Kapitel 4b).
   Rasul 13.11.2026: „2 würde ich machen im Wechsel wie bei BBH. Der Vorteil wäre dann, wir könnten
   schneller auch ein Video austauschen.“ Austauschen = Eintrag in der Liste `filme` ändern.
   - Filme laufen nacheinander, je einmal ganz durch (keine Schleife), am Filmende kommt der nächste,
     nach dem letzten wieder der erste.
   - Immer stumm (nach Seitenwechseln geht „muted“ sonst verloren, gemessen 13.11.2026).
   - Geladen werden nur der laufende und der nächste Film (wie BBH).
   - Punkte unten rechts: weiße Quadrate 8 × 8 px, 8 px Abstand, 32 px vom Rand; aktiver Punkt voll,
     die anderen 50 %, Wechsel 150 ms. Linke und rechte Bildhälfte springen zurück und weiter.
   - Spielt nur, solange mindestens 20 % zu sehen sind. */
interface Film { src: string; titel: string }
interface Props { filme: Film[] }
const { filme } = Astro.props;
---
<div class="filmkarussell" data-filmkarussell>
	{filme.map((f, i) => (
		<video class:list={["filmkarussell__film", i === 0 && "aktiv"]} data-src={f.src} muted playsinline preload="none" aria-label={f.titel}></video>
	))}
	{filme.length > 1 && (
		<>
			<button type="button" class="filmkarussell__flaeche filmkarussell__flaeche--zurueck" aria-label="Vorheriger Film"></button>
			<button type="button" class="filmkarussell__flaeche filmkarussell__flaeche--weiter" aria-label="Nächster Film"></button>
			<div class="filmkarussell__punkte" aria-hidden="true">
				{filme.map((_, i) => <span class:list={["filmkarussell__punkt", i === 0 && "aktiv"]}></span>)}
			</div>
		</>
	)}
</div>

<style>
	.filmkarussell { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--black); }
	.filmkarussell__film {
		position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
		opacity: 0; transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
	}
	.filmkarussell__film.aktiv { opacity: 1; }
	.filmkarussell__flaeche { position: absolute; top: 0; bottom: 0; width: 50%; border: 0; padding: 0; background: transparent; z-index: 2; }
	.filmkarussell__flaeche--zurueck { left: 0; cursor: w-resize; }
	.filmkarussell__flaeche--weiter { right: 0; cursor: e-resize; }
	.filmkarussell__punkte { position: absolute; right: 32px; bottom: 32px; display: flex; gap: 8px; z-index: 3; pointer-events: none; }
	.filmkarussell__punkt { width: 8px; height: 8px; background: #fff; opacity: 0.5; transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1); }
	.filmkarussell__punkt.aktiv { opacity: 1; }
	@media (max-width: 1023px) { .filmkarussell__punkte { right: 16px; bottom: 16px; } }
</style>

<script>
	let aufraeumen: (() => void) | null = null;
	function karussell() {
		aufraeumen?.(); aufraeumen = null;
		const box = document.querySelector<HTMLElement>("[data-filmkarussell]");
		if (!box || box.offsetParent === null) return; // nicht sichtbar (z. B. Hero-Variante „Text“)
		const filme = [...box.querySelectorAll<HTMLVideoElement>(".filmkarussell__film")];
		const punkte = [...box.querySelectorAll<HTMLElement>(".filmkarussell__punkt")];
		let i = 0, sichtbar = false;
		const lade = (n: number) => { const v = filme[n]; if (v && !v.src) { v.src = v.dataset.src!; v.preload = "auto"; } };
		const zeige = (n: number) => {
			const alt = filme[i];
			alt.pause();
			i = (n + filme.length) % filme.length;
			const v = filme[i];
			filme.forEach((f, k) => f.classList.toggle("aktiv", k === i));
			punkte.forEach((p, k) => p.classList.toggle("aktiv", k === i));
			lade(i); lade((i + 1) % filme.length);
			v.muted = true;
			v.currentTime = 0;
			if (sichtbar) v.play().catch(() => {});
		};
		const ende = () => zeige(i + 1);
		filme.forEach((v) => { v.muted = true; v.addEventListener("ended", ende); });
		lade(0); lade(1 % filme.length);
		const zurueck = box.querySelector(".filmkarussell__flaeche--zurueck");
		const weiter = box.querySelector(".filmkarussell__flaeche--weiter");
		const klickZurueck = () => zeige(i - 1);
		const klickWeiter = () => zeige(i + 1);
		zurueck?.addEventListener("click", klickZurueck);
		weiter?.addEventListener("click", klickWeiter);
		const beob = new IntersectionObserver(([e]) => {
			sichtbar = e.isIntersecting;
			const v = filme[i];
			if (sichtbar) { v.muted = true; v.play().catch(() => {}); } else v.pause();
		}, { threshold: 0.2 });
		beob.observe(box);
		aufraeumen = () => {
			beob.disconnect();
			filme.forEach((v) => { v.removeEventListener("ended", ende); v.pause(); });
			zurueck?.removeEventListener("click", klickZurueck);
			weiter?.removeEventListener("click", klickWeiter);
		};
	}
	document.addEventListener("astro:page-load", karussell);
</script>
