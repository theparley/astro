---
/* B18 Kennzahlen: Zahl in Bartle, darunter die Erklärzeile, alles mittig. Bis zu drei
   nebeneinander, auf dem Handy untereinander. gross=true setzt eine einzelne Zahl in mega
   statt xl (Parley: „41,8“ als Hauptbeleg). quelle steht klein darunter.
   Ergänzt 14.11.2026 (Vorteile im Segment „Videobeweis“, Rasul: „Vielleicht sogar als kleine Kacheln … Und wenn es nur
   Kacheln mit Text sind.“): rahmen={false}, wenn der Baustein in einem anderen Rahmen steht; mehr als drei Einträge
   laufen in Reihen zu je drei (Abweichung von BBH, dort höchstens drei); Wert darf ein Wort sein. */
/* woerter: Wert ist ein Wort; dann in der schmalen Bogle (BBH nimmt sie für Zwischentitel, B6 und B11) statt der breiten
   Bartle, sonst laufen lange Wörter aus der Spalte (gemessen 14.11.2026: „Blickkontakt“, „Ohne Kamerastress“). */
/* mehr (14.11.2026, Rasul: „Und wenn man drauf klickt, klappt es auf oder was anderes, was vielleicht bei der BBH-Seite
   finden, wo dann tiefer erklärt wird. Die Kunst wird sein, den Abschnitt schnell scannbar zu haben“): Eintrag klappt
   auf wie BBHs Akkordeon (B11: Plus, Inhalt öffnet darunter), hier in der Kachel. Ohne Skript (details/summary). */
interface Props { zahlen: { wert: string; zeile: string; mehr?: string }[]; gross?: boolean; quelle?: string; rahmen?: boolean; woerter?: boolean }
const { zahlen, gross = false, quelle, rahmen = true, woerter = false } = Astro.props;
---
<div class:list={["kennzahlen", rahmen && "rahmen", woerter && "kennzahlen--woerter"]} data-einblenden>
	<div class:list={["kennzahlen__reihe", `kennzahlen__reihe--${Math.min(zahlen.length, 3)}`]}>
		{zahlen.map((z) => z.mehr ? (
			<details class="kennzahl kennzahl--mehr">
				<summary>
					<div class:list={["t-zahl", gross && "kennzahl--gross"]}>{z.wert}</div>
					<p class="kennzahl__zeile">{z.zeile}</p>
					<span class="kennzahl__plus" aria-hidden="true"></span>
				</summary>
				<p class="kennzahl__mehr" set:html={z.mehr} />
			</details>
		) : (
			<div class="kennzahl">
				<div class:list={["t-zahl", gross && "kennzahl--gross"]}>{z.wert}</div>
				<p class="kennzahl__zeile">{z.zeile}</p>
			</div>
		))}
	</div>
	{quelle && <p class="t-mini grau kennzahlen__quelle" set:html={quelle} />}
	<slot />
</div>
<style>
	.kennzahlen { text-align: center; }
	.kennzahlen__reihe { display: grid; gap: 32px 64px; justify-content: center; }
	@media (min-width: 1024px) { .kennzahlen__reihe--2 { grid-template-columns: repeat(2, auto); } .kennzahlen__reihe--3 { grid-template-columns: repeat(3, auto); } }
	.kennzahl--gross { font-size: var(--text-mega); line-height: var(--zeile-mega); }
	.kennzahl__zeile { margin: 16px auto 0; max-width: 46ch; font-size: var(--text-md); line-height: 1.2; text-wrap: balance; }
	.kennzahlen--woerter .kennzahlen__reihe { grid-template-columns: 1fr; }
	@media (min-width: 1024px) { .kennzahlen--woerter .kennzahlen__reihe { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	.kennzahlen--woerter .t-zahl { font-family: var(--schrift-schmal); font-size: var(--text-xl); line-height: var(--zeile-xl); }
	.kennzahlen--woerter .kennzahl__zeile { font-size: var(--text-base); }
	.kennzahlen--woerter .kennzahlen__reihe { align-items: start; }
	.kennzahl--mehr summary { list-style: none; cursor: pointer; }
	.kennzahl--mehr summary::-webkit-details-marker { display: none; }
	.kennzahl--mehr summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
	/* Plus wie BBHs Akkordeon, wird beim Öffnen zum Minus */
	.kennzahl__plus { position: relative; display: block; width: 14px; height: 14px; margin: 16px auto 0; opacity: 0.6; transition: opacity 200ms; }
	.kennzahl__plus::before, .kennzahl__plus::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -0.75px; background: currentColor; transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1); }
	.kennzahl__plus::after { transform: rotate(90deg); }
	.kennzahl--mehr[open] .kennzahl__plus::after { transform: rotate(0deg); }
	@media (hover: hover) { .kennzahl--mehr summary:hover .kennzahl__plus { opacity: 1; } }
	.kennzahl__mehr { margin: 16px auto 0; max-width: 36ch; font-size: var(--text-sm); line-height: 1.3; opacity: 0.8; text-wrap: pretty; }
	.kennzahlen__quelle { margin: 16px auto 0; max-width: 60ch; text-wrap: balance; }
</style>
