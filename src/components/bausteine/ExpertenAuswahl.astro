	// Probe „punkt“ (Rasul 13.11.2026 abends: „ob wir mit Punkten starten können, die dann zu Männchen werden“), danach
	// entschieden: „Zurück zu Figuren“. Grundeinstellung „figur“, „punkt“ bleibt im Schalter.
	const form = () => (document.documentElement.dataset.form === "punkt" ? "punkt" : "figur");
	// Aufstellung, die von oben ungeordnet wirkt und von vorne trägt: einer vorne, zwei dahinter, zwei Reihen, viele hinten
	// Erscheinen bis kurz vor Ende der Kamerafahrt (Rasul 14.11.2026: „wenn du es hinkriegst, noch Männchen erscheinen zu
	// lassen, während die Kamera dreht? Weil vorhin sind die vom Himmel gefallen, das war schlecht, dann kannst du es auch noch
	// länger machen … bis zu dem Punkt, wo die Kamera fast reingefahren ist.“). Alle entstehen an ihrem Platz (Einblenden,
	// keine Bewegung), deshalb fällt niemand vom Himmel. Verlauf weiter Ease-in und Ease-out, aber mit langem Auslauf: gut die
	// Hälfte ist da, wenn der Text kommt, danach werden es immer weniger bis 85 % der Fahrt. Die nahen Reihen (Ebene 2)
	// erscheinen nur vor der Fahrt, sonst würden nah an der Kamera große Figuren aufblenden; spät kommen nur hintere Reihen.
	// Vorher: alle bis 1,65 s, dazu drei Nachzügler bis zur Hälfte der Geste (Git-Geschichte).
	const T_ERSCH_BIS = () => T_GESTE + 0.85 * D_KAMERA - 0.5; // letzte Einblendung (0,5 s) endet bei 85 % der Fahrt
	const verteilung = (x: number) => { const y = Math.pow(x, 0.55); return y * y * (3 - 2 * y); }; // Anteil, der bis x da ist
	function erscheinZeit(u: number) {
		let lo = 0, hi = 1;
		for (let i = 0; i < 30; i++) { const m = (lo + hi) / 2; if (verteilung(m) < u) lo = m; else hi = m; }
		return 0.2 + lo * (T_ERSCH_BIS() - 0.2);
	}
	function uebergang(liste: Person[]): Person[] {
		const nahBis = T_GESTE - 0.5; // nahe Reihen fertig, bevor die Kamera losfährt
		const k = (nahBis - 0.2) / (T_ERSCH_BIS() - 0.2);
		liste.forEach((q) => { if (q.ebene === 2 && !q.spaet && q.ein > 0.2) q.ein = 0.2 + (q.ein - 0.2) * k; });
		return liste;
	}
	function personenFahrt(): Person[] {
		const rnd = zufall(23), liste: Person[] = [];
		const halb = RW / 2 - 80;
		const neu = (X: number, Z: number, ebene: number, ein: number): Person => ({ x: CX + X, y: CY - Z, s: 1, ein, zx: 0, zy: 0, bleibt: ebene <= 1, rang: 0, ebene, ex: 0, ey: 0, eg: 1, z: 1, wx: X, wz: Z, tx: X, tz: Z });
		const j = (w: number) => (rnd() - 0.5) * w;
		// alle erscheinen im ersten Abschnitt, bis kurz vor der Pause (letzte Einblendung dauert 0,5 s)
		// Tempo des Erscheinens (Rasul 14.11.2026: „Gib dem Erscheinen der Männchen auch mal eine Geschwindigkeit. Lass es mal
		// langsam anfangen, steigern und wieder abflachen.“): Die Zeitpunkte folgen einem Sinus-Verlauf (Umkehrung von sanft),
		// also erst wenige, in der Mitte die meisten, am Ende wieder wenige. Vorher gleichmäßig verteilt. Gleich viele
		// Zufallszahlen wie vorher, die Plätze bleiben deshalb dieselben.
		const spaeter = () => erscheinZeit(rnd()); // Verlauf siehe erscheinZeit (seit 14.11.2026 bis kurz vor Ende der Fahrt)
		// Links und rechts ungleich (Rasul 13.11.2026 abends: „in der Endposition sind die Hintergrundmännchen rechts und
		// links … ein bisschen ähnlich … mach da mal eine Seite ein bisschen größer und mehr und auf der anderen Seite ein
		// bisschen weniger, dass es organischer aussieht“): links stehen mehr Personen und näher an der Kamera (also größer),
		// rechts weniger und weiter hinten. Die Plätze gelten von Anfang an, verschoben wird niemand.
		liste.push(neu(0, -300, 0, rnd() * 0.5), neu(-225 + j(20), -205 + j(20), 1, rnd() * 0.7), neu(175 + j(20), -110 + j(20), 1, rnd() * 0.7));
		const reihe = (n: number, zVon: number, zBis: number, breite: number, ebene: number, ein: () => number) => {
			for (let i = 0; i < n; i++) {
				const X = (n === 1 ? 0 : (i / (n - 1) - 0.5) * 2 * breite) + j((2 * breite) / n * 0.6);
				liste.push(neu(X, zVon + rnd() * (zBis - zVon), ebene, ein()));
