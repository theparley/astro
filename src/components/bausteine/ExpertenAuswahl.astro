---
/* Experten-Auswahl: viele Personen, die Videobeweis-Geste, am Ende bleiben drei.
   Rasul 13.11.2026 abends: „die einzigste Animation wäre unsere Videobeweisanimation, diese Bewegung in der Luft, die
   jemand macht, und wir würden jetzt einfach unsortiert auf einer Fläche sehen ganz viele Icons von Personen. Das wären
   unsere Experten. Dann kommt diese Bewegung. Und dann reduziert sich das auf 3. Probier es mal, ob das Sinn macht, ob
   man sowas angucken will.“
   Geste wie Probe 2 (Marketing-Ordner branding/aktiv/Parley_Videobeweis_Geste_2026-11.md: 16:9, Ecken wie das Logo,
   1,6 s, Tempo wie eine Hand, Nachleuchten 0,9 s, Fingerdicke 34, Lücke 8, Glühen), hier dunkel auf hellem Grund.
   Ablauf: Personen erscheinen verstreut (bis 1,4 s), die Finger ziehen den Rahmen (ab 1,8 s), während die Spur
   verglimmt, verschwinden alle bis auf drei, die drei rücken in die Mitte des Rahmens. Spielt einmal, sobald die
   Fläche zur Hälfte sichtbar ist; Klick spielt noch einmal. Bei reduzierter Bewegung sofort das Endbild.
   Endbild steht allein (Grafik-Leitfaden Abschnitt 2): drei Personen. */
interface Props { label?: string }
const { label = "Viele Personen, eine Handbewegung zeichnet einen Rahmen, drei bleiben übrig." } = Astro.props;
---
<figure class="experten" data-experten>
	<canvas class="experten__bild" role="img" aria-label={label}></canvas>
	<button type="button" class="experten__nochmal" aria-label="Animation noch einmal abspielen">Noch einmal</button>
</figure>

<style>
	/* Über die ganze Breite des Bandes (Rasul 13.11.2026 abends: „bei der Kamerafahrt werden jetzt rechts und links
	   Personen abgeschnitten. Ich fände es für den Effekt super, wenn die nicht abgeschnitten würden und sogar noch weiter
	   in die Breite gehen, als sie vorher waren.“). Die Höhe bleibt die der 16:9-Fläche von höchstens 960 px Breite; der
	   Rahmen der Geste steht in deren Mitte, nach dem Kippen dürfen die hinteren bis an den Rand des Bandes. */
	.experten { --innen: min(960px, 100vw - 2 * var(--rand)); position: relative; width: 100vw; margin-left: calc(50% - 50vw); max-width: none; }
	.experten__bild { display: block; width: 100%; height: calc(var(--innen) * 9 / 16); cursor: pointer; }
	.experten__nochmal { position: absolute; right: calc(50vw - var(--innen) / 2); bottom: -28px; font: inherit; font-size: var(--text-sm); color: var(--gray); background: none; border: 0; padding: 0; cursor: pointer; opacity: 0; transition: opacity var(--tempo) var(--kurve); }
	.experten[data-fertig] .experten__nochmal { opacity: 1; }
</style>

<script>
	type Spur = [number, number][]; // [Weg-Anteil s, Zeit]: gezeichnet wird entlang des echten Wegs, nicht als Gerade
	                                // zwischen zwei Bildern (sonst entstehen bei ausgelassenen Bildern Balken quer durch)
	const W = 1600, H = 900;
	const DAUER = 1.6, GLIMM = 0.9, DICKE = 34, LUECKE = 8;
	const T_PERSONEN = 1.4, T_GESTE = 1.8, T_AUSWAHL = T_GESTE + DAUER - 0.2, D_AUSWAHL = 1.1;
	// Ende (Rasul 13.11.2026 abends: „die drei Personen [können] größer werden. Die Frage wäre, ob wir dann nachher nur
	// einen zeigen. Oder ob wir einen zeigen und die anderen beiden grau machen oder blurren sogar.“). Probe mit Schalter
	// „Animation“ (html data-ende): drei | eins | grau | unscharf. Der Fokus folgt nach der Auswahl.
	const T_FOKUS = T_AUSWAHL + D_AUSWAHL + 0.3, D_FOKUS = 0.9;
	const D_KIPP = 2.6; // Kamerafahrt beim Ende „kamera“ (gleichmäßiger Verlauf, siehe sanft)
	// Danach fährt die Kamera auf die vordere Person zu (Rasul 13.11.2026 abends: „die Kamera … kippt nicht nur, sondern
	// fährt dann auch noch auf die Person zu. Dadurch wird es hinten auch breiter.“). Beginnt kurz vor Ende des Kippens.
	const T_FAHRT = T_AUSWAHL + D_KIPP * 0.8, D_FAHRT = 1.8;
	const ENDE = Math.max(T_FOKUS + D_FOKUS, T_FAHRT + D_FAHRT + 0.4, T_AUSWAHL + 3.4 + 0.5) + 0.2; // 3,4 = D_KAMERA
	const GROSS = 2.3; // Größe der drei am Ende (vorher 1,5)
	// Entschieden: „unscharf“ (Rasul 13.11.2026 abends). Ohne Schalter (auf der hochgeladenen Seite) gilt das.
	// Danach Probe „ebenen“ (Rasul 13.11.2026 abends), seitdem Grundeinstellung; „unscharf“ bleibt im Schalter.
	// Danach Probe „kamera“ (Rasul 13.11.2026 abends), seitdem Grundeinstellung; „ebenen“ bleibt im Schalter.
	const ende = () => document.documentElement.dataset.ende || "kamera";

	// fester Zufall, damit jedes Abspielen gleich aussieht
	function zufall(saat: number) { return () => { saat = (saat * 16807) % 2147483647; return (saat - 1) / 2147483646; }; }
	const kubisch = (x: number) => x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
	const weich = (x: number) => x <= 0 ? 0 : x >= 1 ? 1 : 1 - Math.pow(1 - x, 3);
	// Sinus-Verlauf: sanft an, sanft aus, ohne den starken Tempo-Sprung in der Mitte wie bei kubisch (Rasul 13.11.2026:
	// „sie ruckelt ein bisschen, sie verändert die Geschwindigkeit“)
	const sanft = (x: number) => x <= 0 ? 0 : x >= 1 ? 1 : 0.5 - 0.5 * Math.cos(Math.PI * x);
	const anteil = (t: number, von: number, dauer: number) => Math.max(0, Math.min(1, (t - von) / dauer));

	// Rahmen 16:9 mittig, so groß, dass alle Personen darin stehen (Rasul 13.11.2026 abends: „mach lieber den Frame
	// größer und lass alle Personen drin sein“); Höhe 86 % der Fläche, je Finger ein halber Umlauf von oben nach unten
	// Breite des Rahmens: 21:9 (Rasul 13.11.2026 abends: „Probier mal 21 zu 9 … Wir reden ja von Film“), Schalter
	// „Rahmen“ (html data-rahmen = 21 | 16); höchstens so breit, wie die Fläche es erlaubt (siehe rahmen()).
	const RH = H * 0.86, CX = W / 2, CY = H / 2, T = CY - RH / 2, B = CY + RH / 2, RAD = RH * 0.05;
	let RW = RH * 16 / 9, L = CX - RW / 2;
	const format = () => (document.documentElement.dataset.rahmen === "16" ? 16 / 9 : 21 / 9);
	const G = (DICKE + LUECKE) / 2;
	function halbweg(seite: 1 | -1) {
		const p: [number, number][] = [];
		const x = (v: number) => CX + seite * v;
		const kante = RW / 2;
		for (let v = G; v <= kante - RAD; v += 3) p.push([x(v), T]);
		for (let a = 0; a <= 90; a += 6) { const r = a * Math.PI / 180; p.push([x(kante - RAD + Math.sin(r) * RAD), T + RAD - Math.cos(r) * RAD]); }
		for (let y = T + RAD; y <= B - RAD; y += 3) p.push([x(kante), y]);
		for (let a = 0; a <= 90; a += 6) { const r = a * Math.PI / 180; p.push([x(kante - RAD + Math.cos(r) * RAD), B - RAD + Math.sin(r) * RAD]); }
		for (let v = kante - RAD; v >= G; v -= 3) p.push([x(v), B]);
		const lang = [0];
		for (let i = 1; i < p.length; i++) lang.push(lang[i - 1] + Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1]));
		return { p, lang, ges: lang[lang.length - 1] };
	}
	let WEG_R = halbweg(1), WEG_L = halbweg(-1);
	function rahmen(flaecheBreite: number) {
		RW = Math.min(RH * format(), flaecheBreite - 160); L = CX - RW / 2;
		WEG_R = halbweg(1); WEG_L = halbweg(-1);
	}
	function punkt(w: ReturnType<typeof halbweg>, s: number): [number, number] {
		const ziel = s * w.ges; let lo = 1, hi = w.lang.length - 1; // binäre Suche statt Durchlaufen
		while (lo < hi) { const mid = (lo + hi) >> 1; if (w.lang[mid] < ziel) lo = mid + 1; else hi = mid; }
		const i = lo;
		const a = w.lang[i - 1], b = w.lang[i], f = b > a ? (ziel - a) / (b - a) : 0;
		return [w.p[i - 1][0] + (w.p[i][0] - w.p[i - 1][0]) * f, w.p[i - 1][1] + (w.p[i][1] - w.p[i - 1][1]) * f];
	}

	// Kamera für das Ende „kamera“ (Rasul 13.11.2026 abends: „dass wir aus der 2D-Ansicht eine 3D-Ansicht machen, weil wir
	// sozusagen die Kamera runterkippen … wie wenn man die von oben sehen würde und dann mit der Kamera runter an die Front
	// kippt. Und dabei bewegen sie sich natürlich auch“). Boden y = 0, Kamera kreist im Abstand KD um den Mittelpunkt und
	// kippt von 90° (senkrecht von oben, Bild wie die Draufsicht) auf PHI_ENDE. Brennweite = Abstand, also Draufsicht 1 : 1.
	const KD = 1000, PHI_ENDE = 12 * Math.PI / 180;
	// zoom: Brennweite als Vielfaches von KD; während der Fahrt kurz größer, damit die Personen in der Mitte der Fahrt
	// nicht klein zusammenrutschen (Anfang und Ende bleiben 1).
	function kamera(X: number, Z: number, phi: number, zoom = 1, abstand = KD) {
		const cy = abstand * Math.sin(phi), cz = -abstand * Math.cos(phi);
		const vy = -cy, vz = Z - cz;
		const zc = vy * -Math.sin(phi) + vz * Math.cos(phi), yc = vy * Math.cos(phi) + vz * Math.sin(phi);
		const F = KD * zoom;
		return { x: CX + F * X / zc, y: CY - F * yc / zc, g: F / zc, zc };
	}
	const KD_ENDE = 660; // die Kamera fährt beim Kippen heran (Abstand 1000 auf 660), damit vorne einer groß wird
	const KD_FAHRT = 540; // danach fährt sie weiter auf die vordere Person zu

	// Anordnung für „kamera“ (Rasul 13.11.2026 abends: „jetzt springen mir die Personen zu arg. Also das Kippen ist gut,
	// aber die Bewegung findet vielleicht am Ende statt … dass wir die schon so anordnen, dass wenn man das kippt, der eine
	// im Vordergrund ist und die anderen zwei im Hintergrund. Und der Rest dahinter darf sich ein bisschen bewegen, aber
	// nicht so stark.“). Die drei stehen schon in der Draufsicht an ihrem Platz (einer unten mittig = vorne, zwei darüber
	// links und rechts); die übrigen rücken nur etwas nach hinten.
	function personenKamera(): Person[] {
		const rnd = zufall(11), liste: Person[] = [];
		const neu = (x: number, y: number, ebene: number): Person => ({ x, y, s: 1, ein: rnd() * (T_PERSONEN - 0.5), zx: x, zy: y, bleibt: ebene <= 1, rang: ebene === 0 ? 1 : 0, ebene, ex: x, ey: y, eg: 1, z: 1, wx: x - CX, wz: CY - y, tx: x - CX, tz: CY - y });
		liste.push(neu(CX, CY + 250, 0), neu(CX - 190, CY + 120, 1), neu(CX + 190, CY + 120, 1));
		const RAND = 80; let versuche = 0;
		while (liste.length < 34 && versuche++ < 6000) {
			// die übrigen nicht ganz unten: dort steht nur der eine vorne (sonst sind sie beim Kippen kurz groß im Vordergrund)
			const x = L + RAND + rnd() * (RW - 2 * RAND), y = T + RAND + rnd() * (CY + 190 - T - RAND);
			if (liste.every((q) => Math.hypot(q.x - x, q.y - y) > 125)) liste.push(neu(x, y, 3)); // alle gleich groß
		}
		// Erscheinen (Rasul 13.11.2026 abends: „hörst jetzt auf, neue Personen erscheinen zu lassen, kurz bevor wir den
		// Videobeweis machen … während der Videobeweisanimation mit den Linien dürfen innerhalb des Fensters immer noch welche
		// entstehen … am Ende nur noch ganz dezent im Hintergrund … kurz vorher dann auch gar nicht mehr, dass es zur Ruhe
		// kommt“; „mach sie mal alle gleich groß. Der größte Unterschied kommt jetzt über die Perspektive.“).
		// Die drei zuerst, die übrigen verteilt bis kurz vor Ende der Geste.
		liste.forEach((q, i) => { q.ein = i < 3 ? rnd() * 0.8 : 0.2 + rnd() * (T_GESTE + DAUER - 0.5); });
		const rest = liste.filter((q) => q.ebene > 1).sort((a, b) => a.wz - b.wz);
		rest.forEach((q, i) => {
			// seitlich etwas zur Mitte, damit nach dem Kippen niemand aus dem Bild ragt
			// Seitlich bewegt sich niemand (Rasul 13.11.2026 abends: „dass man es hinten in die Breite zieht. Das stimmt
			// einfach vom Kameragefühl her nicht.“); die hinteren treten nur ein Stück gerade nach hinten.
			if (i < 10) { q.ebene = 2; q.tz = Math.max(q.wz, -40) + 120; }
			else { q.ebene = 3; q.tz = 300 + (q.wz + 307) * 0.9; }
			q.tx = q.wx;
		});
		// Während der Kamerafahrt kommen nur noch wenige ganz hinten dazu, leise (Ebene 3), und ab drei Vierteln keine mehr
		// Die späten entstehen an ihrem Platz hinten, wenn das Kippen fast fertig ist, und nicht mehr gegen Ende der Fahrt
		// (Rasul: „es fallen jetzt welche noch vom Himmel … die würden eher einfach hintendran entstehen“)
		for (let i = 0; i < 10; i++) {
			const q = neu(CX, CY, 3); q.spaet = true; q.bleibt = false;
			q.tz = 450 + rnd() * 500; q.tx = (-1 + 2 * ((i + 0.5) / 10) + (rnd() - 0.5) * 0.12) * (RW / 2 - RAND);
			q.ein = T_AUSWAHL + D_KIPP * 0.85 + rnd() * D_FAHRT * 0.45;
			liste.push(q);
		}
		return liste;
	}
	function kameraTiefe(Z: number, phi: number) { return kamera(0, Z, phi).zc; }

	// Personen: verstreut, mit Mindestabstand; die drei der Mitte nächsten bleiben
	interface Person { spaet?: boolean; fx?: number; fb?: number; zcE?: number; x: number; y: number; s: number; ein: number; zx: number; zy: number; bleibt: boolean; rang: number; ebene: number; ex: number; ey: number; eg: number; z: number; wx: number; wz: number; tx: number; tz: number }
	function personen(): Person[] {
		const rnd = zufall(7), liste: Person[] = [];
		let versuche = 0;
		const RAND = 80; // Abstand der Personen zur Spur
		while (liste.length < 34 && versuche++ < 6000) {
			const x = L + RAND + rnd() * (RW - 2 * RAND), y = T + RAND + rnd() * (RH - 2 * RAND);
			if (liste.every((q) => Math.hypot(q.x - x, q.y - y) > 130)) liste.push({ x, y, s: 1, ein: rnd() * (T_PERSONEN - 0.5), zx: x, zy: y, bleibt: false, rang: -1, ebene: 3, ex: x, ey: y, eg: 1, z: 1, wx: x - CX, wz: CY - y, tx: 0, tz: 0 });
		}
		const nah = [...liste].sort((a, b) => Math.hypot(a.x - CX, a.y - CY) - Math.hypot(b.x - CX, b.y - CY)).slice(0, 3).sort((a, b) => a.x - b.x);
		nah.forEach((q, i) => { q.bleibt = true; q.rang = i; q.zx = CX + (i - 1) * 380; q.zy = CY + 10; });
		// Ebenen für das Ende „ebenen“: die nächsten zehn zur Mitte bilden Ebene 2, alle übrigen Ebene 3
		const rest = liste.filter((q) => !q.bleibt).sort((a, b) => Math.hypot(a.x - CX, a.y - CY) - Math.hypot(b.x - CX, b.y - CY));
		rest.forEach((q, i) => { q.ebene = i < 10 ? 2 : 3; });
		nah.forEach((q) => { q.ebene = q.rang === 1 ? 0 : 1; });
		// Perspektive (Rasul 13.11.2026 abends: „lass sie nicht im Hintergrund auf der Fläche stehen, sondern setz sie auch
		// so im Hintergrund, wie wenn die hinten dran stehen würden, wie wenn man in einen langen Flur reinguckt oder auf eine
		// große Fläche“). Boden mit Horizont: Tiefe z teilt Abstand zum Horizont, Breite und Größe (Lochkamera).
		const HORIZONT = 230, BODEN = 700, G0 = 2.6;
		const setze = (q: Person, z: number, X: number) => {
			const g = G0 / z, u = (64 * g) / 19;
			q.z = z; q.eg = g; q.ex = CX + X / z; q.ey = HORIZONT + (BODEN - HORIZONT) / z - 9 * u;
		};
		const reihe = (gruppe: Person[], zVon: number, zBis: number, breite: number) => {
			gruppe.sort((a, b) => a.x - b.x).forEach((q, i) => {
				const z = zVon + rnd() * (zBis - zVon);
				const X = (gruppe.length === 1 ? 0 : (i / (gruppe.length - 1) - 0.5) * breite) + (rnd() - 0.5) * (breite / gruppe.length) * 0.8;
				setze(q, z, X);
			});
		};
		nah.forEach((q) => setze(q, q.rang === 1 ? 1 : 1.45, (q.rang - 1) * 520));
		reihe(rest.filter((q) => q.ebene === 2), 2.0, 3.0, 3000);
		reihe(rest.filter((q) => q.ebene === 3), 3.4, 7.5, 6400);
		// Ende „kamera“: Plätze auf dem Boden (Welt-Koordinaten), die Kamera kippt von oben nach vorne (siehe kamera())
		const raum = (gruppe: Person[], zVon: number, zBis: number, anteil: number) => {
			gruppe.sort((a, b) => a.x - b.x).forEach((q, i) => {
				const Z = zVon + rnd() * (zBis - zVon), halb = anteil * kameraTiefe(Z, PHI_ENDE);
				q.tz = Z; q.tx = (gruppe.length === 1 ? 0 : (i / (gruppe.length - 1) - 0.5) * 2 * halb) + (rnd() - 0.5) * (halb / gruppe.length);
			});
		};
		nah.forEach((q) => { if (q.rang === 1) { q.tx = 0; q.tz = -600; } else { q.tx = (q.rang - 1) * 210; q.tz = -420; } });
		raum(rest.filter((q) => q.ebene === 2), -150, 250, 0.5);
		raum(rest.filter((q) => q.ebene === 3), 500, 2600, 0.55);
		return liste;
	}

	// ── Kamerafahrt, Neubau (Rasul 13.11.2026 abends) ─────────────────────────────────────────────────────────────
	// „Gefühl soll es ja nachher wirklich eine Kamerafahrt sein. Also wie wenn die Kamera mittig über diesen Köpfen schwebt
	// … Und dann macht die Kamera anstatt den Blick von oben … von vorne nach hinten. Und bewegt sich in der Mitte über der
	// Masse vor die vorderste Person. Das ist die Kamerabewegung. Die darf ein Ease-in und ein Ease-out haben … lass du mal
	// das Rumschieben von Personen weg … da wo die Personen erscheinen, da bleiben die auch nachher stehen. Wir geben dem
	// eben jetzt schon so eine Struktur, die nachher funktioniert, dass vorne einer steht und man dann noch ruhig zwei, drei
	// Ebenen tief und dann den Rest und dann ganz viel lebend dran.“
	// Welt: Boden y = 0, Personen fest auf (X, Z). Kamera nur in der Mittelebene (x = 0): Position C = [Höhe, Z], Blickziel
	// Lk = [Höhe, Z], Brennweite F. Start: 1000 über der Mitte, Blick senkrecht nach unten, F = 1000 (Draufsicht 1 : 1 zur
	// Fläche). Ende: knapp über dem Boden vor der vordersten Person, Blick nach hinten. Ein einziger weicher Verlauf.
	const D_KAMERA = 3.4;
	// Bahn: Die Kamera kreist um ein Blickziel auf dem Boden, vom Winkel 90° (senkrecht darüber) auf 15° (flach von vorne),
	// der Abstand sinkt von 1000 auf 620, das Blickziel wandert von der Mitte etwas nach hinten (Z 0 auf 150), die
	// Brennweite von 1000 auf 430. So bleibt die vordere Person die ganze Fahrt im Bild (gerechnet 13.11.2026; eine
	// gerade Bahn ließ sie in der Mitte der Fahrt unten aus dem Bild laufen).
	const A0 = Math.PI / 2, R0 = 1000, LZ1 = 150, F0 = 1000;
	// Variante „Augenhöhe“ (Rasul 13.11.2026 abends: „fahr doch nochmal weiter runter mit der Kamera. Bis alle auf einer
	// Linie sind, würde mich interessieren, wie das aussieht.“), Schalter „Höhe“ (html data-hoehe = oben | auge):
	// Kamerahöhe am Ende 49 = Kopfmitte, alle Köpfe auf einer Linie; ohne Horizontlinie. Werte gerechnet: 5,1°, 552, 300.
	const auge = () => document.documentElement.dataset.hoehe === "auge";
	const endWerte = () => (auge() ? { A1: 5.1 * Math.PI / 180, R1: 552, F1: 300 } : { A1: 15 * Math.PI / 180, R1: 620, F1: 430 });
	let F1 = endWerte().F1;
	function bahn(e: number, fEnde = F1) {
		const { A1, R1 } = endWerte();
		const a = A0 + (A1 - A0) * e, R = R0 + (R1 - R0) * e, lz = LZ1 * e;
		const Lk: [number, number] = [0, lz], C: [number, number] = [R * Math.sin(a), lz - R * Math.cos(a)];
		return { C, Lk, F: F0 + (fEnde - F0) * e };
	}
	const glatt = (x: number) => x <= 0 ? 0 : x >= 1 ? 1 : x * x * x * (x * (6 * x - 15) + 10); // Ease-in und Ease-out
	function fahrtKamera(X: number, Z: number, C: [number, number], Lk: [number, number], F: number) {
		const phi = Math.atan2(C[0] - Lk[0], Lk[1] - C[1]);
		const vy = -C[0], vz = Z - C[1];
		const zc = vy * -Math.sin(phi) + vz * Math.cos(phi), yc = vy * Math.cos(phi) + vz * Math.sin(phi);
		return { x: CX + F * X / zc, y: CY - F * yc / zc, g: F / zc, zc, phi };
	}
	// Probe „punkt“ (Rasul 13.11.2026 abends: „ob wir mit Punkten starten können, die dann zu Männchen werden“), danach
	// entschieden: „Zurück zu Figuren“. Grundeinstellung „figur“, „punkt“ bleibt im Schalter.
	const form = () => (document.documentElement.dataset.form === "punkt" ? "punkt" : "figur");
	// Aufstellung, die von oben ungeordnet wirkt und von vorne trägt: einer vorne, zwei dahinter, zwei Reihen, viele hinten
	function personenFahrt(): Person[] {
		const rnd = zufall(23), liste: Person[] = [];
		const halb = RW / 2 - 80;
		const neu = (X: number, Z: number, ebene: number, ein: number): Person => ({ x: CX + X, y: CY - Z, s: 1, ein, zx: 0, zy: 0, bleibt: ebene <= 1, rang: 0, ebene, ex: 0, ey: 0, eg: 1, z: 1, wx: X, wz: Z, tx: X, tz: Z });
		const j = (w: number) => (rnd() - 0.5) * w;
		const spaeter = () => 0.2 + rnd() * (T_GESTE + DAUER - 0.5);
		liste.push(neu(0, -300, 0, rnd() * 0.5), neu(-200 + j(30), -170 + j(30), 1, rnd() * 0.7), neu(200 + j(30), -170 + j(30), 1, rnd() * 0.7));
		const reihe = (n: number, zVon: number, zBis: number, breite: number, ebene: number, ein: () => number) => {
			for (let i = 0; i < n; i++) {
				const X = (n === 1 ? 0 : (i / (n - 1) - 0.5) * 2 * breite) + j((2 * breite) / n * 0.6);
				liste.push(neu(X, zVon + rnd() * (zBis - zVon), ebene, ein()));
			}
		};
		reihe(4, -60, 20, Math.min(450, halb), 2, spaeter);
		reihe(7, 70, 170, halb * 0.85, 2, spaeter);
		reihe(16, 200, 330, halb, 3, spaeter);
		// die späten entstehen hinten an ihrem Platz, wenn die Kamera fast steht
		const spaetVon = T_AUSWAHL + D_KAMERA * 0.7;
		reihe(8, 230, 330, halb * 0.95, 3, () => spaetVon + rnd() * D_KAMERA * 0.15);
		liste.slice(-8).forEach((q) => { q.spaet = true; });
		return liste;
	}

	// Person in derselben Form wie die Augenzeugen-Animationen (Werkstatt augenzeugen-kacheln.js, personPfad):
	// Kopf als Kreis, Schultern als Bogen, Maß in Neunzehnteln der Höhe. Rasul 13.11.2026: „gucken, dass die nachher
	// zusammenpassen, was Formen, Geschwindigkeiten, Erzähltiefe angeht“.
	function zeichnePerson(ctx: CanvasRenderingContext2D, x: number, y: number, g: number, alpha: number) {
		if (alpha <= 0) return;
		const u = (64 * g) / 19;
		ctx.globalAlpha = alpha; ctx.fillStyle = "#000"; ctx.beginPath();
		ctx.moveTo(x + 4.6 * u, y - 5.5 * u); ctx.arc(x, y - 5.5 * u, 4.6 * u, 0, Math.PI * 2);
		ctx.moveTo(x - 8.5 * u, y + 9 * u);
		ctx.bezierCurveTo(x - 8.5 * u, y + 2.5 * u, x - 4.5 * u, y + 0.5 * u, x, y + 0.5 * u);
		ctx.bezierCurveTo(x + 4.5 * u, y + 0.5 * u, x + 8.5 * u, y + 2.5 * u, x + 8.5 * u, y + 9 * u);
		ctx.closePath(); ctx.fill(); ctx.globalAlpha = 1;
	}

	// Unscharfe Personen als vorbereitete Bilder (Messung 13.11.2026: Weichzeichnen jeder Person in jedem Bild kostete bis
	// zu 0,5 s pro Bild und ließ die Animation ruckeln). Je Unschärfe-Stufe wird die Person einmal klein weichgezeichnet und
	// danach nur noch skaliert gesetzt. b = Unschärfe in Personen-Einheiten (Bildschirm-Unschärfe geteilt durch Größe).
	const BILDER = new Map<number, { c: HTMLCanvasElement; pad: number }>();
	const AUF = 3; // Pixel je Einheit im vorbereiteten Bild
	function personBild(b: number) {
		const stufe = b < 4 ? Math.round(b * 2) / 2 : b < 12 ? Math.round(b) : Math.round(b / 2) * 2;
		let e = BILDER.get(stufe);
		if (!e) {
			const pad = stufe * 3 + 2, w = (57.3 + 2 * pad) * AUF, h = (64.4 + 2 * pad) * AUF;
			const c = document.createElement("canvas"); c.width = Math.ceil(w); c.height = Math.ceil(h);
			const x = c.getContext("2d")!; x.filter = `blur(${(stufe * AUF).toFixed(1)}px)`; x.scale(AUF, AUF); // Unschärfe in Bildpixeln
			zeichnePerson(x, 28.65 + pad, 34 + pad, 1, 1);
			e = { c, pad }; BILDER.set(stufe, e);
		}
		return e;
	}
	// Verwandlung Punkt zu Person (Rasul 13.11.2026 abends: „ob wir mit Punkten starten können, die dann zu Männchen werden“):
	// Der Punkt auf dem Boden wird zum Kopf und hebt sich an seinen Platz, die Schultern wachsen unter ihm heraus.
	// p = 0 Punkt, p = 1 fertige Person. fy = Bodenpunkt, y = Mitte der fertigen Person.
	function zeichneVerwandlung(ctx: CanvasRenderingContext2D, x: number, fy: number, y: number, g: number, alpha: number, p: number) {
		if (alpha <= 0) return;
		const u = (64 * g) / 19, rPunkt = 13 * g;
		const kx = x, ky = fy + (y - 5.5 * u - fy) * p, kr = rPunkt + (4.6 * u - rPunkt) * p;
		ctx.globalAlpha = alpha; ctx.fillStyle = "#000"; ctx.beginPath();
		ctx.moveTo(kx + kr, ky); ctx.arc(kx, ky, kr, 0, Math.PI * 2);
		if (p > 0.02) {
			// Schultern wachsen aus dem Hals: Breite und Höhe mit p
			const hx = x, hy = ky + kr + 1.4 * u * p, b = 8.5 * u * p, h = 8.5 * u * p; // Hals unter dem Kopf, bei p = 1 genau wie die Person
			ctx.moveTo(hx - b, hy + h);
			ctx.bezierCurveTo(hx - b, hy + h * 0.24, hx - b * 0.53, hy, hx, hy);
			ctx.bezierCurveTo(hx + b * 0.53, hy, hx + b, hy + h * 0.24, hx + b, hy + h);
			ctx.closePath();
		}
		ctx.fill(); ctx.globalAlpha = 1;
	}
	function zeichneUnscharf(ctx: CanvasRenderingContext2D, x: number, y: number, g: number, alpha: number, unsch: number) {
		if (alpha <= 0) return;
		const b = unsch / Math.max(0.05, g);
		if (b < 0.25) { zeichnePerson(ctx, x, y, g, alpha); return; }
		const { c, pad } = personBild(b);
		ctx.globalAlpha = alpha;
		ctx.drawImage(c, x - (28.65 + pad) * g, y - (34 + pad) * g, (c.width / AUF) * g, (c.height / AUF) * g);
		ctx.globalAlpha = 1;
	}

	function experten() {
		document.querySelectorAll<HTMLElement>("[data-experten]").forEach((fig) => {
			if (fig.dataset.bereit) return; fig.dataset.bereit = "1";
			const cv = fig.querySelector("canvas")!, ctx = cv.getContext("2d")!;
			const off = document.createElement("canvas"), octx = off.getContext("2d")!;
			// Leuchten auf einer Viertel-Fläche weichzeichnen (statt über die volle Fläche in jedem Bild)
			const glut = document.createElement("canvas"), gctx = glut.getContext("2d")!;
			let leuteFlach = personen(), leuteRaum = personenKamera();
			let leute = leuteFlach, zoomEnde = 1;
			let start = -1, spurR: Spur = [], spurL: Spur = [], lauf = 0;
			const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

			const groesse = () => {
				const r = cv.getBoundingClientRect(), d = window.devicePixelRatio || 1;
				cv.width = off.width = Math.max(1, Math.round(r.width * d)); cv.height = off.height = Math.max(1, Math.round(r.height * d));
				glut.width = Math.max(1, Math.round(cv.width / 4)); glut.height = Math.max(1, Math.round(cv.height / 4));
				// Rahmen und Personen passend zur Fläche neu legen
				const breite = cv.width / (cv.height / H);
				rahmen(breite); leuteFlach = personen(); leuteRaum = personenFahrt();
				// Am Ende darf niemand abgeschnitten sein: falls nötig zoomt die Kamera mit der Fahrt etwas heraus (Brennweite),
				// statt Personen seitlich zu verschieben
				const halbe = breite / 2 - 70;
				let weit = 0;
				F1 = endWerte().F1;
				const ende1 = bahn(1);
				for (const q of leuteRaum) { const p = fahrtKamera(q.wx, q.wz, ende1.C, ende1.Lk, ende1.F); weit = Math.max(weit, Math.abs(p.x - CX) + 30 * p.g); }
				zoomEnde = Math.min(1, halbe / Math.max(1, weit));
			};

			const spur = (s: Spur, w: ReturnType<typeof halbweg>, jetzt: number) => {
				octx.lineCap = "round"; octx.lineJoin = "round"; octx.lineWidth = DICKE;
				const schritt = 3 / w.ges;
				for (let i = 1; i < s.length; i++) {
					const [s0, t0] = s[i - 1], [s1, t1] = s[i];
					const n = Math.max(1, Math.ceil((s1 - s0) / schritt));
					if (1 - (jetzt - t1) / GLIMM <= 0) continue; // dieses Stück ist ganz verglüht
					let vorher: [number, number] | null = null;
					for (let j = 1; j <= n; j++) {
						const f = j / n, tt = t0 + (t1 - t0) * f;
						const a = Math.max(0, Math.min(1, 1 - (jetzt - tt) / GLIMM));
						if (a <= 0) { vorher = null; continue; }
						if (!vorher) vorher = punkt(w, s0 + (s1 - s0) * (j - 1) / n);
						const jetztP = punkt(w, s0 + (s1 - s0) * f);
						{
							const v = Math.round(255 * Math.pow(a, 1.6));
							octx.strokeStyle = `rgb(${v},${v},${v})`;
							octx.beginPath(); octx.moveTo(vorher[0], vorher[1]); octx.lineTo(jetztP[0], jetztP[1]); octx.stroke();
						}
						vorher = jetztP;
					}
				}
			};

			const bild = (t: number, jetzt: number) => {
				leute = ende() === "kamera" ? leuteRaum : leuteFlach;
				const sc = cv.height / H, ox = (cv.width - W * sc) / 2; // Fläche 1600 × 900 mittig, breiter Rand links und rechts
				ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.globalCompositeOperation = "source-over"; ctx.filter = "none"; ctx.globalAlpha = 1;
				ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, cv.width, cv.height);
				// Spur nur rechnen, solange sie zu sehen ist
				if (t >= T_GESTE - 0.25 && t <= T_GESTE + DAUER + GLIMM + 0.45) {
				// Spur auf eigener Ebene: schwarz mit weißer Leuchtspur (Maximum), dann per „difference“ auf Weiß = dunkle Spur
				octx.setTransform(1, 0, 0, 1, 0, 0); octx.globalCompositeOperation = "source-over";
				octx.fillStyle = "#000"; octx.fillRect(0, 0, off.width, off.height);
				octx.setTransform(sc, 0, 0, sc, ox, 0); octx.globalCompositeOperation = "lighten";
				let s = 0, deck = 0;
				if (t >= T_GESTE - 0.25 && t < T_GESTE) deck = (t - T_GESTE + 0.25) / 0.25;
				else if (t >= T_GESTE && t < T_GESTE + DAUER) { s = kubisch((t - T_GESTE) / DAUER); deck = 1; }
				else if (t >= T_GESTE + DAUER) { s = 1; deck = Math.max(0, 1 - (t - T_GESTE - DAUER) / 0.4); }
				const pr = punkt(WEG_R, s), pl = punkt(WEG_L, s);
				if (t >= T_GESTE && t <= T_GESTE + DAUER + 0.05) { spurR.push([s, jetzt]); spurL.push([s, jetzt]); }
				spur(spurR, WEG_R, jetzt); spur(spurL, WEG_L, jetzt);
				if (deck > 0) {
					const v = Math.round(255 * deck); octx.fillStyle = `rgb(${v},${v},${v})`;
					[pr, pl].forEach(([x, y]) => { octx.beginPath(); octx.arc(x, y, DICKE / 2, 0, Math.PI * 2); octx.fill(); });
				}
				gctx.setTransform(1, 0, 0, 1, 0, 0); gctx.filter = "none"; gctx.clearRect(0, 0, glut.width, glut.height);
				gctx.filter = `blur(${(DICKE * 0.7 * sc / 4).toFixed(1)}px)`; gctx.drawImage(off, 0, 0, glut.width, glut.height);
				ctx.globalCompositeOperation = "difference";
				ctx.globalAlpha = 0.5; ctx.drawImage(glut, 0, 0, cv.width, cv.height);
				ctx.globalAlpha = 1; ctx.drawImage(off, 0, 0);
				ctx.globalCompositeOperation = "source-over";
				}
				// Personen
				ctx.setTransform(sc, 0, 0, sc, ox, 0);
				const k = weich((t - T_AUSWAHL) / D_AUSWAHL);
				if (ende() === "kamera") {
					// Kamerafahrt: Personen stehen fest, nur die Kamera bewegt sich (Position, Blickziel, Brennweite gemeinsam)
					const e = glatt(anteil(t, T_AUSWAHL, D_KAMERA));
					const { C, Lk, F } = bahn(e, F1 * zoomEnde);
					const punkte = form() === "punkt";
					const lage = leute.map((q) => {
						const pr = fahrtKamera(q.wx, q.wz, C, Lk, F);
						const kipp = 1 - pr.phi / (Math.PI / 2); // 0 = von oben, nahe 1 = von vorne
						const u = (64 * q.s * pr.g) / 19;
						return { q, x: pr.x, y: pr.y - 9 * u * Math.min(1, kipp * 1.15), g: q.s * pr.g, zc: pr.zc, kipp, fy: pr.y };
					}).sort((a, b) => b.zc - a.zc);
					// Rasul 13.11.2026 abends: „die sind jetzt schon im Hintergrund und werden kurz scharf und dann unscharf. Das
					// stimmt von der Perspektivenwirkung der Kamera dann nicht mehr.“ Deshalb: Verwandlung ganz am Anfang des
					// Kippens (Kamera fast senkrecht, alle etwa gleich weit weg) und Unschärfe aus der Entfernung:
					// Schärfe wie bei einem Objektiv: scharfgestellt ist die vordere Person; Unschärfe und Blässe wachsen mit dem
					// Abstand hinter ihr (Zerstreuungskreis ~ F · (1/zFokus − 1/z)). Von oben sind alle gleich weit weg, also
					// scharf; mit dem Kippen entsteht die Tiefe und mit ihr die Unschärfe, in jedem Moment passend.
					const fokus = lage.find((l) => l.q.ebene === 0)?.zc ?? lage[lage.length - 1].zc;
					const F_jetzt = F;
					for (const { q, x, y, g, kipp, fy, zc } of lage) {
						const ein = weich((t - q.ein) / 0.5);
						const tiefe = Math.max(0, 1 - fokus / zc); // 0 = auf der Schärfeebene
						const unsch = 8 * F_jetzt * Math.max(0, 1 / fokus - 1 / zc);
						const alpha = ein * (0.85 + 0.15 * e) * (1 - 0.95 * tiefe);
						if (punkte) {
							// Variante: von oben Punkte, mit dem Kippen werden sie zu Personen (Kopf hebt sich, Schultern wachsen)
							const p = sanft(anteil(kipp, 0.01, 0.17));
							if (p < 1) zeichneVerwandlung(ctx, x, fy, y, g, alpha, p);
							else zeichneUnscharf(ctx, x, y, g, alpha, unsch);
						} else zeichneUnscharf(ctx, x, y, g, alpha, unsch);
					}
					return;
				}
				if (ende() === "ebenen") {
					// Vier Ebenen statt Verschwinden (Rasul 13.11.2026 abends: „dass gar keine verschwinden, sondern dass sie alle
					// noch weiter in den Hintergrund gehen … ein vorne, auf der nächsten Ebene diese beiden und dann vielleicht
					// nochmal eine dritte und eine vierte Ebene“). Unschärfe wirkt als Tiefe nur zusammen mit anderen Tiefenzeichen
					// (Held, Cooper, O'Brien, Banks 2010): je Ebene unschärfer, kleiner und heller (Luftperspektive).
					// Ebene: [Größe, Unschärfe in Flächeneinheiten, Deckkraft]
					// Ebene: [–, Unschärfe in Flächeneinheiten, Deckkraft]; Größe und Lage kommen aus der Perspektive (ex, ey, eg)
					const STUFE: [number, number, number][] = [[0, 0, 1], [0, 5, 0.7], [0, 11, 0.4], [0, 18, 0.22]];
					const f = weich((t - T_FOKUS) / D_FOKUS);
					const sortiert = [...leute].sort((a, b) => b.z - a.z); // hinten zuerst, vorne zuletzt
					for (const q of sortiert) {
						const ein = weich((t - q.ein) / 0.5);
						const [, b1, a1] = STUFE[q.ebene];
						const m = q.ebene >= 2 ? k : q.ebene === 1 ? f : 0; // Unschärfe: Ebene 2/3 mit der Auswahl, Ebene 1 im Fokus-Schritt
						const x = q.x + (q.ex - q.x) * k, y = q.y + (q.ey - q.y) * k;
						const g = q.s + (q.eg - q.s) * k;
						const alpha = ein * (q.ebene <= 1 ? (0.85 + 0.15 * k) * (1 - (1 - a1) * m) : 0.85 * (1 - (1 - a1 / 0.85) * m));
						const unsch = b1 * m;
						zeichneUnscharf(ctx, x, y, g, alpha, unsch);
					}
					return;
				}
				for (const q of leute) {
					const ein = weich((t - q.ein) / 0.5);
					if (q.bleibt) {
						const x = q.x + (q.zx - q.x) * k, y = q.y + (q.zy - q.y) * k, g = q.s + (GROSS - q.s) * k;
						const f = q.rang === 1 ? 0 : weich((t - T_FOKUS) / D_FOKUS), e = ende();
						const alpha = ein * (0.85 + 0.15 * k);
						if (e === "eins") zeichnePerson(ctx, x, y, g, alpha * (1 - f));
						else if (e === "grau") zeichnePerson(ctx, x, y, g, alpha * (1 - 0.8 * f));
						else if (e === "unscharf" && f > 0) {
							zeichneUnscharf(ctx, x, y, g, alpha * (1 - 0.35 * f), 14 * f);
						} else zeichnePerson(ctx, x, y, g, alpha);
					} else {
						zeichnePerson(ctx, q.x, q.y, q.s, ein * 0.85 * (1 - weich((t - T_AUSWAHL + 0.3) / 0.8)));
					}
				}
			};

			const schritt = () => {
				const jetzt = performance.now() / 1000, t = jetzt - start;
				bild(t, jetzt);
				if (t < ENDE + GLIMM) lauf = requestAnimationFrame(schritt);
				else fig.dataset.fertig = "";
			};
			const spiele = () => {
				cancelAnimationFrame(lauf); groesse(); delete fig.dataset.fertig;
				spurR = []; spurL = [];
				if (still) { bild(ENDE + 5, 0); fig.dataset.fertig = ""; return; }
				start = performance.now() / 1000; lauf = requestAnimationFrame(schritt);
			};
			groesse(); bild(0, 0);
			const beob = new IntersectionObserver((e) => { if (e[0].isIntersecting) { beob.disconnect(); spiele(); } }, { threshold: 0.5 });
			beob.observe(fig);
			fig.addEventListener("click", spiele);
			window.addEventListener("resize", () => { if (fig.dataset.fertig !== undefined) { spurR = []; spurL = []; groesse(); bild(ENDE + 5, 0); } });
		});
	}
	document.addEventListener("astro:page-load", experten);
</script>
