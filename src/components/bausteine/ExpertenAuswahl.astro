				F1 = endWerte().F1;
				// Ranfahrt aus der Bildregel (Rasul 13.11.2026 abends: „das Männchen muss am Ende größer sein, das heißt, die
				// Kamera muss näher an die Person ran. Mach's mal so nah, dass der angeschnittene Körper von dem Männchen am
				// unteren Bildrand aufsetzt.“): Augenlinie (Kopfmitte, 14,5 Teile über der Unterkante der Figur) auf der oberen
				// Drittellinie, Unterkante der Figur auf der Unterkante des 16:9-Rahmens, also Figur von Augen bis Unterkante
				// zwei Drittel der Rahmenhöhe. Gesucht wird der Weg RAN_Z, bei dem die vordere Person diese Größe hat.
				const vorneP = leuteRaum.find((q) => q.ebene === 0);
				const gZiel = ((2 / 3) * RH) / ((14.5 * 64) / 19);
				const loese = (fEnde: number) => {
					if (!vorneP) return;
					let lo = 0, hi = 600;
					for (let i = 0; i < 40; i++) {
						const mid = (lo + hi) / 2; RAN_Z = mid;
						const b = bahn(1, fEnde, 1), p = fahrtKamera(vorneP.wx, vorneP.wz, b.C, b.Lk, b.F);
						if (p.zc > 1 && p.g < gZiel) lo = mid; else hi = mid;
					}
					RAN_Z = lo;
				};
				loese(F1);
				// Einpassen in die Breite nur für die hinteren Reihen: Die Nahen dürfen angeschnitten sein wie bei einer Kamera
				let weit = 0;
				const ende0 = bahn(1, F1, 1);
				for (const q of leuteRaum) { if (q.ebene < 2) continue; const p = fahrtKamera(q.wx, q.wz, ende0.C, ende0.Lk, ende0.F); if (p.zc > 1) weit = Math.max(weit, Math.abs(p.x - CX) + 30 * p.g); }
				zoomEnde = Math.min(1, halbe / Math.max(1, weit));
				if (zoomEnde < 1) loese(F1 * zoomEnde);
				const ende1 = bahn(1, F1, 1);
				// Bildausschnitt am Ende wie bei unseren Interviews (Rasul 13.11.2026 abends: „wenn ich Kameramann wäre und den
				// 16:9-Frame mir vorstelle, dann habe ich das Gefühl, würde die Person zu tief im Bild sitzen … im Endeffekt
				// setzen wir ja auch in unseren Videos die Leute in eine gewisse Position“): Der Kopf der vorderen Person liegt
				// am Ende auf der oberen Drittellinie des 16:9-Rahmens. Umgesetzt als Verschiebung des Bildausschnitts (wie ein
				// Shift-Objektiv), die Perspektive bleibt gleich; sie wächst mit der Fahrt.
				{
					const vorne = leuteRaum.find((q) => q.ebene === 0);
					if (vorne) {
						const p = fahrtKamera(vorne.wx, vorne.wz, ende1.C, ende1.Lk, F1 * zoomEnde);
						const kopf = p.y - 14.5 * (64 * p.g) / 19;
						hebung = kopf - (T + RH / 3);
					}
				}
			};

			const spur = (s: Spur, w: ReturnType<typeof halbweg>, jetzt: number) => {
				octx.lineCap = "round"; octx.lineJoin = "round"; octx.lineWidth = DICKE;
				const schritt = 3 / w.ges;
				for (let i = 1; i < s.length; i++) {
					const [s0, t0] = s[i - 1], [s1, t1] = s[i];
					const n = Math.max(1, Math.ceil((s1 - s0) / schritt));
					if (1 - (jetzt - t1) / GLIMM <= 0) continue; // dieses Stück ist ganz verglüht
					let vorher: [number, number] | null = null;
					for (let j = 1; j <= n; j++) {
						const f = j / n, tt = t0 + (t1 - t0) * f;
						const a = Math.max(0, Math.min(1, 1 - (jetzt - tt) / GLIMM));
						if (a <= 0) { vorher = null; continue; }
						if (!vorher) vorher = punkt(w, s0 + (s1 - s0) * (j - 1) / n);
						const jetztP = punkt(w, s0 + (s1 - s0) * f);
						{
							const v = Math.round(255 * Math.pow(a, 1.6));
							octx.strokeStyle = `rgb(${v},${v},${v})`;
							octx.beginPath(); octx.moveTo(vorher[0], vorher[1]); octx.lineTo(jetztP[0], jetztP[1]); octx.stroke();
						}
						vorher = jetztP;
					}
				}
			};

			// Verlauf der Kamerafahrt (Rasul 13.11.2026 abends: „Am Ende ist sie zu schnell. Da fehlt ihr das Ease-in.“).
			// Gemessen: Auf den letzten 10 % des Wegs wächst die vordere Person noch fast aufs Dreifache (Größe ~ 1/Abstand),
			// ein gleichmäßig auslaufender Weg wirkt deshalb am Ende trotzdem schnell. Darum läuft die Fahrt überwiegend nach
			// der sichtbaren Größe der vorderen Person: deren Größe folgt im Verhältnis (wie ein Zoom, jede Verdopplung gleich
			// lang) dem weichen Verlauf glatt, mit 15 % Anteil des gleichmäßigen Wegs, damit das Kippen nicht zu früh fertig ist.
			// Ergebnis: Kippen und Herunterfahren vor allem in der ersten Hälfte, die Ranfahrt läuft weich aus.
			// s = Fortschritt der Geste: Mittel aus Weg (Kippen) und Größe (Ranfahrt), so folgt die Geste der Bewegung.
			const groesseVorne = (e: number) => {
				const q = leuteRaum.find((x) => x.ebene === 0); if (!q) return 1;
				const b = bahn(e, F1 * zoomEnde, e); return fahrtKamera(q.wx, q.wz, b.C, b.Lk, b.F).g;
			};
			const verlauf = (t: number) => {
				const tz = weichKubisch(anteil(t, T_GESTE, D_KAMERA));
				if (tz <= 0 || tz >= 1) return { e: tz, s: tz };
				const L = Math.log(Math.max(1.001, groesseVorne(1))), ziel = tz * L;
				let lo = 0, hi = 1;
				for (let i = 0; i < 24; i++) { const m = (lo + hi) / 2; if (Math.log(groesseVorne(m)) < ziel) lo = m; else hi = m; }
				const e = 0.15 * tz + 0.85 * lo;
				return { e, s: 0.5 * (e + Math.log(groesseVorne(e)) / L) };
			};
			const bild = (t: number, jetzt: number) => {
				leute = ende() === "kamera" ? leuteRaum : leuteFlach;
				const sc = cv.height / H, ox = (cv.width - W * sc) / 2; // Fläche 1600 × 900 mittig, breiter Rand links und rechts
				ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.globalCompositeOperation = "source-over"; ctx.filter = "none"; ctx.globalAlpha = 1;
				ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, cv.width, cv.height);
				// Spur nur rechnen, solange sie zu sehen ist
				// Geste im Takt der Kamera (Rasul 13.11.2026 abends: „Wir koordinieren das Zeichnen von dem Videobeweissymbol mit
				// der Zoomfahrt … wie die Striche entstehen, richtet sich an der Bewegungsgeschwindigkeit von der Kamera, also mit
				// an dem Zoom-in, Zoom-out und an der Länge“): Beim Ende „kamera“ beginnen Geste und Fahrt gleichzeitig, dauern
				// gleich lang und folgen demselben Verlauf (glatt). Vorher: Geste 1,6 s, Fahrt erst danach.
				const kam = ende() === "kamera", gDauer = kam ? D_KAMERA : DAUER;
				if (t >= T_GESTE && t <= T_GESTE + gDauer + GLIMM + 0.45) {
				// Spur auf eigener Ebene: schwarz mit weißer Leuchtspur (Maximum), dann per „difference“ auf Weiß = dunkle Spur
				octx.setTransform(1, 0, 0, 1, 0, 0); octx.globalCompositeOperation = "source-over";
				octx.fillStyle = "#000"; octx.fillRect(0, 0, off.width, off.height);
				octx.setTransform(sc, 0, 0, sc, ox, 0); octx.globalCompositeOperation = "lighten";
				let s = 0, deck = 0;
				if (t >= T_GESTE && t < T_GESTE + gDauer) { const x = (t - T_GESTE) / gDauer; s = kam ? verlauf(t).s : kubisch(x); deck = sanft(Math.min(1, (t - T_GESTE) / D_FINGER)); }
				else if (t >= T_GESTE + gDauer) { s = 1; deck = Math.max(0, 1 - (t - T_GESTE - gDauer) / 0.4); }
				const pr = punkt(WEG_R, s), pl = punkt(WEG_L, s);
				if (t >= T_GESTE && t <= T_GESTE + gDauer + 0.05) { spurR.push([s, jetzt]); spurL.push([s, jetzt]); }
				spur(spurR, WEG_R, jetzt); spur(spurL, WEG_L, jetzt);
				if (deck > 0) {
					const v = Math.round(255 * deck); octx.fillStyle = `rgb(${v},${v},${v})`;
					[pr, pl].forEach(([x, y]) => { octx.beginPath(); octx.arc(x, y, DICKE / 2, 0, Math.PI * 2); octx.fill(); });
				}
				gctx.setTransform(1, 0, 0, 1, 0, 0); gctx.filter = "none"; gctx.clearRect(0, 0, glut.width, glut.height);
				gctx.filter = `blur(${(DICKE * 0.7 * sc / 4).toFixed(1)}px)`; gctx.drawImage(off, 0, 0, glut.width, glut.height);
				ctx.globalCompositeOperation = "difference";
				ctx.globalAlpha = 0.5; ctx.drawImage(glut, 0, 0, cv.width, cv.height);
				ctx.globalAlpha = 1; ctx.drawImage(off, 0, 0);
				ctx.globalCompositeOperation = "source-over";
				}
				// Personen
				ctx.setTransform(sc, 0, 0, sc, ox, 0);
				const k = weich((t - T_AUSWAHL) / D_AUSWAHL);
				if (ende() === "kamera") {
					// Kamerafahrt: Personen stehen fest, nur die Kamera bewegt sich (Position, Blickziel, Brennweite gemeinsam)
					const e = verlauf(t).e, ran = e; // Verlauf und Gründe siehe verlauf()
					const { C, Lk, F } = bahn(e, F1 * zoomEnde, ran);
					if (import.meta.env.DEV) (fig as any).__vorne = groesseVorne(e);
					const punkte = form() === "punkt";
					const lage = leute.map((q) => {
						const pr = fahrtKamera(q.wx, q.wz, C, Lk, F);
						const kipp = 1 - pr.phi / (Math.PI / 2); // 0 = von oben, nahe 1 = von vorne
						const u = (64 * q.s * pr.g) / 19;
						const hoch = hebung * e; // Bildausschnitt wandert mit der Fahrt nach oben (Kopf auf die obere Drittellinie)
						return { q, x: pr.x, y: pr.y - 9 * u * Math.min(1, kipp * 1.15) - hoch, g: q.s * pr.g, zc: pr.zc, kipp, fy: pr.y - hoch };
					}).filter((l) => l.zc > 5).sort((a, b) => b.zc - a.zc); // nichts hinter der Kamera zeichnen
					// Rasul 13.11.2026 abends: „die sind jetzt schon im Hintergrund und werden kurz scharf und dann unscharf. Das
					// stimmt von der Perspektivenwirkung der Kamera dann nicht mehr.“ Deshalb: Verwandlung ganz am Anfang des
					// Kippens (Kamera fast senkrecht, alle etwa gleich weit weg) und Unschärfe aus der Entfernung:
					// Schärfe wie bei einem Objektiv: scharfgestellt ist die vordere Person; Unschärfe und Blässe wachsen mit dem
					// Abstand hinter ihr (Zerstreuungskreis ~ F · (1/zFokus − 1/z)). Von oben sind alle gleich weit weg, also
					// scharf; mit dem Kippen entsteht die Tiefe und mit ihr die Unschärfe, in jedem Moment passend.
					const fokus = lage.find((l) => l.q.ebene === 0)?.zc ?? lage[lage.length - 1].zc;
					const F_jetzt = F;
					for (const { q, x, y, g, kipp, fy, zc } of lage) {
						const ein = weich((t - q.ein) / 0.5);
						const tiefe = Math.max(0, 1 - fokus / zc); // 0 = auf der Schärfeebene
						// sanfter abgestuft (Rasul 13.11.2026 abends: „Das ist jetzt sehr geblurrt alles im Hintergrund“): Faktor 2,5
						// statt 8 (die Ranfahrt vergrößert das Verhältnis vorne zu hinten, deshalb so stark zurückgenommen)
						const unsch = 2.5 * F_jetzt * Math.max(0, 1 / fokus - 1 / zc);
						const alpha = ein * (0.85 + 0.15 * e) * (1 - 0.6 * tiefe);
						if (punkte) {
							// Variante: von oben Punkte, mit dem Kippen werden sie zu Personen (Kopf hebt sich, Schultern wachsen)
							const p = sanft(anteil(kipp, 0.01, 0.17));
							if (p < 1) zeichneVerwandlung(ctx, x, fy, y, g, alpha, p);
							else zeichneUnscharf(ctx, x, y, g, alpha, unsch, ein);
						} else zeichneUnscharf(ctx, x, y, g, alpha, unsch, ein);
					}
					raster(ctx);
					return;
				}
				if (ende() === "ebenen") {
					// Vier Ebenen statt Verschwinden (Rasul 13.11.2026 abends: „dass gar keine verschwinden, sondern dass sie alle
					// noch weiter in den Hintergrund gehen … ein vorne, auf der nächsten Ebene diese beiden und dann vielleicht
					// nochmal eine dritte und eine vierte Ebene“). Unschärfe wirkt als Tiefe nur zusammen mit anderen Tiefenzeichen
					// (Held, Cooper, O'Brien, Banks 2010): je Ebene unschärfer, kleiner und heller (Luftperspektive).
					// Ebene: [Größe, Unschärfe in Flächeneinheiten, Deckkraft]
					// Ebene: [–, Unschärfe in Flächeneinheiten, Deckkraft]; Größe und Lage kommen aus der Perspektive (ex, ey, eg)
					const STUFE: [number, number, number][] = [[0, 0, 1], [0, 5, 0.7], [0, 11, 0.4], [0, 18, 0.22]];
					const f = weich((t - T_FOKUS) / D_FOKUS);
					const sortiert = [...leute].sort((a, b) => b.z - a.z); // hinten zuerst, vorne zuletzt
					for (const q of sortiert) {
						const ein = weich((t - q.ein) / 0.5);
						const [, b1, a1] = STUFE[q.ebene];
						const m = q.ebene >= 2 ? k : q.ebene === 1 ? f : 0; // Unschärfe: Ebene 2/3 mit der Auswahl, Ebene 1 im Fokus-Schritt
						const x = q.x + (q.ex - q.x) * k, y = q.y + (q.ey - q.y) * k;
						const g = q.s + (q.eg - q.s) * k;
						const alpha = ein * (q.ebene <= 1 ? (0.85 + 0.15 * k) * (1 - (1 - a1) * m) : 0.85 * (1 - (1 - a1 / 0.85) * m));
						const unsch = b1 * m;
						zeichneUnscharf(ctx, x, y, g, alpha, unsch);
					}
					return;
				}
				for (const q of leute) {
					const ein = weich((t - q.ein) / 0.5);
					if (q.bleibt) {
						const x = q.x + (q.zx - q.x) * k, y = q.y + (q.zy - q.y) * k, g = q.s + (GROSS - q.s) * k;
						const f = q.rang === 1 ? 0 : weich((t - T_FOKUS) / D_FOKUS), e = ende();
						const alpha = ein * (0.85 + 0.15 * k);
						if (e === "eins") zeichnePerson(ctx, x, y, g, alpha * (1 - f));
						else if (e === "grau") zeichnePerson(ctx, x, y, g, alpha * (1 - 0.8 * f));
						else if (e === "unscharf" && f > 0) {
							zeichneUnscharf(ctx, x, y, g, alpha * (1 - 0.35 * f), 14 * f);
						} else zeichnePerson(ctx, x, y, g, alpha);
					} else {
						zeichnePerson(ctx, q.x, q.y, q.s, ein * 0.85 * (1 - weich((t - T_AUSWAHL + 0.3) / 0.8)));
					}
				}
			};

			// Phase für den Nachsatz unter der Animation: „warten“ bis zur Geste, dann „geste“ (auch am Band, für die Stilregel)
			const bandPhase = fig.closest<HTMLElement>(".anlass--band");
			const phase = (w: string) => { fig.dataset.phase = w; if (bandPhase) bandPhase.dataset.phase = w; };
			phase("warten");
			// eigene Uhr, damit die Animation bei T_PAUSE anhalten kann
			let uhr = 0, zuletzt = 0, freigabe = false, haelt = false;
			const schritt = () => {
				const jetzt = performance.now() / 1000;
				uhr += Math.min(0.1, jetzt - zuletzt); zuletzt = jetzt;
				if (uhr >= T_PAUSE && !freigabe) {
					// erster Abschnitt fertig: anhalten, bis weiter gescrollt wird
					uhr = T_PAUSE; bild(uhr, jetzt); haelt = true; return;
				}
				if (uhr >= T_TEXT && fig.dataset.phase !== "geste") phase("geste"); // Nachsatz einblenden, überlappend mit den letzten Personen
				bild(uhr, jetzt);
				const schluss = ende() === "kamera" ? T_GESTE + D_KAMERA + 0.6 : ENDE; // Kamera: kurz nach dem Stillstand fertig
				if (uhr < schluss + GLIMM) lauf = requestAnimationFrame(schritt);
				else fig.dataset.fertig = "";
			};
			const weiter = () => { if (haelt) { haelt = false; zuletzt = performance.now() / 1000; lauf = requestAnimationFrame(schritt); } };
			let gestartet = false, pausiert = false, pauseSeit = 0;
			const spiele = () => {
				cancelAnimationFrame(lauf); groesse(); delete fig.dataset.fertig; haelt = false; pausiert = false; gestartet = true;
				spurR = []; spurL = [];
				if (still) { bild(ENDE + 5, 0); fig.dataset.fertig = ""; phase("geste"); return; }
				phase("warten");
				start = performance.now() / 1000; uhr = 0; zuletzt = start; lauf = requestAnimationFrame(schritt);
			};
			groesse(); bild(0, 0);
			// Start erst, wenn die ganze Gruppe im Bild ist (Rasul 13.11.2026 abends: „die Animation startet zu früh … ab einem
			// gewissen Punkt soll die starten“): Der Nachsatz unter der Animation muss vollständig sichtbar sein; ohne
			// Nachsatz 90 % der Animation.
			// Danach (Rasul 13.11.2026 abends): „in dem Moment, wo man den Text sieht beim Scrollen, fängt die Animation an“
			// → Auslöser ist „Überall Experten.“ unter der Animation, sobald vollständig sichtbar.
			// Danach (Rasul 13.11.2026 abends): „Sobald der so weit reingescrollt ist, dass sich die beiden anderen Zeilen unten
			// drunter auch lesen könnte, dann geht die Animation los. Man sieht aber die beiden Zeilen noch nicht.“ → Auslöser ist
			// der (noch unsichtbare) Nachsatz, sobald sein Platz vollständig im Bild ist.
			// Zwei Auslöser: Start, wenn „Überall Experten.“ erscheint (zu 60 % sichtbar); Freigabe für den zweiten Abschnitt,
			// wenn der Platz des Nachsatzes vollständig im Bild ist. Ohne diese Zeilen: Start bei 90 % der Animation, frei.
			const bandA = fig.closest(".anlass--band");
			const nachsatz = bandA?.querySelector(".anlass__nachsatz");
			// Ohne Zweiteilung (Rasul 14.11.2026: „wir machen mal die Zweiteilung weg, wir lassen es bei 50 und die Animation
			// startet, wenn die unterste Zeile über diese 20 Prozent drüber ist, also die BBH-Regel“): Die Animation läuft ohne
			// Halt durch (Personen, dann Nachsatz mit Fingerpunkten, Geste, Kamerafahrt). Vorher: Halt nach den Personen bis zur
			// Freigabe durch den Nachsatz (Git-Geschichte).
			freigabe = true;
			// früher (Rasul 13.11.2026 abends: „jetzt kann die Animation ein bisschen früher anfangen. Also wenn unten der Text
			// erscheint … dann könnten oben schon die Punkte erscheinen“): Start, sobald „Überall Experten.“ unten ins Bild kommt
			// noch früher (Rasul 13.11.2026 abends: „zeig mal die Punkte in dem Moment, wo du unten auch den Text zeigst. Die
			// geht jetzt deutlich zu spät los“): Start, sobald ein Drittel der Animation im Bild ist, nicht erst mit der Zeile
			// Start nach der BBH-Regel: sobald die Oberkante des Nachsatzes (unterste Zeilen der Überschrift) die Linie 20 % über
			// der Fensterunterkante erreicht, genau wie BBHs Zeilen-Blende (Schwelle 0). Erst „ganz über der Linie“ (Schwelle 1)
			// war zu spät (Rasul 14.11.2026 bei 1008 px Fensterhöhe: „Eigentlich müsste die Animation jetzt starten, oder?“;
			// gemessen: Oberkante 664 px, Unterkante 840 px, Linie bei 806 px). Ohne Nachsatz: 90 % der Animation im Bild. Bleibt scharf, weil sie sich zurücksetzen kann.
			const beob = new IntersectionObserver((e) => { if (!gestartet && e.some((x) => x.isIntersecting)) spiele(); },
				nachsatz ? { rootMargin: "0px 0px -20% 0px", threshold: 0 } : { threshold: 0.9 });
			beob.observe(nachsatz ?? fig);
			if (import.meta.env.DEV) (fig as any).__freigabe = () => { freigabe = true; weiter(); }; // nur lokal, zum Prüfen
			// Rein- und Rausscrollen (Rasul 14.11.2026: „Ja, so bauen“, Vorschlag Claude nach BBH, Analyse
			// research/BBH_Website_Analyse_2026-11/C_Bewegung_Interaktion.md 3.4 und 4.1):
			// 1. Rausgescrollt, bevor sie fertig ist: Sie hält an und läuft beim Zurückkommen an derselben Stelle weiter
			//    (BBH-Regel für Videos).
			// 2. Nach unten weitergescrollt und wieder hoch: Das Schlussbild bleibt stehen (wer zurückblättert, will nachlesen).
			// 3. Ganz nach oben zurück, über das Band hinaus (Animation liegt unterhalb des Fensters): Sie setzt sich auf den
			//    Anfang zurück und spielt beim nächsten Herunterscrollen neu (wie BBHs Unterschrift, die sich neu schreibt).
			// 4. „Noch einmal“ bleibt, für alle, die die Fahrt bewusst noch einmal sehen wollen (Abweichung von BBH).
			const zuruecksetzen = () => {
				cancelAnimationFrame(lauf); gestartet = false; pausiert = false; haelt = false; freigabe = true;
				uhr = 0; spurR = []; spurL = []; delete fig.dataset.fertig; phase("warten"); groesse(); bild(0, 0);
			};
			const sicht = new IntersectionObserver((e) => {
				const x = e[e.length - 1];
				if (x.isIntersecting) {
					if (pausiert) {
						// Leuchtspur hängt an der Uhrzeit: um die Pause verschieben, sonst wäre sie beim Weiterlaufen verglüht
						pausiert = false; const d = performance.now() / 1000 - pauseSeit;
						spurR = spurR.map(([a, t]) => [a, t + d]); spurL = spurL.map(([a, t]) => [a, t + d]);
						zuletzt = performance.now() / 1000; lauf = requestAnimationFrame(schritt);
					}
					return;
				}
				const unten = window.innerHeight;
				if (x.boundingClientRect.top >= (x.rootBounds?.bottom ?? unten)) { if (gestartet && !still) zuruecksetzen(); return; }
				if (gestartet && !haelt && !pausiert && fig.dataset.fertig === undefined) {
					cancelAnimationFrame(lauf); pausiert = true; pauseSeit = performance.now() / 1000;
				}
			}, { threshold: 0 });
			sicht.observe(fig);
			fig.addEventListener("click", spiele);
			window.addEventListener("resize", () => { if (fig.dataset.fertig !== undefined) { spurR = []; spurL = []; groesse(); bild(ENDE + 5, 0); } else groesse(); });
			// nach dem Laden der Schrift neu messen (vorher hat die Überschrift eine andere Breite und Höhe)
			document.fonts?.ready.then(() => { if (start < 0) { groesse(); bild(0, 0); } });
		});
	}
	document.addEventListener("astro:page-load", experten);
</script>
