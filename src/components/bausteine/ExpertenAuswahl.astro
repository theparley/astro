		// vor allem in den Hintergrund“)
		// Seite: n Personen zwischen xVon und xBis (Welt), Tiefe zVon bis zBis
		const seite = (n: number, xVon: number, xBis: number, zVon: number, zBis: number, ebene: number, ein: () => number) => {
			for (let i = 0; i < n; i++) {
				const X = xVon + (n === 1 ? 0.5 : i / (n - 1)) * (xBis - xVon) + j(((xBis - xVon) / n) * 0.6);
