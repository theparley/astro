---
/* Parley-eigen: Video mit Sprechblasen, die zum Gesagten aufpoppen (Rasul 13.11.2026:
   „Hol die Blasen für den Rohschnitt jetzt auf die Website.“). Form wie in der Szenen-Vorschau
   (Oval 1,4 : 1, Zipfel, Blau #0379A6, Text weiß), Schriftgröße die erste passende Stufe
   xl bis sm. Neu im Neustart: Das Video spielt nur, solange es zu mindestens 20 % zu sehen
   ist (BBH), und das Skript läuft nach jedem Seitenwechsel neu an.
   blasen: Zeiten in Sekunden des Videos, stelle "OL" (oben links) oder "OR" (oben rechts).
   von, bis (13.11.2026): nur diesen Ausschnitt in Schleife spielen, damit ein langer Film in einzelne
   Abschnitte mit je einer Sache zerlegt werden kann, ohne neu zu schneiden (Rasul: „einzelne Videos, die
   jeweils eine Sache erklären“). */
interface Blase { an: number; aus: number; stelle: "OL" | "OR"; text: string }
/* steuerung (13.11.2026, Rasul: „dürfen die Videos jetzt an der Stelle nicht laufen, sondern müssen pausiert
   sein. Die brauchen einen großen Startbutton in der Mitte. Und noch ein Button für Ton an, Ton aus.“):
   Video steht beim ersten Bild still, großer Startknopf in der Mitte (Kachel wie im Menü), Lautsprecher unten
   rechts wie BBHs Player („Unmute audio“). Start stumm wie bei BBH (dort startet kein Video mit Ton), Ton per
   Lautsprecher. Klick aufs laufende Video hält an; aus dem Bild gescrollt hält es an. */
/* blasenlage (13.11.2026): "aussen" (Standard) = Blase wächst oben aus dem Video heraus; "innen" = kleiner und
   ganz im Bild, für Kacheln (VideoKacheln), damit sie nicht in die Reihe darüber ragt. */
interface Props { src: string; blasen: Blase[]; format?: string; von?: number; bis?: number; steuerung?: boolean; blasenlage?: "aussen" | "innen" }
const { src, blasen, format = "16/9", von, bis, steuerung = false, blasenlage = "aussen" } = Astro.props;
---
<div class:list={["blasenvideo", steuerung && "blasenvideo--steuerung"]} data-blasenvideo data-blasen={JSON.stringify(blasen)} data-von={von} data-bis={bis} data-steuerung={steuerung ? "" : undefined} data-blasenlage={blasenlage} style={`--format:${format}`}>
	<video src={src} muted loop playsinline preload="metadata"></video>
	{steuerung && (
		<>
			<button type="button" class="blasenvideo__start" aria-label="Video abspielen">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5 L20 12 L7 19.5 Z" /></svg>
			</button>
			<button type="button" class="blasenvideo__ton" aria-label="Ton an" aria-pressed="false">
				<svg class="aus" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M16 9l5 6M21 9l-5 6" /></svg>
				<svg class="an" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
			</button>
		</>
	)}
	<div class="blase" aria-hidden="true"><svg><path /></svg><div class="blase__text"><p></p></div></div>
</div>
<style>
	.blasenvideo { position: relative; width: 100%; }
	.blasenvideo video { display: block; width: 100%; aspect-ratio: var(--format); object-fit: cover; background: var(--panel); border-radius: 4px; }
	.blase { position: absolute; inset: 0; pointer-events: none; opacity: 0; transform: scale(0.55); transition: opacity 0.18s ease-in, transform 0.25s ease-in; }
	.blase.an { opacity: 1; transform: none; transition: opacity 0.2s ease-out, transform 0.45s cubic-bezier(0.2, 1.3, 0.4, 1); }
	.blase svg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; }
	.blase path { fill: #0379A6; }
	.blase__text { position: absolute; display: flex; align-items: center; justify-content: center; }
	/* Steuerung: Startknopf als Kachel wie im Menü (88 px, #ededed 95 %), Lautsprecher unten rechts wie BBH */
	.blasenvideo__start {
		position: absolute; left: 50%; top: 50%; z-index: 2;
		width: 88px; height: 88px; transform: translate(-50%, -50%);
		display: grid; place-items: center;
		border: 0; padding: 0; cursor: pointer;
		background: rgba(237, 237, 237, 0.95); color: #000;
		transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1), transform 50ms;
	}
	.blasenvideo__start:active { transform: translate(-50%, -50%) scale(0.95); }
	.blasenvideo__start svg { width: 40px; height: 40px; fill: currentColor; }
	.blasenvideo--steuerung.spielt .blasenvideo__start { opacity: 0; pointer-events: none; }
	.blasenvideo--steuerung video { cursor: pointer; }
	.blasenvideo__ton {
		position: absolute; right: 12px; bottom: 12px; z-index: 2;
		width: 44px; height: 44px; display: grid; place-items: center;
		border: 0; padding: 0; cursor: pointer; background: transparent; color: #fff;
		filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
	}
	.blasenvideo__ton svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
	.blasenvideo__ton svg path:first-child { fill: currentColor; }
	.blasenvideo__ton .an { display: none; }
	.blasenvideo__ton[aria-pressed="true"] .an { display: block; }
	.blasenvideo__ton[aria-pressed="true"] .aus { display: none; }
	.blase__text p { margin: 0; color: #fff; font-family: var(--schrift-lesen); font-weight: 700; letter-spacing: -0.02em; line-height: 1.12; text-align: center; text-wrap: balance; }
</style>
<script>
	type Blase = { an: number; aus: number; stelle: "OL" | "OR"; text: string };
	const STUFEN = ["--text-xl", "--text-lg", "--text-md", "--text-base", "--text-sm"];
	const ZIPFEL = { laenge: 0.3, breite: 13, schraeg: 14 };
	const ANTEIL = 0.6;
	let aufraeumen: (() => void)[] = [];

	function starten() {
		aufraeumen.forEach((f) => f());
		aufraeumen = [];
		document.querySelectorAll<HTMLElement>("[data-blasenvideo]").forEach((szene) => {
			const video = szene.querySelector("video")!;
			const blase = szene.querySelector<HTMLElement>(".blase")!;
			const pfad = blase.querySelector("path")!;
			const box = blase.querySelector<HTMLElement>(".blase__text")!;
			const p = box.querySelector("p")!;
			const BLASEN: Blase[] = JSON.parse(szene.dataset.blasen || "[]");
			let laeuft = true;

			const zipfel = (rx: number, winkel: number) => {
				const ry = rx / 1.4, m = (winkel * Math.PI) / 180;
				const ziel = Math.sin(m) >= 0 ? Math.PI / 2 : -Math.PI / 2;
				const sch = Math.abs(Math.cos(m)) < 0.15 ? 0 : Math.sign(Math.atan2(Math.sin(ziel - m), Math.cos(ziel - m))) * (ZIPFEL.schraeg * Math.PI) / 180;
				return [rx * (1 + ZIPFEL.laenge) * Math.cos(m + sch), ry * (1 + ZIPFEL.laenge) * Math.sin(m + sch)];
			};
			const setze = (b: Blase) => {
				const W = szene.clientWidth, H = video.clientHeight || (W * 9) / 16;
				const innen = szene.dataset.blasenlage === "innen";
				const rx = (W * (innen ? 0.42 : ANTEIL)) / 2, ry = rx / 1.4;
				const rechts = b.stelle === "OR";
				const winkel = rechts ? 125 : 55;
				// innen: Zipfelspitze tiefer, so dass die ganze Blase im Bild bleibt
				const anker = [W * (rechts ? 0.62 : 0.38), innen ? ry * 2.25 + H * 0.04 : H * 0.1];
				const m = (winkel * Math.PI) / 180;
				const cx = anker[0] - rx * Math.cos(m), cy = anker[1] - ry * Math.sin(m);
				const half = (ZIPFEL.breite * Math.PI) / 180, z = zipfel(rx, winkel);
				const pts: number[][] = [];
				for (let i = 0; i <= 120; i++) { const t = m + half + ((2 * Math.PI - 2 * half) * i) / 120; pts.push([cx + rx * Math.cos(t), cy + ry * Math.sin(t)]); }
				pts.push([cx + z[0], cy + z[1]]);
				pfad.setAttribute("d", "M" + pts.map((q) => q[0].toFixed(1) + " " + q[1].toFixed(1)).join("L") + "Z");
				blase.style.transformOrigin = `${cx + z[0]}px ${cy + z[1]}px`;
				const bw = rx * 1.42, bh = ry * 1.3;
				Object.assign(box.style, { left: `${cx - bw / 2}px`, top: `${cy - bh / 2}px`, width: `${bw}px`, height: `${bh}px` });
				p.textContent = b.text;
				for (const st of STUFEN) { p.style.fontSize = `var(${st})`; if (p.scrollHeight <= box.clientHeight && p.scrollWidth <= box.clientWidth + 1) break; }
			};
			let aktiv: Blase | null = null, wechsel = 0;
			const schritt = () => {
				if (!laeuft) return;
				const t = video.currentTime;
				const b = BLASEN.find((x) => t >= x.an && t < x.aus) || null;
				if (b !== aktiv) {
					aktiv = b;
					clearTimeout(wechsel);
					blase.classList.remove("an");
					if (b) wechsel = window.setTimeout(() => { setze(b); blase.classList.add("an"); }, 120);
				}
				requestAnimationFrame(schritt);
			};
			const neu = () => { if (aktiv) setze(aktiv); };
			window.addEventListener("resize", neu);
			requestAnimationFrame(schritt);
			// Immer ohne Ton (Rasul 13.11.2026: „Im ersten Schritt sollte es mal nicht automatisch einen Ton
			// abspielen“). Das muted-Attribut allein reicht nicht: nach einem Seitenwechsel über Astros
			// ClientRouter steht es zwar im HTML, die Eigenschaft video.muted ist aber false (gemessen),
			// das Video lief mit Ton. Deshalb hier hart setzen, auch vor jedem Abspielen.
			video.muted = true;
			video.defaultMuted = true;
			// Ausschnitt in Schleife (von, bis)
			const von = szene.dataset.von ? parseFloat(szene.dataset.von) : null;
			const bis = szene.dataset.bis ? parseFloat(szene.dataset.bis) : null;
			if (von !== null || bis !== null) {
				const start = von ?? 0;
				const zumStart = () => { if (Math.abs(video.currentTime - start) > 0.2) video.currentTime = start; };
				if (video.readyState >= 1) zumStart(); else video.addEventListener("loadedmetadata", zumStart, { once: true });
				const wache = () => { if ((bis !== null && video.currentTime >= bis) || video.currentTime < start - 0.3) video.currentTime = start; };
				video.addEventListener("timeupdate", wache);
				aufraeumen.push(() => video.removeEventListener("timeupdate", wache));
			}
			const mitSteuerung = szene.hasAttribute("data-steuerung");
			if (mitSteuerung) {
				const start = szene.querySelector<HTMLButtonElement>(".blasenvideo__start")!;
				const ton = szene.querySelector<HTMLButtonElement>(".blasenvideo__ton")!;
				video.removeAttribute("loop");
				const zeigeStand = () => szene.classList.toggle("spielt", !video.paused);
				const abspielen = () => { video.play().catch(() => {}); };
				const umschalten = () => { if (video.paused) abspielen(); else video.pause(); };
				const tonUm = () => {
					video.muted = !video.muted;
					ton.setAttribute("aria-pressed", String(!video.muted));
					ton.setAttribute("aria-label", video.muted ? "Ton an" : "Ton aus");
				};
				start.addEventListener("click", abspielen);
				video.addEventListener("click", umschalten);
				ton.addEventListener("click", tonUm);
				video.addEventListener("play", zeigeStand);
				video.addEventListener("pause", zeigeStand);
				// Ohne Ausschnitt: am Filmende zurück auf Anfang und Startknopf zeigen
				const ende = () => { video.currentTime = szene.dataset.von ? parseFloat(szene.dataset.von) : 0; zeigeStand(); };
				video.addEventListener("ended", ende);
				aufraeumen.push(() => {
					start.removeEventListener("click", abspielen); video.removeEventListener("click", umschalten);
					ton.removeEventListener("click", tonUm); video.removeEventListener("play", zeigeStand);
					video.removeEventListener("pause", zeigeStand); video.removeEventListener("ended", ende);
				});
			}
			// Nur spielen, solange mindestens 20 % zu sehen sind (BBH, Analyse 1.7). Mit Steuerung: nur anhalten,
			// nie von selbst starten.
			const beobachter = new IntersectionObserver(([e]) => {
				if (e.isIntersecting) { if (!mitSteuerung) { video.muted = true; video.play().catch(() => {}); } }
				else video.pause();
			}, { threshold: 0.2 });
			beobachter.observe(szene);
			aufraeumen.push(() => { laeuft = false; beobachter.disconnect(); window.removeEventListener("resize", neu); });
		});
	}
	document.addEventListener("astro:page-load", starten);
</script>
