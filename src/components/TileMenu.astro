---
// ⚠️ ARCHIVIERT, AKTUELL NICHT EINGEBUNDEN (Stand 2026-08-29).
//
// Das komplette Kachel-Menü-System — Logo-Chip → Hamburger-Kachel →
// 2×2-Navigation (Format/Studio/Buchen/Kontakt) samt Backdrop — wurde aus
// der Startseite ausgebaut, aber bewusst NICHT gelöscht (Website-Brief,
// "Entscheidung 29.08.": Phase 1 läuft ohne Menü, weil Format/Studio/
// Kontakt noch gar nicht existieren — 75% der Ziele würden ins Leere
// führen). Fred will es in Phase 2 (sobald /formate + Produktseiten
// stehen) SCHNELL wieder reinholen können, deshalb bleibt der Code
// unangetastet hier liegen statt gelöscht zu werden.
//
// So reaktivierst du es:
// 1. In Layout.astro importieren: `import TileMenu from "../components/TileMenu.astro";`
// 2. `<TileMenu startCollapsed={...} />` statt/neben `<BrandLogo />` +
//    `<CtaTile />` einbinden — vermutlich willst du dann den separaten
//    Let's-Parley-Button aus CtaTile.astro wieder HIER reinziehen (er wurde
//    beim Ausbau nach CtaTile.astro verschoben und lebt dort jetzt
//    eigenständig, unten mittig statt unten rechts). Die alte Choreografie
//    (CTA erscheint erst NACH der Logo→Chip-Verwandlung, gemeinsames
//    .menu-tiles.transitions-ready-Gate) müsste dafür wieder zusammengeführt
//    werden — im aktuellen Split laufen beide unabhängig.
// 3. BrandLogo.astro kann dann entfallen (das Logo lebt wieder hier, inkl.
//    Scroll-Collapse-in-Chip-Mechanik) — oder parallel bestehen bleiben,
//    falls eine Seite das Logo ohne Menü-Funktion braucht.
// 4. Für die vier Menü-Ziele echte Hrefs statt "#" eintragen, sobald
//    /formate, /studio, /kontakt existieren (tabindex="-1" dann auch raus).
//
// Unverändert übernommen aus der letzten aktiven Fassung (vormals
// MenuTiles.astro, Commit e5e3724) — nur der eigenständige CTA-Button
// wurde entfernt (siehe CtaTile.astro), der Rest ist 1:1 stehen geblieben.
interface Props {
	startCollapsed?: boolean;
}

const { startCollapsed = false } = Astro.props;
---

<div class="menu-tiles">
<div class="hero-logo-group">
	<a href="/" aria-label="The Parley" class={`hero-logo${startCollapsed ? " collapsed" : ""}`}>
		<div class="hero-logo__hit-area" aria-hidden="true"></div>
		{/* Fahne+Text bleiben in ihrem normalen Layout stehen, verschwinden
		   nicht mehr. Beim Scrollen färben sie sich schwarz (Filter/Hintergrund
		   statt neuer Assets) und ein heller Chip erscheint dahinter, wie bei
		   BBHs Logo-Fläche — die Fahne selbst wird der Button. */}
		<div class="hero-logo__chip" aria-hidden="true"></div>
		{/* Eigener Wrapper nur für Stange+Fahne+Text — bekommt beim Scrollen
		   eine Skalierung, damit die Kombo ins Quadrat passt (echtes Quadrat,
		   nicht nur ein Rechteck-Chip). Der Chip selbst bleibt fix und skaliert
		   nicht mit. */}
		<div class="hero-logo__mark">
			<div class="hero-logo__pole" aria-hidden="true"></div>
			<div class="hero-logo__banner-wrap" aria-hidden="true">
				<img src="/parley/parley-flag-banner.svg" alt="" class="hero-logo__banner" />
			</div>
			<div class="hero-logo__text-wrap">
				<img src="/parley/parley-text.svg" alt="The Parley" class="hero-logo__text" />
			</div>
		</div>
		{/* Zweite Kachel rechts daneben, wie bei BBH (Logo + Hamburger als
		   Paar) — erscheint erst, wenn die erste Kachel fertig animiert ist
		   (Verzögerung über CSS, siehe transition-delay unten). Gleiche
		   Farbe/Deckkraft wie der Chip (BBH nutzt für beide Kacheln dieselbe
		   #ededed/95-Fläche, kein Schwarz). */}
		<div class="hero-logo__hamburger-tile" aria-hidden="true">
			<span class="hero-logo__burger-line"></span>
			<span class="hero-logo__burger-line"></span>
			<span class="hero-logo__burger-line"></span>
		</div>
	</a>
	{/* Vier Kacheln, NEBEN der (verschwindenden) Hamburger-Kachel statt oben
	   drüber — 1:1 wie bei BBH: volle Kachelbreite, halbe Kachelhöhe, als
	   2×2-Raster. Eigenes Element statt in .hero-logo verschachtelt, weil
	   .hero-logo selbst ein <a> ist (kein <a> in <a>, ungültiges HTML).
	   Reihenfolge im Markup = Lesereihenfolge (links-oben nach rechts-unten),
	   Stagger folgt derselben Reihenfolge. */}
	<ul class="hero-logo__nav" aria-hidden="true">
		<li style="--in-delay: 0ms"><a href="#" tabindex="-1">Format</a></li>
		<li style="--in-delay: 80ms"><a href="#" tabindex="-1">Studio</a></li>
		<li style="--in-delay: 160ms"><a href="/buchen" tabindex="-1">Buchen</a></li>
		<li style="--in-delay: 240ms"><a href="#" tabindex="-1">Kontakt</a></li>
	</ul>
</div>
{/* Dimmt/verwischt die ganze Seite leicht, während das Menü offen ist — wie
   BBHs nav-backdrop (bg-black/10 + backdrop-blur-sm), nicht der volldeckende
   Wisch vom Seitenübergang, der ist für Seitenwechsel. */}
<div class="hero-logo__backdrop" aria-hidden="true"></div>
</div>

<style>
	.menu-tiles {
		/* Erzeugt bewusst keine eigene Box — alle Kinder positionieren sich
		   per position:fixed komplett selbst. Trägt alle Geometrie-Variablen
		   des Systems. */
		display: contents;
		--logo-h: clamp(40px, 5.2vw, 64px);
		--pole-w: calc(var(--logo-h) * 52.36 / 2018.08);
		/* Breite von Fahne/Text, einmal ausgerechnet — für Gruppen-Zentrierung
		   und Quadrat-Maße unten wiederverwendet. */
		--banner-w: calc(var(--logo-h) * 1072.97 / 2018.08);
		--text-w: calc(var(--logo-h) * 1986.93 / 2018.08);
		/* Linker Rand der Kombo (Banner-Außenkante) und Gesamtbreite, relativ
		   zum Anker (= Stangen-Mitte) bei 0. */
		--combo-left: calc(-1 * var(--pole-w) / 2 - 4px - var(--banner-w));
		--combo-w: calc(var(--pole-w) + 8px + var(--banner-w) + var(--text-w));
		/* Eigener Mittelpunkt der Kombo (nicht der Stangen-Anker) — Text ist
		   breiter als die Fahne, die Mitte liegt also rechts vom Anker. Wird
		   für Gruppen-Zentrierung UND als Skalierungs-Ankerpunkt fürs Quadrat
		   gebraucht. */
		--combo-center-x: calc((var(--text-w) - var(--banner-w)) / 2);
		/* Kachelgröße als EINE Variable — BBHs eigenes Maß ist 88px. */
		--tile-size: 88px;
		--tile-gap: 4px;
		/* Echtes Quadrat, scharfe Kanten wie BBHs Logo-Feld — die Kombo ist von
		   Natur aus breiter als hoch, deshalb wird sie beim Scrollen zusätzlich
		   verkleinert (.hero-logo__mark), damit sie wirklich reinpasst.
		   Ziel-Innenbreite = 80% der Kachelgröße (ca. 10% Rand je Seite). */
		--mark-scale: calc(var(--tile-size) * 0.8 / var(--combo-w));
		/* Horizontaler Ankerpunkt: die Trennlinie zwischen Chip- und
		   Hamburger-Kachel (bzw. der linke Rand des aufgeklappten 2×2-Rasters).
		   Normal Viewport-Mitte — unten per Media Query auf einen linken
		   Dock-Punkt umgeschaltet, sobald das aufgeklappte Menü sonst mit dem
		   Let's-Parley-Button unten rechts kollidieren würde. */
		--seam-x: 50%;
	}

	@media (max-width: 560px) {
		.menu-tiles {
			/* Unter ~560px würde das volle 2×2-Menü (Chip+Hamburger+Raster,
			   zusammen 4× tile-size + 3× tile-gap ≈ 364px ab der Mitte nach
			   rechts) den unten rechts fixierten Let's-Parley-Button
			   überlappen. Deshalb dockt das ganze Logo/Menü-Paar links an, auf
			   gleicher Kante wie der Seiteninhalt (16px, siehe .wrap). */
			--seam-x: calc(16px + var(--tile-size));
		}
	}

	.hero-logo-group {
		/* Eigener (verschachtelter) display:contents-Wrapper nur für Logo +
		   Nav — damit :hover auf ihm gemeinsam auf beide DOM-Nachfahren
		   reagiert, ohne dass Backdrop (Geschwister davon) mit hovert. */
		display: contents;
	}

	.hero-logo {
		/* Fest am unteren Bildrand verankert — scrollt nicht mit weg, weil sie
		   perspektivisch zum Menü-Button wird und deshalb immer erreichbar
		   bleiben muss (wie die fixe Header-Nav, nur unten statt oben). */
		position: fixed;
		bottom: 0;
		/* Nullbreiter Anker. Am Anfang ("The Parley" für sich) ist die
		   Fahne+Text-Kombo mittig zentriert (--pair-shift: 0). Erst sobald die
		   zweite Kachel erscheint, wandert der ganze Anker zusätzlich nach
		   links (--pair-shift, unten bei .collapsed gesetzt), damit am Ende
		   die Trennlinie zwischen den beiden Kacheln exakt bei --seam-x liegt
		   — animiert, synchron mit dem Wisch der zweiten Kachel, nicht von
		   Anfang an statisch. */
		--pair-shift: 0px;
		left: calc(var(--seam-x) - var(--combo-center-x) + var(--pair-shift));
		width: 0;
		height: var(--logo-h);
		z-index: 100;
		/* Ladeanimation wie bei theparley.de (dort: seitliches Reinwischen der
		   Hero-Headline), hier aber von unten — echte Bewegung (translateY),
		   kein Freilegen/Maskieren: das Logo fährt aus dem Boden hoch, statt
		   an Ort und Stelle "eingemalt" zu werden. Läuft auch auf Seiten, die
		   schon collapsed starten — die fertige Kachel fährt dann als Ganzes
		   hoch, statt "The Parley" erst auszuschreiben. */
		animation: hero-logo-rise 700ms cubic-bezier(0.22, 0.61, 0.36, 1) 150ms both;
	}

	@keyframes hero-logo-rise {
		from {
			transform: translateY(100%);
		}
		to {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-logo {
			animation: none;
		}
	}

	.hero-logo.collapsed {
		--pair-shift: calc(-1 * var(--tile-size) / 2);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-logo.transitions-ready {
			/* Gleiches Timing wie der Hamburger-Kachel-Wisch (400ms Dauer, 400ms
			   Verzögerung) — der Anker wandert erst los, wenn die erste Kachel
			   fertig ist, und kommt genau dann bei --seam-x an, wenn die
			   zweite Kachel fertig aufgewischt ist. */
			transition: left 400ms cubic-bezier(0.77, 0, 0.18, 1) 400ms;
		}
	}

	.hero-logo__hit-area {
		/* Unsichtbare, großzügige Hover-/Klick-Fläche — deckt Chip UND die
		   zweite (Hamburger-)Kachel samt etwas Rand ab. :hover auf einem
		   Nachfahren zählt für .hero-logo:hover mit, unabhängig von dessen
		   eigener (nullbreiter) Box. */
		position: absolute;
		left: calc(var(--combo-left) - 20px);
		top: -120px;
		width: calc(var(--combo-center-x) - var(--combo-left) + 1.5 * var(--tile-size) + var(--tile-gap) + 40px);
		height: 140px;
	}

	.hero-logo__mark {
		/* Umschließt Stange+Fahne+Text — bekommt beim Scrollen eine Skalierung
		   plus Verschiebung, damit die Kombo mittig ins Quadrat passt (der
		   Chip selbst bleibt fix, siehe unten). Ankerpunkt fürs Skalieren ist
		   die natürliche Kombo-Mitte (--combo-center-x, vertikal 50% von
		   --logo-h) — die bleibt beim reinen scale() fix, die zusätzliche
		   translateY schiebt sie danach exakt in die Quadrat-Mitte. */
		position: absolute;
		inset: 0;
		/* z-index nötig: sobald der scale()-Transform beim Scrollen greift,
		   erzeugt .hero-logo__mark automatisch einen eigenen Stacking-Context —
		   ohne eigenen z-index läge der dann bei "auto" (~0), UNTER dem Chip
		   (z-index:1), der dadurch alles verdeckt hätte. */
		z-index: 2;
		transform-origin: var(--combo-center-x) 50%;
	}

	.hero-logo.collapsed .hero-logo__mark {
		/* Quadrat-Mitte (vertikal) liegt bei logo-h - tile/2 (Quadrat unten
		   bündig mit dem Boden) — die natürliche Kombo-Mitte liegt bei
		   logo-h/2. Differenz = logo-h/2 - tile/2, das ist die nötige
		   Verschiebung nach dem Skalieren (horizontal keine Verschiebung nötig:
		   die Kombo-Mitte ist ja schon der Skalierungs-Ankerpunkt). */
		transform: translateY(calc(var(--logo-h) / 2 - var(--tile-size) / 2)) scale(var(--mark-scale));
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-logo.transitions-ready .hero-logo__mark {
			transition: transform 400ms;
		}
	}

	.hero-logo__chip {
		/* Helles Quadrat hinter Stange+Fahne+Text, wie BBHs Logo-Feld — Farbe
		   UND Deckkraft 1:1 von dort übernommen (bg-[#ededed]/95, live
		   gemessen), 0px Radius (scharfe Ecken, live gemessen). Erscheint erst,
		   sobald geschwollen (.collapsed). Unten bündig mit dem Boden
		   (bottom:0-Verankerung von .hero-logo). Horizontal zentriert auf
		   denselben Punkt wie die Skalierung (--combo-center-x). */
		position: absolute;
		left: calc(var(--combo-center-x) - var(--tile-size) / 2);
		top: calc(var(--logo-h) - var(--tile-size));
		width: var(--tile-size);
		height: var(--tile-size);
		background: rgba(237, 237, 237, 0.95);
		border-radius: 0;
		z-index: 1;
		opacity: 0;
	}

	.hero-logo.collapsed .hero-logo__chip {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-logo.transitions-ready .hero-logo__chip {
			transition: opacity 300ms;
		}
	}

	.hero-logo__hamburger-tile {
		/* Zweite Kachel wie bei BBH (Logo + Hamburger als Paar) — gleiche Farbe/
		   Deckkraft/Radius wie der Chip (BBH nutzt für beide dieselbe Fläche),
		   direkt rechts daneben mit kleiner Lücke. */
		position: absolute;
		left: calc(var(--combo-center-x) + var(--tile-size) / 2 + var(--tile-gap));
		top: calc(var(--logo-h) - var(--tile-size));
		width: var(--tile-size);
		height: var(--tile-size);
		background: rgba(237, 237, 237, 0.95);
		border-radius: 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 9px;
		/* Wischt von links nach rechts ein (BBHs "mask-in"-Technik: clip-path
		   von voll verdeckt zu sichtbar), statt nur einzublenden — deshalb
		   opacity hier weg, clip-path übernimmt die Sichtbarkeit komplett. */
		clip-path: inset(0 100% 0 0);
	}

	/* Erscheint erst, wenn die erste Kachel fertig durchgewachsen/skaliert ist
	   (transition-delay = Dauer der .hero-logo__mark-Transition, 400ms) —
	   "wenn The Parley in der Kachel fertig animiert ist", wie Fred es wollte. */
	.hero-logo.collapsed .hero-logo__hamburger-tile {
		clip-path: inset(0 0 0 0);
	}

	/* Beim Öffnen des Menüs fährt die Hamburger-Kachel in Richtung Schaf
	   (Chip) rein — sie schrumpft von rechts her weg, der sichtbare Rest
	   bleibt links (an der Chip-Kante) hängen, bis nichts mehr übrig ist.
	   Live bei BBH so beobachtet: die Kachel verschwindet nicht einfach, sie
	   zieht sich zur Logo-Seite hin zurück. Muss NACH der .collapsed-Regel
	   stehen, sonst gewinnt die falsche bei gleicher Spezifität. Passiert wie
	   bei BBH schon beim Drüber-Hovern, nicht erst nach einem Klick — Bezug
	   ist :hover auf .hero-logo-group (nicht auf .hero-logo selbst), damit
	   der Hover beim Wechsel von der Hamburger-Kachel auf eine der vier
	   Menü-Kacheln nicht kurz "verloren" geht und der Effekt fälschlich
	   rückwärts läuft. .is-open bleibt zusätzlich bestehen, damit ein Klick
	   (Touch-Geräte ohne Hover) das Menü offen hält. */
	.hero-logo-group:hover .hero-logo.collapsed .hero-logo__hamburger-tile,
	.hero-logo.is-open .hero-logo__hamburger-tile {
		clip-path: inset(0 100% 0 0);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-logo.transitions-ready .hero-logo__hamburger-tile {
			/* Wie bei BBHs mask-in: 400ms, dieselbe Easing-Kurve, die wir schon
			   an anderer Stelle von BBH übernommen haben. Verzögerung 400ms =
			   Dauer der ersten Kachel-Skalierung (.hero-logo__mark), damit die
			   zweite Kachel erst aufwischt, wenn die erste fertig ist. */
			transition: clip-path 400ms cubic-bezier(0.77, 0, 0.18, 1) 400ms;
		}

		/* Das Zurückziehen beim Öffnen/Hovern soll sofort losgehen (keine
		   400ms-Verzögerung mehr nötig, die galt nur fürs allererste
		   Erscheinen). */
		.hero-logo-group:hover .hero-logo.collapsed.transitions-ready .hero-logo__hamburger-tile,
		.hero-logo.is-open.transitions-ready .hero-logo__hamburger-tile {
			transition: clip-path 300ms cubic-bezier(0.77, 0, 0.18, 1) 0ms;
		}
	}

	.hero-logo__burger-line {
		display: block;
		width: 40px;
		height: 3px;
		background: var(--black);
		flex: none;
	}

	.hero-logo__pole {
		/* Bleibt stehen — das ist der feste Ankerpunkt. Volle Logo-Höhe, oben
		   bündig (wie im Original-Logo: Stange geht über die volle Höhe, die
		   Fahne sitzt nur oben drauf und ragt nicht drüber hinaus). Wird beim
		   Scrollen schwarz statt weiß — zusammen mit Fahne+Text (Filter, siehe
		   unten) und dem hellen Chip dahinter wird aus der Fahne ein Button,
		   wie bei BBHs Logo-Chip. */
		position: absolute;
		left: calc(var(--pole-w) / -2);
		top: 0;
		width: var(--pole-w);
		height: var(--logo-h);
		background: var(--white);
		z-index: 3;
	}

	.hero-logo.collapsed .hero-logo__pole {
		background: var(--black);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-logo.transitions-ready .hero-logo__pole {
			transition: background-color 300ms;
		}
	}

	.hero-logo__banner-wrap {
		/* Rechter Rand exakt an der Stange — Fahne+Text bleiben an Ort und
		   Stelle stehen, kein Wegschieben. */
		position: absolute;
		right: calc(var(--pole-w) / 2 + 4px);
		top: calc(var(--logo-h) * 40.9736 / 2018.08);
		width: calc(var(--logo-h) * 1072.97 / 2018.08);
		height: calc(var(--logo-h) * 459.85 / 2018.08);
		z-index: 2;
	}

	.hero-logo__banner {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-logo__text-wrap {
		/* Linker Rand exakt an der Stange (+ 4px Lücke). */
		position: absolute;
		left: calc(var(--pole-w) / 2 + 4px);
		bottom: 0;
		width: calc(var(--logo-h) * 1986.93 / 2018.08);
		height: calc(var(--logo-h) * 1057.41 / 2018.08);
		z-index: 2;
	}

	.hero-logo__text {
		display: block;
		height: 100%;
		width: auto;
	}

	/* Weißer Fahnen-/Text-Fill wird zu Schwarz — per Filter statt neuer Assets,
	   da die SVGs mit fill="white" fest kodiert sind. invert(1) auf Weiß
	   ergibt exakt Schwarz, Transparenz bleibt unangetastet. */
	.hero-logo.collapsed .hero-logo__banner,
	.hero-logo.collapsed .hero-logo__text {
		filter: invert(1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-logo.transitions-ready .hero-logo__banner,
		.hero-logo.transitions-ready .hero-logo__text {
			transition: filter 300ms;
		}
	}

	.hero-logo__nav {
		/* 1:1 wie bei BBH: die ersten beiden neuen Kacheln übernehmen genau den
		   Platz der (verschwindenden) Hamburger-Kachel — schließen also direkt
		   an den Chip an, nicht erst hinter der Hamburger-Kachel. Als
		   2×2-Raster, bündig am Boden wie Chip und Hamburger-Kachel. */
		position: fixed;
		left: calc(var(--seam-x) + var(--tile-gap));
		bottom: 0;
		width: calc(var(--tile-size) * 2 + var(--tile-gap));
		display: flex;
		flex-wrap: wrap;
		gap: var(--tile-gap);
		margin: 0;
		padding: 0;
		list-style: none;
		z-index: 95;
		pointer-events: none;
	}

	.hero-logo-group:hover .hero-logo.collapsed ~ .hero-logo__nav,
	.hero-logo.is-open ~ .hero-logo__nav {
		pointer-events: auto;
	}

	.hero-logo__nav li {
		/* Volle Kachelbreite, halbe Kachelhöhe — aber die Lücke zwischen den
		   zwei Reihen zählt mit: zwei Reihen + eine Lücke müssen zusammen genau
		   --tile-size ergeben (wie die große Chip/Hamburger-Kachel), sonst wird
		   das 2×2-Raster insgesamt höher als die Kachel daneben. Deshalb erst
		   die Lücke abziehen, dann halbieren. Klappt von OBEN rein (inset(0 0
		   100% 0) lässt nur einen Nullpixel-Streifen am oberen Rand sichtbar,
		   wächst dann nach unten auf volle Höhe auf), gestaffelt über --in-delay
		   pro <li> in Lesereihenfolge. */
		width: var(--tile-size);
		height: calc((var(--tile-size) - var(--tile-gap)) / 2);
		background: rgba(237, 237, 237, 0.95);
		clip-path: inset(0 0 100% 0);
	}

	.hero-logo-group:hover .hero-logo.collapsed ~ .hero-logo__nav li,
	.hero-logo.is-open ~ .hero-logo__nav li {
		clip-path: inset(0 0 0 0);
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Gate auf .menu-tiles.transitions-ready (nicht ungated!): sonst würde
		   ein initial-collapsed-Start (Unterseiten-Prop ODER Mobil-Sofort-
		   Collapse) selbst noch eine sichtbare 400ms-Anwisch-Animation zeigen,
		   obwohl die Kachel "von Anfang an" sichtbar sein soll — die Klasse
		   wird ja erst 100ms NACH dem initialen Collapse gesetzt. */
		.menu-tiles.transitions-ready .hero-logo__nav li {
			transition: clip-path 400ms cubic-bezier(0.77, 0, 0.18, 1) var(--in-delay, 0ms);
		}
	}

	.hero-logo__nav a {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		padding: 0 20px;
		white-space: nowrap;
		font-family: "Forma DJR", Helvetica, Arial, sans-serif;
		font-weight: 900;
		font-size: 20px;
		color: var(--black);
		text-decoration: none;
	}

	.hero-logo__backdrop {
		/* Wie BBHs nav-backdrop: dimmt+verwischt die GANZE Seite leicht,
		   während das Menü offen ist (nicht der volldeckende Wisch vom
		   Seitenübergang — das ist ausdrücklich stärker/anders, für
		   Seitenwechsel reserviert). */
		position: fixed;
		inset: 0;
		z-index: 90;
		background: rgba(0, 0, 0, 0.1);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		opacity: 0;
		pointer-events: none;
	}

	/* .hero-logo__backdrop ist Geschwister von .hero-logo-group (nicht direkt
	   von .hero-logo) — deshalb :has() statt einfachem Geschwister-Selektor,
	   um den Zustand aus dem Wrapper heraus zu prüfen. */
	.hero-logo-group:hover:has(.hero-logo.collapsed) ~ .hero-logo__backdrop,
	.hero-logo-group:has(.hero-logo.is-open) ~ .hero-logo__backdrop {
		opacity: 1;
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-logo__backdrop {
			transition: opacity 300ms;
		}
	}
</style>

<script>
	// An astro:page-load gekoppelt (gleiches Muster wie PageWipe.astro) — läuft
	// bei jedem Seitenaufruf UND nach jedem Client-Side-Wechsel neu an. Ohne
	// diese Kopplung würde das Menü nach einer Navigation einfach nicht mehr
	// reagieren (Kernbefund aus dem Website-Brief).
	const MOBILE_BREAKPOINT = 560;

	let cleanup: (() => void) | null = null;

	function initTileMenu() {
		cleanup?.();
		cleanup = null;

		const group = document.querySelector<HTMLElement>(".hero-logo-group");
		const logo = document.querySelector<HTMLElement>(".hero-logo");
		const backdrop = document.querySelector<HTMLElement>(".hero-logo__backdrop");
		if (!group || !logo) return;

		// Mobil (bzw. jede Seite ohne Splash-Scroll, siehe startCollapsed-Prop)
		// startet direkt collapsed — auf schmalen Viewports war die
		// Scroll-Schwelle teils unerreichbar (Website-Brief, Zweitbefund
		// mobil), und auf Unterseiten gibt es ohnehin keinen Splash-Scroll.
		const startsCollapsed = logo.classList.contains("collapsed") || window.innerWidth <= MOBILE_BREAKPOINT;

		if (startsCollapsed) {
			logo.classList.add("collapsed");
		} else {
			// Zwei Scroll-Phasen — Timing hier tunen.
			const BANNER_START = 0;
			const BANNER_DISTANCE = 100;
			const TEXT_START = 0;
			const TEXT_DISTANCE = 100;

			let rafId = 0;
			// Einmal verwandelt, bleibt es verwandelt — auch beim Zurückscrollen
			// nach oben. Statt der aktuellen Scroll-Position nehmen wir den
			// bisher weitesten erreichten Stand: der kann nur wachsen, nie
			// sinken, die Animation läuft also nie rückwärts.
			let maxScrollY = window.scrollY;

			const progress = (start: number, distance: number) => Math.max(0, Math.min(1, (maxScrollY - start) / distance));

			const update = () => {
				maxScrollY = Math.max(maxScrollY, window.scrollY);
				const bannerCollapse = progress(BANNER_START, BANNER_DISTANCE);
				const textCollapse = progress(TEXT_START, TEXT_DISTANCE);
				logo.style.setProperty("--banner-collapse", String(bannerCollapse));
				logo.style.setProperty("--text-collapse", String(textCollapse));
				// Hover/Klick sollen erst wirken, wenn "The Parley" fertig
				// verschwunden ist — vorher bleibt die Maus wirkungslos.
				logo.classList.toggle("collapsed", bannerCollapse >= 1 && textCollapse >= 1);
			};

			const onScroll = () => {
				if (rafId) return;
				rafId = requestAnimationFrame(() => {
					update();
					rafId = 0;
				});
			};

			update();
			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll, { passive: true });
			cleanup = () => {
				window.removeEventListener("scroll", onScroll);
				window.removeEventListener("resize", onScroll);
			};
		}

		// Klick hält den Button offen (wie Zwetschkes .open-Klasse) statt zur
		// Startseite zu navigieren. Wirkt nur, wenn bereits collapsed ist —
		// sonst bliebe ein "vorgemerktes" Öffnen stehen, das erst später
		// unerwartet aufploppt.
		logo.addEventListener("click", (event) => {
			event.preventDefault();
			if (!logo.classList.contains("collapsed")) return;
			logo.classList.toggle("is-open");
		});

		// Tipp auf den Backdrop schließt das Menü (BBHs Touch-Modell:
		// vollflächiger "Close Navigation"-Button auf dem Backdrop).
		backdrop?.addEventListener("click", () => {
			logo.classList.remove("is-open");
		});

		// Transition erst kurz nach dem ersten Seitenaufbau aktivieren (siehe
		// Kommentar bei .transitions-ready im <style>) — auf .hero-logo UND
		// auf .menu-tiles (für Nav-Kacheln, die keine Nachfahren von
		// .hero-logo sind).
		window.setTimeout(() => {
			logo.classList.add("transitions-ready");
			group.closest(".menu-tiles")?.classList.add("transitions-ready");
		}, 100);
	}

	document.addEventListener("astro:page-load", initTileMenu);
</script>
