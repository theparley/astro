{/* Marken-Logo im Hero — FIXIERT unten Mitte, klappt beim Scrollen ein und
   übergibt an CtaTile.astro an DERSELBEN Stelle.

   Zweite Nachbesserung (Fred, 29.08. spät): die erste Fassung dieser
   Komponente (Phase-1-Menü-Rückbau) hatte die Scroll-Choreografie komplett
   verloren — Logo lag im normalen Fluss (kein position:fixed, kein
   Scroll-Collapse), CtaTile.astro beobachtete es per IntersectionObserver.
   Dadurch feuerte die Kachel zu spät/unzuverlässig, und es gab KEINE echte
   Kopplung — Logo und Kachel liefen technisch unabhängig, nur zufällig
   ungefähr synchron. Freds Erwartung (= der Vor-Menü-Stand, siehe
   Git-Historie 60a9921/49861a5 + die alte --collapse-Mechanik aus
   Header.astro/dbdbecc): Logo sitzt fixiert unten Mitte, klappt
   scroll-getrieben ein, die CTA-Kachel erscheint an GENAU derselben Stelle
   im selben Moment — eine Übergabe, kein unabhängiges Timing, reversibel.

   Lösung: EIN gemeinsamer Fortschrittswert, keine zwei Mechanismen. Das
   <script> unten schreibt bei jedem Scroll die CSS-Custom-Property
   --hero-dock (0 = Hero ganz oben/Logo voll da, 1 = Hero durchgescrollt/
   Logo weg) auf <html>. Das Logo hier UND CtaTile.astro's gated Variante
   lesen BEIDE denselben --hero-dock-Wert direkt in ihrem CSS (calc()) —
   keine zwei Uhren, keine Race Condition, kein "ungefähr". Rein
   scroll-Y-basiert (aktuelle Position, nicht maximal je erreichte) —
   dadurch von selbst reversibel: zurückscrollen bringt das Logo zurück und
   die Kachel weg, exakt spiegelbildlich. */}

<div class="brand-logo" aria-hidden="true">
	<div class="brand-logo__banner-wrap" aria-hidden="true">
		<img src="/parley/parley-flag-banner.svg" alt="" class="brand-logo__banner" />
	</div>
	<div class="brand-logo__pole" aria-hidden="true"></div>
	<div class="brand-logo__text-wrap">
		<img src="/parley/parley-text.svg" alt="The Parley" class="brand-logo__text" />
	</div>
</div>

<style>
	.brand-logo {
		/* 50% größer als der frühere Header-Maßstab, nur hier im Hero — 1:1
		   der Wert von vor dem Menü-Bau. */
		--logo-h: calc(clamp(32px, 4.4vw, 56px) * 1.5);
		--pole-w: calc(var(--logo-h) * 52.36 / 2018.08);
		/* Fixiert unten Mitte an der Viewport-Kante (Fred: "wie vor dem
		   Menü-Bau", siehe Kommentar oben) — scrollt NICHT mit dem
		   Seiteninhalt, sondern bleibt am Bildschirmrand stehen, bis der
		   Scroll-Fortschritt (--hero-dock) es ausblendet. */
		position: fixed;
		left: 50%;
		bottom: 0;
		z-index: 90;
		transform: translateX(-50%) translateY(calc(var(--hero-dock, 0) * 32px));
		display: flex;
		align-items: flex-end;
		justify-content: center;
		height: var(--logo-h);
		/* Gleiche Randabstand-Stufe wie .hero-headline/.wrap (16px bis 1024px,
		   danach 32px) — Logo geht auf keiner Breite näher an den Rand als der
		   restliche Seiteninhalt. */
		padding: 0 16px;
		/* Reine Dekoration, nie interaktiv (kein Klick-Handler mehr seit dem
		   Menü-Rückbau) — Klicks fallen durch auf das, was darunterliegt. */
		pointer-events: none;
		/* Blendet aus, während die Kachel an derselben Stelle einblendet —
		   beide direkt aus --hero-dock abgeleitet, siehe Kommentar oben.
		   Keine CSS-transition hier: der Wert wird pro Scroll-Frame vom
		   Script gesetzt, das IST schon die Animation (1:1 an den
		   Scroll-Fortschritt gekoppelt, kein Nachlaufen/Ruckeln durch eine
		   zusätzliche, konkurrierende Zeitsteuerung). */
		opacity: calc(1 - var(--hero-dock, 0));
		/* Ladeanimation beim allerersten Aufruf (Seite frisch geladen, bevor
		   das Script überhaupt einen Scroll-Wert gesetzt hat) — von unten
		   hoch, wie schon vor dem Menü-Bau. Läuft auf clip-path statt
		   transform, weil transform hier schon für die Scroll-Kopplung
		   gebraucht wird (zwei Animationen auf derselben Property würden sich
		   gegenseitig überschreiben). */
		clip-path: inset(0 0 0 0);
		animation: brand-logo-rise 700ms cubic-bezier(0.22, 0.61, 0.36, 1) 150ms both;
	}

	@media (min-width: 1024px) {
		.brand-logo {
			padding: 0 32px;
		}
	}

	@keyframes brand-logo-rise {
		from {
			clip-path: inset(100% 0 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-logo {
			animation: none;
		}
	}

	.brand-logo__pole {
		width: var(--pole-w);
		height: 100%;
		background: var(--white);
		flex: none;
	}

	.brand-logo__banner-wrap {
		align-self: flex-start;
		margin-top: calc(var(--logo-h) * 40.9736 / 2018.08);
		margin-right: 4px;
		width: calc(var(--logo-h) * 1072.97 / 2018.08);
		height: calc(var(--logo-h) * 459.85 / 2018.08);
		flex: none;
	}

	.brand-logo__banner {
		display: block;
		width: 100%;
		height: 100%;
	}

	.brand-logo__text-wrap {
		margin-left: 4px;
		width: calc(var(--logo-h) * 1986.93 / 2018.08);
		height: calc(var(--logo-h) * 1057.41 / 2018.08);
		flex: none;
	}

	.brand-logo__text {
		display: block;
		height: 100%;
		width: auto;
	}
</style>

<script>
	// An astro:page-load gekoppelt (gleiches Muster wie PageWipe.astro/
	// TileMenu.astro) — läuft bei jedem Seitenaufruf UND nach jedem
	// Client-Side-Wechsel neu an, inkl. Cleanup zwischen Navigationen.
	//
	// EINZIGE Quelle für den Scroll-Fortschritt --hero-dock: 0 direkt nach
	// dem Laden (Hero ganz oben, Logo voll sichtbar), 1 sobald um eine volle
	// Hero-Höhe gescrollt wurde (Logo ausgeblendet, CtaTile.astro zeigt die
	// Kachel an derselben Stelle — siehe dortiges CSS, das denselben Wert
	// liest). Rein aktueller scrollY, nicht der höchste je erreichte Wert
	// (anders als die alte Menü-Mechanik) — dadurch von selbst reversibel.
	let cleanup: (() => void) | null = null;

	function initHeroDock() {
		cleanup?.();
		cleanup = null;

		const root = document.documentElement;
		const hero = document.querySelector<HTMLElement>(".hero");

		if (!hero) {
			// Keine Hero-Sektion auf dieser Seite (sollte bei .brand-logo nicht
			// vorkommen, die Komponente wird nur auf der Startseite gerendert) —
			// Sicherheitsnetz: Wert auf 0 lassen, Logo bleibt sichtbar.
			root.style.setProperty("--hero-dock", "0");
			return;
		}

		let rafId = 0;

		const update = () => {
			// Distanz = eine volle Hero-Höhe: sobald der Besucher eine
			// Hero-Höhe weit gescrollt hat, ist der Hero optisch "durch" und
			// die Übergabe an die Kachel abgeschlossen.
			const distance = Math.max(hero.offsetHeight, 1);
			const progress = Math.max(0, Math.min(1, window.scrollY / distance));
			root.style.setProperty("--hero-dock", String(progress));
		};

		const onScroll = () => {
			if (rafId) return;
			rafId = requestAnimationFrame(() => {
				update();
				rafId = 0;
			});
		};

		update();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll, { passive: true });
		cleanup = () => {
			window.removeEventListener("scroll", onScroll);
			window.removeEventListener("resize", onScroll);
			root.style.removeProperty("--hero-dock");
		};
	}

	document.addEventListener("astro:page-load", initHeroDock);
</script>
