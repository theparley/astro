{/* Marken-Logo im Hero — FIXIERT unten Mitte, fährt beim Scrollen in die
   Stange ein und übergibt an CtaTile.astro an DERSELBEN Stelle.

   Dritte Nachbesserung (Fred, exakte Choreografie beschrieben): die zweite
   Fassung (opacity-Fade + proportional aufdeckende CTA-Kachel) traf DREI
   Punkte nicht:
   1) Kein opacity-Fade als Hauptmechanik — gefordert ist die alte
      EINFAHR-Animation: die Wortmarke "The Parley" fährt in die Stange
      (translateX + overflow:hidden auf dem Text-Wrap, 1:1 die Mechanik aus
      Header.astro: transform:translateX(calc(var(--collapse)*-110%)) im
      überlaufversteckten Wrap), DANACH fährt auch die Fahne in die Stange
      (gleiches Prinzip, gespiegelt). Sequenz aus EINEM Fortschrittswert:
      Phase Text = clamp(dock*2, 0, 1) [0→0.5], Phase Fahne = clamp(dock*2-1,
      0, 1) [0.5→1] — Text fährt zuerst vollständig ein, danach erst die
      Fahne.
   2) Die Scroll-Strecke war eine volle Hero-Höhe (viel zu lang) — gefordert
      ist eine kurze Strecke wie beim alten Header (COLLAPSE_START 120/
      DISTANCE 160 dort): hier neu kalibriert auf Start ~80px, fertig
      ~280px (DISTANCE 200).
   3) Die CTA-Kachel war proportional zum Fortschritt aufgedeckt (clip-path
      direkt an --hero-dock gekoppelt) — gefordert ist ein EREIGNIS: bei
      dock>=1 (Einfahr-Animation fertig) wird eine Klasse gesetzt, die
      CtaTile.astro's bestehende 400ms-Erscheinen-Animation abspielt; bei
      dock<1 wird die Klasse wieder entfernt (Button verschwindet,
      reversibel). Kein anteiliges Aufdecken mehr — siehe CtaTile.astro.

   Die POLE (Stange) selbst bleibt während der ganzen Sequenz unverändert
   stehen (nur Text und Fahne fahren HINEIN) — Fred hat für die Stange
   selbst kein Ausblenden verlangt, nur für Text und Fahne. */}

<div class="brand-logo" aria-hidden="true">
	<div class="brand-logo__banner-wrap" aria-hidden="true">
		<img src="/parley/parley-flag-banner.svg" alt="" class="brand-logo__banner" />
	</div>
	<div class="brand-logo__pole" aria-hidden="true"></div>
	<div class="brand-logo__text-wrap">
		<img src="/parley/parley-text.svg" alt="The Parley" class="brand-logo__text" />
	</div>
</div>

<style>
	.brand-logo {
		/* 50% größer als der frühere Header-Maßstab, nur hier im Hero — 1:1
		   der Wert von vor dem Menü-Bau. */
		--logo-h: calc(clamp(32px, 4.4vw, 56px) * 1.5);
		--pole-w: calc(var(--logo-h) * 52.36 / 2018.08);
		/* Fixiert unten Mitte an der Viewport-Kante (Fred: "wie vor dem
		   Menü-Bau") — scrollt NICHT mit dem Seiteninhalt. Bleibt hier
		   während der ganzen Einfahr-Sequenz unbewegt stehen; nur Text und
		   Fahne (innere Elemente) animieren, siehe unten. */
		position: fixed;
		left: 50%;
		bottom: 0;
		z-index: 90;
		transform: translateX(-50%);
		display: flex;
		align-items: flex-end;
		justify-content: center;
		height: var(--logo-h);
		/* Gleiche Randabstand-Stufe wie .hero-headline/.wrap (16px bis 1024px,
		   danach 32px) — Logo geht auf keiner Breite näher an den Rand als der
		   restliche Seiteninhalt. */
		padding: 0 16px;
		/* Reine Dekoration, nie interaktiv (kein Klick-Handler mehr seit dem
		   Menü-Rückbau) — Klicks fallen durch auf das, was darunterliegt. */
		pointer-events: none;
		/* Ladeanimation beim allerersten Aufruf (Seite frisch geladen) — von
		   unten hoch, wie schon vor dem Menü-Bau. */
		clip-path: inset(0 0 0 0);
		animation: brand-logo-rise 700ms cubic-bezier(0.22, 0.61, 0.36, 1) 150ms both;
	}

	@media (min-width: 1024px) {
		.brand-logo {
			padding: 0 32px;
		}
	}

	@keyframes brand-logo-rise {
		from {
			clip-path: inset(100% 0 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-logo {
			animation: none;
		}
	}

	.brand-logo__pole {
		width: var(--pole-w);
		height: 100%;
		background: var(--white);
		flex: none;
	}

	/* Fahne-Wrap: overflow:hidden macht daraus das "Fenster", aus dem die
	   Fahne (Kind-Element, siehe .brand-logo__banner) beim Einfahren
	   herausgleitet — exakt die Header.astro-Technik, hier auf die Fahne
	   gespiegelt (Fahne sitzt LINKS von der Stange, muss also nach RECHTS,
	   zur Stange hin, verschwinden). */
	.brand-logo__banner-wrap {
		align-self: flex-start;
		margin-top: calc(var(--logo-h) * 40.9736 / 2018.08);
		margin-right: 4px;
		width: calc(var(--logo-h) * 1072.97 / 2018.08);
		height: calc(var(--logo-h) * 459.85 / 2018.08);
		flex: none;
		overflow: hidden;
	}

	/* Fährt NACH dem Text ein (Phase Fahne = dock 0.5→1, siehe Script) —
	   translateX(+110%) schiebt die Fahne nach rechts aus ihrem eigenen
	   Fenster hinaus, also zur Stange hin/dahinter. Kein CSS-transition:
	   der Wert kommt pro Scroll-Frame direkt vom Script (1:1 scroll-gekoppelt,
	   wie die alte --collapse-Mechanik). */
	.brand-logo__banner {
		display: block;
		width: 100%;
		height: 100%;
		transform: translateX(calc(var(--dock-flag, 0) * 110%));
	}

	/* Text-Wrap: identische Technik wie Header.astro
	   (.parley-nav__logo-text-wrap: overflow:hidden, fester Ausschnitt). */
	.brand-logo__text-wrap {
		margin-left: 4px;
		width: calc(var(--logo-h) * 1986.93 / 2018.08);
		height: calc(var(--logo-h) * 1057.41 / 2018.08);
		flex: none;
		overflow: hidden;
	}

	/* Fährt ZUERST ein (Phase Text = dock 0→0.5) — translateX(-110%), 1:1 die
	   Formel aus Header.astro (dort: calc(var(--collapse,0) * -110%)), nur
	   jetzt an die neue Phase-Variable gekoppelt statt an --collapse. Text
	   sitzt RECHTS von der Stange, muss also nach LINKS wegfahren. */
	.brand-logo__text {
		display: block;
		height: 100%;
		width: auto;
		transform: translateX(calc(var(--dock-text, 0) * -110%));
	}
</style>

<script>
	// An astro:page-load gekoppelt (gleiches Muster wie PageWipe.astro/
	// TileMenu.astro) — läuft bei jedem Seitenaufruf UND nach jedem
	// Client-Side-Wechsel neu an, inkl. Cleanup zwischen Navigationen.
	//
	// EINZIGE Quelle für die gesamte Sequenz: EIN Fortschrittswert "dock"
	// (0…1), aus dem sowohl die Text-/Fahnen-Einfahr-Phasen ALS AUCH das
	// diskrete Erscheinen der CTA-Kachel abgeleitet werden — kein zweiter
	// Mechanismus, keine Race Condition (Fred-Vorgabe seit der zweiten
	// Nachbesserung, jetzt auf die neue Choreografie übertragen).
	//
	// Kurze Scroll-Strecke (dritte Nachbesserung): Start bei 80px scrollY,
	// fertig eingefahren bei 280px (DISTANCE 200) — Referenzwerte aus dem
	// alten Header.astro-Script (dort COLLAPSE_START 120 / DISTANCE 160),
	// hier leicht angepasst auf Freds explizite Vorgabe 80/280.
	const DOCK_START = 80;
	const DOCK_DISTANCE = 200;

	let cleanup: (() => void) | null = null;

	function initHeroDock() {
		cleanup?.();
		cleanup = null;

		const root = document.documentElement;
		// Die CTA-Kachel wird hier direkt geschaltet (Klasse an/aus statt
		// eines eigenen Beobachters in CtaTile.astro) — genau EIN Skript
		// treibt die ganze Sequenz.
		const cta = document.querySelector<HTMLElement>(".cta-tile--gated");

		let rafId = 0;

		const update = () => {
			const raw = (window.scrollY - DOCK_START) / DOCK_DISTANCE;
			const dock = Math.max(0, Math.min(1, raw));
			// Phase Text: läuft über die ERSTE Hälfte von dock (0→0.5 dock ==
			// 0→1 Phase) — Text fährt zuerst komplett ein.
			const phaseText = Math.max(0, Math.min(1, dock * 2));
			// Phase Fahne: läuft über die ZWEITE Hälfte von dock (0.5→1 dock ==
			// 0→1 Phase) — Fahne fährt erst ein, wenn der Text fertig ist.
			const phaseFlag = Math.max(0, Math.min(1, dock * 2 - 1));

			root.style.setProperty("--hero-dock", String(dock));
			root.style.setProperty("--dock-text", String(phaseText));
			root.style.setProperty("--dock-flag", String(phaseFlag));

			// CTA-Kachel: diskretes Ereignis bei dock>=1 (Einfahr-Animation
			// fertig), NICHT proportional. classList.toggle mit Boolean setzt/
			// entfernt sauber je nach Richtung — dadurch reversibel: scrollt
			// der Besucher wieder unter 280px, verschwindet die Kachel wieder.
			cta?.classList.toggle("cta-tile--revealed", dock >= 1);
		};

		const onScroll = () => {
			if (rafId) return;
			rafId = requestAnimationFrame(() => {
				update();
				rafId = 0;
			});
		};

		update();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll, { passive: true });
		cleanup = () => {
			window.removeEventListener("scroll", onScroll);
			window.removeEventListener("resize", onScroll);
			root.style.removeProperty("--hero-dock");
			root.style.removeProperty("--dock-text");
			root.style.removeProperty("--dock-flag");
		};
	}

	document.addEventListener("astro:page-load", initHeroDock);
</script>
