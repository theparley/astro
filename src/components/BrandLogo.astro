{/* KEIN LOGO UNTEN MEHR (Fred 10.10.2026, abgenommen „so ist gut“; live seit
   26.10.2026): Fahne, Stange und Schriftzug „The Parley“ sind raus. Die
   Zwischenstände des 10./11.10. mit der Wortmarke ‚parley‛ (Bildmarke unten,
   Zeichen gleiten zum Menü, Wort schreibt sich) sind durch die Namensregel
   vom 26.10. (Parley Film) überholt und liegen im Zweig
   archiv/markenbasis-parley-2026-10; die alte Fahne in der Git-Historie
   (Commit 670cd1f und früher).
   Was bleibt, ist der Schalter: das Script darunter entscheidet, WANN der
   Menüknopf (MenuTile.astro, .menu-tile--gated) auf der Startseite
   erscheint. Vorbild für das Tempo: zwetschke.de (Fred 10.10.: „das Menü
   erscheint viel zu spät“). Dieses Element ist nur noch ein leerer Anker. */}
<div class="brand-logo" aria-hidden="true"></div>

<script>
	// An astro:page-load gekoppelt (gleiches Muster wie PageWipe.astro) —
	// läuft bei jedem Seitenaufruf UND nach jedem Client-Side-Wechsel neu an,
	// inkl. Cleanup zwischen Navigationen.
	//
	// Knopf auf ab 50 px Scrollweg, zu erst wieder unter 40 px (Totband).
	// Ohne Totband kippte die Klasse bei jedem Scroll-Zittern um die Schwelle
	// hin und her, und der Knopf blitzte (Fred 10.10., dreimal „es blitzt“).
	// Das Ein- und Ausblenden selbst (70 ms rein, 220 ms raus) steht in
	// MenuTile.astro.
	const OPEN_AT = 50;
	const CLOSE_BELOW = 40;

	let cleanup: (() => void) | null = null;

	function initMenuGate() {
		cleanup?.();
		cleanup = null;

		const knopf = document.querySelector<HTMLElement>(".menu-tile--gated");
		if (!knopf) return;

		let revealed = false;
		let rafId = 0;

		const update = () => {
			const y = window.scrollY;
			revealed = revealed ? y >= CLOSE_BELOW : y >= OPEN_AT;
			knopf.classList.toggle("menu-tile--revealed", revealed);
		};

		const onScroll = () => {
			if (rafId) return;
			rafId = requestAnimationFrame(() => {
				update();
				rafId = 0;
			});
		};

		update();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll, { passive: true });
		cleanup = () => {
			window.removeEventListener("scroll", onScroll);
			window.removeEventListener("resize", onScroll);
			if (rafId) cancelAnimationFrame(rafId);
		};
	}

	document.addEventListener("astro:page-load", initMenuGate);
</script>
