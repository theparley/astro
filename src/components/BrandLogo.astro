{/* PROBE LOKAL (Fred 10.10.2026, Markenbasis ‚parley‛): statt Fahne + Stange
   + Schriftzug „The Parley" steht unten die BILDMARKE, die zwei Zeichen
   nebeneinander auf einer Hoehe. Dritte Fassung des Tages (Fred: „wir lassen
   nicht parley erscheinen, wir lassen einfach das Menue erscheinen; wenn das
   Menue fertig aufgebaut ist, verschwinden die beiden Apostrophe"):
   RUHE: die beiden Zeichen VERSETZT wie deutsche Anfuehrungszeichen (links
   unten, rechts oben, eng zusammen; sechste Fassung 10.10.), blenden nach
   dem Hero-Wisch ein (1100 ms).
   SCROLLEN: die Bildmarke bleibt stehen, keine Klammer, kein Schreiben. Bei
   dock = 1 entsteht wie bisher der Menueknopf aus der Mitte (CtaTile,
   400 ms); WAEHRENDDESSEN gleiten die beiden Zeichen auseinander bis neben
   den Knopf (vierte Fassung, Fred 10.10.), ist er fertig, blenden sie aus.
   Rueckweg: Knopf schliesst sich, danach kommen die Zeichen wieder.
   Die Wortmarke (Wort + Klammer-Stellung) bleibt im Markup, ist aber
   stillgelegt: das Wort ist weggeschnitten, die Zeichen stehen dauerhaft in
   der Bildmarken-Stellung (--g: 1). Die Schreib-Choreografie (Zeichen
   gleiten auseinander, Wort schreibt sich) liegt in der Git-Historie des
   Tages, falls sie zurueckkommt. */}
{/* KLAMMER UNTEN RAUS (Fred 10.10., siebte Fassung: „die doppelte Klammer
   hier weg, das Menue erscheint einfach, sobald man scrollt, und geht ohne
   Blitzen wieder weg"). Die Anfuehrungszeichen-Animation soll stattdessen in
   den Hero-Text wandern (offen, naechster Schritt). Dieses Element bleibt
   als leerer Anker: das Script darunter steuert weiterhin, WANN der
   Menueknopf (CtaTile) erscheint — Schwelle, Totband, Ruhe-Abwarten. Die
   Marken-Choreografien des Tages (Gegenueber, Klammer, Schreiben) liegen in
   der Git-Historie. */}
<div class="brand-logo" aria-hidden="true"></div>

<style>
	/* :global() auf den wortmarke__-Teilen: sie kommen aus Wortmarke.astro
	   und tragen dessen Scope-Attribut, nicht das dieser Datei. */
	.brand-logo {
		/* GROESSE (Fred 10.10., zweite Runde: „am Ende soll ‚parley‛ MIT
		   Anfuehrungs- und Endzeichen so hoch sein wie der Menueknopf", nicht
		   ein einzelnes Zeichen): Tintenhoehe der fertigen Wortmarke = von der
		   Oberkante des schliessenden Zeichens (Oberlaenge 0,70 em) bis zur
		   Unterlaenge von p/y (0,17 em) = 0,87 em = 88 px (CtaTile
		   --tile-size) → 101 px Schrift. Die Zeichen sind dann 33 px hoch, die
		   geschriebene Wortmarke ~3,6 em = 362 px breit. Deckel 25vw fuer
		   schmale Fenster. */
		--logo-fs: min(calc(88px / 0.87), 25vw);
		position: fixed;
		left: 50%;
		bottom: 0;
		z-index: 90;
		width: 0;
		height: var(--logo-fs);
		pointer-events: none;
	}

	.brand-logo__marke {
		position: absolute;
		left: 0;
		/* Grundlinie 0,2 em ueber der Unterkante (Unterlaengen p/y = 0,17 em
		   bleiben sichtbar); die Zeilenbox endet 0,2 em unter der Grundlinie,
		   also sitzt die Box auf 0. */
		bottom: 0;
		transform: translateX(-50%);
		font-size: var(--logo-fs);
		/* Logo-Farbe = Flaechen-Ton #ededed statt Reinweiss (BBH-Regel, wie
		   bisher bei Fahne und Schriftzug). */
		color: #ededed;
		line-height: 1;
		animation: brand-logo-rein 300ms ease-out 1100ms backwards; /* nach dem Hero-Wisch (900 ms); die P-Klappe davor ist seit 10.10. raus */
	}
	@keyframes brand-logo-rein {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	/* Wort stillgelegt (nur Bildmarke, s. oben). */
	.brand-logo :global(.wortmarke__wort) {
		clip-path: inset(0 100% 0 0);
	}

	/* Zeichen dauerhaft in der Bildmarken-Stellung (--g 1 = beide
	   nebeneinander; 0 waere die Klammer-Stellung der Wortmarke). */
	.brand-logo :global(.wortmarke__zeichen) {
		--g: 1;
	}
	/* AUSEINANDERGEHEN BEIM MENUE (Fred 10.10.: „die beiden Apostrophe gehen
	   auseinander, und dabei erscheint das Menue"): mit der Kachel-Geburt
	   (400 ms, gleiche BBH-Kurve wie CtaTile) gleiten die Zeichen nach aussen
	   bis NEBEN den fertigen Knopf, je 8 px Luft zur Knopfkante, der Knopf
	   steht damit kurz in Anfuehrungszeichen; danach blenden sie aus
	   (s. Uebergabe unten). --sx-l/--sx-r misst das Script aus Knopfbreite
	   und Zeichenlage. */
	/* VERSETZT (Fred 10.10., fuenfte Fassung: „fuer den Menueaufbau die
	   versetzte Variante"): die Zeichen gleiten nicht nur nach aussen,
	   sondern wie deutsche Anfuehrungszeichen auseinander, das linke nach
	   unten (Unterkante = Knopf-Unterkante), das rechte nach oben (Oberkante
	   = Knopf-Oberkante). Der Knopf steht dann in ‚…‛. --sy-l/--sy-r aus dem
	   Script. */
	.brand-logo.brand-logo--handedover :global(.wortmarke__zeichen--auf) { /* doppelte Klasse: schlaegt die Ruhe-Regel unten bei gleicher Spezifitaet */
		transform: translate(calc(var(--dx-l, 0px) + var(--sx-l, 0px)), calc(var(--dy-l, 0px) + var(--sy-l, 0px)));
	}
	.brand-logo.brand-logo--handedover :global(.wortmarke__zeichen--zu) {
		transform: translate(calc(var(--dx-r, 0px) + var(--sx-r, 0px)), calc(var(--dy-r, 0px) + var(--sy-r, 0px)));
	}
	@media (prefers-reduced-motion: no-preference) {
		/* Nur auf dem Hinweg animiert: beim Laden stehen die Zeichen sofort
		   zusammen (das Script setzt --dx erst nach dem Layout, eine
		   Dauer-Transition wuerde sie aus der Klammer-Stellung hereingleiten
		   lassen), und auf dem Rueckweg springen sie unsichtbar zurueck. */
		.brand-logo.brand-logo--handedover :global(.wortmarke__zeichen) {
			transition: transform 400ms cubic-bezier(0.77, 0, 0.18, 1);
		}
	}
	.brand-logo :global(.wortmarke__zeichen--auf) {
		transform: translate(calc(var(--dx-l, 0px) * var(--g)), calc(var(--dy-l, 0px) * var(--g)));
	}
	.brand-logo :global(.wortmarke__zeichen--zu) {
		transform: translate(calc(var(--dx-r, 0px) * var(--g)), calc(var(--dy-r, 0px) * var(--g)));
	}

	/* Uebergabe-Moment: die Kachel liegt ueber der Marke, diese blendet
	   aus (wie frueher die Stange). Rueckwaerts kommt sie wieder. */
	.brand-logo--handedover .brand-logo__marke {
		opacity: 0;
	}
	@media (prefers-reduced-motion: no-preference) {
		/* UEBERGABE (Fred 10.10.): Hinweg = die Zeichen bleiben, bis der
		   Menueknopf fertig aufgebaut ist (400 ms Kachel-Geburt, CtaTile),
		   dann blenden sie in 150 ms aus. Rueckweg = Zeichen erst wieder da,
		   wenn der Knopf zu ist (550 ms = Schrift aus + Kachel schliessen,
		   s. CLOSE_MS im Script). So liegt nie ein Blitzer zwischen beiden. */
		.brand-logo__marke {
			transition: opacity 150ms ease 550ms;
		}
		.brand-logo--handedover .brand-logo__marke {
			transition: opacity 150ms ease 400ms;
		}
		/* Spiegel-Rueckweg (Script setzt --gliding fuer 300 ms): Wort
		   loescht sich, Zeichen gleiten zusammen, statt zu springen. */
		.brand-logo--gliding :global(.wortmarke__zeichen) {
			transition: transform 300ms cubic-bezier(0.77, 0, 0.18, 1);
		}
		.brand-logo--gliding :global(.wortmarke__wort) {
			transition: clip-path 300ms cubic-bezier(0.77, 0, 0.18, 1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-logo__marke {
			animation: none;
		}
	}
</style>

<script>
	// An astro:page-load gekoppelt (gleiches Muster wie PageWipe.astro/
	// TileMenu.astro) — läuft bei jedem Seitenaufruf UND nach jedem
	// Client-Side-Wechsel neu an, inkl. Cleanup zwischen Navigationen.
	//
	// EINZIGE Quelle für die gesamte Sequenz: EIN Fortschrittswert "dock"
	// (0…1), aus dem sowohl die Text-/Fahnen-Einfahr-Phasen ALS AUCH das
	// diskrete Erscheinen der CTA-Kachel (die "Geburt" aus der Stange,
	// siehe CtaTile.astro) abgeleitet werden — kein zweiter Mechanismus,
	// keine Race Condition.
	//
	// Kurze Scroll-Strecke: Start bei 80px scrollY, fertig eingefahren bei
	// 280px (DISTANCE 200) — Referenzwerte aus dem alten Header.astro-Script
	// (dort COLLAPSE_START 120 / DISTANCE 160), hier auf Freds explizite
	// Vorgabe 80/280 angepasst.
	// „sobald man scrollt, wie zwetschke.de" (Fred 10.10., zweite Runde):
	// Knopf ab 50 px Scrollweg (vorher 280, dann 120), zu wieder unter 40 px
	// (Totband 0,8), Ruhe-Abwarten auf 0 ms (naechster Takt; Flicks faengt die weiche Ueberblendung ab).
	const DOCK_START = 0;
	const DOCK_DISTANCE = 50;

	let cleanup: (() => void) | null = null;

	function initHeroDock() {
		cleanup?.();
		cleanup = null;

		const root = document.documentElement;
		// Die CTA-Kachel wird hier direkt geschaltet (Klasse an/aus statt
		// eines eigenen Beobachters in CtaTile.astro) — genau EIN Skript
		// treibt die ganze Sequenz.
		// Seit dem Menü-Umbau (Fred 30.08. abends) ist die geborene Kachel der
		// Menü-Knopf (MenuTile.astro), nicht mehr der Let's-Parley-CTA — die
		// Choreografie ist identisch, nur die Klassennamen sind umgezogen.
		const cta = document.querySelector<HTMLElement>(".menu-tile--gated");
		const logo = document.querySelector<HTMLElement>(".brand-logo");

		// RUHEPOSITIONEN DER ZEICHEN (Bildmarke): beide nebeneinander auf einer
		// Hoehe, Luecke 10 % der Versalhoehe (Markenbasis), mittig auf dem
		// Anker; als Versatz zur Klammer-Stellung (Layout-Position) berechnet.
		// Gemessen ueber offset* (ignoriert laufende Transforms), relativ zur
		// Marke; Hoehe = Mittelwert der beiden Zeichen-Mitten.
		const measureMarke = () => {
			if (!logo) return;
			const marke = logo.querySelector<HTMLElement>(".brand-logo__marke");
			const auf = logo.querySelector<HTMLElement>(".wortmarke__zeichen--auf");
			const zu = logo.querySelector<HTMLElement>(".wortmarke__zeichen--zu");
			const wort = logo.querySelector<HTMLElement>(".wortmarke__wort");
			if (!marke || !auf || !zu || !wort) return;
			const cap = parseFloat(getComputedStyle(wort).fontSize) * 0.7;
			const gap = cap * 0.1;
			const cx = marke.offsetWidth / 2;
			const aufC = { x: auf.offsetLeft + auf.offsetWidth / 2, y: auf.offsetTop + auf.offsetHeight / 2 };
			const zuC = { x: zu.offsetLeft + zu.offsetWidth / 2, y: zu.offsetTop + zu.offsetHeight / 2 };
			// RUHE = VERSETZT (Fred 10.10., sechste Fassung: „vom Start ab die
			// Variante, wo die schon versetzt sind"): die Zeichen behalten ihre
			// Hoehe aus der Wortmarke (links Kopf auf der Grundlinie, rechts
			// Oberkante auf der Oberlaenge) und ruecken nur waagerecht zusammen,
			// Luecke 10 % der Versalhoehe. Ergibt ein kompaktes ‚‛, 0,85 em hoch,
			// fast genau die Knopfhoehe. Das Gegenueber auf einer Hoehe (--dy auf
			// die gemeinsame Mitte) war die fuenfte Fassung.
			logo.style.setProperty("--dx-l", `${cx - gap / 2 - auf.offsetWidth / 2 - aufC.x}px`);
			logo.style.setProperty("--dy-l", `0px`);
			logo.style.setProperty("--dx-r", `${cx + gap / 2 + zu.offsetWidth / 2 - zuC.x}px`);
			logo.style.setProperty("--dy-r", `0px`);
			// Spread-Ziel (Menue-Uebergabe): Zeichen-Mitte je 8 px + halbe
			// Zeichenbreite ausserhalb der Knopfkante; Knopfbreite aus CtaTile
			// (2 × 88 + Fuge), Rueckfall 234 px.
			const knopf = document.querySelector<HTMLElement>(".menu-tile--gated");
			const halb = (knopf?.offsetWidth || 234) / 2;
			const restL = cx - gap / 2 - auf.offsetWidth / 2; // Zeichen-Mitte in Ruhe
			const restR = cx + gap / 2 + zu.offsetWidth / 2;
			logo.style.setProperty("--sx-l", `${cx - halb - 8 - auf.offsetWidth / 2 - restL}px`);
			logo.style.setProperty("--sx-r", `${cx + halb + 8 + zu.offsetWidth / 2 - restR}px`);
			// Versetzt (deutsche Anfuehrungszeichen): links unten buendig mit der
			// Knopf-Unterkante, rechts oben buendig mit der Knopf-Oberkante. Die
			// Marke endet an der Viewport-Unterkante wie der Knopf (beide bottom 0).
			const knopfH = knopf?.offsetHeight || 88;
			const unten = marke.offsetHeight; // Knopf-Unterkante in Marken-Koordinaten
			logo.style.setProperty("--sy-l", `${unten - auf.offsetHeight / 2 - aufC.y}px`);
			logo.style.setProperty("--sy-r", `${unten - knopfH + zu.offsetHeight / 2 - zuC.y}px`);
		};
		measureMarke();
		if (document.fonts && document.fonts.ready) document.fonts.ready.then(measureMarke);
		window.addEventListener("resize", measureMarke, { passive: true });

		let rafId = 0;
		// Spiegel-Rückweg-Zustand (siehe CSS-Kommentar .brand-logo--gliding):
		// beim Verlassen von dock>=1 werden die Phasen eingefroren, bis die
		// Kachel zu ist (CLOSE_MS = CtaTile-Transition), dann Freigabe mit
		// 300ms-Gleit-Transition, danach wieder normale Scroll-Kopplung.
		const CLOSE_MS = 220; // Kachel blendet in 220 ms aus (CtaTile, seit 10.10. Fade statt Geburt)
		const GLIDE_MS = 300;
		let prevRevealed = false;
		let frozen = false;
		let releaseTimer = 0;
		let glideTimer = 0;
		let armTimer = 0;
		let armed = false;
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		const computePhases = () => {
			const raw = (window.scrollY - DOCK_START) / DOCK_DISTANCE;
			const dock = Math.max(0, Math.min(1, raw));
			return {
				dock,
				// Markenbasis-Choreografie (10.10.): --dock-flag = Zeichen gleiten
				// auseinander (dock 0 → 0,4), --dock-text = Wort schreibt sich
				// (0,4 → 0,8); 0,8 → 1 steht die Wortmarke, bei 1 kommt die Kachel.
				phaseText: Math.max(0, Math.min(1, (dock - 0.4) / 0.4)),
				phaseFlag: Math.max(0, Math.min(1, dock / 0.4)),
			};
		};

		const setPhases = (phaseText: number, phaseFlag: number) => {
			root.style.setProperty("--dock-text", String(phaseText));
			root.style.setProperty("--dock-flag", String(phaseFlag));
		};

		const update = () => {
			const { dock, phaseText, phaseFlag } = computePhases();
			// HYSTERESE GEGEN BLITZEN (Fred 10.10.: „wenn ich schnell hoch- oder
			// runterscrolle, blitzt der Menueknopf"): Oeffnen bei dock >= 1
			// (280 px), Schliessen erst wieder unter dock 0,8 (240 px). Ohne das
			// Totband kippte die Klasse bei jedem Scroll-Zittern um die Schwelle
			// hin und her, und Kachel plus Zeichen starteten ihre Transitions
			// immer neu.
			const wantRevealed = prevRevealed ? dock > 0.8 : dock >= 1;
			// ANLAUFZEIT (Fred 10.10., zweiter Befund: „neu laden, zweimal schnell
			// hoch und runter, der Knopf blitzt auf"): ein Flick ueber die
			// Schwelle und sofort zurueck liess die Kachel fuer ein paar Frames
			// aufgehen und wieder zu. Jetzt muss die Position 150 ms jenseits der
			// Schwelle BLEIBEN, bevor der Knopf aufgeht; wer vorher zurueck ist,
			// loest nichts aus. Zu geht er weiterhin sofort.
			if (wantRevealed && !prevRevealed) {
				// RUHE ABWARTEN (dritter Befund 10.10., „immer noch"): nicht 150 ms
				// nach dem Ueberschreiten, sondern 150 ms nach dem LETZTEN
				// Scroll-Ereignis jenseits der Schwelle. Wer in Bewegung ist,
				// bekommt keinen Knopf; er kommt, sobald die Seite steht. Jedes
				// Scroll-Ereignis setzt die Uhr neu.
				clearTimeout(armTimer);
				armTimer = window.setTimeout(() => {
					armTimer = 0;
					if (computePhases().dock >= 1) {
						armed = true;
						update();
					}
				}, 0);
			} else if (!wantRevealed) {
				clearTimeout(armTimer);
				armTimer = 0;
				armed = false;
			}
			const revealed = wantRevealed && (prevRevealed || armed);

			root.style.setProperty("--hero-dock", String(dock));

			if (revealed) {
				// Vorwärts bzw. wieder ganz unten: alles eingefahren, Kachel
				// offen — eventuelle Rückweg-Sequenz abbrechen.
				clearTimeout(releaseTimer);
				clearTimeout(glideTimer);
				frozen = false;
				logo?.classList.remove("brand-logo--gliding");
				setPhases(1, 1);
			} else if (prevRevealed) {
				// EBEN den Button-Zustand verlassen (Rückweg beginnt):
				if (reduceMotion.matches) {
					setPhases(phaseText, phaseFlag);
				} else {
					// Text+Fahne einfrieren, bis die Kachel zu ist …
					frozen = true;
					clearTimeout(releaseTimer);
					releaseTimer = window.setTimeout(() => {
						frozen = false;
						logo?.classList.add("brand-logo--gliding");
						// … dann auf die aktuellen Scroll-Werte GLEITEN lassen
						const now = computePhases();
						setPhases(now.phaseText, now.phaseFlag);
						clearTimeout(glideTimer);
						glideTimer = window.setTimeout(() => {
							logo?.classList.remove("brand-logo--gliding");
							// Anschluss an die Live-Werte (falls weitergescrollt wurde)
							const cur = computePhases();
							setPhases(cur.phaseText, cur.phaseFlag);
						}, GLIDE_MS + 50);
					}, CLOSE_MS);
				}
			} else if (!frozen) {
				// Normale Scroll-Kopplung (auch während des Gleitens: neue
				// Zielwerte retargeten die laufende Transition sanft).
				setPhases(phaseText, phaseFlag);
			}
			// Während frozen: Phasen bleiben auf 1 stehen, nur dock läuft mit.

			// CTA-Kachel: diskretes Ereignis bei dock>=1 (Einfahr-Animation
			// fertig, Stange bereit für die Geburt), NICHT proportional.
			cta?.classList.toggle("menu-tile--revealed", revealed);
			// Stange ausblenden, sobald die Kachel sie "übernommen" hat
			// (sonst scheint sie durch die 95%-Deckkraft der Kachel durch)
			logo?.classList.toggle("brand-logo--handedover", revealed);

			prevRevealed = revealed;
		};

		const onScroll = () => {
			if (rafId) return;
			rafId = requestAnimationFrame(() => {
				update();
				rafId = 0;
			});
		};

		update();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll, { passive: true });
		cleanup = () => {
			window.removeEventListener("scroll", onScroll);
			window.removeEventListener("resize", onScroll);
			window.removeEventListener("resize", measureMarke);
			if (rafId) cancelAnimationFrame(rafId);
			clearTimeout(armTimer);
			clearTimeout(releaseTimer);
			clearTimeout(glideTimer);
			root.style.removeProperty("--hero-dock");
			root.style.removeProperty("--dock-text");
			root.style.removeProperty("--dock-flag");
		};
	}

	document.addEventListener("astro:page-load", initHeroDock);
</script>
