---
// Der eine, feste "Let's Parley"-CTA — site-weit über Layout.astro
// eingebunden. Vormals Teil von MenuTiles.astro (Logo+Menü+CTA in einem
// Bauteil), beim Phase-1-Menü-Rückbau (Website-Brief, "Entscheidung
// 29.08.": Phase 1 ohne Menü) herausgelöst: das Menü selbst liegt jetzt
// archiviert in TileMenu.astro (aktuell nicht eingebunden), dieser
// CTA-Button bleibt als einziges fixes UI-Element aktiv.
//
// Platzierung geändert: vorher unten RECHTS (neben dem Menüblock unten
// MITTE), jetzt selbst unten MITTE (Website-Brief: "Die fixe Let's-parley-
// Kachel wandert von unten rechts nach UNTEN MITTE" — ohne das koexistierende
// Menü ist die Mitte wieder die beste Daumen-/Klick-Zone, siehe Konversions-
// Kapitel "beste Daumen-Zone überhaupt"). Verhalten unverändert: wächst beim
// Hovern als Doppelkachel auf, zeigt "Gespräch buchen →"; auf Touch (kein
// :hover) ist die Unterzeile PERMANENT sichtbar (Website-Brief-Auftrag),
// Tap-Ziel bleibt die volle 88px-Kachel (deutlich über der 44×44px-Vorgabe).
//
// Timing-Bug, Historie über VIER Bau-Versuche:
// 1) Ursprünglich lief die Erscheinen-Animation rein zeitgesteuert (fixe
//    animation-delay), unabhängig vom Hero — die Kachel tauchte sofort beim
//    Laden auf, während das Logo noch stand.
// 2) Ein erster Fix-Versuch koppelte die Kachel per IntersectionObserver an
//    BrandLogo.astro. Zweite Nachbesserung (Fred): das war die falsche
//    Choreografie — BrandLogo.astro lag im normalen Fluss, der Observer
//    beobachtete ein Element, das nur "wegscrollt", nicht "einklappt" —
//    zwei unabhängige Zeitsteuerungen statt einer echten Kopplung.
// 3) Zweiter Fix-Versuch: BrandLogo.astro wieder fixiert, EIN gemeinsamer
//    Fortschrittswert --hero-dock (0…1), diese Kachel deckte sich per
//    clip-path PROPORTIONAL dazu auf. Dritte Nachbesserung (Fred): falsch —
//    die Kachel soll als EREIGNIS erscheinen, GENAU wenn die Logo-Einfahr-
//    Animation fertig ist (dock>=1). BrandLogo.astro's Script setzte dafür
//    die Klasse "cta-tile--revealed", die eine 400ms-Wisch-Animation
//    (von unten) auslöste.
// 4) VIERTE Nachbesserung (Fred, "die Verwandlungs-Kette wird vollständig"):
//    das Wischen von unten war der falsche visuelle Übergang — die Kachel
//    soll stattdessen AUS DER STANGE ENTSTEHEN (BrandLogo.astro's
//    .brand-logo__pole, die nach dem Einfahren von Text+Fahne als einziges
//    Element übrig bleibt): eine horizontale Expansion aus der Mitte
//    heraus (clip-path inset(0 50% 0 50%) -> inset(0 0 0 0)), an EXAKT
//    derselben X-Position wie die Stange (siehe BrandLogo.astro-Kommentar
//    zur TileMenu.astro-Geometrie-Übernahme) und in identischer Farbe
//    (--surface-Ton, die Stange trägt jetzt dieselbe rgba(237,237,237,.95)
//    wie diese Kachel). Technik jetzt eine CSS-transition statt einer
//    Animation (siehe .cta-tile--gated unten) — dadurch automatisch
//    bidirektional: Klasse dran = öffnet sich aus der Stangen-Form zur
//    vollen Kachel, Klasse weg = schließt sich zurück zur Stangen-Form,
//    ohne zwei getrennte Keyframe-Sets pflegen zu müssen.
//    Weiterhin EIN Skript (BrandLogo.astro), EINE Quelle — nur die Art, WIE
//    dieses eine Skript die Kachel steuert, hat sich mit jeder Nachbesserung
//    verfeinert (jetzt: Klasse + CSS-transition statt Klasse + Animation).
interface Props {
	// true nur auf /buchen: die Tür ist schon erreicht, der Button verschwindet.
	hideCta?: boolean;
	// true nur auf der Startseite: die Kachel wird per Klasse (siehe oben)
	// statt zeitgesteuert sichtbar. Unterseiten haben keinen Hero/kein
	// BrandLogo.astro, das die Klasse setzt, und zeigen die Kachel deshalb
	// sofort (ungated).
	gateBehindHero?: boolean;
}

const { hideCta = false, gateBehindHero = false } = Astro.props;
---

{!hideCta && (
	<a href="/buchen" class={`cta-tile${gateBehindHero ? " cta-tile--gated" : ""}`} aria-label="Let's Parley. Gespräch buchen.">
		{/* Das P ist das Marken-P mit Play-Kerbe (aus dem Logo/Favicon,
		   public/parley/parley-p-glyph.svg — hier inline mit currentColor,
		   damit es Textfarbe und ALLE Text-Animationen erbt). Der Rest
		   bleibt echter Text; den zugänglichen Namen trägt das aria-label. */}
		<span class="cta-tile__main" aria-hidden="true">Let's<br /><svg
			class="cta-tile__p"
			viewBox="91.829 56.25 330.342 387.5"
			xmlns="http://www.w3.org/2000/svg"
		><g transform="translate(91.829 56.250) scale(0.840564) translate(-1255.32 -1445.08)"><path
			fill-rule="evenodd"
			clip-rule="evenodd"
			fill="currentColor"
			d="M1261.54 1906.08C1257.61 1906.08 1255.32 1904.1 1255.32 1899.82L1258.59 1681.51L1255.32 1451.01C1255.32 1447.06 1257.61 1445.08 1261.54 1445.08H1456.56C1582.22 1445.08 1648.32 1497.77 1648.32 1601.82C1648.32 1699.29 1579.6 1763.83 1454.6 1763.83H1401.59L1402.57 1899.82C1402.57 1904.1 1400.28 1906.08 1396.68 1906.08H1261.54ZM1401.63 1529.4L1400.18 1602.16L1401.63 1674.92L1465.14 1639.8L1527.2 1602.16L1465.14 1564.52L1401.63 1529.4Z"
		/></g></svg>arley</span>
		<span class="cta-tile__sub">Gespräch buchen →</span>
	</a>
)}

<style>
	.cta-tile {
		/* Unten MITTIG fix, scrollt nicht mit. transform:translateX(-50%) auf
		   einem left:50%-Anker statt right:0 — dadurch bleibt die Kachel beim
		   Hover-Aufwachsen (width-Änderung) automatisch zentriert, weil der
		   Browser die Verschiebung bei jedem Reflow neu aus der aktuellen
		   Breite berechnet, kein manuelles Nachrechnen nötig. Gleiche Stelle
		   wie BrandLogo.astro (auch dort left:50% + translateX(-50%), bottom:0)
		   — die Übergabe passiert exakt an diesem Punkt. */
		--tile-size: 88px;
		--tile-gap: 4px;
		position: fixed;
		left: 50%;
		bottom: 0;
		transform: translateX(-50%);
		width: var(--tile-size);
		height: var(--tile-size);
		display: flex;
		align-items: center;
		justify-content: center;
		/* KEIN fester Fußraum mehr (der frühere padding-bottom:42px schob
		   „Let's Parley" dauerhaft aus der Mitte, auch wenn die Unterzeile
		   unsichtbar war — Freds Befund 30.08.). Der Haupttext ist jetzt echt
		   mittig; erscheint die Unterzeile (Hover/Touch), rückt er per
		   translateY nach oben (siehe .cta-tile__main unten). */
		background: rgba(237, 237, 237, 0.95);
		color: var(--black);
		font-family: "Forma DJR", Helvetica, Arial, sans-serif;
		text-align: center;
		text-decoration: none;
		z-index: 100;
		/* Kommt "von unten ins Bild" (clip-path von komplett verdeckt zu
		   sichtbar), gleiche Technik wie das archivierte Menü. Startzustand
		   ist für BEIDE Varianten (gated/ungated) identisch verdeckt — der
		   Unterschied liegt nur darin, WAS die Sichtbarkeit steuert (siehe
		   unten). */
		clip-path: inset(100% 0 0 0);
	}

	/* Ungated (jede Seite ohne Hero, also alle außer der Startseite): Timing
	   bleibt an den Seitenübergang gekoppelt (PageWipe braucht 800ms) — die
	   Kachel darf sofort erscheinen, es gibt kein Hero-Logo, das sie
	   verdecken müsste. */
	.cta-tile:not(.cta-tile--gated) {
		animation: cta-tile-in 400ms cubic-bezier(0.77, 0, 0.18, 1) 900ms both;
	}

	/* Gated (nur Startseite, gateBehindHero-Prop): "geschlossener" Zustand =
	   die Kachel ist auf die Breite der Stange zusammengezogen — inset(0 50%
	   0 50%) heißt "0% oben/unten, 50% links UND 50% rechts weggeschnitten",
	   also ein 0px schmaler, senkrechter Strich exakt in der Kachel-Mitte
	   (= exakt da, wo BrandLogo.astro's .brand-logo__pole steht, siehe
	   dortiger Kommentar zur pixelgenauen X-Ausrichtung). Läuft NICHT über
	   eine einmalige Animation, sondern über eine transition — CSS-
	   transitions reagieren automatisch auf JEDE Wertänderung, in BEIDE
	   Richtungen, dadurch entsteht die geforderte Reversibilität (Punkt 4)
	   ohne zwei getrennte Keyframe-Sets für "auf" und "zu". */
	/* Doppelklasse für höhere Spezifität: die spätere Hover-Regel
	   ".cta-tile { transition: width ... }" (Media-Query unten) hatte mit
	   gleicher Spezifität die clip-path-Transition ÜBERSCHRIEBEN (transition
	   ist ein Shorthand!) — dadurch sprang die Kachel ohne seitliche
	   Geburts-Animation auf (Bug 29.08. nachts). Jetzt trägt die gated-Regel
	   beide Transitions selbst und gewinnt. */
	.cta-tile.cta-tile--gated {
		animation: none;
		clip-path: inset(0 50% 0 50%);
		/* SCHLIESS-Richtung (Klasse weg): erst verschwindet die Schrift
		   (150ms, siehe __main/__sub unten), DANN fährt die Kachel zu —
		   deshalb hier 150ms Verzögerung auf clip-path (Fred 30.08.). */
		transition:
			clip-path 400ms cubic-bezier(0.77, 0, 0.18, 1) 150ms,
			width 300ms cubic-bezier(0.77, 0, 0.18, 1);
	}

	/* Das eigentliche Ereignis (vierte Nachbesserung, "Der Strich WIRD der
	   Button"): sobald BrandLogo.astro dock>=1 meldet und die Klasse setzt,
	   öffnet sich der Strich horizontal aus der Mitte zur vollen Kachel
	   (inset(0 0 0 0)) — die BBH-Kurve (cubic-bezier(0.77,0,0.18,1)) ist
	   dieselbe, die schon für den Hamburger-Kachel-Wisch in TileMenu.astro
	   und den Seitenübergang (PageWipe.astro) verwendet wurde, hier 1:1
	   wiederverwendet statt neu erfunden. Entfernt BrandLogo.astro die
	   Klasse wieder (zurückgescrollt unter dock 1), übernimmt dieselbe
	   transition automatisch die RÜCKWÄRTS-Animation (Kachel schließt sich
	   zur Stangen-Form) — kein Extra-Code nötig. */
	.cta-tile--gated.cta-tile--revealed {
		clip-path: inset(0 0 0 0);
		/* ÖFFNEN-Richtung: Kachel sofort (keine Verzögerung), die Schrift
		   folgt erst NACH vollständiger Öffnung (siehe unten). */
		transition:
			clip-path 400ms cubic-bezier(0.77, 0, 0.18, 1),
			width 300ms cubic-bezier(0.77, 0, 0.18, 1);
	}

	/* Schrift-Sequenz (Fred 30.08.): „Let's Parley" + Unterzeile sind im
	   gated-Zustand unsichtbar, solange die Kachel nicht VOLL geöffnet ist —
	   sie erscheinen erst nach Ende der Öffnung (400ms Verzögerung) und
	   verschwinden beim Schließen ZUERST (sofort, 150ms), bevor die Kachel
	   zufährt. Überstimmt bewusst auch die Touch-Dauersichtbarkeit der
	   Unterzeile, solange die Kachel nicht offen ist. */
	.cta-tile--gated:not(.cta-tile--revealed) .cta-tile__main,
	.cta-tile--gated:not(.cta-tile--revealed) .cta-tile__sub {
		opacity: 0;
	}

	/* Mikro-Overshoot beim Einblenden (Fred 30.08., „nicht übertreiben"):
	   Schrift startet bei 94%, die Feder-Kurve unten schwingt kurz über 100%
	   und setzt sich. `scale` als eigene Property, damit es dem
	   translateY-Hover (transform) nicht in die Quere kommt. */
	.cta-tile--gated:not(.cta-tile--revealed) .cta-tile__main {
		scale: 0.94;
	}

	.cta-tile--gated.cta-tile--revealed .cta-tile__main {
		scale: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.cta-tile--gated .cta-tile__main {
			transition:
				transform 200ms cubic-bezier(0.77, 0, 0.18, 1),
				opacity 150ms ease,
				scale 150ms ease;
		}

		.cta-tile--gated.cta-tile--revealed .cta-tile__main {
			transition:
				transform 200ms cubic-bezier(0.77, 0, 0.18, 1),
				opacity 200ms ease 400ms,
				scale 350ms cubic-bezier(0.34, 1.56, 0.64, 1) 400ms;
		}

		.cta-tile--gated .cta-tile__sub {
			transition: opacity 150ms ease;
		}

		.cta-tile--gated.cta-tile--revealed .cta-tile__sub {
			transition: opacity 200ms ease 400ms;
		}
	}

	@keyframes cta-tile-in {
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta-tile:not(.cta-tile--gated) {
			animation: none;
			clip-path: inset(0 0 0 0);
		}

		.cta-tile.cta-tile--gated {
			transition: none;
		}
	}

	.cta-tile:hover {
		width: calc(var(--tile-size) * 2 + var(--tile-gap));
	}

	@media (prefers-reduced-motion: no-preference) {
		.cta-tile {
			transition: width 300ms cubic-bezier(0.77, 0, 0.18, 1);
		}
	}

	.cta-tile__main {
		font-weight: 900;
		font-size: 20px;
		line-height: 1.05;
	}

	/* Marken-P mit Play-Kerbe: Höhe ≈ Versalhöhe der 20px-Schrift, sitzt
	   per inline-block-Baseline exakt auf der Schriftlinie. Feintuning der
	   Höhe (0.70–0.74em) bei Bedarf am lebenden Objekt. */
	.cta-tile__p {
		display: inline-block;
		height: 0.72em;
		width: auto;
		vertical-align: baseline;
	}

	/* Platz für die Unterzeile nur, wenn sie sichtbar ist: Hover (Desktop)
	   oder permanent auf Touch — der Haupttext weicht nach oben aus. */
	.cta-tile:hover .cta-tile__main {
		transform: translateY(-10px);
	}

	@media (hover: none) {
		.cta-tile__main {
			transform: translateY(-10px);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.cta-tile__main {
			transition: transform 200ms cubic-bezier(0.77, 0, 0.18, 1);
		}
	}

	.cta-tile__sub {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 14px;
		font-weight: 500;
		font-size: 12px;
		opacity: 0;
	}

	.cta-tile:hover .cta-tile__sub {
		opacity: 1;
	}

	/* Touch hat kein :hover — die Unterzeile muss deshalb permanent sichtbar
	   sein, sonst sieht ein Touch-Besucher "Gespräch buchen →" nie
	   (Website-Brief-Auftrag). */
	@media (hover: none) {
		.cta-tile__sub {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.cta-tile__sub {
			transition: opacity 200ms;
		}
	}
</style>
