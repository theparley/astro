		}

		.mo-trennspalte {
			display: none;
		}

		.mo-wand .mo-kachel {
			/* Faktor 1,0 = Kachelbreite (Fred 14.09.): im Stapel-Modus
			   wirkten die Buchstaben kleiner im Verhältnis zur Kachel als
			   auf Desktop (dort läuft die Schrift entkoppelt in Lead-Typo,
			   ≈ Kachelbreite). Doppel-Selektor nötig: die Basis-Regel steht
			   SPÄTER im Stylesheet und gewann sonst die Spezifität. */
			font-size: var(--mo-k);
		}

		/* Überschrift lief rechts aus dem Bild (das &nbsp; hält "echter
		   Gespräche" als Block zusammen) — kleiner statt umbrechen, damit
		   der gewollte Zeilenfall erhalten bleibt. */
		.mo-kopf h2 {
			font-size: clamp(1.7rem, 9vw, 2.6rem);
		}

		/* Die Input-Hälfte bespielt in beiden Akten nur die Zeilen 0–5
		   (INPUT, 1 GESPRÄCH, weiße Kachel, 1 STUNDE/AUFWAND) — gestapelt
		   wären die leeren Rest-Zeilen ein halber Bildschirm tote Kacheln.
		   Die Engine schreibt weiter in die versteckten Kacheln (harmlos). */
		.mo-halbwand[data-halb="links"] .mo-zeile:nth-child(n + 7) {
			display: none;
		}
	}

	.mo-zeile {
		display: flex;
		gap: 1px; /* Fuge minimal, beide Achsen (Fred 14.09. abends, alle Boards) */
	}

	.mo-kachel {
		width: var(--mo-k);
		height: calc(var(--mo-k) * 1.38);
		background: var(--panel);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
		position: relative;
		/* PERSPEKTIVE (Fred 14.09. abends, "immer noch Ein-/Ausblenden"):
		   rotateX OHNE perspective auf dem Elternelement ist mathematisch
		   nur ein vertikales Stauchen — genau der Blend-Eindruck. Gleiches
		   Verhaeltnis wie .sf-tile (Hoehe × 3.2 = Kachelbreite × 4.4). */
		perspective: calc(var(--mo-k) * 4.4);
		display: flex;
		align-items: center;
		justify-content: center;
		/* Schrift/Schichten kommen aus dem Fallblatt-Material (fallblatt.css:
		   Forma DJR Mono 900 auf .sf-glyph — EIN Tafel-Material, Fred
		   14.09. abends). Hier nur die Größen-Variablen des Moduls:
		   Kachelhöhe + Glyphengröße (= Lead-Formel der Seite, „Von der
		   Kachel ENTKOPPELT", Fred 13.09. dritte Runde). Scharnier-Linie
		   liefert der .sf-hinge-Layer. */
		--sf-tile-h: calc(var(--mo-k) * 1.38);
		--sf-font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		flex: 0 0 auto;
	}

	/* UHR-AUFBAU (Fred 14.09., "Animation in der Animation"): die
	   Weiss-Kachel ist kein voller weisser Block mehr, sondern eine
	   KLEINE UHR — ein gefüllter weisser Kreis, der sich beim Aufklappen
	   der Kachel im Uhrzeigersinn aufbaut (conic-gradient über eine
	   registrierte @property-Winkelvariable). Passt zur Bedeutung: jede
	   Kachel in Akt 2 IST eine Stunde (1 Stunde Aufwand / +100 Stunden
	   Zuschauerzeit). Kachel-Grund bleibt dunkel, nur der Kreis ist weiss. */
	@property --mo-uhr {
		syntax: "<angle>";
		initial-value: 0deg;
		/* inherits:true ist der Kern der Schichten-Synchronität: die
		   Kachel animiert den Winkel, alle vier Kreis-Kopien in den
		   Klapp-Schichten erben denselben Momentanwert. */
		inherits: true;
	}

	/* KOMBINIERT mit dem Kachel-Klapp (Fred 14.09., zweite Runde): die
	   mo-weiss-Klasse kippt am Phasenwechsel der echten Doppelklappe
	   (fireEvent), die Uhr läuft erst NACH dem Aufklappen los
	   (animation-delay ≈ Rest-Klappdauer, fill both hält den Kreis vorher
	   unsichtbar leer). Seit dem Fallblatt-Umbau ist die Uhr ein Overlay
	   auf der KACHEL (über den Klapp-Schichten, z-index 4 > Scharnier 3). */
	.mo-kachel.mo-weiss {
		animation: mo-uhr-aufbau 700ms linear 140ms both;
	}

	.mo-uhr {
