---
// MultiOutputTafel.astro — Sektion „Der Multi-Output echter Gespräche".
// PORT des von Fred am Objekt abgenommenen Entwurfs
// `letitbeam Marketing/website/Ein_Gespraech_Sektion_Entwurf.html`
// (BAU-ANWEISUNG im Website-Brief, Abschnitt „Der Multi-Output echter
// Gespräche", 14.09.2026). Der Entwurf ist die gestalterische Quelle der
// Wahrheit — Ablauf, Zeilen-Inhalte, Wandgeometrie (41 Spalten, Trenner
// exakt Mitte), Zahlenkolonne, rechtsbündige Logos, 10×10-Block, Abbau von
// oben nach unten sind 1:1 übernommen. Eigene Komponente nach dem
// SplitFlap-Muster (SSG-Raster + sr-only-Kernaussage) — SplitFlap.astro
// selbst bleibt unberührt (Format-Tafel).
//
// Beim Port ENTFERNT (reine Entwurfs-Werkzeuge): Timeline-Scrubber, Takt-/
// Lese-Regler, Pause, rote Mitte-Hilfslinie, Entwurfs-Banner. Stattdessen:
// Start per IntersectionObserver beim Viewport-Eintritt, danach Endlos-Loop;
// prefers-reduced-motion zeigt den fertigen Akt-1-Endzustand statisch.
//
// KLAPPER-QUALITÄT: SEIT 14.09. ABENDS VEREINHEITLICHT (Fred: "bei allen
// drei Boards und allen zukünftigen Boards die gleiche Logik") — die Wand
// nutzt jetzt dieselbe Lamellen-Mechanik wie SplitFlap.astro aus dem
// gemeinsamen Modul src/lib/fallblatt.ts (+ styles/fallblatt.css):
// Zeichentrommel mit MAX_FLAPS-Deckel für Einzelzeichen, EINE echte
// Doppelklappe für Logos/Uhr-Kacheln, gleicher Takt (FLAP_STEP_MS). Die Schichten-Struktur baut buildTileLayers
// client-seitig in die leeren SSG-Kacheln (kein sichtbarer Sprung — die
// Wand startet ohnehin leer).
//
// NICHT ANFASSEN ohne Fred (BAU-ANWEISUNG Punkt 6): Zeilen-Wortlaute und
// Zahlen (ungelockt, aber Freds Diktat), Überschrift, Sub-Zeile,
// Logo-Zuordnungen. Offene Flaggen (Zahlen rechenfest, echte Brand-Logos
// nach Markenrichtlinien, Forma-DJR-Mono-Lizenz, Mobil-Form der 41er-Wand)
// stehen in der Port-Checkliste im Website-Brief — hier nicht gelöst.

import "../styles/fallblatt.css";

interface Props {
	/** Zeilen-Takt in Akt 1 (ms je Listenzeile). Fred 14.09.: bewusst schnell — wird am Objekt feingetunt, NICHT gelockt. */
	taktMs?: number;
	/** Lese-Pause am Ende jedes Akts (ms). Ebenfalls ungelockt. */
	leseMs?: number;
	/** Pause zwischen linker und rechter Wandhälfte (ms, Fred 20.09.):
	 * erst steht die INPUT-Seite fertig geflappt da (Akt 1: INPUT +
	 * 1 GESPRÄCH, Akt 2: 1 STUNDE/AUFNAHME + Kreis), dann diese Pause,
	 * dann beginnt die OUTPUT-Seite. */
	seitePauseMs?: number;
	/** ENTSTEHEN-PROBE (Fred 14.09. nacht, /wand): die Kacheln selbst
	 * klappen erst als Welle auf (Board entsteht), DANN beginnt das
	 * Flappen der Timeline. */
	entstehen?: boolean;
}

// Takt = Abstand von Zeile zu Zeile beim Aufbau (Fred 20.09.: "läuft zu
// langsam"): 400 → 260 → 220 → 200 → 180 ms. Regler fürs Tempo; die
// Klappzeit je Kachel (FLAP_STEP_MS 110 im gemeinsamen Modul) sitzt schon
// knapp über der Frame-Grenze und kann kaum schneller.
const { taktMs = 180, leseMs = 2500, seitePauseMs = 500, entstehen = false } = Astro.props;

// Wandgeometrie — identisch zum Entwurf: exakt halbierte Wand, 20 Kacheln
// je Hälfte, EINE Trenner-Spalte auf der Bildmitte.
const HALB = 20;
const GESAMT_COLS = HALB + 1 + HALB; // 41
// +KOPF-Zeilen (Fred 14.09. spät: VIDEOPODCAST wandert IN die Wand) und
// RAND (Fred 14.09. nacht: "Text klebt am Rand" — eine Leerzeile oben und
// unten, eine Leerspalte links und rechts als Passepartout).
// Fred 20.09.: VIDEOPODCAST-Titel und Akt-Label (CONTENT-OUTPUT/WATCHTIME)
// sind raus — die Wand zeigt rechts selbst, was rauskommt. Kopf = Rand-
// Zeile + eine Zeile Luft; die Wand wird dadurch zwei Zeilen kürzer.
const KOPF = 2; // Rand-Zeile + 1 Zeile Luft
const RAND_UNTEN = 1;
// 13 = Anzahl der Output-Zeilen (ZEILEN im Skript unten) — MUSS mitziehen,
// wenn dort eine Zeile dazukommt, sonst fehlen der Wand Kachelzeilen.
// +5 statt +3 seit 20.09. abends: über der Liste steht jetzt auch in Akt 1
// eine Summenzeile ("9 AUSSPIELUNGEN"), auf derselben Höhe wie "100+ STUNDEN"
// und "1000+ ZUSCHAUER" in den Akten 2 und 3 — plus eine Leerzeile
// zwischen Summe und Aufzählung.
const ROWS = 13 + 5 + KOPF + RAND_UNTEN;

// sr-only-Kernaussage (Port-Checkliste Punkt 1): echte Lesefassung der
// Tafel-Botschaft für Crawler/Screenreader — das Kachel-Raster selbst ist
// aria-hidden. Inhalte = Freds Zeilen-Diktat in Satzform.
const kernaussage =
	"Aus einem Gespräch im Monat entstehen: 1 Livestream, 1 Videopodcast, " +
	"1 Audio-Podcast, 10 Beiträge, 10 Clips, 10 Shorts, 1 Newsletter, " +
	"1 Transkript und 10 Zitate für KI. Eure Bibliothek wächst jeden Monat. " +
	"1 Stunde Aufnahme steht gegen 100+ Stunden Zuschauerzeit.";
---

{/* MOBIL-FORM ENTSCHIEDEN (Fred 14.09.): unterhalb eines Breakpoints
   sollen INPUT-Haelfte und OUTPUT-Haelfte der Wand UEBEREINANDER stehen
   statt nebeneinander (die 41er-Wand wird dazu in zwei ~20er-Boards
   zerlegt, Timeline entsprechend). UMGESETZT 14.09. (drei Teil-Wände,
   Breakpoint 760px — Schwellwert ungelockt). */}
<section
	class="mo-sektion"
	data-mo-tafel
	data-takt-ms={taktMs}
	data-lese-ms={leseMs}
	data-seite-pause-ms={seitePauseMs}
	data-entstehen={entstehen ? "1" : undefined}
>
	<div class="mo-kopf">
		{/* Überschrift FINAL (Fred 14.09.); Sub-Zeile = das gelockte
		   Zahlen-Staccato (der frühere Satz 2 mit Content-Output/Beispiel
		   ist seit 14.09. spät raus — VIDEOPODCAST steht in der Wand).
		   Kamera-Wort bleibt komplett draußen. Beide Zeilen NICHT ohne
		   Fred anfassen. */}
		{/* &#8209; = geschützter Bindestrich (Fred 14.09.: der Umbruch „DER
		   MULTI- / OUTPUT" mitten im Kompositum sah nicht schön aus) —
		   „Multi-Output" bricht damit auf keiner Breite mehr auseinander;
		   das &nbsp; hält wie gehabt „echter Gespräche" zusammen. Mögliche
		   Zeilenfälle nur noch: Einzeiler oder der gewollte Zweizeiler. */}
		{/* IMMER zweizeilig (Fred 14.09. nacht): der gewollte Zeilenfall
		   „Der Multi-Output / eines Gesprächs" ist jetzt fest gesetzt —
		   auch wenn Platz für einen Einzeiler wäre. */}
		<h2>Der Multi&#8209;Output<br />eines&nbsp;Gesprächs</h2>
		{/* Vierte Fassung (Fred 14.09., Diktat): „am Beispiel des Formats
		   einer Live-Q&A-Session" — löst das Dreifach-Kompositum
		   „Live-Q&A-Session-Formats" auf und macht ehrlich, dass die Tafel
		   EIN Beispiel zeigt (nicht jedes Format liefert exakt diese
		   Stückzahlen — entlastet still die Zahlen-Flagge). */}
		{/* PROBE Inline-Fallblatt (Fred 14.09. abends, zweite Runde: "nur
		   Zahlen"): die ZIFFERN als einzelne Kacheln im Fließtext — 2
		   Experten, 1 Gespräch, 1 Stunde. Passt zur Zahlenkolonne der
		   Wand; die Wort-Fassung (ZWEI/EIN/EINE) war die erste Probe. */}
		{/* Beispiel-Satz ERSATZLOS raus (Fred 14.09. spät); VIDEOPODCAST
		   steht in der Wand selbst (Kopf-Zeile der Timeline). Die
		   Ziffern-Kacheln (FlapWort 2/1/1) sind nach Sichtung wieder
		   VERWORFEN (Fred: "als Wörter hinschreiben") — es gilt der
		   gelockte Zahlen-Staccato-Wortlaut. Die Inline-Kachel-Komponente
		   FlapWort.astro bleibt als Baustein im Repo. */}
		{/* Zahlwörter fett auf 900 (Fred 14.09. nacht) — gleiche Bauform
		   wie die Expertise-Öffner im Paragraph. */}
		{/* Staccato bleibt, nur die Reihenfolge ist neu (Fred 20.09.):
		   Gespräch, Stunde, Experten — die Fließtext-Fassung ("Ein Gespräch
		   in einer Stunde mit zwei Experten.") war ein Irrweg derselben
		   Runde. Vorfassung 14.09.: "Zwei Experten. Ein Gespräch. Eine
		   Stunde." */}
		<p><strong>Ein</strong> Gespräch. <strong>Eine</strong> Stunde. <strong>Zwei</strong> Experten.</p>
	</div>

	<p class="mo-fallback">{kernaussage}</p>

	{/* Kachelwand: server-gerendert (kein Layout-Sprung, Raster steht auch
	   ohne JS), Inhalte leer — die Timeline flappt sie ein. Rein dekorativ,
	   der Lesetext steht in .mo-fallback. */}
	{/* Wand in DREI Teil-Wänden (Mobil-Umbau Fred 14.09.): links 20,
	   Trenner-Spalte 1, rechts 20 — auf Desktop nebeneinander (optisch
	   identisch zur alten 41er-Wand), unterm Breakpoint stapeln Input-
	   und Output-Hälfte übereinander, der Trenner verschwindet. Die
	   Engine adressiert weiter global tiles[r][0..40] (Mapping unten). */}
	{/* (Akt-Schalter CONTENT-OUTPUT/ZUSCHAUERZEIT vom 14.09. spät nach
	   Sichtung ENTFERNT — Fred: die Wand ist so hoch, dass man zum
	   Treffen der Knöpfe hin- und herscrollen muss. Fassung samt
	   Menü-Schutz und der Content-Wort-Präzisierung in der Git-Historie
	   und im Memory positioning_content_wort_angebot_nicht_verboten.) */}
	<div class="mo-wand-wrap">
		<div class="mo-wand" aria-hidden="true" data-mo-wand>
			<div class="mo-halbwand" data-halb="links">
				{Array.from({ length: ROWS }).map(() => (
					<div class="mo-zeile">
						{Array.from({ length: HALB }).map(() => (
							<div class="mo-kachel"><div class="mo-inhalt">&nbsp;</div></div>
						))}
					</div>
				))}
			</div>
			<div class="mo-trennspalte" data-halb="mitte">
				{Array.from({ length: ROWS }).map(() => (
					<div class="mo-kachel"><div class="mo-inhalt">&nbsp;</div></div>
				))}
			</div>
			<div class="mo-halbwand" data-halb="rechts">
				{Array.from({ length: ROWS }).map(() => (
					<div class="mo-zeile">
						{Array.from({ length: HALB }).map(() => (
							<div class="mo-kachel"><div class="mo-inhalt">&nbsp;</div></div>
						))}
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	// Timeline-Engine — Port aus dem Entwurf (Ein_Gespraech_Sektion_Entwurf
	// .html); die Ablauf-Logik ist bewusst 1:1 übernommen, nur Entwurfs-
	// Steuerung (Scrubber/Regler/Pause) ist durch IntersectionObserver-Start
	// + Endlos-Loop ersetzt. astro:page-load-Muster mit Cleanup wie
	// SplitFlap.astro (ClientRouter-Wechsel würden sonst verwaiste
	// rAF-Schleifen zurücklassen). Die Klapp-Mechanik kommt seit 14.09.
	// abends aus dem gemeinsamen Fallblatt-Modul (EINE Logik, alle Boards).
	import {
		type FlapTile,
		buildTileLayers,
		resetInstant,
		queueFlap,
		enqueue,
		reduceMotion,
		FLAP_STEP_MS,
		stagStreu,
		stagWelle,
		LOGOS,
	} from "../lib/fallblatt";

	// ── Plattform-Logos seit 15.09. im gemeinsamen Modul (lib/fallblatt,
	//    Sync mit GIF-Werkstatt); Flagge „echte Brand-Logos nach Marken-
	//    richtlinien" bleibt offen, siehe Website-Brief. ──

	// ── Zeilen-Wortlaute (Freds Diktat, NICHT ohne ihn ändern) ──
	// Zahlen-Spalte auch im INPUT (Fred 14.09., Mobil-Sicht): die 1 rückt
	// eine Kachel nach rechts, damit sie mit den rechtsbündigen Zahlen der
	// Output-Liste fluchtet (Einser in Spalte 1, Wörter ab Spalte 3);
	// AUFWAND zieht unter STUNDE mit (Muster "   WÄCHST.").
	const INPUT_ZEILE = " 1 GESPRÄCH";
	// Die Taktung steht ganz vorn (Fred 20.09. abends: „ein Gespräch im
	// Monat"). Einzeilig passt es nicht — " 1 GESPRÄCH IM MONAT" wären 20
	// Kacheln, die linke Halbwand hat 20 und braucht den Rand. Also zweite
	// Zeile, eingerückt aufs G wie "   WÄCHST." unter der Bibliothek.
	const INPUT_ZEILE2 = "   IM MONAT";
	const INPUT_COLS = 16;
	// Logo-Reihenfolge je Zeile (Fred 15.09., wie im GIF-Creator): die
	// HÄUFIGSTE Plattform sitzt außen an der gemeinsamen rechten Kante
	// (dort teilen sich alle Zeilen die Spalte), seltene wandern nach
	// innen; Gleichstand nach Set-Reihenfolge. KI-Zeile trägt die vier
	// bekanntesten Assistenten statt des generischen Funkens.
	const ZEILEN: Array<{ text: string; logos: string[] }> = [
		{ text: " 1 LIVESTREAM",    logos: ["linkedin", "youtube"] },
		{ text: " 1 VIDEOPODCAST",  logos: ["web", "youtube"] },
		{ text: " 1 AUDIO-PODCAST", logos: ["spotify", "apple", "web"] },
		{ text: "10 BEITRÄGE",      logos: ["linkedin"] },
		{ text: "10 CLIPS",         logos: ["instagram", "tiktok", "linkedin", "youtube"] },
		{ text: "10 SHORTS",        logos: ["instagram", "tiktok", "youtube"] },
		{ text: " 1 NEWSLETTER",    logos: ["mail"] },
		{ text: " 1 TRANSKRIPT",    logos: ["web"] },
		// Perplexity raus (Fred 20.09.): mit vier Logos rückt die Kolonne so
		// weit nach links, dass das I von KI überdeckt wird.
		{ text: "10 ZITATE FÜR KI", logos: ["chatgpt", "claude", "gemini"] },
		{ text: "", logos: [] },
		// „Eure Bibliothek wächst jeden Monat." (Fred 20.09. abends) — das
		// Gegenstück zum „1 Gespräch im Monat" der Eingangsseite. Dreizeilig,
		// weil "   WÄCHST JEDEN MONAT." 22 Kacheln bräuchte und rechts nur
		// 19 frei sind. Die drei Zeilen laufen in dünner Schrift.
		{ text: " + EURE BIBLIOTHEK", logos: [] },
		{ text: "   WÄCHST JEDEN", logos: [] },
		{ text: "   MONAT.", logos: [] },
	];
	const TEXT_COLS = Math.max(...ZEILEN.map((z) => z.text.length));
	// KOPF-Zeilen + RAND (Fred 14.09. nacht): Zeile 0 bleibt LEER
	// (Passepartout), eine Zeile Luft, dann der Aufbau; unten eine
	// Leerzeile, links Spalte 0 leer, rechts endet vor der letzten Spalte.
	// Fred 20.09.: der VIDEOPODCAST-Titel (Zeile 1) und das Akt-Label
	// (Zeile 2) sind raus — man sieht rechts, was rauskommt; Kopf um zwei
	// Zeilen geschrumpft. Wortlaut-Vorrat: FORMAT_TITEL "VIDEOPODCAST",
	// AKT_LABELS ["CONTENT-OUTPUT","WATCHTIME"] in der Git-Historie.
	const RAND = 1;
	const KOPF = 1 + RAND;
	const ROWS = ZEILEN.length + 5 + KOPF + RAND;
	const HALB = 20;
	const GESAMT_COLS = HALB + 1 + HALB; // 41, Trenner = Spalte 20
	const MITTE_RECHTS = HALB + 1;
	const BLOCK_BREITE = 10;
	// Spaltenköpfe ausgeschrieben (Fred 20.09.: INPUT/OUTPUT statt IN/OUT,
	// weil der Absatz darüber von "multiplizieren" und die Sektion vom
	// Multi-OUTPUT spricht).
	const KOPF_LINKS = "INPUT";
	const KOPF_RECHTS = "OUTPUT";

	type Ev = { t: number; r: number; c: number; html?: string; weiss?: boolean };

	// Versätze aus dem gemeinsamen Modul (15.09.): Aufbau organisch
	// (stagStreu), Abbau (addClearAll) diszipliniert von oben nach
	// unten (stagWelle) — dieselben Formeln nutzt die GIF-Werkstatt.
	const stag = stagStreu;

	function buildTimeline(takt: number, lese: number, seitePause: number) {
		// „Fertig geflappt" = größter Streuversatz einer Zeile (8 × 26 ms)
		// plus die volle Trommelzeit einer Kachel (MAX_FLAPS Klappen).
		// Danach erst läuft die Seitenpause, dann startet die andere Hälfte.
		const FERTIG = 8 * 26 + 6 * FLAP_STEP_MS;
		const events: Ev[] = [];
		const add = (t: number, r: number, c: number, props: Partial<Ev>) =>
			events.push({ t, r, c, ...props });
		const addText = (r: number, startCol: number, breite: number, text: string, base: number) => {
			const voll = text.padEnd(breite, " ");
			[...voll].forEach((ch, i) =>
				add(base + stag(r, startCol + i), r, startCol + i, { html: ch === " " ? "&nbsp;" : ch }),
			);
		};
		const addClearAll = (base: number) => {
			for (let r = 0; r < ROWS; r++)
				for (let c = 0; c < GESAMT_COLS; c++) {
					const tAb = base + stagWelle(r, c);
					add(tAb, r, c, { html: "&nbsp;" });
					add(tAb, r, c, { weiss: false });
				}
		};
		// Nur die RECHTE Hälfte abräumen (Fred 20.09. abends): zwischen den
		// Akten bleibt die linke Seite STEHEN — INPUT, 1 GESPRÄCH und die
		// LIVE-Q&A-SESSION halten, nur der Output flappt raus und macht
		// Platz für die Zuschauerzeit.
		// Die OUTPUT-Kopfzeile bleibt dabei STEHEN (Fred 20.09. abends):
		// beide Spaltenköpfe halten über den Aktwechsel, es flappt nur der
		// Inhalt darunter.
		const addClearRechts = (base: number) => {
			for (let r = 0; r < ROWS; r++)
				for (let c = MITTE_RECHTS; c < GESAMT_COLS; c++) {
					if (r === KOPF) continue;
					const tAb = base + stagWelle(r, c);
					add(tAb, r, c, { html: "&nbsp;" });
					add(tAb, r, c, { weiss: false });
				}
		};
		const CLEAR_RECHTS_MS =
			stagWelle(ROWS - 1, GESAMT_COLS - 1) - stagWelle(0, MITTE_RECHTS) + 6 * FLAP_STEP_MS;

		let t = 200;
		// ── Akt 1: INPUT → 1 GESPRÄCH → OUTPUT → Liste ──
		addText(KOPF, RAND, INPUT_COLS, KOPF_LINKS, t); t += 500;
		addText(KOPF + 2, RAND, INPUT_COLS, INPUT_ZEILE, t);
		addText(KOPF + 3, RAND, INPUT_COLS, INPUT_ZEILE2, t + 160);
		// Formatname unter dem Gespräch, eingerückt auf das G von GESPRÄCH
		// (Index 3 in " 1 GESPRÄCH"). "&" liegt auf der Trommel, kein
		// Sonderzeichen nötig. Fred 20.09. abends: "LIVE" ist raus — ohne
		// das Wort passt "Q&A SESSION" wieder in EINE Zeile (14 von 16
		// Kacheln), die Zweizeiligkeit war nur der Breite geschuldet.
		addText(KOPF + 4, RAND, INPUT_COLS, "   Q&A SESSION", t + 320);
		// Linke Seite steht fertig geflappt → Seitenpause (Fred 20.09.)
		t += FERTIG + seitePause;
		addText(KOPF, MITTE_RECHTS, TEXT_COLS, KOPF_RECHTS, t); t += 500;
		// Anzahl der Ausspielungen über der Liste (Fred 20.09. abends): Akt 1
		// bekommt damit dieselbe Bauform wie Akt 2 und 3 — Kopfwort, Summe,
		// dann das Bild. Die Zahl wird aus ZEILEN GERECHNET, nicht getippt:
		// gezählt werden die Zeilen mit einer Stückzahl davor (die leere
		// Zeile und der Bibliotheks-Nachsatz zählen nicht).
		// WORTWAHL (Fred 20.09. abends, nach Wortsuche): "VARIANTEN" war
		// inhaltsgleich mit "OUTPUT" darüber und mit der Sektionsüberschrift
		// — dreimal derselbe Gedanke. "AUSSPIELUNGEN" trägt die fehlende
		// Information, dass diese neun Dinge RAUSGEHEN, und ist damit die
		// Überschrift der Logo-Kolonne rechts. Deckung: steht schon
		// kundenseitig im Angebots-Master ("Planung der Ausspielung",
		// "Ausspielrhythmus"). 13 Zeichen = 16 Kacheln, fluchtet exakt mit
		// "10 ZITATE FÜR KI". Ausweichwort ohne Jargon-Risiko: "STÜCKE".
		// Verworfen: FORMATE (bezeichnet auf derselben Seite die
		// EINGANGSseite), BEWEISSTÜCKE (Label der Produkte-Sektion),
		// AUFTRITTE (Performance-Modus), DELIVERABLES, VERÖFFENTLICHUNGEN
		// (18 Zeichen).
		const AUSSPIELUNGEN = ZEILEN.filter((z) => /^\s*\d/.test(z.text)).length;
		addText(
			KOPF + 2,
			MITTE_RECHTS,
			TEXT_COLS,
			String(AUSSPIELUNGEN).padStart(2) + " AUSSPIELUNGEN",
			t,
		);
		t += 500;
		ZEILEN.forEach((def, i) => {
			const r = KOPF + 4 + i;
			addText(r, MITTE_RECHTS, TEXT_COLS, def.text, t);
			// Logos rechtsbündig am Wandrand (Gleis-Kolonne), geflappt einzeln:
			def.logos.forEach((name, l) => {
				add(t + 260 + l * 150, r, GESAMT_COLS - RAND - def.logos.length + l, { html: LOGOS[name] });
			});
			t += Math.max(takt, 60);
		});
		t += 500 + lese;
		const akt1EndeT = t - 1; // Moment „Liste steht komplett" (reduced-motion-Standbild)
		// FÜNFTE Dramaturgie-Fassung (Fred 20.09. abends): kein kompletter
		// Abbau mehr zwischen den Akten. Die LINKE Seite hält ihren Stand,
		// nur der OUTPUT flappt raus — dann wächst links die Aufnahme-Zeile
		// nach, und erst wenn die fertig geflappt ist, kommt rechts die
		// Zuschauerzeit. (Vorfassung mit vollem addClearAll + parallelen
		// Kopfzeilen: Git-Historie.)
		addClearRechts(t); t += CLEAR_RECHTS_MS;

		// ── Akt 2: 1 Stunde Aufnahme gegen 100+ Stunden Zuschauerzeit ──
		// Links wächst UNTER dem Gespräch nach (Zahlen-Spalte wie oben:
		// Einser in Spalte 1, Wort ab Spalte 3).
		addText(KOPF + 6, RAND, INPUT_COLS, " 1 STUNDE", t);
		addText(KOPF + 7, RAND, INPUT_COLS, "   AUFNAHMEZEIT", t);
		// Die Uhr sitzt hinter STUNDE, mit EINER Leerkachel Abstand (Fred
		// 20.09. abends): " 1 STUNDE" endet auf Spalte 9, Spalte 10 bleibt
		// leer, der Kreis nimmt Spalte 11.
		add(t + 500, KOPF + 6, RAND + 10, { weiss: true });
		// Links steht fertig geflappt → dieselbe Seitenpause wie in Akt 1
		t += FERTIG + seitePause;
		// Rechts erscheint die Summe UNTER dem stehengebliebenen OUTPUT —
		// auf denselben Zeilen, auf denen eben noch die Liste anfing.
		addText(KOPF + 2, MITTE_RECHTS, TEXT_COLS, "100+ STUNDEN", t);
		addText(KOPF + 3, MITTE_RECHTS, TEXT_COLS, "ZUSCHAUERZEIT", t); t += 500;
		// 10×10-Block: das Zehner-Quadrat hat exakt die Einzelkachel-Proportion
		// 1:1,38 — „die kleine Kachel wird zur großen Kachel", 100 geht glatt auf.
		// DIAGONAL-WELLE (Fred 14.09. abends): Verzögerung = (Zeile ×
		// Versatz + Spalte) × Takt, von oben nach unten. ZEILEN-VERSATZ =
		// Freds Regler-Achse (10 = Zeile fertig, dann nächste; 1 =
		// steilste Diagonale). UNGELOCKT.
		const BLOCK_TAKT = 30;
		const BLOCK_ZEILEN_VERSATZ = 3;
		let i = 0;
		// Block startet eine Zeile tiefer als früher: über ihm stehen jetzt
		// die zwei Beschriftungszeilen + eine Leerzeile (wie in Akt 1).
		const BLOCK_START = KOPF + 5;
		for (let r = BLOCK_START; r < ROWS && i < 100; r++)
			for (let c = 0; c < BLOCK_BREITE && i < 100; c++) {
				const tK = t + ((r - BLOCK_START) * BLOCK_ZEILEN_VERSATZ + c) * BLOCK_TAKT;
				// Letzte Kachel des Quadrats trägt „…" statt Kreis (Fred
				// 20.09. abends, wie beim Zuschauer-Block): das Quadrat hört
				// nicht auf, es bricht ab — deshalb heißt es oben „100+".
				// Die Form bleibt 10×10, nur die untere rechte Ecke wechselt.
				if (i === 99) add(tK, r, MITTE_RECHTS + c, { html: LOGOS.weiter });
				else add(tK, r, MITTE_RECHTS + c, { weiss: true });
				i++;
			}
		const blockDauer = (9 * BLOCK_ZEILEN_VERSATZ + 9) * BLOCK_TAKT;
		// Wahrnehmungs-Pause (Fred 14.09. nacht: "kommt zu schnell"):
		// blockDauer ist nur der STARTVERSATZ der letzten Kachel — bis ihr
		// Kreis wirklich steht, rattert sie noch bis zu 6 Klappen nach.
		// Danach die Lesezeit auf dem fertigen Bild (die Beschriftungen
		// stehen seit 20.09. schon oben, es kommt nichts mehr nach).
		t += blockDauer + 6 * FLAP_STEP_MS + 300 + lese;

		// ── Akt 3: 2 Experten gegen 1000+ Zuschauer ──
		// Gleiches Prinzip wie der Übergang 1→2 (Fred 20.09. abends): die
		// Kreise und die Zuschauerzeit flappen raus, INPUT und OUTPUT
		// bleiben stehen, links bleibt der ganze Stand stehen. Danach
		// wächst links die dritte Zeile nach — und auf DERSELBEN Zeile
		// rechts die Summe, damit das Paar waagerecht zu lesen ist.
		addClearRechts(t); t += CLEAR_RECHTS_MS;
		addText(KOPF + 9, RAND, INPUT_COLS, " 2 EXPERTEN", t);
		// Hinter EXPERTEN stehen ZWEI EIGENE Kacheln mit je einem großen
		// Männchen (Fred 20.09. abends: „zwei große Menschen, nicht die
		// Doppelkachel"). Setzung wie die Uhr hinter STUNDE: Text endet auf
		// Spalte 11, Leerkachel 12, dann Spalte 13 und 14.
		add(t + 500, KOPF + 9, RAND + 12, { html: LOGOS.person1 });
		add(t + 620, KOPF + 9, RAND + 13, { html: LOGOS.person1 });
		t += FERTIG + seitePause;
		// Rechts oben unter OUTPUT (Fred 20.09. abends), auf derselben Zeile
		// wie „100+ STUNDEN" in Akt 2. Der Zuschauer-Block ist NICHT mehr das
		// 10×10-Quadrat der Zuschauerzeit, sondern füllt die rechte Halbwand
		// bis zum Anschlag (Fred 20.09. abends): von der Trennspalte bis zur
		// letzten Kachel vor dem Rand, und nach unten bis zur Randzeile.
		// Jede Kachel trägt VIER Männchen (2×2, Fred 20.09. abends: "das ist mir
		// lieber" — bei acht wurden die Figuren zur Textur).
		addText(KOPF + 2, MITTE_RECHTS, TEXT_COLS, "1000+ ZUSCHAUER", t); t += 500;
		const VOLL_BREITE = GESAMT_COLS - RAND - MITTE_RECHTS; // bis zum Rand rechts
		const VOLL_START = BLOCK_START;
		const VOLL_ZEILEN = ROWS - RAND - VOLL_START; // bis zur Randzeile unten
		// Die LETZTE Kachel unten rechts trägt „…" statt Männchen (Fred
		// 20.09. abends): der Block hört nicht auf, er bricht nur ab.
		const LETZTE_R = VOLL_START + VOLL_ZEILEN - 1;
		const LETZTE_C = VOLL_BREITE - 1;
		for (let r = VOLL_START; r < VOLL_START + VOLL_ZEILEN; r++)
			for (let c = 0; c < VOLL_BREITE; c++) {
				const punkte = r === LETZTE_R && c === LETZTE_C;
				add(
					t + ((r - VOLL_START) * BLOCK_ZEILEN_VERSATZ + c) * BLOCK_TAKT,
					r,
					MITTE_RECHTS + c,
					{ html: punkte ? LOGOS.weiter : LOGOS.personen4 },
				);
			}
		const vollDauer =
			((VOLL_ZEILEN - 1) * BLOCK_ZEILEN_VERSATZ + (VOLL_BREITE - 1)) * BLOCK_TAKT;
		t += vollDauer + 6 * FLAP_STEP_MS + 300 + lese;

		// Schluss-Abbau + ATEMPAUSE vor dem Loop-Neustart (Fred 14.09.: der
		// Neustart kam, bevor die weißen Kacheln ganz weg waren). Der Abbau
		// selbst dauert (ROWS-1)*90 + (COLS-1)*6 ≈ 1,5s — erst NACH seinem
		// Ende plus einer knappen Sekunde Leere beginnt die Wand von vorn.
		addClearAll(t);
		// Abbau-Dauer REAL rechnen (Bugfix 14.09. abends): seit dem
		// Fallblatt-Umbau rattert jede Kachel bis zu MAX_FLAPS Klappen
		// zur Leertafel (statt einem 170ms-Kipp) — die Kaskade allein
		// unterschätzte den Abbau, Nachzügler klapperten in den nächsten
		// Akt hinein.
		const abbauDauer =
			(ROWS - 1) * 90 + (GESAMT_COLS - 1) * 6 + 6 * FLAP_STEP_MS;
		// Stille vor dem Loop-Neustart auf 0 (Fred 20.09., vorher 900 ms) —
		// die Wand beginnt von vorn, sobald die letzte Kachel schwarz ist.
		t += abbauDauer + 0;

		events.sort((a, b) => a.t - b.t);
		return { events, total: t, akt1EndeT };
	}

	function setupTafel(sektion: HTMLElement): () => void {
		const wand = sektion.querySelector<HTMLElement>("[data-mo-wand]");
		if (!wand) return () => {};
		// Drei Teil-Wände → globale tiles[r][0..40]-Matrix (Mobil-Umbau);
		// jede Kachel bekommt client-seitig die Vier-Schichten-Struktur des
		// Fallblatt-Moduls (die SSG-Kacheln sind leer — kein Sprung).
		const rowsL = Array.from(wand.querySelector('[data-halb="links"]')!.children) as HTMLElement[];
		const rowsR = Array.from(wand.querySelector('[data-halb="rechts"]')!.children) as HTMLElement[];
		const trennTiles = Array.from(wand.querySelector('[data-halb="mitte"]')!.children) as HTMLElement[];
		const tiles: FlapTile[][] = rowsL.map((zl, r) =>
			[
				...(Array.from(zl.children) as HTMLElement[]),
				trennTiles[r],
				...(Array.from(rowsR[r].children) as HTMLElement[]),
			].map((el) => buildTileLayers(el)),
		);
		if (sektion.dataset.entstehen === "1") {
			tiles.forEach((row, r) =>
				row.forEach((tile, c) => {
					tile.el.style.transitionDelay = r * 40 + c * 10 + "ms";
				}),
			);
		}

		const takt = Number(sektion.dataset.taktMs) || 400;
		const lese = Number(sektion.dataset.leseMs) || 2500;
		const seitePause = Number(sektion.dataset.seitePauseMs ?? 500);
		const entstehen = sektion.dataset.entstehen === "1";

		const { events, total, akt1EndeT } = buildTimeline(takt, lese, seitePause);

		// Entsteh-Welle: jede Kachel bekommt ihren Versatz als
		// transition-delay (diagonal wie die Block-Welle); Gesamtdauer =
		// letzter Versatz + Klappzeit + Atempause.
		let entstehTimer = 0;
		let ENTSTEH_MS = 0;
		if (entstehen && !reduceMotion()) {
			ENTSTEH_MS = (ROWS - 1) * 40 + (GESAMT_COLS - 1) * 10 + 420 + 250;
		}

		// Pro Kachel indizierte Event-Listen für seekInstant:
		const textEv: Ev[][][] = tiles.map((row) => row.map(() => []));
		const weissEv: Ev[][][] = tiles.map((row) => row.map(() => []));
		events.forEach((ev) => {
			(ev.html !== undefined ? textEv : weissEv)[ev.r][ev.c].push(ev);
		});

		// Timeline-Blanks heißen "&nbsp;", die Trommel kennt " " — hier die
		// eine Übersetzungsstelle.
		const asDrum = (html: string) => (html === "&nbsp;" ? " " : html);

		// Uhr-Kachel: der Kreis ist das TROMMEL-SONDERZEICHEN ● (Fred 14.09.
		// abends, dritte Runde: "einfach in die Kette einfügen") — die
		// Kachel rattert dadurch wie ein Buchstabe durch die Trommel und
		// endet auf dem Kreis. Gerendert wird ● als Kreis-Span (lib,
		// SONDERZEICHEN); den Aufbau-Winkel liest jede Schicht per
		// var(--mo-uhr) von der KACHEL (inherits:true), deshalb laufen
		// Ober- und Unterhälfte nie auseinander.
		const UHR = "●";

		function seekInstant(T: number) {
			for (let r = 0; r < tiles.length; r++)
				for (let c = 0; c < tiles[r].length; c++) {
					const tile = tiles[r][c];
					let te: Ev | null = null;
					for (const ev of textEv[r][c]) { if (ev.t <= T) te = ev; else break; }
					resetInstant(tile, asDrum(te ? te.html! : " "));
					let we: Ev | null = null;
					for (const ev of weissEv[r][c]) { if (ev.t <= T) we = ev; else break; }
					const weiss = !!(we && we.weiss);
					if (weiss) resetInstant(tile, UHR);
					tile.el.classList.toggle("mo-weiss", weiss);
				}
		}

		// Ereignis → Kachel-Warteschlange (pro Kachel strikt geordnet):
		// Einzelzeichen rattern durch die Trommel (MAX_FLAPS-Deckel im
		// Modul), Logos wechseln mit EINER Doppelklappe. Uhr-Kacheln
		// klappen einmal echt auf; die mo-weiss-Klasse kippt am
		// Phasenwechsel, damit der Uhr-Aufbau (animation-delay) mit dem
		// Aufklappen startet. Weiss-AUS räumt nur die Klasse — der Abbau
		// klappt die Kachel ohnehin über sein paralleles Text-Event.
		function fireEvent(ev: Ev) {
			const tile = tiles[ev.r]?.[ev.c];
			if (!tile) return;
			if (ev.html !== undefined) {
				queueFlap(tile, asDrum(ev.html), FLAP_STEP_MS);
			} else if (ev.weiss) {
				// Die Uhr rattert als Trommel-Zeichen herein; die Klasse
				// startet am letzten Phasenwechsel den Winkel-Aufbau.
				queueFlap(tile, UHR, FLAP_STEP_MS, () =>
					tile.el.classList.add("mo-weiss"),
				);
			} else {
				enqueue(tile, () => {
					tile.el.classList.remove("mo-weiss");
				});
			}
		}

		let cancelled = false;
		let rafId = 0;
		let laufend = false;
		let T = 0;
		let gIdx = 0;
		let last = 0;

		function springeZu(startT: number) {
			T = startT;
			gIdx = events.findIndex((e) => e.t >= startT);
			if (gIdx === -1) gIdx = events.length;
			last = performance.now();
			seekInstant(startT);
		}

		function startLoop(vonT = 0) {
			if (cancelled) return;
			springeZu(vonT);
			const loop = (now: number) => {
				if (cancelled || !laufend) return;
				T += now - last;
				last = now;
				if (T > total) {
					springeZu(0);
				}
				while (gIdx < events.length && events[gIdx].t <= T) {
					fireEvent(events[gIdx]);
					gIdx++;
				}
				rafId = requestAnimationFrame(loop);
			};
			rafId = requestAnimationFrame(loop);
		}

		if (reduceMotion()) {
			// Fertiger Akt-1-Endzustand statisch (BAU-ANWEISUNG Punkt 3).
			seekInstant(akt1EndeT);
		} else {
			// VOLL an die Sichtbarkeit gekoppelt (Fred 14.09. abends: "wenn
			// der Viewport neu rein gescrollt wird, immer von vorne"): beim
			// Eintritt startet die Wand frisch bei T=0, beim Austritt hält
			// sie an und wird geleert (seekInstant killt via Generation auch
			// alle in der Luft hängenden Klappen). Kein Weiterlaufen mehr im
			// Verborgenen — das war zugleich die Quelle der Geister-Effekte
			// beim Hoch-/Runterscrollen.
			// START ERST BEI HALBER SICHTBARKEIT (Fred 20.09.: "wenn ich
			// runterscrolle, war die Wand schon bei den Stunden"): der Lauf
			// beginnt erst, wenn die Sektion zur Hälfte im Blick ist. Zwei
			// Bedingungen, damit es auf jeder Höhe funktioniert — entweder
			// die halbe Sektion ist sichtbar (kurze Sektion) ODER sie füllt
			// die halbe Bildschirmhöhe (Sektion höher als der Viewport,
			// sonst würde threshold 0.5 dort nie auslösen). Beendet wird wie
			// gehabt erst beim vollständigen Verlassen.
			const halbDrin = (e: IntersectionObserverEntry) =>
				e.isIntersecting &&
				(e.intersectionRatio >= 0.5 ||
					e.intersectionRect.height >= window.innerHeight * 0.5);
			const io = new IntersectionObserver(
				(entries) => {
					// NUR DER NEUESTE EINTRAG zählt (Bugfix 20.09.): beim
					// schnellen Scrollen liefert der Observer mehrere
					// Zustände in EINEM Paket. Mit some()/every() konnte ein
					// ÄLTERER Eintrag "halb sichtbar" melden, während der
					// jüngste schon "draußen" war — die Wand startete im
					// Verborgenen, merkte sich "läuft" und schaltete beim
					// Zurückscrollen nicht mehr um (Freds Befund: von oben
					// zurück kein Neustart).
					const letzte = entries[entries.length - 1];
					const drin = halbDrin(letzte);
					const ganzDraussen = !letzte.isIntersecting;
					if (drin && !laufend) {
						laufend = true;
						if (entstehen) {
							// Erst die Kachel-Welle, dann die Timeline.
							sektion.classList.add("ist-entstanden");
							entstehTimer = window.setTimeout(() => startLoop(), ENTSTEH_MS);
						} else {
							startLoop();
						}
					} else if (ganzDraussen && laufend) {
						laufend = false;
						cancelAnimationFrame(rafId);
						window.clearTimeout(entstehTimer);
						seekInstant(0);
						// Zurückfalten — beim Wieder-Eintritt entsteht die
						// Wand erneut (Neustart-Regel).
						if (entstehen) sektion.classList.remove("ist-entstanden");
					}
				},
				// Viele Schwellen, damit die Halb-Sichtbarkeit beim Scrollen
				// zuverlässig gemeldet wird (ein einzelner Wert feuert nur
				// beim Überqueren genau dieser Marke).
				{ threshold: Array.from({ length: 21 }, (_, i) => i / 20) },
			);
			io.observe(sektion);
			return () => {
				cancelled = true;
				io.disconnect();
				cancelAnimationFrame(rafId);
			};
		}
		return () => {
			cancelled = true;
			cancelAnimationFrame(rafId);
		};
	}

	let cleanupFns: Array<() => void> = [];
	function mountAll() {
		cleanupFns.forEach((fn) => fn());
		cleanupFns = [];
		document.querySelectorAll<HTMLElement>("[data-mo-tafel]").forEach((el) => {
			cleanupFns.push(setupTafel(el));
		});
	}
	document.addEventListener("astro:page-load", mountAll);
</script>

<style is:global>
	/* is:global + mo--Präfix (gleiche Astro-Falle wie bei SplitFlap.astro
	   dokumentiert): das Skript injiziert Logo-Markup (.mo-logo-text, svg)
	   zur Laufzeit — gescopte Selektoren träfen diese neu erzeugten Elemente
	   nie (kein data-astro-cid). Maße/Formeln 1:1 aus dem Entwurf. */
	.mo-sektion {
		/* Sektions-Abstand oben = BBHs Original-XL (Fred 14.09.: Übergang vom
		   Paragraph war zu eng; BBH fährt zwischen Sektionen 120–320px fluid —
		   Token --abstand-xl in Layout.astro). Unten bleibt das Entwurfs-Maß,
		   die Formatfrage-Sektion holt sich ihren eigenen Abstand. */
		padding: var(--abstand-xl) clamp(16px, 3vw, 56px) 0;
		display: flex;
		flex-direction: column;
		gap: clamp(28px, 4vh, 56px);
	}

	/* Kopf MITTIG (Fred 13.09.) + Haus-Vorgaben statt Entwurfs-Maße:
	   Überschrift = EXAKT das Sektions-Titel-Rezept der Seite (identisch mit
	   .bausteine-titel "Wie wir das machen" — zwei Sektionstitel auf einer
	   Seite teilen EINE Größe, analog der Statement-Einheitsgröße-Regel);
	   Sub-Zeile = EXAKT die .plaedoyer-text-Lead-Typo (BBH-gemessen, weiß
	   statt des Entwurfs-Graus — "Helligkeit wie die Texte oben"). */
	.mo-kopf {
		text-align: center;
	}


	.mo-kopf h2 {
		margin: 0 0 40px;
		font-weight: 900;
		text-transform: uppercase;
		/* 0.9 — seit Fred 14.09. nacht der EINHEITLICHE Zeilenabstand
		   aller Sektionstitel (Regler-Runde 0.85 → 0.95 → 0.9). */
		line-height: 0.9;
		letter-spacing: -0.01em;
		font-size: clamp(2.5rem, 1rem + 7vw, 8rem);
		text-wrap: balance;
	}

	.mo-kopf p {
		font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--white);
		margin: 0 auto;
		max-width: 46rem;
	}

	.mo-kopf p strong {
		font-weight: 900;
	}

	.mo-fallback {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}

	/* Mobil-Form der 41er-Wand ist eine OFFENE Objekt-Entscheidung (Brief);
	   bis dahin scrollt die Wand horizontal statt das Raster zu brechen. */
	.mo-wand-wrap {
		overflow-x: auto;
	}

	.mo-wand {
		display: flex;
		gap: 1px; /* Fuge minimal, beide Achsen (Fred 14.09. abends, alle Boards) */
		--mo-k: clamp(11px, 1.75vw, 30px);
		width: max-content;
		margin: 0 auto;
		/* Gehäuse (Fred 14.09. nacht, mehrere Farb-/Dicken-Runden — Stand:
		   Tokens --tafel-zarge/--tafel-wand in Layout.astro, abgeleitet aus
		   der Kachelfarbe): content-box-Layer = WAND hinter den Kacheln
		   (Fugen), border-box-Layer = ZARGE im Padding-Ring. */
		padding: calc(var(--mo-k) * 0.24); /* 0.16 + 50% (Fred 14.09. nacht) */
		background:
			linear-gradient(var(--tafel-wand, #1a1a1a), var(--tafel-wand, #1a1a1a)) content-box,
			var(--tafel-zarge, #1a1a1a) border-box;
	}

	.mo-halbwand,
	.mo-trennspalte {
		display: flex;
		flex-direction: column;
		gap: 1px; /* Fuge minimal, beide Achsen (Fred 14.09. abends, alle Boards) */
	}

	/* BREAKPOINT (Fred 14.09., entschieden): unterm Schwellwert stapeln
	   Input- und Output-Hälfte übereinander, der Trenner entfällt, die
	   Kacheln füllen mit 20 Spalten die Viewport-Breite, und die Schrift
	   koppelt sich wieder an die Kachelgröße (die Lead-Typo-Entkopplung
	   gilt nur für die breite Wand). Schwellwert ungelockt, am Objekt. */
	@media (max-width: 760px) {
		.mo-wand {
			flex-direction: column;
			gap: clamp(14px, 5vw, 28px);
			--mo-k: calc((100vw - 92px) / 20);
		}

		.mo-trennspalte {
			display: none;
		}

		.mo-wand .mo-kachel {
			/* Faktor 1,0 = Kachelbreite (Fred 14.09.): im Stapel-Modus
			   koppelt die Schrift wieder an die Kachel. REVIEW-FIX 14.09.
			   nacht: seit dem Fallblatt-Layer-Umbau lesen die Glyphen
			   --sf-font-size — die alte font-size-Regel lief ins Leere,
			   mobil liefen die Lead-Glyphen über die kleinen Kacheln. */
			--sf-font-size: var(--mo-k);
		}

		/* Überschrift lief rechts aus dem Bild (das &nbsp; hält "echter
		   Gespräche" als Block zusammen) — kleiner statt umbrechen, damit
		   der gewollte Zeilenfall erhalten bleibt. */
		.mo-kopf h2 {
			font-size: clamp(1.7rem, 9vw, 2.6rem);
		}

		/* ⚠️ MOBIL-FLAGGE VERSCHÄRFT (Review 14.09. nacht): dieser Cut war
		   für die alte Geometrie gebaut. Seit Kopf-Zeilen (+4) und der
		   Akt-2-Dramaturgie liegen links auch der halbe VIDEOPODCAST-Titel
		   (bricht über die Stapel-Hälften!) und die Summen-Zeilen 1 STUNDE/
		   AUFWAND (Zeilen 17/18) — Letztere sind hier mit ABGESCHNITTEN.
		   Die Mobil-Form der Wand ist laut Brief ohnehin eine OFFENE
		   Objekt-Entscheidung; hier nur der ehrliche Befund, kein
		   Nacht-Umbau. Engine schreibt weiter in versteckte Kacheln
		   (harmlos). */
		.mo-halbwand[data-halb="links"] .mo-zeile:nth-child(n + 7) {
			display: none;
		}
	}

	.mo-zeile {
		display: flex;
		gap: 1px; /* Fuge minimal, beide Achsen (Fred 14.09. abends, alle Boards) */
	}

	/* Dünne Schrift für die BESCHRIFTUNGEN (Fred 20.09. abends): was die
	   Zahl erklärt, wiegt leichter als die Zahl selbst — die Zahlenzeilen
	   bleiben 900. Die Forma DJR Mono ist variabel (wght 1–900), 300 ist
	   echte Schnittstärke, kein Fake-Light.
	   LINKS: „Q&A SESSION" (Zeilenindex 6) und „AUFNAHMEZEIT" (9).
	   RECHTS: „EURE BIBLIOTHEK / WÄCHST JEDEN / MONAT." (16/17/18).
	   ACHTUNG: nth-child zählt ab 1, die Indizes hängen an der Timeline —
	   verschiebt sich dort eine Zeile, müssen diese Zahlen mit. */
	.mo-halbwand[data-halb="links"] .mo-zeile:nth-child(7) .sf-glyph,
	.mo-halbwand[data-halb="links"] .mo-zeile:nth-child(10) .sf-glyph,
	.mo-halbwand[data-halb="rechts"] .mo-zeile:nth-child(17) .sf-glyph,
	.mo-halbwand[data-halb="rechts"] .mo-zeile:nth-child(18) .sf-glyph,
	.mo-halbwand[data-halb="rechts"] .mo-zeile:nth-child(19) .sf-glyph {
		font-weight: 300;
	}

	/* Das PLUS bleibt fett (Fred 20.09. abends): es gehört zur Zahlenspalte,
	   nicht zur Beschriftung — " + EURE BIBLIOTHEK" setzt auf Spalte 21 auf,
	   das + sitzt also auf der zweiten Kachel der rechten Halbwand. */
	.mo-halbwand[data-halb="rechts"] .mo-zeile:nth-child(17) .mo-kachel:nth-child(2) .sf-glyph {
		font-weight: 900;
	}

	.mo-kachel {
		width: var(--mo-k);
		height: calc(var(--mo-k) * 1.38);
		/* Jede Kachel ist ein eigener Layout- und Malbereich (20.09. abends,
		   Mobil-Ruckeln): ohne das muss der Browser bei jeder Klappe prüfen,
		   ob sich der Rest der Wand verschiebt — bei 861 Kacheln und ~8.600
		   Knoten ist das auf dem Telefon der teure Teil. `size` bleibt
		   bewusst draußen, die Kachelgröße kommt ja von außen. */
		contain: layout paint style;
		background: var(--panel);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
		position: relative;
		/* PERSPEKTIVE (Fred 14.09. abends, "immer noch Ein-/Ausblenden"):
		   rotateX OHNE perspective auf dem Elternelement ist mathematisch
		   nur ein vertikales Stauchen — genau der Blend-Eindruck. Gleiches
		   Verhaeltnis wie .sf-tile (Hoehe × 3.2 = Kachelbreite × 4.4). */
		perspective: calc(var(--mo-k) * 4.4);
		display: flex;
		align-items: center;
		justify-content: center;
		/* Schrift/Schichten kommen aus dem Fallblatt-Material (fallblatt.css:
		   Forma DJR Mono 900 auf .sf-glyph — EIN Tafel-Material, Fred
		   14.09. abends). Hier nur die Größen-Variablen des Moduls:
		   Kachelhöhe + Glyphengröße (= Lead-Formel der Seite, „Von der
		   Kachel ENTKOPPELT", Fred 13.09. dritte Runde). Scharnier-Linie
		   liefert der .sf-hinge-Layer. */
		--sf-tile-h: calc(var(--mo-k) * 1.38);
		--sf-font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		flex: 0 0 auto;
	}

	/* UHR-AUFBAU (Fred 14.09., "Animation in der Animation"): jede weiße
	   Kachel in Akt 2 IST eine Stunde — der Kreis baut sich nach dem
	   Einklappen im Uhrzeigersinn auf (conic-gradient über eine
	   registrierte @property-Winkelvariable). Der Kreis selbst ist das
	   Trommel-SONDERZEICHEN ● (lib/fallblatt.ts) und lebt als .mo-uhr-Span
	   IN den vier Klapp-Schichten — er klappt wie ein Buchstabe. */
	@property --mo-uhr {
		syntax: "<angle>";
		initial-value: 0deg;
		/* inherits:true ist der Kern der Schichten-Synchronität: die
		   Kachel animiert den Winkel, alle vier Kreis-Kopien in den
		   Klapp-Schichten erben denselben Momentanwert. */
		inherits: true;
	}

	/* Die mo-weiss-Klasse kippt am letzten Phasenwechsel des Einratterns
	   (fireEvent-onMid) und startet NUR den Winkel-Aufbau; animation-delay
	   ≈ Rest-Klappdauer, fill both hält den Kreis vorher unsichtbar leer.
	   inherits:true (unten) synchronisiert alle vier Schichten-Kopien. */
	.mo-kachel.mo-weiss {
		animation: mo-uhr-aufbau 700ms linear 140ms both;
	}

	.mo-uhr {
		width: 70%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: conic-gradient(#ededed var(--mo-uhr), transparent 0);
	}

	@keyframes mo-uhr-aufbau {
		from { --mo-uhr: 0deg; }
		to { --mo-uhr: 360deg; }
	}

	@media (prefers-reduced-motion: reduce) {
		.mo-kachel.mo-weiss {
			animation: none;
			--mo-uhr: 360deg;
		}
	}

	/* ── ENTSTEHEN-PROBE (Fred 14.09. nacht, Seite /wand): die Kacheln
	   selbst klappen als Welle auf, bevor die Timeline flappt. Jede
	   Kachel hängt an ihrer Oberkante (transform-origin top) und fällt
	   ins Bild; den Versatz je Kachel setzt das Skript als
	   transition-delay. Nur aktiv mit data-entstehen. ── */
	.mo-sektion[data-entstehen] .mo-zeile,
	.mo-sektion[data-entstehen] .mo-trennspalte {
		perspective: 900px;
	}

	.mo-sektion[data-entstehen] .mo-kachel {
		transform: rotateX(-92deg);
		transform-origin: center top;
		transition: transform 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	.mo-sektion[data-entstehen].ist-entstanden .mo-kachel {
		transform: rotateX(0deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.mo-sektion[data-entstehen] .mo-kachel {
			transition: none;
			transform: none;
		}
	}

	.mo-kachel svg {
		width: 62%;
		height: 62%;
		display: block;
	}

	/* Große Einzelfigur (Fred 20.09. abends): das Männchen hinter
	   „2 EXPERTEN" soll die Kachel tragen, nicht als Logo darin sitzen.
	   86 % statt 62 % — die Figur ist quadratisch, die Breite begrenzt. */
	.mo-kachel svg.sf-gross {
		width: 86%;
		height: 86%;
	}

	.mo-logo-text {
		font-family: -apple-system, "Helvetica Neue", sans-serif;
		font-weight: 800;
		font-size: calc(var(--mo-k) * 0.62);
		letter-spacing: -0.03em;
	}

</style>
