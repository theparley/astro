	}

	.mo-kopf h2 {
		margin: 0 0 40px;
		font-weight: 900;
		text-transform: uppercase;
		/* 0.95 statt der 0.85 des Sektions-Titel-Rezepts (Fred 13.09.): dieser
		   Titel ist ZWEIZEILIG mit Umlaut — die Ä-Punkte ragen über die
		   Versalhöhe und kollidierten bei 0.85 mit der ersten Zeile.
		   ("Wie wir das machen" bleibt einzeilig bei 0.85 — dort kann nichts
		   kollidieren.) */
		line-height: 0.95;
		letter-spacing: -0.01em;
		font-size: clamp(2.5rem, 1rem + 7vw, 8rem);
		text-wrap: balance;
	}

	.mo-kopf p {
		font-size: clamp(1.125rem, 0.9094rem + 0.9583vw, 1.9444rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--white);
		margin: 0 auto;
		max-width: 46rem;
	}

	.mo-fallback {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}

	/* Mobil-Form der 41er-Wand ist eine OFFENE Objekt-Entscheidung (Brief);
	   bis dahin scrollt die Wand horizontal statt das Raster zu brechen. */
