---
// MultiOutputTafel.astro — Sektion „Der Multi-Output echter Gespräche".
// PORT des von Fred am Objekt abgenommenen Entwurfs
// `letitbeam Marketing/website/Ein_Gespraech_Sektion_Entwurf.html`
// (BAU-ANWEISUNG im Website-Brief, Abschnitt „Der Multi-Output echter
// Gespräche", 14.09.2026). Der Entwurf ist die gestalterische Quelle der
// Wahrheit — Ablauf, Zeilen-Inhalte, Wandgeometrie (41 Spalten, Trenner
// exakt Mitte), Zahlenkolonne, rechtsbündige Logos, 10×10-Block, Abbau von
// oben nach unten sind 1:1 übernommen. Eigene Komponente nach dem
// SplitFlap-Muster (SSG-Raster + sr-only-Kernaussage) — SplitFlap.astro
// selbst bleibt unberührt (Format-Tafel).
//
// Beim Port ENTFERNT (reine Entwurfs-Werkzeuge): Timeline-Scrubber, Takt-/
// Lese-Regler, Pause, rote Mitte-Hilfslinie, Entwurfs-Banner. Stattdessen:
// Start per IntersectionObserver beim Viewport-Eintritt, danach Endlos-Loop;
// prefers-reduced-motion zeigt den fertigen Akt-1-Endzustand statisch.
//
// KLAPPER-QUALITÄT: SEIT 14.09. ABENDS VEREINHEITLICHT (Fred: "bei allen
// drei Boards und allen zukünftigen Boards die gleiche Logik") — die Wand
// nutzt jetzt dieselbe Lamellen-Mechanik wie SplitFlap.astro aus dem
// gemeinsamen Modul src/lib/fallblatt.ts (+ styles/fallblatt.css):
// Zeichentrommel mit MAX_FLAPS-Deckel für Einzelzeichen, EINE echte
// Doppelklappe für Logos/Uhr-Kacheln, gleicher Takt (FLAP_STEP_MS). Die Schichten-Struktur baut buildTileLayers
// client-seitig in die leeren SSG-Kacheln (kein sichtbarer Sprung — die
// Wand startet ohnehin leer).
//
// NICHT ANFASSEN ohne Fred (BAU-ANWEISUNG Punkt 6): Zeilen-Wortlaute und
// Zahlen (ungelockt, aber Freds Diktat), Überschrift, Sub-Zeile,
// Logo-Zuordnungen. Offene Flaggen (Zahlen rechenfest, echte Brand-Logos
// nach Markenrichtlinien, Forma-DJR-Mono-Lizenz, Mobil-Form der 41er-Wand)
// stehen in der Port-Checkliste im Website-Brief — hier nicht gelöst.

import "../styles/fallblatt.css";

interface Props {
	/** Zeilen-Takt in Akt 1 (ms je Listenzeile). Fred 14.09.: bewusst schnell — wird am Objekt feingetunt, NICHT gelockt. */
	taktMs?: number;
	/** Lese-Pause am Ende jedes Akts (ms). Ebenfalls ungelockt. */
	leseMs?: number;
	/** Dauer der einzelnen Kipp-Bewegung einer Kachel (ms). */
	flipMs?: number;
}

const { taktMs = 400, leseMs = 2500, flipMs = 85 } = Astro.props;

// Wandgeometrie — identisch zum Entwurf: exakt halbierte Wand, 20 Kacheln
// je Hälfte, EINE Trenner-Spalte auf der Bildmitte.
const HALB = 20;
const GESAMT_COLS = HALB + 1 + HALB; // 41
// +3 KOPF-Zeilen (Fred 14.09. spät: VIDEOPODCAST wandert IN die Wand
// statt als separate Zeile darüber — Titel-Zeile + 2 Zeilen Luft).
const KOPF = 3;
const ROWS = 12 + 3 + KOPF; // Kopf + 12 Listen-Zeilen + Kopfzeile, Leerzeile, Reserve

// sr-only-Kernaussage (Port-Checkliste Punkt 1): echte Lesefassung der
// Tafel-Botschaft für Crawler/Screenreader — das Kachel-Raster selbst ist
// aria-hidden. Inhalte = Freds Zeilen-Diktat in Satzform.
const kernaussage =
	"Aus einem Gespräch im Monat entstehen: 1 Livestream, 1 Videopodcast, " +
	"1 Audio-Podcast, 10 Beiträge, 10 Clips, 10 Shorts, 1 Newsletter, " +
	"1 Transkript und 10 Zitate für KI. Eure Bibliothek wächst. " +
	"1 Stunde Aufwand steht gegen 100+ Stunden Zuschauerzeit.";
---

{/* MOBIL-FORM ENTSCHIEDEN (Fred 14.09.): unterhalb eines Breakpoints
   sollen INPUT-Haelfte und OUTPUT-Haelfte der Wand UEBEREINANDER stehen
   statt nebeneinander (die 41er-Wand wird dazu in zwei ~20er-Boards
   zerlegt, Timeline entsprechend). UMGESETZT 14.09. (drei Teil-Wände,
   Breakpoint 760px — Schwellwert ungelockt). */}
<section
	class="mo-sektion"
	data-mo-tafel
	data-takt-ms={taktMs}
	data-lese-ms={leseMs}
	data-flip-ms={flipMs}
>
	<div class="mo-kopf">
		{/* Überschrift FINAL (Fred 14.09.); Sub-Zeile dritte Fassung (Fred
		   14.09. nachts, Diktat): Zahlen-Staccato "Zwei. Ein. Eine." (passt
		   zur Zahlenkolonnen-Ästhetik der Tafel) + Satz 2 kündigt BEIDE Akte
		   an (Content-Output = Akt 1, Zuschauerzeit = Akt 2). ⚠️ "Content"
		   steht hier erstmals auf der EIGENEN Seite (Register-Regel: Content
		   = Wort der KI-/Flut-Seite) — als bewusste Fred-Entscheidung
		   umgesetzt und im Brief geflaggt; schlanke Alternative ohne Content:
		   "Der Output und die Zuschauerzeit …". Kamera-Wort bleibt weiter
		   komplett draußen. Beide Zeilen NICHT ohne Fred anfassen. */}
		{/* &#8209; = geschützter Bindestrich (Fred 14.09.: der Umbruch „DER
		   MULTI- / OUTPUT" mitten im Kompositum sah nicht schön aus) —
		   „Multi-Output" bricht damit auf keiner Breite mehr auseinander;
		   das &nbsp; hält wie gehabt „echter Gespräche" zusammen. Mögliche
		   Zeilenfälle nur noch: Einzeiler oder der gewollte Zweizeiler. */}
		<h2>Der Multi&#8209;Output eines&nbsp;Gesprächs</h2>
		{/* Vierte Fassung (Fred 14.09., Diktat): „am Beispiel des Formats
		   einer Live-Q&A-Session" — löst das Dreifach-Kompositum
		   „Live-Q&A-Session-Formats" auf und macht ehrlich, dass die Tafel
		   EIN Beispiel zeigt (nicht jedes Format liefert exakt diese
		   Stückzahlen — entlastet still die Zahlen-Flagge). */}
		{/* PROBE Inline-Fallblatt (Fred 14.09. abends, zweite Runde: "nur
		   Zahlen"): die ZIFFERN als einzelne Kacheln im Fließtext — 2
		   Experten, 1 Gespräch, 1 Stunde. Passt zur Zahlenkolonne der
		   Wand; die Wort-Fassung (ZWEI/EIN/EINE) war die erste Probe. */}
		{/* Beispiel-Satz ERSATZLOS raus (Fred 14.09. spät); VIDEOPODCAST
		   steht in der Wand selbst (Kopf-Zeile der Timeline). Die
		   Ziffern-Kacheln (FlapWort 2/1/1) sind nach Sichtung wieder
		   VERWORFEN (Fred: "als Wörter hinschreiben") — es gilt der
		   gelockte Zahlen-Staccato-Wortlaut. Die Inline-Kachel-Komponente
		   FlapWort.astro bleibt als Baustein im Repo. */}
		<p>Zwei Experten. Ein Gespräch. Eine Stunde.</p>
	</div>

	<p class="mo-fallback">{kernaussage}</p>

	{/* Kachelwand: server-gerendert (kein Layout-Sprung, Raster steht auch
	   ohne JS), Inhalte leer — die Timeline flappt sie ein. Rein dekorativ,
	   der Lesetext steht in .mo-fallback. */}
	{/* Wand in DREI Teil-Wänden (Mobil-Umbau Fred 14.09.): links 20,
	   Trenner-Spalte 1, rechts 20 — auf Desktop nebeneinander (optisch
	   identisch zur alten 41er-Wand), unterm Breakpoint stapeln Input-
	   und Output-Hälfte übereinander, der Trenner verschwindet. Die
	   Engine adressiert weiter global tiles[r][0..40] (Mapping unten). */}
	{/* AKT-SCHALTER (Fred 14.09. spät: "hin- und herschalten zwischen
	   Content Output und Zuschauerzeit"): zwei Kachel-Schalter in der
	   Haus-Grammatik (dunkel = tippbar, weiß gefüllt = gewählt/aktiv).
	   Im Automatik-Lauf zeigen sie den gerade spielenden Akt an; ein
	   Klick übernimmt, spielt den Akt von vorn und hält auf dessen
	   Endbild. Rausscrollen setzt auf Automatik zurück. */}
	<div class="mo-schalter">
		{/* "Content-Output" (Fred 14.09. spät) — und Fred hat die
		   Register-Regel dabei präzisiert: Content ist für The Parley NICHT
		   verboten, sondern ein Angebot ("wir bieten das eben auch an, wir
		   können das auch"). Die Regel meint: Content nicht als EIGENES
		   Identitätswort für die Gesprächs-These verwenden — als Kategorie
		   des Outputs, den der Markt kennt und wir liefern, ist es korrekt.
		   Genau das benennt der Schalter. */}
		<button type="button" class="mo-schalt" data-akt="1">Content-Output</button>
		<button type="button" class="mo-schalt" data-akt="2">Zuschauerzeit</button>
	</div>

	<div class="mo-wand-wrap">
		<div class="mo-wand" aria-hidden="true" data-mo-wand>
			<div class="mo-halbwand" data-halb="links">
				{Array.from({ length: ROWS }).map(() => (
					<div class="mo-zeile">
						{Array.from({ length: HALB }).map(() => (
							<div class="mo-kachel"><div class="mo-inhalt">&nbsp;</div></div>
						))}
					</div>
				))}
			</div>
			<div class="mo-trennspalte" data-halb="mitte">
				{Array.from({ length: ROWS }).map(() => (
					<div class="mo-kachel"><div class="mo-inhalt">&nbsp;</div></div>
				))}
			</div>
			<div class="mo-halbwand" data-halb="rechts">
				{Array.from({ length: ROWS }).map(() => (
					<div class="mo-zeile">
						{Array.from({ length: HALB }).map(() => (
							<div class="mo-kachel"><div class="mo-inhalt">&nbsp;</div></div>
						))}
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	// Timeline-Engine — Port aus dem Entwurf (Ein_Gespraech_Sektion_Entwurf
	// .html); die Ablauf-Logik ist bewusst 1:1 übernommen, nur Entwurfs-
	// Steuerung (Scrubber/Regler/Pause) ist durch IntersectionObserver-Start
	// + Endlos-Loop ersetzt. astro:page-load-Muster mit Cleanup wie
	// SplitFlap.astro (ClientRouter-Wechsel würden sonst verwaiste
	// rAF-Schleifen zurücklassen). Die Klapp-Mechanik kommt seit 14.09.
	// abends aus dem gemeinsamen Fallblatt-Modul (EINE Logik, alle Boards).
	import {
		type FlapTile,
		buildTileLayers,
		resetInstant,
		flapOnce,
		queueFlap,
		enqueue,
		reduceMotion,
		FLAP_STEP_MS,
	} from "../lib/fallblatt";

	// ── Vereinfachte Plattform-Logos (Entwurf 1:1; Flagge „echte Brand-Logos
	//    nach Markenrichtlinien" bleibt offen, siehe Website-Brief). ──
	const LOGOS: Record<string, string> = {
		linkedin: '<span class="mo-logo-text">in</span>',
		youtube: '<svg viewBox="0 0 24 24" fill="none"><rect x="1" y="4" width="22" height="16" rx="4.5" stroke="white" stroke-width="1.8"/><path d="M10 8.8v6.4l5.6-3.2z" fill="white"/></svg>',
		instagram: '<svg viewBox="0 0 24 24" fill="none"><rect x="2.2" y="2.2" width="19.6" height="19.6" rx="5.5" stroke="white" stroke-width="1.8"/><circle cx="12" cy="12" r="4.6" stroke="white" stroke-width="1.8"/><circle cx="17.6" cy="6.4" r="1.4" fill="white"/></svg>',
		tiktok: '<svg viewBox="0 0 24 24" fill="white"><path d="M14.5 3h2.2c.2 1.8 1.4 3.3 3.8 3.7v2.5c-1.5 0-2.8-.5-3.8-1.2v6.6c0 3.4-2.3 5.9-5.6 5.9-3.1 0-5.6-2.3-5.6-5.5 0-3.4 2.9-5.8 6.2-5.4v2.6c-1.9-.5-3.6.8-3.6 2.7 0 1.7 1.3 3 3 3 1.9 0 3.4-1.4 3.4-3.7V3z"/></svg>',
		spotify: '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.8"/><path d="M6.8 9.6c3.4-1 7.2-.7 10.2 1M7.4 12.6c2.8-.8 5.8-.5 8.2.8M8 15.4c2.2-.6 4.4-.4 6.3.6" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>',
		apple: '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9.5" stroke="white" stroke-width="1.6"/><circle cx="12" cy="8.8" r="2.5" fill="white"/><path d="M9.3 17.8c.3-3.2 1.1-4.8 2.7-4.8s2.4 1.6 2.7 4.8a6.9 6.9 0 0 1-5.4 0z" fill="white"/></svg>',
		web: '<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6"><circle cx="12" cy="12" r="9.5"/><ellipse cx="12" cy="12" rx="4.2" ry="9.5"/><path d="M2.8 12h18.4M4 7h16M4 17h16"/></svg>',
		mail: '<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2.5"/><path d="M3 6.5l9 7 9-7"/></svg>',
		ki: '<svg viewBox="0 0 24 24" fill="white"><path d="M12 2.5l1.9 6.2 6.2 1.9-6.2 1.9L12 18.7l-1.9-6.2-6.2-1.9 6.2-1.9z"/><path d="M19 15.5l.9 2.8 2.8.9-2.8.9-.9 2.8-.9-2.8-2.8-.9 2.8-.9z" opacity="0.85"/></svg>',
	};

	// ── Zeilen-Wortlaute (Freds Diktat, NICHT ohne ihn ändern) ──
	// Zahlen-Spalte auch im INPUT (Fred 14.09., Mobil-Sicht): die 1 rückt
	// eine Kachel nach rechts, damit sie mit den rechtsbündigen Zahlen der
	// Output-Liste fluchtet (Einser in Spalte 1, Wörter ab Spalte 3);
	// AUFWAND zieht unter STUNDE mit (Muster "   WÄCHST.").
	const INPUT_ZEILE = " 1 GESPRÄCH";
	const INPUT_COLS = 16;
	const ZEILEN: Array<{ text: string; logos: string[] }> = [
		{ text: " 1 LIVESTREAM",    logos: ["linkedin", "youtube"] },
		{ text: " 1 VIDEOPODCAST",  logos: ["youtube", "web"] },
		{ text: " 1 AUDIO-PODCAST", logos: ["spotify", "apple", "web"] },
		{ text: "10 BEITRÄGE",      logos: ["linkedin"] },
		{ text: "10 CLIPS",         logos: ["linkedin", "instagram", "tiktok", "youtube"] },
		{ text: "10 SHORTS",        logos: ["youtube", "instagram", "tiktok"] },
		{ text: " 1 NEWSLETTER",    logos: ["mail"] },
		{ text: " 1 TRANSKRIPT",    logos: ["web"] },
		{ text: "10 ZITATE FÜR KI", logos: ["ki"] },
		{ text: "", logos: [] },
		{ text: " + EURE BIBLIOTHEK", logos: [] },
		{ text: "   WÄCHST.", logos: [] },
	];
	const TEXT_COLS = Math.max(...ZEILEN.map((z) => z.text.length));
	// KOPF-Zeilen (Fred 14.09. spät): Zeile 0 = VIDEOPODCAST mittig über
	// der ganzen Wand, zwei Zeilen Luft, dann der bisherige Aufbau um
	// KOPF nach unten verschoben.
	const KOPF = 3;
	const ROWS = ZEILEN.length + 3 + KOPF;
	const HALB = 20;
	const GESAMT_COLS = HALB + 1 + HALB; // 41, Trenner = Spalte 20
	const MITTE_RECHTS = HALB + 1;
	const SUMME_ROW = 13 + KOPF;
	const BLOCK_BREITE = 10;
	const FORMAT_TITEL = "VIDEOPODCAST";
	const FORMAT_START = Math.floor((GESAMT_COLS - FORMAT_TITEL.length) / 2);

	type Ev = { t: number; r: number; c: number; html?: string; weiss?: boolean };

	// Deterministischer "Zufalls"-Versatz je Kachel (Entwurf) — Aufbau
	// organisch, Abbau (addClearAll) diszipliniert von oben nach unten.
	function stag(r: number, c: number) {
		return ((r * 37 + c * 23) % 9) * 26;
	}

	function buildTimeline(takt: number, lese: number) {
		const events: Ev[] = [];
		const add = (t: number, r: number, c: number, props: Partial<Ev>) =>
			events.push({ t, r, c, ...props });
		const addText = (r: number, startCol: number, breite: number, text: string, base: number) => {
			const voll = text.padEnd(breite, " ");
			[...voll].forEach((ch, i) =>
				add(base + stag(r, startCol + i), r, startCol + i, { html: ch === " " ? "&nbsp;" : ch }),
			);
		};
		const addClearAll = (base: number) => {
			for (let r = 0; r < ROWS; r++)
				for (let c = 0; c < GESAMT_COLS; c++) {
					const tAb = base + r * 90 + c * 6;
					add(tAb, r, c, { html: "&nbsp;" });
					add(tAb, r, c, { weiss: false });
				}
		};

		let t = 200;
		// ── Akt 1: FORMAT-TITEL → INPUT → 1 GESPRÄCH → OUTPUT → Liste ──
		addText(0, FORMAT_START, FORMAT_TITEL.length, FORMAT_TITEL, t); t += 600;
		addText(KOPF, 0, INPUT_COLS, "INPUT", t); t += 500;
		addText(KOPF + 2, 0, INPUT_COLS, INPUT_ZEILE, t); t += 600;
		addText(KOPF, MITTE_RECHTS, TEXT_COLS, "OUTPUT", t); t += 500;
		ZEILEN.forEach((def, i) => {
			const r = KOPF + 2 + i;
			addText(r, MITTE_RECHTS, TEXT_COLS, def.text, t);
			// Logos rechtsbündig am Wandrand (Gleis-Kolonne), geflappt einzeln:
			def.logos.forEach((name, l) => {
				add(t + 260 + l * 150, r, GESAMT_COLS - def.logos.length + l, { html: LOGOS[name] });
			});
			t += Math.max(takt, 60);
		});
		t += 500 + lese;
		const akt1EndeT = t - 1; // Moment „Liste steht komplett" (reduced-motion-Standbild)
		// Auch hier: Kaskade + echte Trommel-Klappzeit (s. Abbau unten).
		addClearAll(t); t += (ROWS - 1) * 90 + (GESAMT_COLS - 1) * 6 + 6 * FLAP_STEP_MS + 500;

		// ── Akt 2: 1 Stunde Aufwand gegen +100 Stunden Zuschauerzeit ──
		// (Die Von-unten-Dramaturgie vom 14.09. spät ist VERWORFEN — Fred
		// nach Sichtung: "sieht doch nicht so gut aus, zurück auf die
		// alte". Es gilt wieder: alles baut von oben nach unten.)
		const akt2StartT = t;
		addText(0, FORMAT_START, FORMAT_TITEL.length, FORMAT_TITEL, t); t += 600;
		addText(KOPF, 0, INPUT_COLS, "INPUT", t); t += 500;
		add(t, KOPF + 2, 0, { weiss: true }); t += 500;
		// Kein Einrück-Leerzeichen mehr (Fred 14.09. spät): Kreis, Zahl und
		// Wort stehen bündig an Spalte 0 — wie die Output-Seite.
		addText(KOPF + 4, 0, INPUT_COLS, "1 STUNDE", t);
		addText(KOPF + 5, 0, INPUT_COLS, "AUFWAND", t); t += 600;
		addText(KOPF, MITTE_RECHTS, TEXT_COLS, "OUTPUT", t); t += 500;
		// 10×10-Block: das Zehner-Quadrat hat exakt die Einzelkachel-Proportion
		// 1:1,38 — „die kleine Kachel wird zur großen Kachel", 100 geht glatt auf.
		// DIAGONAL-WELLE (Fred 14.09. abends): Verzögerung = (Zeile ×
		// Versatz + Spalte) × Takt, von oben nach unten. ZEILEN-VERSATZ =
		// Freds Regler-Achse (10 = Zeile fertig, dann nächste; 1 =
		// steilste Diagonale). UNGELOCKT.
		const BLOCK_TAKT = 30;
		const BLOCK_ZEILEN_VERSATZ = 3;
		let i = 0;
		for (let r = KOPF + 2; r < ROWS && i < 100; r++)
			for (let c = 0; c < BLOCK_BREITE && i < 100; c++) {
				add(t + ((r - KOPF - 2) * BLOCK_ZEILEN_VERSATZ + c) * BLOCK_TAKT, r, MITTE_RECHTS + c, { weiss: true });
				i++;
			}
		const blockDauer = (9 * BLOCK_ZEILEN_VERSATZ + 9) * BLOCK_TAKT;
		t += blockDauer + 400;
		addText(SUMME_ROW, MITTE_RECHTS, TEXT_COLS, "100+ STUNDEN", t);
		addText(SUMME_ROW + 1, MITTE_RECHTS, TEXT_COLS, "ZUSCHAUERZEIT", t);
		t += 300 + lese;
		const akt2EndeT = t - 1; // Standbild-Moment für den Schalter-Modus
		// Schluss-Abbau + ATEMPAUSE vor dem Loop-Neustart (Fred 14.09.: der
		// Neustart kam, bevor die weißen Kacheln ganz weg waren). Der Abbau
		// selbst dauert (ROWS-1)*90 + (COLS-1)*6 ≈ 1,5s — erst NACH seinem
		// Ende plus einer knappen Sekunde Leere beginnt die Wand von vorn.
		addClearAll(t);
		// Abbau-Dauer REAL rechnen (Bugfix 14.09. abends): seit dem
		// Fallblatt-Umbau rattert jede Kachel bis zu MAX_FLAPS Klappen
		// zur Leertafel (statt einem 170ms-Kipp) — die Kaskade allein
		// unterschätzte den Abbau, Nachzügler klapperten in den nächsten
		// Akt hinein.
		const abbauDauer =
			(ROWS - 1) * 90 + (GESAMT_COLS - 1) * 6 + 6 * FLAP_STEP_MS;
		t += abbauDauer + 900;

		events.sort((a, b) => a.t - b.t);
		return { events, total: t, akt1EndeT, akt2StartT, akt2EndeT };
	}

	function setupTafel(sektion: HTMLElement): () => void {
		const wand = sektion.querySelector<HTMLElement>("[data-mo-wand]");
		if (!wand) return () => {};
		// Drei Teil-Wände → globale tiles[r][0..40]-Matrix (Mobil-Umbau);
		// jede Kachel bekommt client-seitig die Vier-Schichten-Struktur des
		// Fallblatt-Moduls (die SSG-Kacheln sind leer — kein Sprung).
		const rowsL = Array.from(wand.querySelector('[data-halb="links"]')!.children) as HTMLElement[];
		const rowsR = Array.from(wand.querySelector('[data-halb="rechts"]')!.children) as HTMLElement[];
		const trennTiles = Array.from(wand.querySelector('[data-halb="mitte"]')!.children) as HTMLElement[];
		const tiles: FlapTile[][] = rowsL.map((zl, r) =>
			[
				...(Array.from(zl.children) as HTMLElement[]),
				trennTiles[r],
				...(Array.from(rowsR[r].children) as HTMLElement[]),
			].map((el) => buildTileLayers(el)),
		);

		const takt = Number(sektion.dataset.taktMs) || 400;
		const lese = Number(sektion.dataset.leseMs) || 2500;

		const { events, total, akt1EndeT, akt2StartT, akt2EndeT } = buildTimeline(takt, lese);
		const schalter = Array.from(sektion.querySelectorAll<HTMLButtonElement>(".mo-schalt"));

		// Pro Kachel indizierte Event-Listen für seekInstant:
		const textEv: Ev[][][] = tiles.map((row) => row.map(() => []));
		const weissEv: Ev[][][] = tiles.map((row) => row.map(() => []));
		events.forEach((ev) => {
			(ev.html !== undefined ? textEv : weissEv)[ev.r][ev.c].push(ev);
		});

		// Timeline-Blanks heißen "&nbsp;", die Trommel kennt " " — hier die
		// eine Übersetzungsstelle.
		const asDrum = (html: string) => (html === "&nbsp;" ? " " : html);

		// Uhr-Kachel: der Kreis ist das TROMMEL-SONDERZEICHEN ● (Fred 14.09.
		// abends, dritte Runde: "einfach in die Kette einfügen") — die
		// Kachel rattert dadurch wie ein Buchstabe durch die Trommel und
		// endet auf dem Kreis. Gerendert wird ● als Kreis-Span (lib,
		// SONDERZEICHEN); den Aufbau-Winkel liest jede Schicht per
		// var(--mo-uhr) von der KACHEL (inherits:true), deshalb laufen
		// Ober- und Unterhälfte nie auseinander.
		const UHR = "●";

		function seekInstant(T: number) {
			for (let r = 0; r < tiles.length; r++)
				for (let c = 0; c < tiles[r].length; c++) {
					const tile = tiles[r][c];
					let te: Ev | null = null;
					for (const ev of textEv[r][c]) { if (ev.t <= T) te = ev; else break; }
					resetInstant(tile, asDrum(te ? te.html! : " "));
					let we: Ev | null = null;
					for (const ev of weissEv[r][c]) { if (ev.t <= T) we = ev; else break; }
					const weiss = !!(we && we.weiss);
					if (weiss) resetInstant(tile, UHR);
					tile.el.classList.toggle("mo-weiss", weiss);
				}
		}

		// Ereignis → Kachel-Warteschlange (pro Kachel strikt geordnet):
		// Einzelzeichen rattern durch die Trommel (MAX_FLAPS-Deckel im
		// Modul), Logos wechseln mit EINER Doppelklappe. Uhr-Kacheln
		// klappen einmal echt auf; die mo-weiss-Klasse kippt am
		// Phasenwechsel, damit der Uhr-Aufbau (animation-delay) mit dem
		// Aufklappen startet. Weiss-AUS räumt nur die Klasse — der Abbau
		// klappt die Kachel ohnehin über sein paralleles Text-Event.
		function fireEvent(ev: Ev) {
			const tile = tiles[ev.r]?.[ev.c];
			if (!tile) return;
			if (ev.html !== undefined) {
				queueFlap(tile, asDrum(ev.html), FLAP_STEP_MS);
			} else if (ev.weiss) {
				// Die Uhr rattert als Trommel-Zeichen herein; die Klasse
				// startet am letzten Phasenwechsel den Winkel-Aufbau.
				queueFlap(tile, UHR, FLAP_STEP_MS, () =>
					tile.el.classList.add("mo-weiss"),
				);
			} else {
				enqueue(tile, () => {
					tile.el.classList.remove("mo-weiss");
				});
			}
		}

		let cancelled = false;
		let rafId = 0;
		let laufend = false;
		// 0 = Automatik (Endlos-Loop beider Akte); 1/2 = Fred-Schalter —
		// gewählter Akt spielt von vorn und hält auf seinem Endbild.
		let modus: 0 | 1 | 2 = 0;
		let T = 0;
		let gIdx = 0;
		let last = 0;

		function zeigeAktivenAkt() {
			const aktiv = modus !== 0 ? modus : T >= akt2StartT ? 2 : 1;
			schalter.forEach((b) =>
				b.classList.toggle("aktiv", Number(b.dataset.akt) === aktiv),
			);
		}

		function springeZu(startT: number) {
			T = startT;
			gIdx = events.findIndex((e) => e.t >= startT);
			if (gIdx === -1) gIdx = events.length;
			last = performance.now();
			seekInstant(startT);
		}

		function startLoop(vonT = 0) {
			if (cancelled) return;
			springeZu(vonT);
			const loop = (now: number) => {
				if (cancelled || !laufend) return;
				T += now - last;
				last = now;
				const halt = modus === 1 ? akt1EndeT : modus === 2 ? akt2EndeT : null;
				if (halt !== null && T >= halt) {
					// Standbild am Akt-Ende: restliche Ereignisse bis zum
					// Halt feuern, dann anhalten (kein weiterer rAF).
					while (gIdx < events.length && events[gIdx].t <= halt) {
						fireEvent(events[gIdx]);
						gIdx++;
					}
					T = halt;
					zeigeAktivenAkt();
					return;
				}
				if (T > total) {
					springeZu(0);
				}
				while (gIdx < events.length && events[gIdx].t <= T) {
					fireEvent(events[gIdx]);
					gIdx++;
				}
				zeigeAktivenAkt();
				rafId = requestAnimationFrame(loop);
			};
			rafId = requestAnimationFrame(loop);
		}

		schalter.forEach((b) => {
			b.addEventListener("click", () => {
				modus = Number(b.dataset.akt) === 2 ? 2 : 1;
				cancelAnimationFrame(rafId);
				laufend = true;
				startLoop(modus === 2 ? akt2StartT : 0);
				zeigeAktivenAkt();
			});
		});

		if (reduceMotion()) {
			// Fertiger Akt-1-Endzustand statisch (BAU-ANWEISUNG Punkt 3).
			seekInstant(akt1EndeT);
		} else {
			// VOLL an die Sichtbarkeit gekoppelt (Fred 14.09. abends: "wenn
			// der Viewport neu rein gescrollt wird, immer von vorne"): beim
			// Eintritt startet die Wand frisch bei T=0, beim Austritt hält
			// sie an und wird geleert (seekInstant killt via Generation auch
			// alle in der Luft hängenden Klappen). Kein Weiterlaufen mehr im
			// Verborgenen — das war zugleich die Quelle der Geister-Effekte
			// beim Hoch-/Runterscrollen.
			const io = new IntersectionObserver(
				(entries) => {
					const drin = entries.some((e) => e.isIntersecting);
					if (drin && !laufend) {
						laufend = true;
						startLoop();
					} else if (!drin && laufend) {
						laufend = false;
						modus = 0;
						cancelAnimationFrame(rafId);
						seekInstant(0);
					}
				},
				{ threshold: 0.2 },
			);
			io.observe(sektion);
			return () => {
				cancelled = true;
				io.disconnect();
				cancelAnimationFrame(rafId);
			};
		}
		return () => {
			cancelled = true;
			cancelAnimationFrame(rafId);
		};
	}

	let cleanupFns: Array<() => void> = [];
	function mountAll() {
		cleanupFns.forEach((fn) => fn());
		cleanupFns = [];
		document.querySelectorAll<HTMLElement>("[data-mo-tafel]").forEach((el) => {
			cleanupFns.push(setupTafel(el));
		});
	}
	document.addEventListener("astro:page-load", mountAll);
</script>

<style is:global>
