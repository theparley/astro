</span>

<style is:global>
	/* is:global: BrandLogo und Footer greifen auf die Teile zu (Dock-
	   Choreografie, Groessen), und die Klassen tragen einen eigenen Praefix. */
	.wortmarke {
		display: inline-block;
		font-family: "Forma DJR", Helvetica, Arial, sans-serif;
		font-weight: 900;
		font-optical-sizing: none;
		font-variation-settings: "opsz" 72;
		text-transform: lowercase;
		letter-spacing: 0;
		line-height: 1;
		white-space: nowrap;
	}
	.wortmarke__wort {
		display: inline-block;
	}
	.wortmarke__zeichen {
		display: inline-block;
		width: 0.2385em;
		height: 0.322em;
	}
	.wortmarke__zeichen svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	.wortmarke__zeichen--auf {
		vertical-align: -0.1485em;
		margin-right: 0.049em;
	}
	.wortmarke__zeichen--zu {
		vertical-align: 0.378em;
		margin-left: 0.049em;
	}
</style>
